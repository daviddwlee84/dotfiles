# Profiling: start a profiled shell with `ZSH_PROF=1 zsh`
if [[ -n "$ZSH_PROF" ]]; then
    zmodload zsh/zprof
fi

# ~/.zshrc - Interactive shell configuration
# Managed by chezmoi - do not edit directly

# =============================================================================
# Oh-My-Zsh Configuration
# =============================================================================

# Theme (disabled - using starship prompt instead)
ZSH_THEME=""

# Prevent zsh from overwriting tmux/tmuxp window names (only inside tmux)
# [[ -n "$TMUX" ]] && export DISABLE_AUTO_TITLE='true'
export DISABLE_AUTO_TITLE='true'

# Plugins (from $ZSH/plugins/ and $ZSH_CUSTOM/plugins/)
plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
{{- if .enableVimMode }}
    zsh-vi-mode
{{- end }}
)

{{ if .enableVimMode -}}
# zsh-vi-mode overrides all keybindings on init; re-source fzf bindings afterward
# so that Ctrl+R (history search), Ctrl+T (file search), Alt+C still work.
# fzf config moved to dot_config/shell/10_fzf.sh (shared with bash) — re-source
# from the new path; the zsh path here matches what load_modular_dir sees.
zvm_after_init() {
    [ -f "$XDG_CONFIG_HOME/shell/10_fzf.sh" ] && source "$XDG_CONFIG_HOME/shell/10_fzf.sh"
    # atuin Alt+R re-bind — see dot_config/shell/15_atuin.sh
    # (only the bindkey call needs replaying; atuin init already ran on first source)
    if (( ${+widgets[_atuin_search_widget]} )); then
        bindkey -M emacs '\er' _atuin_search_widget
        bindkey -M viins '\er' _atuin_search_widget
        bindkey -M vicmd '\er' _atuin_search_widget
    fi
    # aisuggest trigger (Alt+; default) — see dot_config/zsh/tools/05_aisuggest.zsh
    if (( ${+widgets[aisuggest]} )); then
        bindkey -M viins "${AISUGGEST_KEY:-^[;}" aisuggest
        bindkey -M vicmd "${AISUGGEST_KEY:-^[;}" aisuggest
        bindkey -M emacs "${AISUGGEST_KEY:-^[;}" aisuggest
    fi
    # keys-picker (Alt+/) — see dot_config/zsh/tools/13_keys_picker.zsh
    if (( ${+widgets[keys-picker]} )); then
        bindkey -M viins '\e/' keys-picker
        bindkey -M vicmd '\e/' keys-picker
        bindkey -M emacs '\e/' keys-picker
    fi
}
{{- else }}
# enableVimMode = false: no zsh-vi-mode plugin loaded → no keymap-wiping
# behavior to compensate for. The picker tools (atuin/aisuggest/keys-picker/
# fzf) call `bindkey -M emacs` at source-time and stick on first source —
# no zvm_after_init rebind hook needed. See docs/this_repo/vim-mode.md.
{{- end }}

# Oh-My-Zsh path
export ZSH="$HOME/.oh-my-zsh"

# Extra completion paths (must be set before oh-my-zsh runs compinit)
fpath+=~/.zfunc
[[ -d ~/.oh-my-zsh/custom/plugins/zsh-completions/src ]] && fpath=(~/.oh-my-zsh/custom/plugins/zsh-completions/src $fpath)
[[ -d ~/.docker/completions ]] && fpath=(~/.docker/completions $fpath)

{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64") -}}
# Skip compinit insecure directory warnings (e.g. /usr/local/share on Intel Macs)
# ZSH_DISABLE_COMPFIX=true
{{ end }}

# Load Oh-My-Zsh (also runs compinit)
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# =============================================================================
# Moved from .zshenv (seems Superset only load .zshrc but not .zshenv)
# =============================================================================

# XDG Base Directory Specification
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# Modular config directory
export ZSH_CONFIG_DIR="$XDG_CONFIG_HOME/zsh"

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew (macOS)
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{ end -}}

# =============================================================================
# Modular Configuration Loader
# =============================================================================

# Load all files matching $extension from $dir (sorted by filename).
# Used for the shared POSIX layer (.sh) and the zsh-only layer (.zsh).
# The sister bash equivalent (load_modular_dir in dot_bashrc.tmpl) shares
# the same name + signature so dot_config/shell/*.sh are sourced uniformly.
load_modular_dir() {
    local dir="$1"
    local ext="${2:-zsh}"
    [[ -d "$dir" ]] || return 0
    setopt local_options null_glob
    local f
    for f in "$dir"/*."$ext"; do
        [[ -r "$f" ]] && source "$f"
    done
}

# Load modular configs.
# Shared POSIX layer first — env/PATH/Homebrew shellenv, tool init wrappers
# (starship/mise/zoxide/direnv/thefuck), POSIX aliases. Both ~/.zshrc and
# ~/.bashrc source this dir so env stays consistent across shells.
load_modular_dir "$XDG_CONFIG_HOME/shell" sh
load_modular_dir "$ZSH_CONFIG_DIR" zsh
load_modular_dir "$ZSH_CONFIG_DIR/tools" zsh

# Load secrets (not tracked by chezmoi).
# Shared shell secrets (~/.shellrc.secrets) are POSIX-only and sourced by
# BOTH ~/.zshrc and ~/.bashrc — the canonical home for API keys / tokens
# that both shells need. Per-shell secrets (~/.config/zsh/secrets.zsh)
# layer on top for zsh-only constructs and override on conflict.
# Full design: docs/shells/adhoc-and-secrets.md
[[ -r "$HOME/.shellrc.secrets" ]] && source "$HOME/.shellrc.secrets" || true
[[ -r "$ZSH_CONFIG_DIR/secrets.zsh" ]] && source "$ZSH_CONFIG_DIR/secrets.zsh" || true

# =============================================================================
# Adhoc Configuration (not tracked by chezmoi)
# =============================================================================

# Create shared adhoc file if it doesn't exist (sourced by both zsh and bash).
if [[ ! -f "$HOME/.shellrc.adhoc" ]]; then
    cat > "$HOME/.shellrc.adhoc" << 'SHELLRC_ADHOC_EOF'
# ~/.shellrc.adhoc - Personal SHARED shell customizations (not tracked by chezmoi)
#
# This file is sourced by BOTH ~/.zshrc AND ~/.bashrc. Put anything POSIX-
# portable here so you don't have to duplicate it in ~/.zshrc.adhoc and
# ~/.bashrc.adhoc.
#
# HARD RULE: POSIX-only.
#   - No zsh-isms: no `setopt`, `compdef`, ZLE widgets, `read -q`, `${m:t}`,
#     glob qualifiers, `bindkey`. Put those in ~/.zshrc.adhoc instead.
#   - No bash-isms: no `bind -x`, `ble-bind`, `shopt`, `complete -F`. Put
#     those in ~/.bashrc.adhoc instead.
#   - If you need shell-specific logic, dispatch via $ZSH_VERSION /
#     $BASH_VERSION (same convention as ~/.config/shell/*.sh):
#       if [ -n "$ZSH_VERSION" ]; then ...
#       elif [ -n "$BASH_VERSION" ]; then ...
#       fi
#
# Sourced AFTER ~/.shellrc.secrets, BEFORE the per-shell ~/.{zsh,bash}rc.adhoc
# (per-shell wins on conflict). See docs/shells/adhoc-and-secrets.md.
#
# Example:
# export MY_SHARED_VAR="hello from both shells"
# alias ll='ls -lah'

SHELLRC_ADHOC_EOF
fi

# Source shared adhoc (POSIX, both shells).
[[ -r "$HOME/.shellrc.adhoc" ]] && source "$HOME/.shellrc.adhoc"

# Create zsh-only adhoc file if it doesn't exist
if [[ ! -f "$HOME/.zshrc.adhoc" ]]; then
    cat > "$HOME/.zshrc.adhoc" << 'ADHOC_EOF'
# ~/.zshrc.adhoc - Personal ZSH-ONLY shell customizations (not tracked by chezmoi)
#
# Use this file for:
#   - Quick experiments with zsh-only constructs (ZLE widgets, `bindkey`,
#     `setopt`, `compdef`, `read -q`, `${m:t}`, glob qualifiers)
#   - Machine-specific zsh-only configurations
#   - Testing before adding to chezmoi-managed configs
#
# For anything POSIX-portable that should also affect bash, prefer
# ~/.shellrc.adhoc instead. See docs/shells/adhoc-and-secrets.md.
#
# This file is sourced at the end of ~/.zshrc, AFTER ~/.shellrc.adhoc, so
# settings here override the shared layer on conflict.
# Changes here take effect on new shell sessions (or run: source ~/.zshrc.adhoc)

# Example:
# alias myalias='echo "Hello from adhoc!"'
# export MY_VAR="my_value"

ADHOC_EOF
fi

# Source zsh-only adhoc (per-shell wins over ~/.shellrc.adhoc on conflict).
[[ -r "$HOME/.zshrc.adhoc" ]] && source "$HOME/.zshrc.adhoc"

# Profiling: output results
if [[ -n "$ZSH_PROF" ]]; then
    zprof
fi
