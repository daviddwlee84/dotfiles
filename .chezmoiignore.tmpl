# -----------------------------------------------------------------------------
# Editor overlays (VSCode / Cursor / Antigravity)
#
# Source files live in two parallel trees to keep a single overlay template
# usable on both platforms:
#
#   macOS:  Library/Application Support/<Editor>/User/{modify_settings.json,keybindings.json}.tmpl
#   Linux:  .config/<Editor>/User/{modify_settings.json,keybindings.json}.tmpl
#
# Gates below:
#   1. OS-mismatch  -> ignore the tree that doesn't apply to this OS
#   2. Editor-absent -> ignore per-editor paths when the editor isn't installed
#                       (avoids creating phantom ~/Library/.../Antigravity dirs
#                        on machines without that editor)
# -----------------------------------------------------------------------------

{{- if ne .chezmoi.os "darwin" }}
Library
Library/**
{{- end }}

{{- if ne .chezmoi.os "linux" }}
.config/Code
.config/Code/**
.config/Cursor
.config/Cursor/**
.config/Antigravity
.config/Antigravity/**
{{- end }}

{{- range (list "Code" "Cursor" "Antigravity") }}
{{- if eq $.chezmoi.os "darwin" }}
{{- if not (stat (joinPath $.chezmoi.homeDir "Library/Application Support" .)) }}
Library/Application Support/{{ . }}
Library/Application Support/{{ . }}/**
{{- end }}
{{- else if eq $.chezmoi.os "linux" }}
{{- if not (stat (joinPath $.chezmoi.homeDir ".config" .)) }}
.config/{{ . }}
.config/{{ . }}/**
{{- end }}
{{- end }}
{{- end }}

# -----------------------------------------------------------------------------
# Coding-agent CLI overlays (Cursor / OpenCode / Codex)
#
# Each tree ships a `modify_*` overlay that enforces a small set of stable
# preferences over the live config file. Everything else (auth tokens,
# per-project trust, plugin caches, sessions, telemetry) stays as machine-
# local state and is intentionally NOT tracked.
#
# Presence gates below skip the entire tree when the CLI isn't installed,
# so we don't create phantom ~/.cursor/ etc. dirs on fresh machines.
# -----------------------------------------------------------------------------

{{- if not (stat (joinPath .chezmoi.homeDir ".cursor")) }}
.cursor
.cursor/**
{{- end }}

{{- if not (stat (joinPath .chezmoi.homeDir ".codex")) }}
.codex
.codex/**
{{- end }}

{{- if not (stat (joinPath .chezmoi.homeDir ".config" "opencode")) }}
.config/opencode
.config/opencode/**
{{- end }}

# -----------------------------------------------------------------------------
# CodeIsland-owned hook sidecars (macOS-only HUD app, see
# docs/tools/agent-overlays.md → "CodeIsland integration").
#
# These files are written and auto-repaired by the CodeIsland.app on every
# launch. They MUST NOT be checked into the source tree — if accidentally
# `chezmoi add`-ed they would clobber CodeIsland's runtime updates and
# create a ping-pong with the app's auto-installer. The Claude
# settings.json overlay uses a hook-aware merger to coexist with
# CodeIsland's parallel entries; for these dedicated sidecars we leave
# the file fully unmanaged.
#
# Always-ignore (regardless of OS / dir presence) because the only sane
# state on machines without CodeIsland is "doesn't exist".
# -----------------------------------------------------------------------------
.codex/hooks.json
.cursor/hooks.json
.copilot/hooks/codeisland.json
.copilot/hooks/**
.gemini/settings.json
.antigravity/settings.json
