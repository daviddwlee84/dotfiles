# niri compositor config — only manage on Linux when installNiri=true
# (ubuntu_desktop). hasKey guard so hosts whose chezmoi.toml predates the
# installNiri prompt don't error.
{{- $installNiri := false }}{{ if hasKey . "installNiri" }}{{ $installNiri = .installNiri }}{{ end }}
{{- if or (ne .chezmoi.os "linux") (not $installNiri) }}
.config/niri
.config/niri/**
{{- end }}

# AeroSpace config (XDG) — macOS-only tiling WM, installed via the cask in
# Brewfile.darwin.tmpl (gated by installBrewApps). Only manage on darwin when
# installBrewApps=true. Legacy ~/.aerospace.toml is removed by .chezmoiremove
# to avoid AeroSpace's both-configs-present ambiguity error.
{{- $installBrewApps := false }}{{ if hasKey . "installBrewApps" }}{{ $installBrewApps = .installBrewApps }}{{ end }}
{{- if or (ne .chezmoi.os "darwin") (not $installBrewApps) }}
.config/aerospace
.config/aerospace/**
{{- end }}

# Rime user config — only manage when installInputMethod=true, and only the tree
# for this OS (macOS/Squirrel reads ~/Library/Rime, Linux/ibus-rime reads
# ~/.config/ibus/rime). The portable bodies live in .chezmoitemplates/rime/ and
# are byte-identical to dotfiles-windows'; only squirrel.custom.yaml is
# macOS-specific. The runtime files Rime writes alongside them (user.yaml,
# installation.yaml, build/, *.userdb/) stay unmanaged on purpose — see
# docs/input_methods/README.md.
{{- $installInputMethod := false }}{{ if hasKey . "installInputMethod" }}{{ $installInputMethod = .installInputMethod }}{{ end }}
{{- if or (ne .chezmoi.os "darwin") (not $installInputMethod) }}
Library/Rime
Library/Rime/**
{{- end }}
{{- if or (ne .chezmoi.os "linux") (not $installInputMethod) }}
.config/ibus
.config/ibus/**
{{- end }}

# -----------------------------------------------------------------------------
# Editor overlays (VSCode / Cursor / Antigravity)
#
# Source files live in two parallel trees to keep a single overlay template
# usable on both platforms:
#
#   macOS:  Library/Application Support/<Editor>/User/{modify_settings.json,keybindings.json}.tmpl
#   Linux:  .config/<Editor>/User/{modify_settings.json,keybindings.json}.tmpl
#
# Gates below:
#   1. OS-mismatch  -> ignore the tree that doesn't apply to this OS
#   2. Editor-absent -> ignore per-editor paths when the editor isn't installed
#                       (avoids creating phantom ~/Library/.../Antigravity dirs
#                        on machines without that editor)
# -----------------------------------------------------------------------------

{{- if ne .chezmoi.os "darwin" }}
Library
Library/**
{{- end }}

{{- if ne .chezmoi.os "linux" }}
.config/Code
.config/Code/**
.config/Cursor
.config/Cursor/**
.config/Antigravity
.config/Antigravity/**
# TV channels that only make sense on Linux (sudo lives in unified log on
# macOS; macOS has no auditd — see docs/sysadmin/atuin-vs-audit.md).
.config/television/cable/sudo-history.toml
.config/television/cable/audit-events.toml
{{- end }}

{{- range (list "Code" "Cursor" "Antigravity") }}
{{- if eq $.chezmoi.os "darwin" }}
{{- if not (stat (joinPath $.chezmoi.homeDir "Library/Application Support" .)) }}
Library/Application Support/{{ . }}
Library/Application Support/{{ . }}/**
{{- end }}
{{- else if eq $.chezmoi.os "linux" }}
{{- if not (stat (joinPath $.chezmoi.homeDir ".config" .)) }}
.config/{{ . }}
.config/{{ . }}/**
{{- end }}
{{- end }}
{{- end }}

# -----------------------------------------------------------------------------
# Coding-agent CLI overlays (Cursor / OpenCode / Codex)
#
# Each tree ships a `modify_*` overlay that enforces a small set of stable
# preferences over the live config file. Everything else (auth tokens,
# per-project trust, plugin caches, sessions, telemetry) stays as machine-
# local state and is intentionally NOT tracked.
#
# Presence gates below skip the entire tree when the CLI isn't installed,
# so we don't create phantom ~/.cursor/ etc. dirs on fresh machines.
# -----------------------------------------------------------------------------

{{- if not (stat (joinPath .chezmoi.homeDir ".cursor")) }}
.cursor
.cursor/**
{{- end }}

{{- if not (stat (joinPath .chezmoi.homeDir ".codex")) }}
.codex
.codex/**
{{- end }}

{{- if not (stat (joinPath .chezmoi.homeDir ".config" "opencode")) }}
.config/opencode
.config/opencode/**
{{- end }}

# -----------------------------------------------------------------------------
# CodeIsland-owned hook sidecars (macOS-only HUD app, see
# docs/tools/agent-overlays.md → "CodeIsland integration").
#
# These files are written and auto-repaired by the CodeIsland.app on every
# launch. They MUST NOT be tracked as plain files: that would clobber runtime
# updates and create a ping-pong with the app's auto-installer. Claude and
# Codex instead use hook-aware modify_ mergers; the remaining pure sidecars
# below stay fully unmanaged.
#
# Always-ignore (regardless of OS / dir presence) because the only sane
# state on machines without CodeIsland is "doesn't exist".
# -----------------------------------------------------------------------------
.cursor/hooks.json
.copilot/hooks/codeisland.json
.copilot/hooks/**
.gemini/settings.json
.antigravity/settings.json
