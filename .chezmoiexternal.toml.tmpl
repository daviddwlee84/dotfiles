# https://www.chezmoi.io/reference/special-files-and-directories/chezmoiexternal-format/
# https://www.chezmoi.io/user-guide/include-files-from-elsewhere/
#
# Upstream sources that used to be cloned/downloaded by Ansible are declared
# here so chezmoi can refresh them automatically on `chezmoi apply`.
#
# refreshPeriod = "168h" -> re-pull once a week. Force an immediate refresh
# with `chezmoi apply --refresh-externals`.
#
# All git-repo entries use --depth 1 (shallow) and --ff-only on pull so a
# dirty working tree in the clone won't be clobbered silently.

# -----------------------------------------------------------------------------
# Oh-My-Zsh core + custom plugins
# -----------------------------------------------------------------------------
# Nested externals are safe: chezmoi does `git pull` on refresh (not re-clone),
# so plugin subdirs under .oh-my-zsh/custom/plugins/ are preserved.

[".oh-my-zsh"]
    type = "git-repo"
    url = "https://github.com/ohmyzsh/ohmyzsh.git"
    refreshPeriod = "168h"
    [".oh-my-zsh".clone]
        args = ["--depth", "1"]
    [".oh-my-zsh".pull]
        args = ["--ff-only"]

[".oh-my-zsh/custom/plugins/zsh-autosuggestions"]
    type = "git-repo"
    url = "https://github.com/zsh-users/zsh-autosuggestions.git"
    refreshPeriod = "168h"
    [".oh-my-zsh/custom/plugins/zsh-autosuggestions".clone]
        args = ["--depth", "1"]
    [".oh-my-zsh/custom/plugins/zsh-autosuggestions".pull]
        args = ["--ff-only"]

[".oh-my-zsh/custom/plugins/zsh-syntax-highlighting"]
    type = "git-repo"
    url = "https://github.com/zsh-users/zsh-syntax-highlighting.git"
    refreshPeriod = "168h"
    [".oh-my-zsh/custom/plugins/zsh-syntax-highlighting".clone]
        args = ["--depth", "1"]
    [".oh-my-zsh/custom/plugins/zsh-syntax-highlighting".pull]
        args = ["--ff-only"]

[".oh-my-zsh/custom/plugins/zsh-completions"]
    type = "git-repo"
    url = "https://github.com/zsh-users/zsh-completions.git"
    refreshPeriod = "168h"
    [".oh-my-zsh/custom/plugins/zsh-completions".clone]
        args = ["--depth", "1"]
    [".oh-my-zsh/custom/plugins/zsh-completions".pull]
        args = ["--ff-only"]

{{ if .enableVimMode -}}
[".oh-my-zsh/custom/plugins/zsh-vi-mode"]
    type = "git-repo"
    url = "https://github.com/jeffreytse/zsh-vi-mode.git"
    refreshPeriod = "168h"
    [".oh-my-zsh/custom/plugins/zsh-vi-mode".clone]
        args = ["--depth", "1"]
    [".oh-my-zsh/custom/plugins/zsh-vi-mode".pull]
        args = ["--ff-only"]
{{- end }}

# -----------------------------------------------------------------------------
# Oh-My-Bash core (sister of oh-my-zsh; all platforms).
# -----------------------------------------------------------------------------
# Cloned regardless of primaryShell so `bash` works ad-hoc on zsh-primary
# hosts. Source order in dot_bashrc.tmpl is presence-gated, so a missing
# clone (mid-bootstrap, network failure) just falls back to plain bash +
# starship. OMB's autosuggestions / syntax-highlighting / history-substring-
# search plugins are deliberately NOT enabled in dot_config/bash/01_omb_plugins
# because ble.sh provides better native versions and double-init causes
# flicker + duplicate-completion bugs.
#
# We do NOT use OMB's installer (`tools/install.sh`) — it destructively `mv`s
# ~/.bashrc to .bashrc.omb-backup-<date>. chezmoi already manages dot_bashrc,
# so we just clone OMB's source tree and source oh-my-bash.sh from our bashrc.

[".oh-my-bash"]
    type = "git-repo"
    url = "https://github.com/ohmybash/oh-my-bash.git"
    refreshPeriod = "168h"
    [".oh-my-bash".clone]
        args = ["--depth", "1"]
    [".oh-my-bash".pull]
        args = ["--ff-only"]

# -----------------------------------------------------------------------------
# ble.sh (Bash Line Editor; all platforms; bash 4.0+)
# -----------------------------------------------------------------------------
# Provides zsh-style autosuggestions / syntax-highlighting / vi-mode for bash.
# Init order in dot_bashrc.tmpl is load-bearing — see the 12-step header
# comment there. Compiled artefact lives at ~/.local/share/blesh/ble.sh,
# regenerated by `.chezmoiscripts/global/run_onchange_after_25_install_blesh
# .sh.tmpl` whenever the source clone HEAD changes.
#
# Submodules: ble.sh depends on a `contrib` submodule that ships extras
# (color themes, integration helpers). The upstream README explicitly
# recommends `git clone --recursive`; we pass --recurse-submodules to the
# clone and --recurse-submodules to the pull so the submodule tree stays
# fresh on the weekly refresh.

[".local/share/blesh"]
    type = "git-repo"
    url = "https://github.com/akinomyoga/ble.sh.git"
    refreshPeriod = "168h"
    [".local/share/blesh".clone]
        args = ["--depth", "1", "--recurse-submodules", "--shallow-submodules"]
    [".local/share/blesh".pull]
        args = ["--ff-only", "--recurse-submodules"]

# -----------------------------------------------------------------------------
# TPM (Tmux Plugin Manager) -- all platforms
# -----------------------------------------------------------------------------
# The `tpm install_plugins` step that populates ~/.tmux/plugins/* stays in
# the ansible `devtools` role (it needs a running tmux + the tmux config).

[".tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm.git"
    refreshPeriod = "168h"
    [".tmux/plugins/tpm".clone]
        args = ["--depth", "1"]
    [".tmux/plugins/tpm".pull]
        args = ["--ff-only"]

{{ if ne .chezmoi.os "darwin" -}}
# -----------------------------------------------------------------------------
# fzf (Linux only)
# -----------------------------------------------------------------------------
# macOS installs fzf via Homebrew (see roles/lazyvim_deps). On Linux the apt
# package is too old and lacks `--zsh`, so we clone upstream and let ansible
# run `~/.fzf/install --bin` to populate ~/.fzf/bin/fzf.

[".fzf"]
    type = "git-repo"
    url = "https://github.com/junegunn/fzf.git"
    refreshPeriod = "168h"
    [".fzf".clone]
        args = ["--depth", "1"]
    [".fzf".pull]
        args = ["--ff-only"]
{{ end -}}

# -----------------------------------------------------------------------------
# toolkami.rb (single-file Ruby tool, sourced by dot_config/zsh/tools/33_toolkami.zsh)
# -----------------------------------------------------------------------------
# Harmless to always download: the zsh autoloader only eval's it when ruby is
# available, so noRoot machines without ruby just ignore the file.
#
# Path lives under .local/share/ (XDG data dir) on purpose — putting it
# directly at .local/toolkami.rb made chezmoi imply ownership of ~/.local
# itself with mode 0775, which then conflicted with system-set 0700/0755
# on every apply ("mode-only diff" on .local). Nesting under share/
# pushes the chezmoi-implied parent down to a directory nobody else
# manages, eliminating the drift.

[".local/share/toolkami/toolkami.rb"]
    type = "file"
    url = "https://raw.githubusercontent.com/aperoc/toolkami/refs/heads/main/toolkami.rb"
    refreshPeriod = "168h"
    executable = true
