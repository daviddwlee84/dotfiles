#!/bin/bash
# Re-run ansible when any role changes
# Triggers on changes to any role's tasks or defaults files
# Profile: {{ .profile }}

# === Role Hashes (changes trigger re-run) ===
# homebrew: {{ include "dot_ansible/roles/homebrew/tasks/main.yml" | sha256sum }}
# base: {{ include "dot_ansible/roles/base/tasks/main.yml" | sha256sum }}
# zsh tasks: {{ include "dot_ansible/roles/zsh/tasks/main.yml" | sha256sum }}
# zsh defaults: {{ include "dot_ansible/roles/zsh/defaults/main.yml" | sha256sum }}
# neovim tasks: {{ include "dot_ansible/roles/neovim/tasks/main.yml" | sha256sum }}
# neovim defaults: {{ include "dot_ansible/roles/neovim/defaults/main.yml" | sha256sum }}
# lazyvim_deps tasks: {{ include "dot_ansible/roles/lazyvim_deps/tasks/main.yml" | sha256sum }}
# lazyvim_deps defaults: {{ include "dot_ansible/roles/lazyvim_deps/defaults/main.yml" | sha256sum }}
# devtools: {{ include "dot_ansible/roles/devtools/tasks/main.yml" | sha256sum }}
# docker: {{ include "dot_ansible/roles/docker/tasks/main.yml" | sha256sum }}
# nerdfonts: {{ include "dot_ansible/roles/nerdfonts/tasks/main.yml" | sha256sum }}
# coding_agents tasks: {{ include "dot_ansible/roles/coding_agents/tasks/main.yml" | sha256sum }}
# coding_agents defaults: {{ include "dot_ansible/roles/coding_agents/defaults/main.yml" | sha256sum }}
# bitwarden tasks: {{ include "dot_ansible/roles/bitwarden/tasks/main.yml" | sha256sum }}
# bitwarden defaults: {{ include "dot_ansible/roles/bitwarden/defaults/main.yml" | sha256sum }}
# security_tools: {{ include "dot_ansible/roles/security_tools/tasks/main.yml" | sha256sum }}
# python_uv_tools tasks: {{ include "dot_ansible/roles/python_uv_tools/tasks/main.yml" | sha256sum }}
# python_uv_tools defaults: {{ include "dot_ansible/roles/python_uv_tools/defaults/main.yml" | sha256sum }}
# js_cli_tools tasks: {{ include "dot_ansible/roles/js_cli_tools/tasks/main.yml" | sha256sum }}
# js_cli_tools defaults: {{ include "dot_ansible/roles/js_cli_tools/defaults/main.yml" | sha256sum }}
# llm_tools tasks: {{ include "dot_ansible/roles/llm_tools/tasks/main.yml" | sha256sum }}
# llm_tools defaults: {{ include "dot_ansible/roles/llm_tools/defaults/main.yml" | sha256sum }}
# rust_cargo_tools tasks: {{ include "dot_ansible/roles/rust_cargo_tools/tasks/main.yml" | sha256sum }}
# rust_cargo_tools defaults: {{ include "dot_ansible/roles/rust_cargo_tools/defaults/main.yml" | sha256sum }}
# ruby_gem_tools tasks: {{ include "dot_ansible/roles/ruby_gem_tools/tasks/main.yml" | sha256sum }}
# ruby_gem_tools defaults: {{ include "dot_ansible/roles/ruby_gem_tools/defaults/main.yml" | sha256sum }}
# starship: {{ include "dot_ansible/roles/starship/tasks/main.yml" | sha256sum }}
# input_method: {{ include "dot_ansible/roles/input_method/tasks/main.yml" | sha256sum }}
# networking_tools: {{ include "dot_ansible/roles/networking_tools/tasks/main.yml" | sha256sum }}
# iac_tools tasks: {{ include "dot_ansible/roles/iac_tools/tasks/main.yml" | sha256sum }}
# iac_tools defaults: {{ include "dot_ansible/roles/iac_tools/defaults/main.yml" | sha256sum }}
# dotnet_tools tasks: {{ include "dot_ansible/roles/dotnet_tools/tasks/main.yml" | sha256sum }}
# dotnet_tools defaults: {{ include "dot_ansible/roles/dotnet_tools/defaults/main.yml" | sha256sum }}
# alacritty: {{ include "dot_ansible/roles/alacritty/tasks/main.yml" | sha256sum }}

set -e
export PATH="$HOME/.local/bin:$PATH"

# Override locale to a safe default so ansible can start even before locale
# packages are installed (e.g. en_US.UTF-8 not yet generated on a fresh machine).
export LC_ALL=C.UTF-8
export LANG=C.UTF-8

# --- Shared sudo session (see scripts/lib/sudo_shared.sh for full docs)
# Inlined at template-render time so this script carries the helper body.
# bootstrap has already prompted + spawned a watchdog in the normal flow;
# the idempotent `sudo_session_init` below just re-exports the env vars
# and (re)registers the INT/TERM/HUP abort trap. It will prompt here only
# when the user ran ansible manually without the bootstrap phase.
{{ include "scripts/lib/sudo_shared.sh" }}
# --- end sudo helper

# Whether ANY sudo surface is exercised in this run. Linux ansible always
# needs sudo unless noRoot. On macOS only the input_method role needs sudo.
NEED_SUDO={{ if or (and (eq .chezmoi.os "linux") (not .noRoot)) (and (eq .chezmoi.os "darwin") .installInputMethod) }}1{{ else }}0{{ end }}

# Setup Homebrew PATH so brew subprocesses can find sibling tools like git-lfs.
{{ if eq .chezmoi.os "darwin" -}}
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{ else -}}
# Linuxbrew
if [[ -d /home/linuxbrew/.linuxbrew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -d "$HOME/.linuxbrew" ]]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
fi
{{ end -}}

{{ if .useChineseMirror -}}
# GFW mirrors (useChineseMirror=true) — exported so ansible subprocesses
# (community.general.homebrew, mise, rustup, gem) inherit them. Without
# this, ghcr.io bottle downloads frequently fail with
# `curl: (18) Transferred a partial file` and rust-lang.org / nodejs.org
# downloads time out on constrained networks.
# Ref: https://mirrors.tuna.tsinghua.edu.cn/help/
export HOMEBREW_API_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/api"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles"
export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/brew.git"
export HOMEBREW_CORE_GIT_REMOTE="https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/homebrew-core.git"
export RUSTUP_DIST_SERVER="https://mirrors.tuna.tsinghua.edu.cn/rustup"
export RUSTUP_UPDATE_ROOT="https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup"
export MISE_NODE_MIRROR_URL="https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/"
export NODE_BUILD_MIRROR_URL="https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/"
{{ end -}}

# Colors
info() { echo -e "\033[0;34m[INFO]\033[0m $1"; }
success() { echo -e "\033[0;32m[SUCCESS]\033[0m $1"; }
warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; }

ANSIBLE_DIR="$HOME/.ansible"
export ANSIBLE_CONFIG="$ANSIBLE_DIR/ansible.cfg"
INVENTORY="$ANSIBLE_DIR/inventories/localhost.ini"

command -v ansible-playbook &> /dev/null || { warn "ansible-playbook not found"; exit 0; }

# === Profile-based tag selection ===
# Profile: {{ .profile }}
#
# Tag categories:
#   Core:    base, zsh, starship, neovim, lazyvim_deps, security_tools
#   Desktop: devtools, docker, nerdfonts
#   Server:  devtools, docker (no nerdfonts - no GUI)
#   macOS:   homebrew
#   Optional: coding_agents, bitwarden, python_uv_tools, llm_tools, rust_cargo_tools, ruby_gem_tools

{{ if eq .chezmoi.os "darwin" -}}
PLAYBOOK="$ANSIBLE_DIR/playbooks/macos.yml"
# macOS: full desktop experience
TAGS="homebrew,base,zsh,starship,neovim,lazyvim_deps,devtools,docker,nerdfonts,security_tools,rust_cargo_tools,ruby_gem_tools,alacritty"
{{ else if eq .profile "ubuntu_desktop" -}}
PLAYBOOK="$ANSIBLE_DIR/playbooks/linux.yml"
# Ubuntu Desktop: full desktop experience (no homebrew)
TAGS="base,zsh,starship,neovim,lazyvim_deps,devtools,docker,nerdfonts,security_tools,rust_cargo_tools,ruby_gem_tools,alacritty"
{{ else if eq .profile "ubuntu_server" -}}
PLAYBOOK="$ANSIBLE_DIR/playbooks/linux.yml"
# Ubuntu Server: no GUI stuff (no nerdfonts)
TAGS="base,zsh,starship,neovim,lazyvim_deps,devtools,docker,security_tools,rust_cargo_tools,ruby_gem_tools"
{{ else -}}
warn "Unknown profile: {{ .profile }}"
exit 0
{{ end -}}

# Add optional tags based on chezmoi config
{{ if .installCodingAgents -}}
TAGS="${TAGS},coding_agents"
{{ end -}}
{{ $installBitwarden := false }}{{ if hasKey . "installBitwarden" }}{{ $installBitwarden = .installBitwarden }}{{ end -}}
{{ if $installBitwarden -}}
TAGS="${TAGS},bitwarden"
{{ end -}}
{{ if .installPythonUvTools -}}
TAGS="${TAGS},python_uv_tools"
{{ end -}}
{{ $installJsCliTools := false }}{{ if hasKey . "installJsCliTools" }}{{ $installJsCliTools = .installJsCliTools }}{{ end -}}
{{ if $installJsCliTools -}}
TAGS="${TAGS},js_cli_tools"
{{ end -}}
{{ $installLlmTools := false }}{{ if hasKey . "installLlmTools" }}{{ $installLlmTools = .installLlmTools }}{{ end -}}
{{ if $installLlmTools -}}
TAGS="${TAGS},llm_tools"
{{ end -}}
{{ $installInputMethod := false }}{{ if hasKey . "installInputMethod" }}{{ $installInputMethod = .installInputMethod }}{{ end -}}
{{ if $installInputMethod -}}
TAGS="${TAGS},input_method"
{{ end -}}
{{ $installNetworkingTools := false }}{{ if hasKey . "installNetworkingTools" }}{{ $installNetworkingTools = .installNetworkingTools }}{{ end -}}
{{ if $installNetworkingTools -}}
TAGS="${TAGS},networking_tools"
{{ end -}}
{{ $installIacTools := false }}{{ if hasKey . "installIacTools" }}{{ $installIacTools = .installIacTools }}{{ end -}}
{{ if $installIacTools -}}
TAGS="${TAGS},iac_tools"
{{ end -}}
{{ $installDotnetTools := false }}{{ if hasKey . "installDotnetTools" }}{{ $installDotnetTools = .installDotnetTools }}{{ end -}}
{{ if $installDotnetTools -}}
TAGS="${TAGS},dotnet_tools"
{{ end -}}

# Extra vars for role-level configuration
EXTRA_VARS=""
{{ if and $installBitwarden (or (eq .chezmoi.os "darwin") (eq .profile "ubuntu_desktop")) -}}
# Install Bitwarden Desktop app (for SSH agent) on desktop profiles
EXTRA_VARS="bitwarden_install_desktop=true"
{{ end -}}
{{ if $installLlmTools -}}
if [[ -z "$EXTRA_VARS" ]]; then
    EXTRA_VARS="llm_tools_install_brew_apps={{ .installBrewApps }}"
else
    EXTRA_VARS="$EXTRA_VARS llm_tools_install_brew_apps={{ .installBrewApps }}"
fi
{{ end -}}

[[ -f "$PLAYBOOK" ]] || { warn "Playbook not found: $PLAYBOOK"; exit 0; }

# === Handle sudo (delegated to scripts/lib/sudo_shared.sh) ==================
# The helper (sudo_session_init) is idempotent: if bootstrap already prompted
# the user and spawned the watchdog, this call just re-exports the env vars.
# If ansible is run standalone (bypassing bootstrap), it prompts here instead.
#
# After init we classify via sudo_session_skip_reason:
#   "cached"           -> pass $CHEZMOI_ANSIBLE_BECOME_FILE to ansible via -e @
#   "passwordless"     -> no become password needed
#   "non-interactive"  -> caller-specific fallback (below)
# Importantly we DO NOT run `sudo -k` here anymore — doing so would throw away
# the bootstrap-era cache and force a second prompt for the ansible phase.
BECOME_FLAGS=""
{{ if eq .chezmoi.os "darwin" -}}
{{ $noRoot := false }}{{ if hasKey . "noRoot" }}{{ $noRoot = .noRoot }}{{ end -}}
{{ if $noRoot -}}
info "noRoot mode enabled on macOS - skipping input_method (requires sudo for pkg installers)"
TAGS="${TAGS//,input_method/}"
{{ else -}}
# input_method role uses Homebrew cask pkg installers (Squirrel) which invoke
# `sudo /usr/sbin/installer` internally. Pre-warm the sudo timestamp via the
# shared helper so the non-TTY child process finds a live ticket.
if [[ "$NEED_SUDO" == "1" ]]; then
    if sudo_session_init "ansible"; then
        case "$(sudo_session_skip_reason)" in
            cached)
                # Refresh the current TTY's sudo timestamp so the cask child
                # `sudo /usr/sbin/installer` finds a live ticket (it does not
                # accept a piped password). The watchdog keeps it warm every 50s.
                sudo_session_warm_cache || warn "sudo_session_warm_cache failed; pkg casks may still prompt"
                ;;
            passwordless)
                info "Passwordless sudo detected"
                ;;
            non-interactive | "")
                warn "Non-interactive mode without passwordless sudo - pkg-based casks may be skipped"
                ;;
        esac
    else
        warn "Sudo session could not be established - pkg-based casks may be skipped"
    fi
fi
{{ end -}}
{{ else -}}
{{ $noRoot := false }}{{ if hasKey . "noRoot" }}{{ $noRoot = .noRoot }}{{ end -}}
{{ if $noRoot -}}
# noRoot mode: skip all sudo-requiring tasks, user-level fallbacks will install tools
info "noRoot mode enabled - installing user-level tools to ~/.local/bin"
info ""
info "The following tools will be installed without sudo:"
info "  neovim, fzf, lazygit, gh, diffnav, ripgrep, fd, jq, just, bat, eza, delta,"
info "  yazi, zellij, btop, gitleaks, zoxide, tldr, pre-commit, thefuck,"
info "  duckdb, rclone, litellm, llmfit, models"
info ""
info "The following tools require sudo (ask your administrator):"
info "  git, curl, wget, zsh, tmux, htop, direnv, build-essential, docker, ollama"
info ""
info "Suggested command for your administrator:"
info "  sudo apt install git curl wget zsh tmux htop direnv build-essential tree"
info ""
BECOME_FLAGS="--skip-tags sudo"
# Ruby can't compile without libffi-dev (requires sudo on Ubuntu)
TAGS="${TAGS//,ruby_gem_tools/}"
{{ if $installLlmTools -}}
if [[ -z "$EXTRA_VARS" ]]; then
    EXTRA_VARS="llm_tools_no_root=true"
else
    EXTRA_VARS="$EXTRA_VARS llm_tools_no_root=true"
fi
{{ end -}}
{{ else -}}
# Non-noRoot Linux: the shared helper gives us one of three outcomes.
if ! sudo_session_init "ansible"; then
    warn "Non-interactive mode without passwordless sudo and no /dev/tty access"
    warn "Skipping ansible run. To complete setup, run manually:"
    warn ""
    warn "  cd ~/.ansible && ansible-playbook -i inventories/localhost.ini \\"
    warn "    $PLAYBOOK \\"
    warn "    --tags '$TAGS' --ask-become-pass"
    warn ""
    warn "Or grant passwordless sudo:"
    warn "  echo '$USER ALL=(ALL) NOPASSWD:ALL' | sudo tee /etc/sudoers.d/$USER"
    exit 0
fi
case "$(sudo_session_skip_reason)" in
    cached)
        info "Sudo session active (password cached; ansible becomes via -e @ans-become.yml)"
        BECOME_FLAGS="-e @$CHEZMOI_ANSIBLE_BECOME_FILE"
        ;;
    passwordless)
        info "Passwordless sudo detected"
        BECOME_FLAGS=""
        ;;
    non-interactive | "")
        # Shouldn't hit this after a successful sudo_session_init, but keep
        # the manual-command fallback in case probes contradict each other.
        warn "Sudo state inconsistent after session init; falling back to manual instructions"
        warn "  cd ~/.ansible && ansible-playbook -i inventories/localhost.ini \\"
        warn "    $PLAYBOOK \\"
        warn "    --tags '$TAGS' --ask-become-pass"
        exit 0
        ;;
esac
{{ end -}}
{{ end -}}

info "Profile: {{ .profile }}"
info "Re-running ansible with tags: $TAGS"
EXTRA_VARS_ARGS=()
[[ -n "$EXTRA_VARS" ]] && EXTRA_VARS_ARGS=(--extra-vars "$EXTRA_VARS")

{{ $allowPartialFailure := false }}{{ if hasKey . "allowPartialFailure" }}{{ $allowPartialFailure = .allowPartialFailure }}{{ end -}}
{{ if $allowPartialFailure -}}
# Best-effort mode: run each tag separately so one failure doesn't block others
info "allowPartialFailure=true: running each tag independently"
FAILED_TAGS=()
IFS=',' read -ra TAG_ARRAY <<< "$TAGS"
for tag in "${TAG_ARRAY[@]}"; do
    info "────── Running tag: $tag ──────"
    ansible-playbook -i "$INVENTORY" "$PLAYBOOK" --tags "$tag" $BECOME_FLAGS "${EXTRA_VARS_ARGS[@]}" || {
        warn "Tag '$tag' had failures (continuing in best-effort mode)"
        FAILED_TAGS+=("$tag")
    }
done
if [[ ${#FAILED_TAGS[@]} -gt 0 ]]; then
    warn "────── Summary ──────"
    warn "The following tags had failures: ${FAILED_TAGS[*]}"
    warn "Retry manually:"
    warn "  cd ~/.ansible && ansible-playbook -i inventories/localhost.ini $PLAYBOOK --tags '$(IFS=,; echo "${FAILED_TAGS[*]}")' $BECOME_FLAGS ${EXTRA_VARS_ARGS[*]}"
    success "Ansible roles partially updated (${#FAILED_TAGS[@]} tag(s) failed)."
else
    success "Ansible roles updated!"
fi
{{ else -}}
ansible-playbook -i "$INVENTORY" "$PLAYBOOK" --tags "$TAGS" $BECOME_FLAGS "${EXTRA_VARS_ARGS[@]}"
success "Ansible roles updated!"
{{ end -}}
