# https://www.chezmoi.io/reference/special-files/chezmoi-format-tmpl/

# Implied parent dirs of managed files / externals (e.g. ~/.local when only
# ~/.local/share/toolkami/toolkami.rb is managed) inherit mode from
# `0o777 & ~umask`. Default umask is the user's login umask, which on macOS
# (002 → 0775) and various Linux distros (022 → 0755 / 0700 for ~) differs,
# producing recurring "mode-only diff" noise on .local and friends across
# the fleet. Pin umask to 022 so implied dirs are always 0755 regardless of
# host login umask. Files that need stricter modes use the `private_` prefix
# explicitly.
umask = 0o022

[data]
# 只在 init 才需要問一次：你之後都讀這個值
# TODO: not all the things we want to change all the time we chezmoi init
#
# Profile only encodes user-role choices that can't be auto-detected
# (desktop vs server). OS/arch facts come from .chezmoi.os / .chezmoi.arch;
# see docs/tools/chezmoi-templating.md for the full rule.
{{- $profileChoices := list "macos" "ubuntu_desktop" "ubuntu_server" "centos_server" }}
{{- $defaultProfile := "ubuntu_server" }}
{{- if eq .chezmoi.os "darwin" }}{{ $defaultProfile = "macos" }}{{ end }}
{{- $profile := promptChoiceOnce . "profile" "Which profile" $profileChoices $defaultProfile }}
profile = {{ $profile | quote }}
email   = {{ promptStringOnce . "email" "What is your email address" "daviddwlee84@gmail.com" | quote }}
name    = {{ promptStringOnce . "name" "What is your full name" "Da-Wei Lee" | quote }}
# >>> dotfiles-init:prompts (generated by scripts/init/dotfiles_init.py gen) — DO NOT EDIT BY HAND >>>
# 是否安裝 coding agents (Claude Code, OpenCode, Cursor, Copilot, Gemini, etc.)
installCodingAgents = {{ promptBoolOnce . "installCodingAgents" "Install coding agents (Claude Code, OpenCode, Cursor, Copilot, Gemini, etc.)" true }}
# 是否安裝本地 LLM tools (Ollama, LiteLLM, llmfit, models)
installLlmTools = {{ promptBoolOnce . "installLlmTools" "Install local LLM tools (Ollama, LiteLLM, llmfit, models)" false }}
# 是否安裝 macOS AI desktop apps via Homebrew Brewfile (Claude, ChatGPT, OpenCode, Antigravity, Codex, Ollama app)
{{ if eq .chezmoi.os "darwin" -}}
installAiDesktopApps = {{ promptBoolOnce . "installAiDesktopApps" "Install AI desktop apps via macOS Homebrew Brewfile (Claude, ChatGPT, OpenCode, Antigravity, Codex, Ollama app)" false }}
{{ else -}}
installAiDesktopApps = false
{{ end -}}
# 是否安裝 Python CLI tools via uv (mlflow, sqlit-tui, tmuxp, etc.)
installPythonUvTools = {{ promptBoolOnce . "installPythonUvTools" "Install Python CLI tools via uv (mlflow, sqlit-tui, tmuxp, etc.)" true }}
# 是否安裝 standalone JS/npm CLI utilities (readability-cli for `readnode`, etc.)
installJsCliTools = {{ promptBoolOnce . "installJsCliTools" "Install standalone JS/npm CLI utilities (readability-cli for terminal web reader, etc.)" true }}
# 是否安裝 .NET SDK (via mise) 與 .NET global tools (azure-cost-cli, 等)
installDotnetTools = {{ promptBoolOnce . "installDotnetTools" "Install .NET SDK via mise and dotnet global tools (azure-cost-cli, etc.)" false }}
# 是否安裝額外的 mise runtimes (rust, bun, ruby) 與對應的 cargo/gem 工具（~1.8GB）。
# Node 永遠會裝（nvim LSP / npm-based coding agents 硬依賴），不受此 flag 影響。
# false 時 mise [tools] 只留 node，且 ansible TAGS 會剔除 rust_cargo_tools /
# ruby_gem_tools（沒有 toolchain 跑了也只會失敗）。lean cloud VM / CI 建議 false。
installExtraRuntimes = {{ promptBoolOnce . "installExtraRuntimes" "Install extra mise runtimes (rust, bun, ruby) and their cargo/gem tools" true }}
# 是否安裝 Linux Audit framework (auditd) + 基準規則集（identity / sudoers /
# sshd_config / privileged-exec watch）。Linux only — macOS 自動跳過（macOS 用
# OpenBSM，不是 auditd），所以在 darwin 上不問也直接 false。
# 詳見 docs/sysadmin/auditd.md 與 docs/playbooks/auditd.md。
{{ if eq .chezmoi.os "linux" -}}
installAuditd = {{ promptBoolOnce . "installAuditd" "Install Linux audit framework (auditd) + baseline rules (identity / sudoers / sshd_config / privileged-exec watches)" false }}
{{ else -}}
installAuditd = false
{{ end -}}
# 是否安裝 homelab 硬體監控 CLI（lm-sensors / smartmontools / ipmitool /
# nvme-cli / storcli）。每個工具還會依實際偵測到的硬體決定要不要裝（沒有
# MegaRAID 控制器就不裝 storcli、沒有 NVMe 就不裝 nvme-cli…），避免裝一堆
# 用不到的東西。Linux only — macOS 與 VM 內自動跳過。
# 詳見 docs/sysadmin/hardware.md。
{{ if eq .chezmoi.os "linux" -}}
installHomelabTools = {{ promptBoolOnce . "installHomelabTools" "Install homelab hardware-monitoring tools (lm-sensors / smartmontools / ipmitool / nvme-cli / storcli), gated on detected hardware" false }}
{{ else -}}
installHomelabTools = false
{{ end -}}
# 是否安裝 Infrastructure-as-Code 工具 (Azure CLI, Terraform, OpenTofu)
installIacTools = {{ promptBoolOnce . "installIacTools" "Install Infrastructure-as-Code tools (Azure CLI, Terraform, OpenTofu)" false }}
# 是否安裝影音/媒體 CLI 工具 (ffmpeg, ImageMagick, exiftool, libvips)
# ffmpeg 也是 vhs 的 runtime 依賴；裝了影音包之後 vhs 才能真正錄製。詳見 docs/tools/ffmpeg.md
installMediaTools = {{ promptBoolOnce . "installMediaTools" "Install media/AV CLI tools (ffmpeg, ImageMagick, exiftool, libvips)" false }}
# 是否安裝 Bitwarden CLI（+ SSH Agent 自動偵測 + Zsh completion）；在
# ubuntu_desktop / macOS profile 上同時也會裝 Bitwarden Desktop（snap 優先、
# .deb fallback / Homebrew Cask）。詳細邏輯見 docs/playbooks/linux-gui-apps.md
