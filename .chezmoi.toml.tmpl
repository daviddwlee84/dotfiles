# https://www.chezmoi.io/reference/special-files/chezmoi-format-tmpl/

# Implied parent dirs of managed files / externals (e.g. ~/.local when only
# ~/.local/share/toolkami/toolkami.rb is managed) inherit mode from
# `0o777 & ~umask`. Default umask is the user's login umask, which on macOS
# (002 → 0775) and various Linux distros (022 → 0755 / 0700 for ~) differs,
# producing recurring "mode-only diff" noise on .local and friends across
# the fleet. Pin umask to 022 so implied dirs are always 0755 regardless of
# host login umask. Files that need stricter modes use the `private_` prefix
# explicitly.
umask = 0o022

[data]
# 只在 init 才需要問一次：你之後都讀這個值
# TODO: not all the things we want to change all the time we chezmoi init
#
# Profile only encodes user-role choices that can't be auto-detected
# (desktop vs server). OS/arch facts come from .chezmoi.os / .chezmoi.arch;
# see docs/tools/chezmoi-templating.md for the full rule.
{{- $profileChoices := list "macos" "ubuntu_desktop" "ubuntu_server" "centos_server" }}
{{- $defaultProfile := "ubuntu_server" }}
{{- if eq .chezmoi.os "darwin" }}{{ $defaultProfile = "macos" }}{{ end }}
{{- $profile := promptChoiceOnce . "profile" "Which profile" $profileChoices $defaultProfile }}
profile = {{ $profile | quote }}
email   = {{ promptStringOnce . "email" "What is your email address" "daviddwlee84@gmail.com" | quote }}
name    = {{ promptStringOnce . "name" "What is your full name" "Da-Wei Lee" | quote }}
# 是否在中國大陸 GFW 內，需要使用鏡像源
useChineseMirror = {{ promptBoolOnce . "useChineseMirror" "Are you in China (behind GFW) and need to use mirrors" false }}
# 是否對所有 repo 啟用 gitleaks 掃描（包含沒有 .pre-commit-config.yaml 的 repo）
gitleaksAllRepos = {{ promptBoolOnce . "gitleaksAllRepos" "Enable gitleaks for ALL git repos (not just those with .pre-commit-config.yaml)" false }}
# 是否安裝 coding agents (Claude Code, OpenCode, Cursor, Copilot, Gemini, etc.)
installCodingAgents = {{ promptBoolOnce . "installCodingAgents" "Install coding agents (Claude Code, OpenCode, Cursor, Copilot, Gemini, etc.)" true }}
# 是否安裝 Bitwarden CLI（+ SSH Agent 自動偵測 + Zsh completion）；在
# ubuntu_desktop / macOS profile 上同時也會裝 Bitwarden Desktop（snap 優先、
# .deb fallback / Homebrew Cask）。詳細邏輯見 docs/playbooks/linux-gui-apps.md
# 和 dot_ansible/roles/bitwarden/。
installBitwarden = {{ promptBoolOnce . "installBitwarden" "Install Bitwarden CLI (and Desktop on ubuntu_desktop/macOS — snap or .deb on Linux, Cask on macOS) with SSH Agent integration" false }}
# 是否安裝 Python CLI tools via uv (mlflow, sqlit-tui, tmuxp, etc.)
installPythonUvTools = {{ promptBoolOnce . "installPythonUvTools" "Install Python CLI tools via uv (mlflow, sqlit-tui, tmuxp, etc.)" true }}
# 是否安裝 standalone JS/npm CLI utilities (readability-cli for `readnode`, etc.)
installJsCliTools = {{ promptBoolOnce . "installJsCliTools" "Install standalone JS/npm CLI utilities (readability-cli for terminal web reader, etc.)" true }}
# 是否安裝本地 LLM tools (Ollama, LiteLLM, llmfit, models)
installLlmTools = {{ promptBoolOnce . "installLlmTools" "Install local LLM tools (Ollama, LiteLLM, llmfit, models)" false }}
# 是否安裝 macOS AI desktop apps via Homebrew Brewfile (Claude, ChatGPT, OpenCode, Antigravity, Codex, Ollama app)
{{ if eq .chezmoi.os "darwin" -}}
installAiDesktopApps = {{ promptBoolOnce . "installAiDesktopApps" "Install AI desktop apps via macOS Homebrew Brewfile (Claude, ChatGPT, OpenCode, Antigravity, Codex, Ollama app)" false }}
{{ else -}}
installAiDesktopApps = false
{{ end -}}
# 是否安裝一般 GUI apps via Homebrew Brewfile (terminals, browsers, utilities, etc.; excludes AI desktop apps)
installBrewApps = {{ promptBoolOnce . "installBrewApps" "Install general GUI apps via Homebrew Brewfile (terminals, browsers, utilities, etc.; excludes AI desktop apps)" false }}
# Discord channel: 哪一條安裝路徑（ubuntu_desktop only — macOS 走 Brewfile cask，
# ubuntu_server 沒有 GUI 不需要）
#   - flatpak: 推薦，Flathub 走 com.discordapp.Discord，自動更新
#   - deb:     官方 .deb，每次版本更新需手動跑 `chezmoi apply` 重抓
#   - none:    完全不裝，留給使用者自行處理
# 詳細決策 + sandbox 副作用見 docs/playbooks/linux-gui-apps.md
# 注意: 這裡引用前面定義的 $profile local variable（不是 .profile，因為
# .chezmoi.toml.tmpl 正在產生 .profile，init 階段 .profile 還不存在）
{{ if eq $profile "ubuntu_desktop" -}}
discordChannel = {{ promptChoiceOnce . "discordChannel" "Discord install channel (flatpak|deb|none)" (list "flatpak" "deb" "none") "flatpak" | quote }}
{{ else -}}
discordChannel = "none"
{{ end -}}
# 是否安裝繁體中文輸入法 (McBopomofo + RIME)
installInputMethod = {{ promptBoolOnce . "installInputMethod" "Install Traditional Chinese input methods (McBopomofo, RIME)" false }}
# 是否安裝網路診斷工具 (nmap, mtr, httpie, gping, trippy, etc.)
installNetworkingTools = {{ promptBoolOnce . "installNetworkingTools" "Install networking CLI tools (nmap, mtr, httpie, gping, trippy, etc.)" false }}
# 是否安裝 Infrastructure-as-Code 工具 (Azure CLI, Terraform, OpenTofu)
installIacTools = {{ promptBoolOnce . "installIacTools" "Install Infrastructure-as-Code tools (Azure CLI, Terraform, OpenTofu)" false }}
# 是否安裝影音/媒體 CLI 工具 (ffmpeg, ImageMagick, exiftool, libvips)
# ffmpeg 也是 vhs 的 runtime 依賴；裝了影音包之後 vhs 才能真正錄製。詳見 docs/tools/ffmpeg.md
installMediaTools = {{ promptBoolOnce . "installMediaTools" "Install media/AV CLI tools (ffmpeg, ImageMagick, exiftool, libvips)" false }}
# 是否安裝 .NET SDK (via mise) 與 .NET global tools (azure-cost-cli, 等)
installDotnetTools = {{ promptBoolOnce . "installDotnetTools" "Install .NET SDK via mise and dotnet global tools (azure-cost-cli, etc.)" false }}
# 沒有 sudo/root 權限，只安裝 user-level 工具 (mise, cargo, gem, uv, npm)
noRoot = {{ promptBoolOnce . "noRoot" "No sudo/root access - skip all system package installations" false }}
# 在 chezmoi apply 之前備份現有的 dotfiles。
# smart = 只備份 chezmoi 將要覆蓋/刪除的檔案（用 `chezmoi status` 偵測）
# full  = 備份固定 allowlist（onboard 第一次最保險）
# off   = 完全跳過（CI / Docker / 一次性環境用）
backupMode = {{ promptChoiceOnce . "backupMode" "Backup mode for existing dotfiles (smart|full|off)" (list "smart" "full" "off") "smart" | quote }}
# 允許 Ansible 部分失敗（逐 tag 執行，單一 role 失敗不影響其餘）
allowPartialFailure = {{ promptBoolOnce . "allowPartialFailure" "Allow partial Ansible failures (continue installing other tools if one role fails)" false }}
# SSH login banner (~/.zlogin) 樣式 — 詳見 docs/zsh/motd.md
#   - figlet:         單行 figlet hostname + metadata（~6 行，~5ms，預設）
#   - fastfetch-slim: figlet hostname + fastfetch 精簡版（~10 行，~80ms）
#   - fastfetch-full: fastfetch 完整輸出含 distro logo（~22 行，~150ms）
# Runtime override: 在 ~/.zshrc.adhoc 設 MOTD_STYLE=... 可即時切換無需 chezmoi init --force
motdStyle = {{ promptChoiceOnce . "motdStyle" "SSH login banner style (figlet|fastfetch-slim|fastfetch-full)" (list "figlet" "fastfetch-slim" "fastfetch-full") "figlet" | quote }}

# https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/#dont-show-scripts-that-would-run-in-chezmoi-diffchezmoi-status
[diff]
    exclude = ["scripts"]
{{- if lookPath "delta" }}
    # Side-by-side diff: left = current (before apply), right = target (after apply)
    pager = "delta --side-by-side --line-numbers --navigate --paging=always --file-style=yellow --file-decoration-style='yellow ul' --hunk-header-decoration-style='blue box'"
{{- end }}
[status]
    exclude = ["scripts"]
