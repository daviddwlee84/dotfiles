# shellcheck shell=sh
# audit-* helpers — sysadmin queries for "who did what on this server"
#
# POSIX-portable wrappers around last / lastlog / journalctl / ausearch /
# aureport. Sourced by both bash and zsh via load_modular_dir of
# ~/.config/shell/. See docs/sysadmin/helpers.md for the full reference
# table and docs/sysadmin/README.md for the audit hierarchy this lives
# under (Levels 0-3).
#
# Conventions:
#   - All audit-* functions accept --help.
#   - When the underlying source is root-only and the user is not root:
#       interactive TTY  -> single `sudo -v` prompt, then sudo <cmd>
#       non-interactive  -> exit 1 with stderr hint
#   - All functions exit 0 on broken pipe (head | less etc.) — no
#     SIGPIPE noise.
#   - Distro detection avoided where journalctl works for both
#     Debian/RHEL (we just query the journal); only auth.log vs secure
#     fallback paths use distro detection.

# ---------------------------------------------------------------------------
# Internal helpers (prefix _audit_ — not part of public surface)
# ---------------------------------------------------------------------------

_audit_is_tty() { [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; }
_audit_is_root() { [ "$(id -u)" = "0" ]; }

# Run "$@" with sudo if not root; if root, run directly.
#
# Strategy:
#   1. If already root -> run directly.
#   2. If `sudo -n true` works (sudo cache still warm OR NOPASSWD) -> sudo -n.
#   3. If we have any TTY (stdin/stdout/stderr) -> sudo -v then sudo.
#   4. Otherwise print a clear hint and exit 1.
#
# IMPORTANT: these helpers are shell *functions*, so plain `sudo audit-foo`
# will NOT work — sudo spawns a fresh process that doesn't inherit your
# functions. The hint below tells the user to run `sudo -v` first instead.
_audit_run_root() {
    if _audit_is_root; then
        "$@"
        return $?
    fi
    if ! command -v sudo >/dev/null 2>&1; then
        printf 'audit: needs root and sudo not installed\n' >&2
        return 1
    fi
    # Try non-interactive first (fast path: cache warm or NOPASSWD).
    if sudo -n true 2>/dev/null; then
        sudo "$@"
        return $?
    fi
    # Need to prompt. Try TTY-driven `sudo -v`.
    if _audit_is_tty; then
        if sudo -v; then
            sudo "$@"
            return $?
        fi
        return 1
    fi
    printf 'audit: needs root. Run `sudo -v` once in this shell first, then re-run this helper.\n' >&2
    printf '       (Note: these are shell functions, so `sudo <helper>` will NOT work — sudo spawns a fresh process.)\n' >&2
    return 1
}

# Detect which distro auth log file exists. Echoes file path or empty.
_audit_authlog_path() {
    if [ -r /var/log/auth.log ] 2>/dev/null || [ -e /var/log/auth.log ]; then
        printf '/var/log/auth.log\n'
    elif [ -r /var/log/secure ] 2>/dev/null || [ -e /var/log/secure ]; then
        printf '/var/log/secure\n'
    fi
}

_audit_have() { command -v "$1" >/dev/null 2>&1; }

_audit_help() {
    # Usage: _audit_help <function-name> <one-liner> [more lines...]
    name=$1; shift
    printf 'Usage: %s\n\n' "$name"
    for line in "$@"; do printf '  %s\n' "$line"; done
}

# ---------------------------------------------------------------------------
# audit-sessions [user]
#   Level 0. Who logged in? when? from where?
# ---------------------------------------------------------------------------
audit-sessions() {
    case ${1:-} in
        -h|--help)
            _audit_help 'audit-sessions [user]' \
                'Recent login sessions via last(1).' \
                'On Linux also runs lastlog and shows currently-logged-in users.' \
                'No sudo needed (wtmp/utmp are world-readable).'
            return 0 ;;
    esac
    user=${1:-}
    printf '== last (login history) ==\n'
{{- if eq .chezmoi.os "darwin" }}
    if [ -n "$user" ]; then last "$user" | head -50
    else last | head -50
    fi
{{- else }}
    if [ -n "$user" ]; then last -F -i "$user" | head -50
    else last -F -i | head -50
    fi
    if _audit_have lastlog; then
        printf '\n== lastlog (last login per account) ==\n'
        if [ -n "$user" ]; then lastlog -u "$user"
        else lastlog | awk 'NR==1 || $2 != "**Never"'
        fi
    fi
{{- end }}
    printf '\n== who -a (current sessions) ==\n'
    who -a 2>/dev/null || who
}

# ---------------------------------------------------------------------------
# audit-failed-logins
#   Level 0. Failed login attempts via lastb(1). Linux only; root-only file.
# ---------------------------------------------------------------------------
audit-failed-logins() {
    case ${1:-} in
        -h|--help)
            _audit_help 'audit-failed-logins' \
                'Failed login attempts (Linux btmp). Reads /var/log/btmp via lastb.' \
                'Requires sudo.'
            return 0 ;;
    esac
{{- if eq .chezmoi.os "linux" }}
    if ! _audit_have lastb; then
        printf 'audit-failed-logins: lastb(1) not found (install util-linux)\n' >&2
        return 1
    fi
    _audit_run_root lastb -F -i | head -50
{{- else }}
    printf 'audit-failed-logins: not supported on %s (Linux btmp only)\n' "$(uname -s)" >&2
    return 1
{{- end }}
}

# ---------------------------------------------------------------------------
# audit-sudo [user]
#   Level 1. Who used sudo and what top-level command was invoked.
# ---------------------------------------------------------------------------
audit-sudo() {
    case ${1:-} in
        -h|--help)
            _audit_help 'audit-sudo [user]' \
                'Sudo events: who escalated, what top-level command, success/failure.' \
                'Prefers journalctl _COMM=sudo on systemd; falls back to grepping' \
                '/var/log/auth.log (Debian) or /var/log/secure (RHEL).' \
                'Requires sudo (auth log is root-only).' \
                'NOTE: only captures the sudo line itself — anything typed inside' \
                '`sudo bash` / `sudo -i` is invisible. See docs/sysadmin/sudo-audit.md.'
            return 0 ;;
    esac
    user=${1:-}
    if _audit_have journalctl; then
        if [ -n "$user" ]; then
            _audit_run_root journalctl _COMM=sudo --since '7 days ago' --no-pager \
                | grep -E "(^| )$user( |:|$)" || true
        else
            _audit_run_root journalctl _COMM=sudo --since '7 days ago' --no-pager
        fi
        return $?
    fi
    log=$(_audit_authlog_path)
    if [ -z "$log" ]; then
        printf 'audit-sudo: no journalctl and no /var/log/auth.log|secure found\n' >&2
        return 1
    fi
    if [ -n "$user" ]; then
        _audit_run_root grep -E "sudo(\[|:).*${user}" "$log"
    else
        _audit_run_root grep -E 'sudo(\[|:)' "$log"
    fi
}

# ---------------------------------------------------------------------------
# audit-execve <pattern>
#   Level 3. Did anyone exec <pattern>? Requires auditd + execve rule.
# ---------------------------------------------------------------------------
audit-execve() {
    case ${1:-} in
        ''|-h|--help)
            _audit_help 'audit-execve <pattern>' \
                'Search audit log for execve() of the binary matching <pattern>.' \
                'Wraps `ausearch -sc execve -x <pattern> -i`.' \
                'Requires auditd installed and an execve rule in place.' \
                'See docs/sysadmin/auditd.md for the baseline rule set this repo ships.'
            return 0 ;;
    esac
    if ! _audit_have ausearch; then
        printf 'audit-execve: ausearch(1) not found (install auditd)\n' >&2
        return 1
    fi
    pat=$1
    _audit_run_root ausearch -sc execve -x "$pat" -i 2>/dev/null \
        || { printf 'audit-execve: no events for %s (check rules: audit-rules-show)\n' "$pat" >&2; return 1; }
}

# ---------------------------------------------------------------------------
# audit-file <path>
#   Level 3. Who touched this file? Requires auditd + a watch rule.
# ---------------------------------------------------------------------------
audit-file() {
    case ${1:-} in
        ''|-h|--help)
            _audit_help 'audit-file <path>' \
                'Search audit log for events touching <path>.' \
                'Wraps `ausearch -f <path> -i`.' \
                'Requires auditd AND a `-w <path>` watch rule loaded.' \
                'Useful for: /etc/passwd, /etc/sudoers, /etc/ssh/sshd_config.'
            return 0 ;;
    esac
    if ! _audit_have ausearch; then
        printf 'audit-file: ausearch(1) not found (install auditd)\n' >&2
        return 1
    fi
    path=$1
    _audit_run_root ausearch -f "$path" -i 2>/dev/null \
        || { printf 'audit-file: no events for %s — is a watch rule loaded? (audit-rules-show)\n' "$path" >&2; return 1; }
}

# ---------------------------------------------------------------------------
# audit-summary [--start <when>]
#   Level 3. Daily security summary via aureport.
# ---------------------------------------------------------------------------
audit-summary() {
    start='today'
    while [ $# -gt 0 ]; do
        case $1 in
            --start) start=$2; shift 2 ;;
            -h|--help)
                _audit_help 'audit-summary [--start <when>]' \
                    'Chained aureport summary: overall + auth + executables.' \
                    'Default: --start today. Examples: --start "24h ago", --start "2024-01-01".' \
                    'Requires auditd.'
                return 0 ;;
            *) printf 'audit-summary: unknown arg: %s\n' "$1" >&2; return 1 ;;
        esac
    done
    if ! _audit_have aureport; then
        printf 'audit-summary: aureport(1) not found (install auditd)\n' >&2
        return 1
    fi
    printf '== Overall summary (since %s) ==\n' "$start"
    _audit_run_root aureport --summary -i --start "$start"
    printf '\n== Authentication events ==\n'
    _audit_run_root aureport -au -i --start "$start"
    printf '\n== Executable summary (top 20) ==\n'
    _audit_run_root aureport -x -i --start "$start" | head -22
}

# ---------------------------------------------------------------------------
# audit-rules-show
#   Level 3. Loaded rules + persisted rule files.
# ---------------------------------------------------------------------------
audit-rules-show() {
    case ${1:-} in
        -h|--help)
            _audit_help 'audit-rules-show' \
                'Show rules currently loaded in the kernel (auditctl -l) and' \
                'the persisted rule files under /etc/audit/rules.d/.'
            return 0 ;;
    esac
    if ! _audit_have auditctl; then
        printf 'audit-rules-show: auditctl(1) not found (install auditd)\n' >&2
        return 1
    fi
    printf '== Loaded rules (auditctl -l) ==\n'
    _audit_run_root auditctl -l
    printf '\n== Persisted rules under /etc/audit/rules.d/ ==\n'
    if [ -d /etc/audit/rules.d ]; then
        for f in /etc/audit/rules.d/*.rules; do
            [ -f "$f" ] || continue
            printf '\n--- %s ---\n' "$f"
            _audit_run_root cat "$f"
        done
    else
        printf '(directory missing)\n'
    fi
}

# ===========================================================================
# User-inventory helpers — answer "who exists / who can sudo / who has SSH
# keys" without dropping into tv. Backing data sources differ macOS vs Linux
# (dscl vs getent), so these are templated.
# ===========================================================================

# ---------------------------------------------------------------------------
# user-list [--login]
#   Local user accounts. With --login, only those with a real shell.
# ---------------------------------------------------------------------------
user-list() {
    login_only=0
    case ${1:-} in
        -h|--help)
            _audit_help 'user-list [--login]' \
                'List local user accounts.' \
                '--login restricts to users with a non-nologin/false shell.' \
                'No sudo needed.'
            return 0 ;;
        --login) login_only=1 ;;
    esac
{{- if eq .chezmoi.os "darwin" }}
    if [ "$login_only" = "1" ]; then
        for u in $(dscl . -list /Users UniqueID 2>/dev/null | awk '$2 !~ /^_/ && $2 >= 500 {print $1}'); do
            sh=$(dscl . -read "/Users/$u" UserShell 2>/dev/null | awk '{print $2}')
            case "$sh" in
                */false|*/nologin|"") continue ;;
            esac
            printf '%-24s shell=%s\n' "$u" "$sh"
        done
    else
        dscl . -list /Users UniqueID 2>/dev/null \
            | awk '$2 !~ /^_/ && $2 != "nobody" && $2 != "daemon" {printf "%-24s uid=%s\n", $1, $2}'
    fi
{{- else }}
    if [ "$login_only" = "1" ]; then
        getent passwd | awk -F: '$7 !~ /(nologin|false)$/ {printf "%-24s uid=%-6s shell=%s\n", $1, $3, $7}'
    else
        getent passwd | awk -F: '{printf "%-24s uid=%-6s gid=%-6s shell=%-20s home=%s\n", $1, $3, $4, $7, $6}'
    fi
{{- end }}
}

# ---------------------------------------------------------------------------
# user-info <user>
#   Full identity dump for one user.
# ---------------------------------------------------------------------------
user-info() {
    case ${1:-} in
        ''|-h|--help)
            _audit_help 'user-info <user>' \
                'Identity dump: id, groups, passwd entry, last login, sudo events,' \
                'and authorized_keys count for one user.'
            return 0 ;;
    esac
    u=$1
    printf '== id ==\n'; id "$u" 2>/dev/null || { printf 'unknown user\n' >&2; return 1; }
    printf '\n== groups ==\n'; id -Gn "$u" 2>/dev/null | tr ' ' '\n' | sort
    printf '\n== passwd ==\n'
{{- if eq .chezmoi.os "darwin" }}
    dscl . -read "/Users/$u" 2>/dev/null | head -25
{{- else }}
    getent passwd "$u"
{{- end }}
    printf '\n== last login (5) ==\n'
    last "$u" 2>/dev/null | head -5
{{- if eq .chezmoi.os "linux" }}
    printf '\n== sudo events (last 30 days, last 5) ==\n'
    if _audit_have journalctl; then
        _audit_run_root journalctl _COMM=sudo --since '30 days ago' --no-pager 2>/dev/null \
            | grep -E " $u :" | tail -5
    fi
{{- end }}
    printf '\n== ~/.ssh/authorized_keys ==\n'
    home=$(eval echo "~$u")
    ak="$home/.ssh/authorized_keys"
    if [ -r "$ak" ]; then
        n=$(grep -cvE '^\s*(#|$)' "$ak" 2>/dev/null || echo 0)
        printf '%s key(s)\n' "$n"
    elif _audit_is_root || sudo -n test -r "$ak" 2>/dev/null; then
        n=$(_audit_run_root cat "$ak" 2>/dev/null | grep -cvE '^\s*(#|$)')
        printf '%s key(s) [via sudo]\n' "$n"
    else
        printf '(unreadable)\n'
    fi
}

# ---------------------------------------------------------------------------
# user-groups <user>
#   All groups a user belongs to.
# ---------------------------------------------------------------------------
user-groups() {
    case ${1:-} in
        ''|-h|--help)
            _audit_help 'user-groups <user>' \
                'List all groups <user> is a member of (id -Gn, sorted).'
            return 0 ;;
    esac
    id -Gn "$1" 2>/dev/null | tr ' ' '\n' | sort
}

# ---------------------------------------------------------------------------
# group-members <group>
#   All users in a group.
# ---------------------------------------------------------------------------
group-members() {
    case ${1:-} in
        ''|-h|--help)
            _audit_help 'group-members <group>' \
                'List members of a group.'
            return 0 ;;
    esac
{{- if eq .chezmoi.os "darwin" }}
    dscl . -read "/Groups/$1" GroupMembership 2>/dev/null \
        | sed 's/^GroupMembership: //' | tr ' ' '\n' | sort -u
{{- else }}
    getent group "$1" 2>/dev/null | cut -d: -f4 | tr ',' '\n' | sort -u
{{- end }}
}

# ---------------------------------------------------------------------------
# user-sudoers
#   Who can sudo on this box: sudo/wheel/admin group + sudoers.d/ entries.
# ---------------------------------------------------------------------------
user-sudoers() {
    case ${1:-} in
        -h|--help)
            _audit_help 'user-sudoers' \
                'Who can sudo: members of sudo/wheel/admin groups + raw' \
                'user-bearing lines from /etc/sudoers and /etc/sudoers.d/.' \
                'Reads /etc/sudoers via sudo.'
            return 0 ;;
    esac
{{- if eq .chezmoi.os "linux" }}
    printf '== group memberships ==\n'
    for g in sudo wheel admin; do
        m=$(getent group "$g" 2>/dev/null | cut -d: -f4)
        [ -n "$m" ] && printf '%-8s %s\n' "$g:" "$m"
    done
{{- else }}
    printf '== group memberships ==\n'
    for g in admin wheel; do
        m=$(dscl . -read "/Groups/$g" GroupMembership 2>/dev/null | sed 's/^GroupMembership: //')
        [ -n "$m" ] && printf '%-8s %s\n' "$g:" "$m"
    done
{{- end }}
    printf '\n== /etc/sudoers + /etc/sudoers.d/ (user-bearing lines) ==\n'
    _audit_run_root cat /etc/sudoers /etc/sudoers.d/* 2>/dev/null \
        | grep -vE '^\s*(#|Defaults|$)'
}

# ---------------------------------------------------------------------------
# user-ssh-keys [user]
#   Show authorized_keys for one user (or all if no arg). Each line: user
#   fingerprint comment. Reads other users' files via sudo.
# ---------------------------------------------------------------------------
user-ssh-keys() {
    case ${1:-} in
        -h|--help)
            _audit_help 'user-ssh-keys [user]' \
                'List entries in authorized_keys files: <user> <fingerprint> <comment>.' \
                'Without arg, scans all home dirs (uid >= 1000 on Linux, >= 500 on macOS).' \
                'Other users'\'' files require sudo.'
            return 0 ;;
    esac
    target=${1:-}
    if [ -n "$target" ]; then
{{- if eq .chezmoi.os "darwin" }}
        homes=$(dscl . -read "/Users/$target" NFSHomeDirectory 2>/dev/null | awk '{print $2}' | sed "s|^|$target:|")
{{- else }}
        homes=$(getent passwd "$target" 2>/dev/null | awk -F: '{print $1":"$6}')
{{- end }}
    else
{{- if eq .chezmoi.os "darwin" }}
        homes=$(dscl . -list /Users NFSHomeDirectory 2>/dev/null | awk '$2 ~ /^\/Users\// {print $1":"$2}')
{{- else }}
        homes=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65000 {print $1":"$6}')
{{- end }}
    fi
    printf '%s\n' "$homes" | while IFS=: read -r u h; do
        [ -z "$h" ] && continue
        ak="$h/.ssh/authorized_keys"
        if [ -r "$ak" ]; then
            cat "$ak"
        elif _audit_is_root || sudo -n test -r "$ak" 2>/dev/null; then
            _audit_run_root cat "$ak" 2>/dev/null
        else
            continue
        fi | grep -vE '^\s*(#|$)' | while read -r line; do
            comment=$(printf '%s' "$line" | awk '{for(i=3;i<=NF;i++)printf "%s ",$i; print ""}')
            fp=$(printf '%s\n' "$line" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')
            printf '%-24s %s  %s\n' "$u" "${fp:-?}" "${comment:-(no comment)}"
        done
    done
}

# ---------------------------------------------------------------------------
# user-recent-changes [--days N]
#   What identity-related changes happened recently? Wraps audit-file for
#   /etc/passwd, /etc/group, /etc/shadow, /etc/sudoers (needs auditd
#   baseline rules from this repo).
# ---------------------------------------------------------------------------
user-recent-changes() {
    days=7
    while [ $# -gt 0 ]; do
        case $1 in
            --days) days=$2; shift 2 ;;
            -h|--help)
                _audit_help 'user-recent-changes [--days N]' \
                    'Recent /etc/passwd /etc/group /etc/shadow /etc/sudoers writes.' \
                    'Default: --days 7. Requires auditd identity+sudoers watch rules.'
                return 0 ;;
            *) printf 'user-recent-changes: unknown arg: %s\n' "$1" >&2; return 1 ;;
        esac
    done
    if ! _audit_have ausearch; then
        printf 'user-recent-changes: ausearch not found (auditd not installed)\n' >&2
        return 1
    fi
    for k in identity sudoers; do
        printf '== key=%s (last %s days) ==\n' "$k" "$days"
        _audit_run_root ausearch -k "$k" --start "${days} days ago" -i 2>/dev/null \
            | grep -E '^type=(SYSCALL|PATH)|^----' | head -50
        printf '\n'
    done
}

# ===========================================================================
# Firewall helpers — fw-* (multi-backend; auto-detects nft / iptables / ufw
# / firewalld / pf at runtime).
# ===========================================================================

_fw_have_active() {
    # Echo the first detected active backend, or empty.
    if command -v ufw >/dev/null 2>&1 && (sudo -n ufw status 2>/dev/null || ufw status 2>/dev/null) | grep -q 'Status: active'; then
        echo ufw; return 0
    fi
    if command -v nft >/dev/null 2>&1 && (sudo -n nft list ruleset 2>/dev/null | head -1 | grep -q . ); then
        echo nft; return 0
    fi
    if command -v firewall-cmd >/dev/null 2>&1 && (sudo -n firewall-cmd --state 2>/dev/null | grep -q running); then
        echo firewalld; return 0
    fi
    if command -v iptables >/dev/null 2>&1; then
        echo iptables; return 0
    fi
    if command -v pfctl >/dev/null 2>&1; then
        echo pf; return 0
    fi
    return 1
}

# ---------------------------------------------------------------------------
# fw-rules
#   Show active firewall rules across whichever backend is in use.
# ---------------------------------------------------------------------------
fw-rules() {
    case ${1:-} in
        -h|--help)
            _audit_help 'fw-rules' \
                'Dump active firewall rules. Auto-detects ufw / nft / firewalld /' \
                'iptables (Linux) or pf + Application Firewall (macOS).' \
                'Reads root-only files via sudo.'
            return 0 ;;
    esac
{{- if eq .chezmoi.os "linux" }}
    if command -v nft >/dev/null 2>&1; then
        printf '== nft list ruleset ==\n'
        _audit_run_root nft list ruleset 2>/dev/null
    fi
    if command -v ufw >/dev/null 2>&1; then
        printf '\n== ufw status numbered ==\n'
        _audit_run_root ufw status numbered 2>/dev/null
    fi
    if command -v firewall-cmd >/dev/null 2>&1; then
        printf '\n== firewall-cmd --list-all-zones ==\n'
        _audit_run_root firewall-cmd --list-all-zones 2>/dev/null
    fi
    if command -v iptables >/dev/null 2>&1; then
        printf '\n== iptables -S ==\n'
        _audit_run_root iptables -S 2>/dev/null
        if command -v ip6tables >/dev/null 2>&1; then
            printf '\n== ip6tables -S ==\n'
            _audit_run_root ip6tables -S 2>/dev/null
        fi
    fi
{{- else }}
    if command -v pfctl >/dev/null 2>&1; then
        printf '== pfctl -s rules ==\n'
        _audit_run_root pfctl -s rules 2>/dev/null
        printf '\n== pfctl -s nat ==\n'
        _audit_run_root pfctl -s nat 2>/dev/null
        printf '\n== pfctl -s info ==\n'
        _audit_run_root pfctl -s info 2>/dev/null
    fi
    if [ -x /usr/libexec/ApplicationFirewall/socketfilterfw ]; then
        printf '\n== Application Firewall ==\n'
        /usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate
        /usr/libexec/ApplicationFirewall/socketfilterfw --getstealthmode
        /usr/libexec/ApplicationFirewall/socketfilterfw --getallowsigned
    fi
{{- end }}
}

# ---------------------------------------------------------------------------
# fw-listening
#   What ports are bound, by which process? TCP + UDP.
# ---------------------------------------------------------------------------
fw-listening() {
    case ${1:-} in
        -h|--help)
            _audit_help 'fw-listening' \
                'List sockets in LISTEN state with owning process. Prefers ss; falls' \
                'back to lsof. Sudo for full process info.'
            return 0 ;;
    esac
    if _audit_have ss; then
        printf '== TCP listeners ==\n'
        _audit_run_root ss -tlnp 2>/dev/null
        printf '\n== UDP listeners ==\n'
        _audit_run_root ss -ulnp 2>/dev/null
    elif _audit_have lsof; then
        printf '== TCP listeners (lsof) ==\n'
        _audit_run_root lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null
        printf '\n== UDP (lsof) ==\n'
        _audit_run_root lsof -nP -iUDP 2>/dev/null
    else
        printf 'fw-listening: neither ss(8) nor lsof(8) found\n' >&2
        return 1
    fi
}

# ---------------------------------------------------------------------------
# fw-conn [--all]
#   Established TCP connections. With --all, include LISTEN and other states.
# ---------------------------------------------------------------------------
fw-conn() {
    state='state established'
    case ${1:-} in
        -h|--help)
            _audit_help 'fw-conn [--all]' \
                'Active TCP connections. Default: established only.' \
                '--all includes LISTEN and other states.'
            return 0 ;;
        --all) state='' ;;
    esac
    if _audit_have ss; then
        # shellcheck disable=SC2086
        _audit_run_root ss -tnp $state 2>/dev/null
    elif _audit_have lsof; then
        _audit_run_root lsof -nP -iTCP -sTCP:ESTABLISHED 2>/dev/null
    else
        printf 'fw-conn: neither ss(8) nor lsof(8) found\n' >&2
        return 1
    fi
}

# ---------------------------------------------------------------------------
# fw-port <port>
#   Who is using <port>? Resolves both inbound (LISTEN) and outbound (ESTAB).
# ---------------------------------------------------------------------------
fw-port() {
    case ${1:-} in
        ''|-h|--help)
            _audit_help 'fw-port <port>' \
                'Find the process bound to <port> (LISTEN) or connected via <port>' \
                '(ESTABLISHED). Useful when something complains "port already in use".'
            return 0 ;;
    esac
    p=$1
    if _audit_have ss; then
        printf '== ss matches for :%s ==\n' "$p"
        _audit_run_root ss -tnp "( sport = :$p or dport = :$p )" 2>/dev/null
        _audit_run_root ss -unp "( sport = :$p or dport = :$p )" 2>/dev/null
    elif _audit_have lsof; then
        _audit_run_root lsof -nP -i ":$p" 2>/dev/null
    fi
    printf '\n== /etc/services ==\n'
    awk -v p="$p" '$2 ~ ("^"p"/") {print}' /etc/services 2>/dev/null \
        || getent services "$p" 2>/dev/null
}

# ===========================================================================
# Scheduled-job helper — cron-list (wraps the data the tv channel cycles).
# ===========================================================================

# ---------------------------------------------------------------------------
# cron-list [--user <u>] [--system] [--timers] [--all]
#   Inventory of scheduled jobs. Default: everything readable.
# ---------------------------------------------------------------------------
cron-list() {
    show_user=1; show_system=1; show_timers=1; only_user=''
    while [ $# -gt 0 ]; do
        case $1 in
            -h|--help)
                _audit_help 'cron-list [--user U] [--system] [--timers] [--all]' \
                    'Inventory scheduled jobs across crontab + system cron + systemd timers.' \
                    'Default shows all sources. Filters narrow scope for noisy hosts:' \
                    '  --user U     only crontab for user U' \
                    '  --system     only /etc/crontab + /etc/cron.d + cron.{hourly,daily,...}' \
                    '  --timers     only systemd timers (Linux)'
                return 0 ;;
            --user) only_user=$2; show_system=0; show_timers=0; shift 2 ;;
            --system) show_user=0; show_timers=0; shift ;;
            --timers) show_user=0; show_system=0; shift ;;
            --all) shift ;;
            *) printf 'cron-list: unknown arg: %s\n' "$1" >&2; return 1 ;;
        esac
    done
    if [ -n "$only_user" ]; then
        printf '== crontab for %s ==\n' "$only_user"
        crontab -l -u "$only_user" 2>/dev/null \
            || _audit_run_root crontab -l -u "$only_user" 2>/dev/null \
            || printf '(no crontab)\n'
        return 0
    fi
    if [ "$show_user" = "1" ]; then
        printf '== user crontabs ==\n'
{{- if eq .chezmoi.os "darwin" }}
        users=$(dscl . -list /Users UniqueID 2>/dev/null | awk '$2 !~ /^_/ && $2 >= 500 {print $1}')
{{- else }}
        users=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65000 || $1 == "root" {print $1}')
{{- end }}
        printf '%s\n' "$users" | while read -r u; do
            [ -z "$u" ] && continue
            out=$(crontab -l -u "$u" 2>/dev/null || sudo -n crontab -l -u "$u" 2>/dev/null)
            [ -z "$out" ] && continue
            printf '\n--- %s ---\n%s\n' "$u" "$out"
        done
    fi
{{- if eq .chezmoi.os "linux" }}
    if [ "$show_system" = "1" ]; then
        printf '\n== /etc/crontab ==\n'
        [ -f /etc/crontab ] && grep -vE '^\s*(#|$)' /etc/crontab 2>/dev/null
        printf '\n== /etc/cron.d/ ==\n'
        if [ -d /etc/cron.d ]; then
            for f in /etc/cron.d/*; do
                [ -f "$f" ] || continue
                printf '--- %s ---\n' "$f"
                grep -vE '^\s*(#|$)' "$f" 2>/dev/null
            done
        fi
        for d in /etc/cron.hourly /etc/cron.daily /etc/cron.weekly /etc/cron.monthly; do
            [ -d "$d" ] || continue
            printf '\n== %s ==\n' "$d"
            ls -la "$d" 2>/dev/null | tail -n +2
        done
    fi
    if [ "$show_timers" = "1" ] && _audit_have systemctl; then
        printf '\n== systemd timers (system) ==\n'
        systemctl list-timers --all --no-pager 2>/dev/null
        printf '\n== systemd timers (user) ==\n'
        systemctl --user list-timers --all --no-pager 2>/dev/null \
            || printf '(no user timers)\n'
    fi
{{- else }}
    if [ "$show_system" = "1" ]; then
        printf '\n== launchd plists ==\n'
        for d in /Library/LaunchDaemons /Library/LaunchAgents "$HOME/Library/LaunchAgents"; do
            [ -d "$d" ] || continue
            printf '\n--- %s ---\n' "$d"
            ls "$d" 2>/dev/null | grep '\.plist$' | head -50
        done
    fi
{{- end }}
    if _audit_have atq; then
        printf '\n== at jobs ==\n'
        atq 2>/dev/null
    fi
}

# ===========================================================================
# audit-watch — live colorized risk-pattern monitor.
#
# Tails journalctl + auditd events and highlights:
#   RED      = high-severity (passwd/shadow edits, root login, sudo to root,
#              new sudoers, useradd/userdel, ssh authorized_keys writes,
#              audit rules disabled)
#   YELLOW   = medium (sudo COMMAND, su, failed auth, new SSH login, chmod
#              777, /tmp execve)
#   CYAN     = low / informational (general sudo / sshd events)
#
# Plain text fallback when not on a TTY (no ANSI escapes — pipe-friendly).
# ===========================================================================

audit-watch() {
    case ${1:-} in
        -h|--help)
            _audit_help 'audit-watch [--auth | --audit | --all] [--no-color]' \
                'Live colorized monitor of security-relevant events.' \
                '  --auth   only sshd/sudo/su events (default; works without auditd)' \
                '  --audit  only auditd events (needs auditd)' \
                '  --all    both (default if auditd is installed)' \
                '  --no-color  plain text (auto-on when not a TTY)' \
                'Press Ctrl+C to exit.'
            return 0 ;;
    esac
    src='auth'
    color=1
    if _audit_have ausearch; then src='all'; fi
    while [ $# -gt 0 ]; do
        case $1 in
            --auth) src='auth'; shift ;;
            --audit) src='audit'; shift ;;
            --all) src='all'; shift ;;
            --no-color) color=0; shift ;;
            *) printf 'audit-watch: unknown arg: %s\n' "$1" >&2; return 1 ;;
        esac
    done
    [ -t 1 ] || color=0

    # Patterns. Order matters — first match wins.
    # High = red, medium = yellow, low = cyan.
    awk_prog='
BEGIN {
  if (color) {
    R="\033[1;31m"; Y="\033[1;33m"; C="\033[36m"; D="\033[2m"; N="\033[0m"
  }
  # high-severity regexes (anchored loosely; case-sensitive where it matters)
  hi[1]="(passwd|shadow|gshadow): (open|write)"
  hi[2]="useradd|userdel|usermod"
  hi[3]="root.*session opened|Accepted .* for root"
  hi[4]="sudoers"
  hi[5]="\\.ssh/authorized_keys"
  hi[6]="auditctl.*-D|audit.*disabled|audit.*enabled=0"
  hi[7]="COMMAND=.*(/bin/bash|/bin/sh|su -|sudo -i|/bin/zsh)$"
  hi[8]="chmod 777|chmod -R 777"
  hi[9]="curl .*\\| ?(sh|bash)|wget .*\\| ?(sh|bash)"
  # medium
  mi[1]="sudo: .* : TTY="
  mi[2]="Failed password|authentication failure|FAILED|invalid user"
  mi[3]="session opened for user"
  mi[4]="su(\\[|:).*Successful su"
  mi[5]=" /tmp/[^ ]+ "
  # low
  lo[1]="sshd|sudo|su"
}
{
  marker=""; tag=""
  for (i in hi) if ($0 ~ hi[i]) { marker=R; tag="[!!]"; break }
  if (marker == "") for (i in mi) if ($0 ~ mi[i]) { marker=Y; tag="[!] "; break }
  if (marker == "") for (i in lo) if ($0 ~ lo[i]) { marker=C; tag="[ ] "; break }
  if (marker != "") {
    printf "%s%s%s %s\n", marker, tag, N, $0
  }
  # Drop everything else (keeps the stream readable).
  fflush()
}'

    # Build the command stream. Use `stdbuf` if available so awk sees lines
    # promptly; otherwise journalctl's --output=cat is line-buffered enough.
    if [ "$src" = "audit" ]; then
        if ! _audit_have ausearch; then
            printf 'audit-watch: --audit needs auditd installed\n' >&2
            return 1
        fi
{{- if eq .chezmoi.os "linux" }}
        # tail audit.log; format keeps it grep-friendly
        if _audit_is_root; then
            tail -F /var/log/audit/audit.log 2>/dev/null \
                | awk -v color="$color" "$awk_prog"
        else
            sudo -v && sudo tail -F /var/log/audit/audit.log 2>/dev/null \
                | awk -v color="$color" "$awk_prog"
        fi
{{- else }}
        printf 'audit-watch: --audit not supported on macOS\n' >&2
        return 1
{{- end }}
    else
{{- if eq .chezmoi.os "linux" }}
        # auth (or all): merge sshd / sudo / su / login from journal + audit
        if _audit_have journalctl; then
            sudo_cmd=""
            if ! _audit_is_root; then sudo -v 2>/dev/null && sudo_cmd="sudo"; fi
            (
                $sudo_cmd journalctl -f -o short-iso \
                    _COMM=sshd _COMM=sudo _COMM=su _COMM=login _COMM=systemd-logind \
                    2>/dev/null &
                jpid=$!
                if [ "$src" = "all" ] && [ -r /var/log/audit/audit.log -o -n "$sudo_cmd" ]; then
                    $sudo_cmd tail -F /var/log/audit/audit.log 2>/dev/null &
                    apid=$!
                fi
                trap "kill $jpid $apid 2>/dev/null" INT TERM EXIT
                wait
            ) | awk -v color="$color" "$awk_prog"
        else
            printf 'audit-watch: journalctl not found; cannot --auth\n' >&2
            return 1
        fi
{{- else }}
        # macOS: log stream for sshd / sudo / login
        if _audit_have log; then
            log stream --style compact --predicate 'process == "sshd" OR process == "sudo" OR process == "login" OR process == "su"' 2>/dev/null \
                | awk -v color="$color" "$awk_prog"
        else
            printf 'audit-watch: macOS log(1) not found\n' >&2
            return 1
        fi
{{- end }}
    fi
}

# ===========================================================================
# Disk / filesystem helpers — sysadmin morning checks. Cross-platform; uses
# coreutils on Linux, macOS-compatible flags on Darwin.
# ===========================================================================

# ---------------------------------------------------------------------------
# disk-usage
#   df + per-mount summary, color-coded thresholds.
#   GREEN <70% / YELLOW 70-90% / RED >90%.
# ---------------------------------------------------------------------------
disk-usage() {
    case ${1:-} in
        -h|--help)
            _audit_help 'disk-usage' \
                'Per-mount usage with color-coded thresholds.' \
                'GREEN <70% / YELLOW 70-89% / RED >=90%.' \
                'Excludes pseudo / kernel / overlay filesystems.'
            return 0 ;;
    esac
{{- if eq .chezmoi.os "darwin" }}
    df -h -T nooverlay,nodevfs,nomap 2>/dev/null \
        | awk 'NR==1{print; next}
{ pct=$5; gsub("%","",pct);
  c="\033[32m"; if(pct>=70)c="\033[33m"; if(pct>=90)c="\033[1;31m";
  printf "%s%s\033[0m\n", c, $0 }'
{{- else }}
    df -hT -x tmpfs -x devtmpfs -x squashfs -x overlay -x autofs -x fuse.gvfsd-fuse 2>/dev/null \
        | awk 'NR==1{print; next}
{ pct=$6; gsub("%","",pct);
  c="\033[32m"; if(pct>=70)c="\033[33m"; if(pct>=90)c="\033[1;31m";
  printf "%s%s\033[0m\n", c, $0 }'
{{- end }}
}

# ---------------------------------------------------------------------------
# disk-largest [path] [--top N]
#   Largest dirs at depth 1 under <path> (default $HOME). Sudo for /var, /etc.
# ---------------------------------------------------------------------------
disk-largest() {
    path=${HOME:-/}
    top=20
    while [ $# -gt 0 ]; do
        case $1 in
            -h|--help)
                _audit_help 'disk-largest [path] [--top N]' \
                    'Show the N largest immediate children of <path> by disk usage.' \
                    'Default path is $HOME, default N is 20.' \
                    'For root-owned paths (/var, /etc) the helper auto-elevates.' \
                    'Hint: `disk-largest /var/log --top 10` is the classic disk-full triage.'
                return 0 ;;
            --top) top=$2; shift 2 ;;
            *) path=$1; shift ;;
        esac
    done
    [ -d "$path" ] || { printf 'disk-largest: not a directory: %s\n' "$path" >&2; return 1; }
    if [ -r "$path" ]; then
        du -h --max-depth=1 -- "$path" 2>/dev/null | sort -h | tail -"$top"
    else
        _audit_run_root du -h --max-depth=1 -- "$path" 2>/dev/null | sort -h | tail -"$top"
    fi
}

# ---------------------------------------------------------------------------
# disk-inodes
#   Inodes per mount — catches "disk has free space but can't create files".
# ---------------------------------------------------------------------------
disk-inodes() {
    case ${1:-} in
        -h|--help)
            _audit_help 'disk-inodes' \
                'Inode usage per mount. Catches "no space left on device" with' \
                'apparent free space — the inode table is exhausted.'
            return 0 ;;
    esac
{{- if eq .chezmoi.os "darwin" }}
    df -hi 2>/dev/null
{{- else }}
    df -hi -x tmpfs -x devtmpfs -x squashfs -x overlay 2>/dev/null
{{- end }}
}

# ---------------------------------------------------------------------------
# mount-info
#   Active mounts with options, plus /etc/fstab definitions.
# ---------------------------------------------------------------------------
mount-info() {
    case ${1:-} in
        -h|--help)
            _audit_help 'mount-info' \
                'Active mounts (mount -t) + persisted /etc/fstab definitions.' \
                'Useful for "is this drive mounted nodev/nosuid/noexec correctly?"'
            return 0 ;;
    esac
    printf '== active mounts ==\n'
    mount 2>/dev/null | column -t 2>/dev/null || mount
    printf '\n== /etc/fstab ==\n'
    if [ -r /etc/fstab ]; then
        grep -vE '^\s*(#|$)' /etc/fstab 2>/dev/null
    fi
}

# ---------------------------------------------------------------------------
# disk-watch [mount]
#   Watch usage of one mount over time (1-second updates). Default: /
# ---------------------------------------------------------------------------
disk-watch() {
    case ${1:-} in
        -h|--help)
            _audit_help 'disk-watch [mount]' \
                'Live updating usage of one mount (default /). Press Ctrl+C to exit.'
            return 0 ;;
    esac
    m=${1:-/}
    if _audit_have watch; then
        watch -n 1 "df -h '$m'; echo; ls -laSh '$m' 2>/dev/null | head -10"
    else
        # macOS without coreutils watch — fall back to a loop
        while true; do
            clear 2>/dev/null
            df -h "$m"; echo
            ls -laSh "$m" 2>/dev/null | head -10
            sleep 1
        done
    fi
}

# ===========================================================================
# Package install history — pkg-recent.
# Wraps the platform's package-manager log so you can answer "what was
# installed yesterday?" without remembering the per-distro command.
# ===========================================================================

# ---------------------------------------------------------------------------
# pkg-recent [--days N]
#   Recently-installed/upgraded/removed packages.
# ---------------------------------------------------------------------------
pkg-recent() {
    days=7
    while [ $# -gt 0 ]; do
        case $1 in
            -h|--help)
                _audit_help 'pkg-recent [--days N]' \
                    'Show package install/upgrade/remove events from the last N days.' \
                    'Default --days 7. Auto-detects apt / dnf / pacman / brew / npm-g.' \
                    'Useful for supply-chain triage and onboarding ("what changed?").'
                return 0 ;;
            --days) days=$2; shift 2 ;;
            *) printf 'pkg-recent: unknown arg: %s\n' "$1" >&2; return 1 ;;
        esac
    done
{{- if eq .chezmoi.os "linux" }}
    if [ -d /var/log/apt ]; then
        printf '== apt history (last %s days) ==\n' "$days"
        if _audit_have zgrep; then
            zgrep -hE 'Start-Date|Commandline|Install:|Upgrade:|Remove:' \
                /var/log/apt/history.log* 2>/dev/null \
                | awk -v cutoff="$(date -u -d "$days days ago" +%Y-%m-%d 2>/dev/null)" '
                /^Start-Date/ { d=$2; show=(d>=cutoff) }
                show { print }
            '
        else
            tail -200 /var/log/apt/history.log 2>/dev/null
        fi
    fi
    if _audit_have dnf; then
        printf '\n== dnf history (last %s days) ==\n' "$days"
        _audit_run_root dnf history list --reverse 2>/dev/null | head -50
    fi
    if _audit_have pacman; then
        printf '\n== pacman -Qll-time (last %s days) ==\n' "$days"
        if [ -r /var/log/pacman.log ]; then
            tail -500 /var/log/pacman.log | grep -E "installed|upgraded|removed" | tail -100
        fi
    fi
{{- else }}
    if _audit_have brew; then
        printf '== brew install/upgrade history (last %s days) ==\n' "$days"
        # brew has no native history; use HOMEBREW_LOGS or the Cellar mtimes
        cellar=$(brew --cellar 2>/dev/null)
        caskroom=$(brew --caskroom 2>/dev/null)
        for c in "$cellar" "$caskroom"; do
            [ -d "$c" ] || continue
            find "$c" -maxdepth 2 -type d -mtime "-$days" 2>/dev/null \
                | awk -F/ '{print $(NF-1) "/" $NF}' | sort -u
        done
    fi
{{- end }}
    if _audit_have npm; then
        printf '\n== npm -g recently changed ==\n'
        npmroot=$(npm root -g 2>/dev/null)
        [ -d "$npmroot" ] && find "$npmroot" -maxdepth 1 -type d -mtime "-$days" 2>/dev/null \
            | awk -F/ '{print $NF}' | grep -v '^$\|^node_modules$'
    fi
    if _audit_have pip; then
        printf '\n== pip --user recently installed ==\n'
        if _audit_have pip; then
            pip list --user --format=columns 2>/dev/null | head -20
        fi
    fi
}

# ===========================================================================
# health-check — unified morning summary. One command, one screen, the
# 30-second "is this server OK?" overview.
# ===========================================================================

# ---------------------------------------------------------------------------
# health-check [--quick | --full] [--no-color] [--since <when>]
# ---------------------------------------------------------------------------
health-check() {
    mode='quick'
    color=1
    since='24 hours ago'
    while [ $# -gt 0 ]; do
        case $1 in
            -h|--help)
                _audit_help 'health-check [--quick | --full] [--since <when>] [--no-color]' \
                    'Unified morning summary. Sections (each runs independently;' \
                    'failures in one do not block others):' \
                    '  - Hostname / uptime / load' \
                    '  - Disk usage (color-coded)' \
                    '  - Failed / restart-looping services' \
                    '  - Recent OOM kills' \
                    '  - Recent failed logins (Linux)' \
                    '  - Recent sudo events (last <since>)' \
                    '  - Listening ports (non-loopback only)' \
                    '  - Audit summary (if auditd installed)' \
                    'Modes:' \
                    '  --quick (default): condensed, ~25 lines' \
                    '  --full: per-section detail, ~80 lines' \
                    'Cron-friendly: --no-color is auto-on when stdout is not a TTY.'
                return 0 ;;
            --quick) mode='quick'; shift ;;
            --full) mode='full'; shift ;;
            --no-color) color=0; shift ;;
            --since) since=$2; shift 2 ;;
            *) printf 'health-check: unknown arg: %s\n' "$1" >&2; return 1 ;;
        esac
    done
    [ -t 1 ] || color=0
    if [ "$color" = "1" ]; then
        H='\033[1;36m'; G='\033[32m'; Y='\033[33m'; R='\033[1;31m'; D='\033[2m'; N='\033[0m'
    else
        H=''; G=''; Y=''; R=''; D=''; N=''
    fi

    _hc_section() { printf "${H}== %s ==${N}\n" "$1"; }

    _hc_section 'host'
    printf '  hostname: %s\n' "$(hostname)"
    printf '  uptime:   %s\n' "$(uptime | sed 's/^[ \t]*//')"
    if [ -r /proc/loadavg ]; then
        printf '  loadavg:  %s\n' "$(cut -d' ' -f1-3 /proc/loadavg)"
    fi
    printf '\n'

    _hc_section 'disk usage (>=90%% red, >=70%% yellow)'
{{- if eq .chezmoi.os "darwin" }}
    df -h 2>/dev/null | awk -v G="$G" -v Y="$Y" -v R="$R" -v N="$N" '
NR==1 { print "  "$0; next }
$5 ~ /%/ {
  pct=$5; gsub("%","",pct);
  c=G; if(pct>=70)c=Y; if(pct>=90)c=R;
  printf "  %s%s%s\n", c, $0, N
}'
{{- else }}
    df -hT -x tmpfs -x devtmpfs -x squashfs -x overlay 2>/dev/null | awk -v G="$G" -v Y="$Y" -v R="$R" -v N="$N" '
NR==1 { print "  "$0; next }
$6 ~ /%/ {
  pct=$6; gsub("%","",pct);
  c=G; if(pct>=70)c=Y; if(pct>=90)c=R;
  printf "  %s%s%s\n", c, $0, N
}'
{{- end }}
    printf '\n'

{{- if eq .chezmoi.os "linux" }}
    _hc_section 'failed services'
    if _audit_have systemctl; then
        out=$(systemctl --failed --all --no-pager --no-legend 2>/dev/null)
        if [ -z "$out" ]; then
            printf '  ${G}none${N}\n' | sed "s/\${G}/$G/g; s/\${N}/$N/g"
        else
            printf '%s\n' "$out" | awk -v R="$R" -v N="$N" '{printf "  %s%s%s\n", R, $0, N}'
        fi
    fi
    printf '\n'

    _hc_section 'high-restart services (NRestarts > 3)'
    if _audit_have systemctl; then
        found=0
        for u in $(systemctl list-units --type=service --no-pager --no-legend 2>/dev/null | awk '{print $1}'); do
            n=$(systemctl show -p NRestarts --value "$u" 2>/dev/null)
            [ -z "$n" ] && continue
            if [ "$n" -gt 3 ] 2>/dev/null; then
                printf '  %sNRestarts=%s%s %s\n' "$Y" "$n" "$N" "$u"
                found=1
            fi
        done
        [ "$found" = "0" ] && printf '  %snone%s\n' "$G" "$N"
    fi
    printf '\n'

    _hc_section "recent OOM kills (since $since)"
    if _audit_have journalctl; then
        out=$(_audit_run_root journalctl -k --since "$since" 2>/dev/null \
              | grep -iE 'out of memory|oom-killer|killed process' | tail -5)
        if [ -z "$out" ]; then
            printf '  %snone%s\n' "$G" "$N"
        else
            printf '%s\n' "$out" | awk -v R="$R" -v N="$N" '{printf "  %s%s%s\n", R, $0, N}'
        fi
    fi
    printf '\n'

    _hc_section "failed login attempts (since $since)"
    if _audit_have lastb; then
        n=$(_audit_run_root lastb -F -i 2>/dev/null | grep -v '^$' | grep -v '^btmp' | wc -l)
        c="$G"; [ "$n" -gt 5 ] 2>/dev/null && c="$Y"; [ "$n" -gt 50 ] 2>/dev/null && c="$R"
        printf '  %s%s attempts%s\n' "$c" "$n" "$N"
        if [ "$mode" = "full" ] && [ "$n" -gt 0 ] 2>/dev/null; then
            _audit_run_root lastb -F -i 2>/dev/null | head -10 | sed 's/^/    /'
        fi
    fi
    printf '\n'
{{- else }}
    _hc_section 'launchctl errored services'
    if _audit_have launchctl; then
        out=$(launchctl list 2>/dev/null \
              | awk 'NR>1 && $2 != "0" && $2 != "-" {printf "  PID=%s STATUS=%s LABEL=%s\n", $1, $2, $3}')
        if [ -z "$out" ]; then
            printf '  %snone%s\n' "$G" "$N"
        else
            printf '%s\n' "$out" | sed "s/^/  $R/" | sed "s/$/$N/"
        fi
    fi
    printf '\n'
{{- end }}

    _hc_section "sudo events (since $since)"
    if _audit_have journalctl; then
        n=$(_audit_run_root journalctl _COMM=sudo --since "$since" --no-pager 2>/dev/null | wc -l)
        printf '  %s events\n' "$n"
        if [ "$mode" = "full" ] && [ "$n" -gt 0 ] 2>/dev/null; then
            _audit_run_root journalctl _COMM=sudo --since "$since" --no-pager 2>/dev/null | tail -10 | sed 's/^/    /'
        fi
    fi
    printf '\n'

    _hc_section 'listening ports (non-loopback)'
    if _audit_have ss; then
        out=$(_audit_run_root ss -tlnp 2>/dev/null | tail -n +2 | grep -vE '127\.0\.0\.1|::1|\[::1\]')
        if [ -z "$out" ]; then
            printf '  %snone exposed externally%s\n' "$G" "$N"
        else
            n=$(printf '%s\n' "$out" | wc -l)
            printf '  %s listener(s):\n' "$n"
            printf '%s\n' "$out" | head -10 | sed 's/^/    /'
        fi
    elif _audit_have lsof; then
        _audit_run_root lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | grep -vE '127\.0\.0\.1|::1' | head -10 | sed 's/^/    /'
    fi
    printf '\n'

{{- if eq .chezmoi.os "linux" }}
    if _audit_have aureport; then
        _hc_section "audit summary (since $since)"
        _audit_run_root aureport --start "$since" --summary -i 2>/dev/null | head -25 | sed 's/^/  /'
        printf '\n'
    fi
{{- end }}

    if [ "$mode" = "full" ]; then
        _hc_section "scheduled jobs (next 5 timer fires)"
{{- if eq .chezmoi.os "linux" }}
        if _audit_have systemctl; then
            systemctl list-timers --no-pager --no-legend 2>/dev/null | head -5 | sed 's/^/  /'
        fi
{{- else }}
        if _audit_have launchctl; then
            launchctl list 2>/dev/null | tail -n +2 | head -5 | sed 's/^/  /'
        fi
{{- end }}
        printf '\n'
    fi

    _hc_section 'verdict'
    # Quick & dirty: if anything in failed-services / OOM / failed-logins>50
    # was non-zero, mark RED. Otherwise GREEN.
    verdict="${G}OK${N}"
{{- if eq .chezmoi.os "linux" }}
    if _audit_have systemctl && [ -n "$(systemctl --failed --all --no-pager --no-legend 2>/dev/null)" ]; then
        verdict="${R}WARN: failed services${N}"
    fi
{{- end }}
    printf "  %b\n" "$verdict"
}
