# 00_exports.sh - Shell-agnostic environment variables (POSIX subset).
# Sourced by both ~/.zshrc and ~/.bashrc via load_modular_dir
# "$XDG_CONFIG_HOME/shell" sh.
# Profile: {{ .profile }} (OS: {{ .chezmoi.os }}, arch: {{ .chezmoi.arch }})

# Editor selection is initialized by 09_editor.sh after PATH setup.

# Language
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# PATH additions
# ~/.dotfiles/bin: chezmoi-managed scripts (this repo's dot_dotfiles/bin/)
# ~/bin: legacy / user-placed binaries (transitional, will be removed once
#        every host has applied the new layout and old ~/bin/* cleaned up)
# ~/.local/bin: auto-installed tools (uv tool, cargo install, mise, npm -g, ...)
export PATH="$HOME/.dotfiles/bin:$HOME/bin:$HOME/.local/bin:$PATH"

{{ if eq .chezmoi.os "linux" -}}
# Snap binaries (Linux only)
if [[ -d /snap/bin ]]; then
    export PATH="/snap/bin:$PATH"
fi
{{ end -}}

# OpenCode's official installer writes the binary here on both macOS and
# Linux (coding_agents ansible role runs `curl ...opencode/install | bash
# --no-modify-path` everywhere as of 2026-05). Keep PATH under dotfiles
# control instead of relying on the installer to append shell rc files —
# `--no-modify-path` deliberately skips that mutation, see the comment
# block at dot_ansible/roles/coding_agents/tasks/main.yml `# === OpenCode`.
if [[ -d "$HOME/.opencode/bin" ]]; then
    export PATH="$HOME/.opencode/bin:$PATH"
fi

# .NET global tools (e.g. azure-cost-cli via `dotnet tool install --global`).
# Default install location per `dotnet-install.sh` and Homebrew's dotnet cask.
# Only prepend if the directory exists, so we don't pollute PATH on hosts
# without .NET installed.
if [[ -d "$HOME/.dotnet/tools" ]]; then
    export PATH="$HOME/.dotnet/tools:$PATH"
fi
# dotnet itself (noRoot Linux install target; macOS/Linux-sudo install to
# system locations already on $PATH).
if [[ -x "$HOME/.dotnet/dotnet" ]]; then
    export PATH="$HOME/.dotnet:$PATH"
    export DOTNET_ROOT="$HOME/.dotnet"
fi

# =============================================================================
# Homebrew Setup
# =============================================================================
# macOS Homebrew shellenv runs in dot_zshrc.tmpl / dot_bashrc.tmpl BEFORE this
# modular layer loads (so bash-completion v2 can see $HOMEBREW_PREFIX). We do
# NOT duplicate it here — that would re-run shellenv (~17ms) at zero benefit.
{{ if eq .chezmoi.os "linux" -}}
# Linux: Initialize Linuxbrew if installed (no equivalent block in bashrc/zshrc).
# Linuxbrew is optional on Linux (most packages managed by apt via Ansible).
# Check the binary, not just the dir — a failed `brew install` leaves the
# /home/linuxbrew/.linuxbrew/ tree behind (sudo'd by the installer before
# the actual brew binary download), and `eval "$(.../brew shellenv)"`
# would then print "No such file or directory" on every shell start.
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x "$HOME/.linuxbrew/bin/brew" ]]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
fi
{{ end -}}

# Set default Brewfile location (XDG-compliant)
export HOMEBREW_BUNDLE_FILE="$HOME/.config/homebrew/Brewfile"

{{ if .useChineseMirror -}}
# =============================================================================
# GFW Mirrors (useChineseMirror=true) — env-var driven package ecosystems.
# Config-file driven ecosystems (PyPI/uv, npm, Bun, cargo, docker registry)
# live in their own templates under dot_config/ and dot_cargo/.
# =============================================================================

# Homebrew: bottles (ghcr.io default → partial-transfer errors) + brew.git.
#
# Benchmarked 2026-07 on this Mac (China network) — brew.git shallow fetch +
# ~30 MB bottle-index download, all four mirrors back-to-back:
#   mirror   brew.git fetch          bottle throughput
#   BFSU     OK  1.1s   (ACTIVE)     31 MB/s   ← fastest overall
#   USTC     OK  1.0s                11 MB/s   ← solid fallback
#   Aliyun   FAIL (upload-pack)      17 MB/s   ← git BROKEN, bottles fine
#   TUNA     TIMEOUT 45s             6 MB/s    ← queueing, both slow
# Aliyun's git smart-HTTP upload-pack hangs (ref advertisement / `ls-remote`
# succeeds, packfile streaming stalls → 60s+), so every `brew update` /
# auto-update froze until `unset HOMEBREW_BREW_GIT_REMOTE`. See
# pitfalls/homebrew-aliyun-brew-git-hang-core-clone-bloat.md.
#
# CRITICAL — do NOT set HOMEBREW_CORE_GIT_REMOTE. Homebrew 4.x defaults to the
# JSON API (HOMEBREW_API_DOMAIN); homebrew/core stays a ~8 KB stub and formulae
# come from the API. Setting HOMEBREW_CORE_GIT_REMOTE forces `brew update` to
# maintain a FULL ~1 GB homebrew-core git clone (slow fetch every update + disk
# bloat) for zero benefit. USTC already dropped homebrew-core.git (2026-06) for
# this reason. Bottle/API mirror is what actually matters for downloads.
#
# Homebrew env vars are single-value (no uv-style extra-index fallback). To
# switch mirrors on-the-fly use the `brew-mirror {bfsu|ustc|aliyun|tuna}`
# helper (dot_config/shell/10_aliases.sh) then `brew update`.
export HOMEBREW_API_DOMAIN="https://mirrors.bfsu.edu.cn/homebrew-bottles/api"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.bfsu.edu.cn/homebrew-bottles"
export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.bfsu.edu.cn/git/homebrew/brew.git"
# Defensively clear any inherited/legacy HOMEBREW_CORE_GIT_REMOTE (older configs
# exported it) so already-open shells re-sourcing this file don't keep forcing
# the ~1 GB homebrew-core clone. New shells start clean anyway.
unset HOMEBREW_CORE_GIT_REMOTE
# USTC alternative (solid, well-known university mirror):
#   export HOMEBREW_API_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles/api"
#   export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles"
#   export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.ustc.edu.cn/brew.git"
# Aliyun alternative (bottles fast, but brew.git is BROKEN — bottles only):
#   export HOMEBREW_API_DOMAIN="https://mirrors.aliyun.com/homebrew-bottles/api"
#   export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.aliyun.com/homebrew-bottles"
#   # (do NOT set HOMEBREW_BREW_GIT_REMOTE to Aliyun — it hangs)
# TUNA alternative (upstream of BFSU; frequent "Waiting in queue"):
#   export HOMEBREW_API_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/api"
#   export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles"
#   export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/brew.git"

# Rustup: affects `rustup install`, `rustup update`, `rustup self update`,
# and mise's rust plugin (which invokes rustup internally).
# Ref: https://mirrors.tuna.tsinghua.edu.cn/help/rustup/
export RUSTUP_DIST_SERVER="https://mirrors.tuna.tsinghua.edu.cn/rustup"
export RUSTUP_UPDATE_ROOT="https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup"

# mise runtime downloads: Node.js prebuilt archives.
# Python is usually fine since mise pulls pre-compiled binaries from the
# python-build-standalone GitHub releases (not blocked). If you hit issues,
# set PYTHON_BUILD_MIRROR_URL manually.
#
# Mirror choice: Aliyun (NOT TUNA). TUNA's `nodejs-release` mirror keeps
# only ~5 hand-picked versions and aggressively garbage-collects the rest,
# so `mise install node@lts` 404s on whatever LTS patch isn't in their
# small set (see pitfalls/tuna-nodejs-mirror-aggressive-gc.md). Aliyun
# mirrors all of nodejs.org/dist/ and is much more reliable in practice.
# Ref: https://developer.aliyun.com/mirror/nodejs
export MISE_NODE_MIRROR_URL="https://mirrors.aliyun.com/nodejs-release/"
export NODE_BUILD_MIRROR_URL="https://mirrors.aliyun.com/nodejs-release/"

# Go modules: goproxy.cn is the Qiniu-hosted de-facto standard for China;
# TUNA does not host a Go module proxy. `direct` fallback preserves private
# repo support.
# Ref: https://goproxy.cn/
export GOPROXY="https://goproxy.cn,direct"
export GOSUMDB="sum.golang.google.cn"
{{ end -}}

# --- Suggested exports (uncomment to enable) ---
