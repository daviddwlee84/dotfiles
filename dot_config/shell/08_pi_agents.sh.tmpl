# 08_pi_agents.sh - canonical Pi / OMP / pia PATH precedence (zsh + bash).
#
# 05_mise.sh can prepend a Node-version bin directory and legacy Bun setup can
# prepend ~/.bun/bin. Reassert only the managed agent locations afterwards so
# stale package-manager copies cannot shadow the canonical installs.

{{ if .installCodingAgents -}}
if [ -x "$HOME/.local/bin/pi" ] || [ -x "$HOME/.local/bin/omp" ]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

_pia_root="$HOME/.local/share/pi-agents"
if [ -x "$_pia_root/bin/pia" ]; then
    export PATH="$_pia_root/bin:$PATH"
fi
unset _pia_root
{{ end -}}
