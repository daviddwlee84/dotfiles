# Brewfile - Shared configuration (macOS & Linux)
# Applied via: brew bundle --file=~/.config/homebrew/Brewfile
#
# This file is managed by chezmoi. Edit the source:
#   chezmoi edit ~/.config/homebrew/Brewfile

# =============================================================================
# Taps (Third-party repositories)
# =============================================================================
{{ if and (eq .chezmoi.os "darwin") .installBrewApps -}}
tap "nikitabobko/tap"  # aerospace (macOS window manager)
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
tap "daviddwlee84/tap"  # personal CLIs — auto-trusted by the brew-bundle run-script (trust_bundle_taps)
{{ end -}}

# =============================================================================
# Formulas - CLI Tools (cross-platform)
# =============================================================================
# Note: Most CLI tools are managed by ansible for better cross-platform support
# Only add formulas here that you want to manage via Brewfile

# translate — terminal translator (CLI+TUI). macOS via the public tap; Linux uses
# `go install` (go_tools role). NOT installBrewApps-gated: it's a CLI wanted on every mac.
{{ if eq .chezmoi.os "darwin" -}}
brew "daviddwlee84/tap/translate"
{{ end -}}

# dev-cli — repository, task and worktree command center. macOS via the public
# tap; Linux uses `go install` (go_tools role). Installs as the `dev` command.
{{ if eq .chezmoi.os "darwin" -}}
brew "daviddwlee84/tap/dev-cli"
{{ end -}}

# The following formulas support the general macOS GUI app bundle.
{{ if and (eq .chezmoi.os "darwin") .installBrewApps -}}
# Mac App Store CLI (needed for mas entries in Brewfile.darwin)
brew "mas"
# NOTE: deliberately no `brew "tailscale"` here. On macOS the Tailscale CLI is
# already provided by `cask "tailscale-app"` (Brewfile.darwin) as
# /usr/local/bin/tailscale — a shell wrapper into the app bundle. The standalone
# `tailscale` formula is redundant AND harmful: it fights the cask over that same
# path on every upgrade (ollama-style link conflict) and ships a `tailscaled` the
# app's system extension already runs. Do NOT re-add it for macOS, and never
# `brew services start tailscale`. See
# pitfalls/tailscale-another-copy-app-store-leftover.md
{{ end -}}
