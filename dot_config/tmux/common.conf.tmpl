# ~/.config/tmux/common.conf
# Theme-agnostic settings: plugins, general options, terminal compatibility.
# Managed by chezmoi - do not edit directly.

# =============================================================================
# Plugins (managed by TPM; theme plugins live in theme.*.conf)
# =============================================================================

set-environment -g TMUX_PLUGIN_MANAGER_PATH '~/.tmux/plugins'

set -g @plugin 'tmux-plugins/tpm'

# Session management
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @continuum-restore 'on'

# Restore extra processes beyond resurrect's defaults (vim/nvim/emacs/less/...).
# Coding-agent CLIs and TUI tools are NOT in the default list, so without this
# they'd come back as a bare shell prompt at the right cwd. Adding them here
# makes resurrect re-exec the bare command (no args, no session resume — see
# pitfalls/tmux-resurrect-agents.md for why and what's lost).
set -g @resurrect-processes 'opencode claude codex aider gemini lazygit btop htop k9s lazydocker glow'

# Floating scratch pane (prefix + F to toggle, prefix + P for menu)
set -g @plugin 'omerxx/tmux-floax'
set -g @floax-bind 'F'
set -g @floax-bind-menu 'P'
set -g @floax-width '80%'
set -g @floax-height '80%'
set -g @floax-border-color 'magenta'
set -g @floax-text-color 'blue'
set -g @floax-session-name 'float'
set -g @floax-change-path 'true'

# URL picker: prefix + u opens fzf popup with all URLs in the pane
set -g @plugin 'joshmedeski/tmux-fzf-url'

# Open highlighted selection in copy-mode: o = open, C-o = open in $EDITOR, S = search
set -g @plugin 'tmux-plugins/tmux-open'
set -g @open-S 'https://www.google.com/search?q='

# extrakto: prefix + Tab opens an fzf popup that extracts file paths / URLs / words
# from the pane. Enter = copy to clipboard, Tab = insert to the prompt, Ctrl-f =
# cycle filter, Ctrl-t = cycle clipboard mode (incl. OSC 52 for SSH). PATH-first
# filter order since the main use is grabbing file paths. Complements tmux-fzf-url
# (prefix+u, URLs) and prefix+C-y (line yank); prefix+Tab is otherwise unbound.
set -g @plugin 'laktak/extrakto'
set -g @extrakto_filter_order 'path url word line'

# tmux-fzf: replaces the ugly built-in `prefix + ?` (list-keys dump) with an
# fzf popup over EVERY binding (incl. user-defined), plus session/window/pane/
# command/process/clipboard pickers. The plugin's launch key defaults to `F`
# which collides with tmux-floax — set it to `M-Z` (an unused key) so the
# plugin's auto-binding doesn't shadow floax. Our real entry point is
# `prefix + ?` (rebound in keybindings.conf).
# NOTE: `TMUX_FZF_LAUNCH_KEY=""` does NOT disable the auto-bind — the
# plugin's `[ -z "$VAR" ]` check treats empty as unset and falls back to `F`.
set -g @plugin 'sainnhe/tmux-fzf'
TMUX_FZF_LAUNCH_KEY="M-Z"
TMUX_FZF_OPTIONS="-p -w 80% -h 70% -m"
TMUX_FZF_ORDER="keybinding|session|window|pane|command|process|clipboard"
TMUX_FZF_PREVIEW=1

# =============================================================================
# General Settings
# =============================================================================

# No ESC delay (critical for Neovim and coding agents)
set -sg escape-time 0

# Enable mouse support
setw -g mouse on

# Use vi mode keys in copy mode (gated on chezmoi `enableVimMode` —
# default true; false → emacs copy-mode keymap. See docs/this_repo/vim-mode.md.)
setw -g mode-keys {{ if .enableVimMode }}vi{{ else }}emacs{{ end }}

# Larger scrollback buffer
set -g history-limit 50000

# Don't push the pre-clear screen contents into scrollback when a TUI issues a
# full-screen clear (ED). Streaming coding agents (Claude Code, OpenCode, etc.)
# that run on the main screen (not alternate-screen) otherwise leave ghost
# frames in history every repaint. Alt-screen apps (vim, htop) are unaffected.
# Default in tmux 3.3+ is `on`; we explicitly turn it off for cleaner scrollback.
# See pitfalls/tmux-scrollback-tui-repaint-ghosting.md.
set -g scroll-on-clear off

# 1-indexed windows and panes
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# Focus events for Vim autoread compatibility
set -g focus-events on

# If the current session is destroyed, switch to another one instead of detaching
set -g detach-on-destroy off

# Status bar visibility (position is set per-theme)
set-option -g status on

# Window activity / silence / bell flags
# These drive the per-window flag glyphs (`#` activity, `~` silence, `!` bell)
# that Catppuccin's `window-status-format` already includes via #{window_flags}.
# Use case: glance at the tab bar to see which non-current window produced
# output (`#`) or has been quiet for a while (`~`). Useful for long builds /
# tests / pueue queues running in background panes.
#
# Limitation for LLM agent panes: opencode/claude run a spinner while the
# model is thinking, so from tmux's POV the pane is *always* active —
# `monitor-silence` will not fire for "agent waiting on user". For true
# semantic state (running / idle / error) on agent panes, see
# backlog/tmux-window-status-indicators.md.
#
# `visual-*` are kept off so the message line never spams; the flag in the
# tab list is the only visible signal.
setw -g monitor-activity on
setw -g monitor-bell on
setw -g monitor-silence 0
set -g visual-activity off
set -g visual-silence off
set -g visual-bell off

# Status-bar messages (display-message) — default 750ms is too short to read
# multi-word confirmations like "Moved to foo:3 (zsh)" before they vanish.
# 0 = stay until the next key event (the key still does its normal action;
# only the message gets cleared). Trade-off: occasionally a stale message
# lingers if you stop typing, but no important confirmation is ever missed.
set -g display-time 0

# =============================================================================
# Terminal & Key Compatibility
# =============================================================================

set -s default-terminal 'tmux-256color'
set -as terminal-features ",xterm-256color:RGB"

# Forward extended keys (CSI-u) so Ctrl+/, Shift+Enter etc. reach TUIs.
#
# Use `on` (NOT `always`):
#   - `on`: emit CSI-u only when a key has NO legacy encoding (Shift+Enter,
#     Ctrl+Enter, Ctrl+/, Ctrl+digit). Keys with legacy encoding (Ctrl+letter
#     including Ctrl+J = LF, Ctrl+M = CR, Ctrl+I = TAB) keep their classic
#     bytes.
#   - `always`: emit CSI-u for EVERY modifier+key combo, including ones with
#     a legacy encoding. This breaks ble.sh paste handling because each `\n`
#     in pasted content gets re-encoded as `ESC[106;5u` (Ctrl+J as CSI-u),
#     and ble.sh inserts the escape sequence as literal text instead of as
#     a newline. See pitfalls/tmux-extended-keys-always-paste.md.
#
# Net result on `on`: TUIs that need Ctrl+Enter / Shift+Enter (Claude Code,
# Neovim, etc.) still get them; paste of multi-line text into ble.sh works
# correctly; legacy `Ctrl+letter` shortcuts in shells / tmux / TUIs keep
# their normal encodings.
set -s extended-keys on
if-shell 'tmux -V | grep -qE "tmux ([3-9]\.[5-9]|[3-9]\.[1-9][0-9]|[4-9]\.)"' \
  'set -s extended-keys-format csi-u'
set -as terminal-features 'xterm*:extkeys'

# OSC 52 clipboard (works over SSH)
set -g set-clipboard on

# Declare OSC 52 support explicitly for common outer terminals. tmux 3.2+ only
# emits OSC 52 when it believes the outer terminal supports it; most modern
# terminals (Ghostty, Alacritty, iTerm2, kitty, WezTerm) do. Without these
# hints tmux falls back to terminfo's `Ms` capability, which is absent from
# the `tmux-256color` entry shipped by many distros, so yanks from inner
# apps (e.g. Neovim over SSH) silently drop.
set -as terminal-features ",xterm*:clipboard"
set -as terminal-features ",ghostty*:clipboard"
set -as terminal-features ",alacritty*:clipboard"

# Allow OSC passthrough (for terminal images, sixel, etc.)
set -g allow-passthrough on
