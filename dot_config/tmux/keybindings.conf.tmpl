# ~/.config/tmux/keybindings.conf
# All bind-key definitions and the prefix + Enter popup menu.
# Managed by chezmoi - do not edit directly.
#
# Templated on the chezmoi `enableVimMode` prompt (default true). The
# `copy-mode-vi` table bindings below switch to the `copy-mode` table
# when vim mode is off, and the vim-tmux-navigator block (Ctrl+h/j/k/l)
# is omitted entirely. See docs/this_repo/vim-mode.md.
{{- $copyTable := "copy-mode" -}}
{{- if .enableVimMode -}}{{ $copyTable = "copy-mode-vi" }}{{- end }}

# =============================================================================
# Mouse menu persistence
# =============================================================================
# tmux's built-in MouseDown3* bindings invoke display-menu without -O, so the
# menu dismisses the moment the right-click is released. Rebind with -O so the
# menu stays Open until an item is chosen or Escape is pressed.

unbind-key -n MouseDown3Pane
# *** IF YOU EDIT THE MENU BODY, ALSO UPDATE dot_config/tmux/menu-pane.sh ***
# (keyboard equivalent is `prefix + M-p`, defined near the popup-menu section
# at the bottom of this file; the body is duplicated by design per
# pitfalls/tmux-submenu-flash-and-bottom-right.md).
bind-key -n MouseDown3Pane \
  if-shell -F -t = "#{||:#{mouse_any_flag},#{&&:#{pane_in_mode},#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}}}" \
    { select-pane -t = ; send-keys -M } \
    { display-menu -O -T "#[align=centre]#{pane_current_command} (pane #{pane_index})" -t = -x M -y M \
        "Horizontal Split" h { split-window -h -c "#{pane_current_path}" } \
        "Vertical Split"   v { split-window -v -c "#{pane_current_path}" } \
        "" \
        "Swap Up"    u { swap-pane -U } \
        "Swap Down"  d { swap-pane -D } \
        "Swap Left"  l { swap-pane -t '{left-of}' } \
        "Swap Right" r { swap-pane -t '{right-of}' } \
        "" \
        "#{?window_zoomed_flag,Unzoom,Zoom}" z { resize-pane -Z } \
        "Resize 75%"  "+" { resize-pane -x 75% } \
        "Resize even"  "=" { select-layout even-horizontal } \
        "Mark pane"    m { select-pane -m } \
        "Swap marked"  s { swap-pane } \
        "Join marked pane here (h-split)" j { join-pane -h ; display-message "Joined marked pane here" } \
        "Join marked pane here (v-split)" J { join-pane -v ; display-message "Joined marked pane here" } \
        "Send pane to window... (h-split)" \
          S { choose-tree -Zw -F "#{window_name}" "join-pane -h -s '#{pane_id}' -t '%%' ; display-message 'Sent pane to target'" } \
        "Break to new window" \
          B { break-pane ; display-message "Broke pane out to window #{window_index} (#{window_name})" } \
        "" \
        "Enter copy mode" "[" { copy-mode } \
        "Respawn"     R { respawn-pane -k } \
        "Kill pane"   X { confirm-before -p "Kill pane? (y/n)" kill-pane } }

unbind-key -n MouseDown3Status
# *** IF YOU EDIT THE MENU BODY, ALSO UPDATE dot_config/tmux/menu-window.sh ***
# (keyboard equivalent is `prefix + M-w`; body duplicated by design — see the
# comment above MouseDown3Pane for the pitfall reference.)
#
# Window-tab right-click menu.
#
# WARNING: this menu is currently 23 visible rows, well above the ~14-row
# soft cap documented in AGENTS.md ("tmux ≥ 3.3 required for popup menu").
# tmux's display-menu silently suppresses itself if it can't fit on screen,
# so on small terminals (mobile SSH, half-height splits ~≤ 26 rows) the menu
# may not appear at all. Inlining (rather than nested submenus) is forced by
# pitfalls/tmux-submenu-flash-and-bottom-right.md — nested display-menu via
# run-shell from MouseDown3Status flashes / lands bottom-right / no-ops on
# second invocation. So everything stays flat here.
#
# The bottom block (⭐/📌/🔖/🚩 + Clear agent status) drives two per-window
# tmux user-options:
#   - @bookmark_status — manual tag, toggled by ~/.config/tmux/toggle-bookmark.sh
#   - @workmux_status  — agent state (🤖/💬/✅) written by workmux hooks; cleared
#                        here as the GUI equivalent of `wmclear` from 38_workmux.sh
# Both render side-by-side in the catppuccin window-text format (see
# theme.catppuccin.conf lines 31-32).
bind-key -n MouseDown3Status \
  display-menu -O -T "#[align=centre]#{window_index}:#{window_name}" -t = -x W -y W \
    "Swap Left"  l { swap-window -t :-1 } \
    "Swap Right" r { swap-window -t :+1 } \
    "" \
    "Even horizontal" 1 { select-layout even-horizontal } \
    "Even vertical"   2 { select-layout even-vertical } \
    "Main horizontal" 3 { select-layout main-horizontal } \
    "Main vertical"   4 { select-layout main-vertical } \
    "Tiled (grid)"    5 { select-layout tiled } \
    "" \
    "Move to session..." m { choose-tree -Zs -F "#{session_name}" "move-window -s '#{window_id}' -t '%%'" } \
    "Link to session..." K { choose-tree -Zs -F "#{session_name}" "link-window -s '#{window_id}' -t '%%:'" } \
    "Break all panes → windows" E { run-shell "~/.config/tmux/break-all-panes.sh" } \
    "" \
    "Kill window" X { kill-window } \
    "Renumber windows" N { move-window -r ; display-message "Windows renumbered" } \
    "Rename"      n { command-prompt -F -I "#W" { rename-window -t "#{window_id}" "%%" } } \
    "" \
    "⭐ Star"     s { run-shell "~/.config/tmux/toggle-bookmark.sh '#{window_id}' '⭐'" } \
    "📌 Pin"      p { run-shell "~/.config/tmux/toggle-bookmark.sh '#{window_id}' '📌'" } \
    "🔖 Bookmark" b { run-shell "~/.config/tmux/toggle-bookmark.sh '#{window_id}' '🔖'" } \
    "🚩 Flag"     f { run-shell "~/.config/tmux/toggle-bookmark.sh '#{window_id}' '🚩'" } \
    "Clear agent status" c { set-option -w -t "#{window_id}" -u "@workmux_status" ; display-message "Cleared @workmux_status on #{window_index}:#{window_name}" } \
    "" \
    "New window"  w { new-window }

unbind-key -n MouseDown3StatusLeft
# *** IF YOU EDIT THE MENU BODY, ALSO UPDATE dot_config/tmux/menu-status-left.sh ***
# (keyboard equivalent is `prefix + M-s`; body duplicated by design — see the
# comment above MouseDown3Pane for the pitfall reference.)
#
# "Kill all sessions" + "Kill session & exit" route through the clean-quit
# helpers so tmux-continuum does NOT auto-restore the just-closed sessions.
# See pitfalls/tmux-continuum-restores-on-intentional-quit.md.
bind-key -n MouseDown3StatusLeft \
  display-menu -O -T "#[align=centre]#{session_name}" -t = -x M -y W \
    Next        n { switch-client -n } \
    Previous    p { switch-client -p } \
    "" \
    "Choose session..." c { choose-tree -Zs } \
    Rename      N { command-prompt -I "#S" { rename-session "%%" } } \
    "" \
    "Move current window to..." m { choose-tree -Zs -F "#{session_name}" "move-window -s '#{window_id}' -t '%%'" } \
    "" \
    "New session" s { new-session } \
    "New window"  w { new-window } \
    "" \
    "Kill session"        X { kill-session } \
    "Kill session & exit" E { run-shell "~/.config/tmux/kill-session-exit.sh" } \
    "Kill all sessions"   Q { confirm-before -p "Kill ALL sessions (tmux server)? (y/n)" "run-shell '~/.config/tmux/kill-server-clean.sh'" }

# =============================================================================
# Vim-Style Copy Mode (prefix + [ to enter, q to exit)
# =============================================================================
#
#   h/j/k/l  move cursor        C-u/C-d  half-page up/down
#   g/G      top/bottom          //?      search forward/backward
#   v        begin selection     V        line selection
#   C-v      rectangle select    y        yank to clipboard
#   Escape   clear selection     q        exit copy mode

bind -T {{ $copyTable }} v send-keys -X begin-selection
bind -T {{ $copyTable }} V send-keys -X select-line
bind -T {{ $copyTable }} C-v send-keys -X rectangle-toggle
bind -T {{ $copyTable }} y send-keys -X copy-selection-and-cancel
bind -T {{ $copyTable }} MouseDragEnd1Pane send-keys -X copy-selection
bind -T {{ $copyTable }} DoubleClick1Pane select-pane \; send-keys -X select-word

# -----------------------------------------------------------------------------
# Command-boundary navigation in copy-mode (Warp-style).
# Requires OSC 133 markers from the shell — emitted by
# dot_config/zsh/tools/02_shell_integration.zsh. In a plain shell (no markers,
# e.g. `sh`, `bash` without our hook, or `DISABLE_OSC133=1`), these keys are
# no-ops. tmux 3.4+ required for next-prompt/previous-prompt; the `-o` variant
# (jump to output start, not prompt start) is tmux 3.5+.
#
#   {  / }    previous/next prompt (the prompt line itself)
#   M-[ / M-] previous/next command output (line AFTER the prompt — usually
#             what you want for "skip to the output of the previous command")
# -----------------------------------------------------------------------------
bind -T {{ $copyTable }} '{' send-keys -X previous-prompt
bind -T {{ $copyTable }} '}' send-keys -X next-prompt
bind -T {{ $copyTable }} M-[ send-keys -X previous-prompt -o
bind -T {{ $copyTable }} M-] send-keys -X next-prompt -o

# =============================================================================
# Capture Pane Helpers
# =============================================================================

# prefix + y: copy visible pane content to system clipboard
# `load-buffer -w -` loads into tmux's paste buffer AND forwards to the outer
# terminal via OSC 52 (requires `set-clipboard on` in common.conf). This works
# over SSH without shelling out to pbcopy/xclip on the remote host.
bind y run-shell "tmux capture-pane -p | tmux load-buffer -w - && tmux display-message 'Pane content copied to clipboard'"

# prefix + Y: copy full scrollback to system clipboard
bind Y run-shell "tmux capture-pane -pS - | tmux load-buffer -w - && tmux display-message 'Full scrollback copied to clipboard'"

# prefix + C-y: capture pane into fzf for line-by-line selection, yank chosen lines
bind C-y run-shell "\
  tmux capture-pane -pS - | fzf-tmux -p 80%,70% --multi --tac --no-sort \
    --header 'Select lines to copy (Tab=multi, Enter=copy)' \
    | tmux load-buffer -w - && tmux display-message 'Selected lines copied'"

# prefix + M-y: copy the LAST command's OUTPUT to clipboard (Warp-style).
# Requires OSC 133 markers — if the shell doesn't emit them (non-zsh shell,
# DISABLE_OSC133=1, or a remote bash without our hook), selection ends up
# empty. Chain: enter copy-mode, jump to start of previous command's output,
# begin selection, jump forward to the next prompt (end of output), copy,
# flash confirmation.
bind M-y copy-mode \; \
  send-keys -X previous-prompt -o \; \
  send-keys -X begin-selection \; \
  send-keys -X next-prompt \; \
  send-keys -X copy-pipe-and-cancel "tmux load-buffer -w -" \; \
  display-message "Last command output copied to clipboard"

# prefix + M-i: copy the LAST command's INPUT LINE (prompt + typed command).
# Same dependency on OSC 133 markers. Because we don't emit the B marker
# (end-of-prompt), the copied text includes prompt chrome (e.g. "❯ echo hi"
# not just "echo hi"). Trim in the paste target if needed. Chain: enter
# copy-mode, jump to the previous prompt's A marker, begin selection, jump
# forward to the C marker (= start of output = end of input line), copy.
bind M-i copy-mode \; \
  send-keys -X previous-prompt \; \
  send-keys -X begin-selection \; \
  send-keys -X next-prompt -o \; \
  send-keys -X copy-pipe-and-cancel "tmux load-buffer -w -" \; \
  display-message "Last command input (prompt+line) copied to clipboard"

# =============================================================================
# Vim-Style Pane Navigation
# =============================================================================

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# -----------------------------------------------------------------------------
# vim-tmux-navigator: prefix-less Ctrl+h/j/k/l crosses tmux panes <-> vim splits
# -----------------------------------------------------------------------------
# Detect if the current pane is running vim/neovim; if so forward the key,
# otherwise move between tmux panes. Matches christoomey/vim-tmux-navigator.
# Gated on chezmoi `enableVimMode` (default true). When off, Ctrl+h/j/k/l
# pass through to the inner shell (Ctrl+L = clear, Ctrl+H = backspace, etc.).
# See docs/this_repo/vim-mode.md.
{{ if .enableVimMode -}}
is_vim="ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?\\.?(view|n?vim?x?)(-wrapped)?(diff)?$'"
bind-key -n 'C-h' if-shell "$is_vim" 'send-keys C-h'  'select-pane -L'
bind-key -n 'C-j' if-shell "$is_vim" 'send-keys C-j'  'select-pane -D'
bind-key -n 'C-k' if-shell "$is_vim" 'send-keys C-k'  'select-pane -U'
bind-key -n 'C-l' if-shell "$is_vim" 'send-keys C-l'  'select-pane -R'
# NOTE: C-\ (select-pane -l) removed — tmux 3.4+ cannot parse C-\ in config files.
# Use directional C-h/j/k/l instead, or prefix+; for last-pane.

bind-key -T copy-mode-vi 'C-h' select-pane -L
bind-key -T copy-mode-vi 'C-j' select-pane -D
bind-key -T copy-mode-vi 'C-k' select-pane -U
bind-key -T copy-mode-vi 'C-l' select-pane -R
{{- else -}}
# enableVimMode = false: vim-tmux-navigator omitted. Use prefix + h/j/k/l
# (kept below) or prefix + Arrow for pane navigation.
{{- end }}

# Intuitive split bindings (| = left/right, - = top/bottom)
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# Also override default % and " so they inherit current pane's cwd (consistent with | / - and `c`)
bind % split-window -h -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"

# Resize panes with prefix + H/J/K/L (5 cells)
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# Fine resize with Meta + h/j/k/l (1 cell, repeatable)
bind -r M-h resize-pane -L 1
bind -r M-j resize-pane -D 1
bind -r M-k resize-pane -U 1
bind -r M-l resize-pane -R 1

# Quick ratio: set current pane to 75% width
bind + resize-pane -x 75%

# =============================================================================
# Quick Window Switching (Ctrl+Number, requires CSI-u / extended-keys)
# =============================================================================
# Supplement to prefix + 1..9 (tmux built-in defaults, always available).
# These require extended-keys (CSI-u) support from the terminal emulator
# (Ghostty/cmux, Alacritty, Kitty, WezTerm). Legacy terminals (Terminal.app,
# plain SSH) will not send these sequences — use prefix + number instead.
# Note: prefix + 9 / prefix + 0 are rebound below (scode / sesh-root for
# current dir), so Ctrl+9 below is the only way to reach window 9 from
# the keyboard. Ctrl+0 mirrors prefix+0 (lightweight sesh-root) since
# base-index is 1 and window 0 doesn't exist.

bind-key -n C-1 select-window -t :=1
bind-key -n C-2 select-window -t :=2
bind-key -n C-3 select-window -t :=3
bind-key -n C-4 select-window -t :=4
bind-key -n C-5 select-window -t :=5
bind-key -n C-6 select-window -t :=6
bind-key -n C-7 select-window -t :=7
bind-key -n C-8 select-window -t :=8
bind-key -n C-9 select-window -t :=9
bind-key -n C-0 run-shell -b "~/.config/tmux/sesh-root-here.sh '#{pane_current_path}'"

# New window/pane inherits current path
bind c new-window -c "#{pane_current_path}"

# Reload config with prefix + R
bind R source-file "$HOME/.tmux.conf" \; display-message "Sourced ~/.tmux.conf"

# Session management
bind N command-prompt -p "New session:" "new-session -s '%%'"
bind X confirm-before -p "Kill session #S? (y/n)" kill-session
# Kill current session AND detach client (return to parent shell).
# Differs from `prefix + X` above, which keeps you inside tmux by
# switching to another session (detach-on-destroy off, common.conf).
# Chained via helper script because `confirm-before` takes a single
# tmux command; inline `\;` inside its string arg is not parsed as a
# command separator.
bind M-x confirm-before -p "Kill session #S and exit tmux? (y/n)" \
  "run-shell '$HOME/.config/tmux/kill-session-exit.sh'"
bind x confirm-before -p "Kill pane? (y/n)" kill-pane
bind W confirm-before -p "Kill window #W? (y/n)" kill-window

# Manual renumber (renumber-windows on usually handles this, but kill-pane on
# multi-pane windows or shell-driven exits can leave gaps).
bind r move-window -r \; display-message "Windows renumbered"

# =============================================================================
# Move/Break Windows Across Sessions (GUI tab tear-out feel)
# =============================================================================
# prefix + M : move current window to another session (interactive prompt).
#              Target form: "session:" (auto-pick index) or "session:index"
#              (use -k via "!session:index" trick? simpler: bare prompt).
#              Tab-completes existing sessions.
# prefix + B : break current pane into a new window AND move it to a target
#              session in one go (acts like dragging a tab out).
# prefix + A : link current window into another session (window appears in
#              both sessions; edit either, both update). Use prefix + & to
#              kill, or unlink-window to detach without killing.
#
# Cross-window pane operations (no top-level prefix binding — letter slots are
# saturated by resize-pane H/J/K/L and sesh-last S; pane join/send live in the
# right-click pane menu and the popup menu's Session submenu instead):
#   - Mark current pane:  prefix + m  (built-in)
#   - Pull marked pane:   right-click pane menu → "Join marked pane here"
#   - Push current pane:  right-click pane menu → "Send pane to..."
#   - Break out to new window: right-click pane menu → "Break to new window"
#                              or prefix + ! (built-in, same session)
#                              or prefix + B (break + move to chosen session)

bind M run-shell "tmux set-environment -g _src_window '#{window_id}'" \; \
  display-message "Pick destination session to MOVE window into…" \; \
  choose-tree -Zs -F "#{session_name}" \
  "run-shell '~/.config/tmux/cross-session.sh move %%'"
bind B run-shell "tmux set-environment -g _src_pane '#{pane_id}'" \; \
  display-message "Pick destination session to BREAK pane into (as new window)…" \; \
  choose-tree -Zs -F "#{session_name}" \
  "run-shell '~/.config/tmux/cross-session.sh break %%'"
bind A run-shell "tmux set-environment -g _src_window '#{window_id}'" \; \
  display-message "Pick destination session to LINK window into (window lives in both)…" \; \
  choose-tree -Zs -F "#{session_name}" \
  "run-shell '~/.config/tmux/cross-session.sh link %%'"

# prefix + E : explode — break EVERY pane in current window into its own window
#              within the SAME session. Use case: switching from wide screen
#              (multi-pane layout) to mobile/SSH where one pane per window is
#              easier than zooming with prefix + z. Source window keeps the
#              first pane; other panes become sibling windows inserted right
#              after it, named after each pane's current command.
bind E run-shell "~/.config/tmux/break-all-panes.sh"

# =============================================================================
# Theme Switching (Catppuccin <-> tmux2k)
# =============================================================================
# Note: first-time switch requires `prefix + I` to install the target plugin.

bind M-c run-shell "tmux set -g @theme_variant catppuccin; \
  tmux source-file ~/.tmux.conf; \
  tmux display-message 'Theme: catppuccin'"

bind M-t run-shell "tmux set -g @theme_variant tmux2k; \
  tmux source-file ~/.tmux.conf; \
  tmux display-message 'Theme: tmux2k'"

# =============================================================================
# Sesh (tmux session manager)
# =============================================================================

# prefix + g: sesh picker in a tmux popup with fzf
bind-key "g" run-shell "sesh connect \"$(\
  sesh list --icons | fzf-tmux -p 80%,70% \
    --no-sort --ansi --border-label ' sesh ' --prompt '⚡  ' \
    --header '  ^a all ^t tmux ^g configs ^x zoxide ^d tmux kill ^f find' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t --icons)' \
    --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list -c --icons)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list -z --icons)' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 2 -t d -E .Trash . ~)' \
    --bind 'ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(⚡  )+reload(sesh list --icons)' \
    --preview-window 'right:55%' \
    --preview 'sesh preview {}' \
)\""

bind -N "last-session (via sesh)" S run-shell "sesh last 2>/dev/null || tmux display-message 'No previous sesh session'"

# prefix + 9: open repo-aware coding-agent layout (`scode`) for the current
# pane's directory. scode walks up from cwd to find .git; if not in a repo,
# the error surfaces in the tmux status line.
# Replaces the previous `sesh connect --root $(pwd)` binding (which had a
# subtle bug — $(pwd) was expanded once at config parse time, not per-press).
# Logic is in scode-here.sh because tmux run-shell is /bin/sh (can't see
# zsh functions) and the session-name + switch-client dance is non-trivial.
bind -N "scode for current dir (repo-aware coding layout)" 9 \
  run-shell -b "~/.config/tmux/scode-here.sh '#{pane_current_path}'"

# prefix + 0: lightweight counterpart to prefix+9. Plain sesh session at
# the git root of the current pane's directory (no nvim/agent layout).
# Replaces tmux's built-in `select-window -t :=0` which always errored
# because base-index is 1 (no window 0 exists). Logic in sesh-root-here.sh
# — see that file for the two bugs in the original `sesh connect --root
# $(pwd)` binding (parse-time $(pwd) + misuse of --root flag).
bind -N "sesh-root for current dir (lightweight)" 0 \
  run-shell -b "~/.config/tmux/sesh-root-here.sh '#{pane_current_path}'"

# prefix + T: sesh picker via television (tv) in a tmux popup
bind-key "T" display-popup -E -w 80% -h 70% -d '#{pane_current_path}' -T ' Sesh (tv) ' "tv sesh"

# prefix + O: sesh built-in picker in a tmux popup
bind-key "O" display-popup -h 90% -w 50% -E "sesh picker -i"

# prefix + U: CLI tools picker via television (tv tools)
bind-key "U" display-popup -E -w 80% -h 70% -d '#{pane_current_path}' -T ' CLI Tools (tv) ' "tv tools"

# prefix + a: live coding-agent panes picker (tv agent-panes)
# Shows claude / cursor-agent / codex / opencode sessions currently running in
# any tmux pane. Enter switches focus to that pane. See:
#   docs/tools/agent-panes-discovery.md
bind-key "a" display-popup -E -w 80% -h 70% -d '#{pane_current_path}' -T ' Live agent panes (tv) ' "tv agent-panes"

# (prefix + W is now bound earlier in this file as `kill-window`. The previous
# `sesh window` binding was removed because `sesh` has no `window` subcommand;
# pressing it printed sesh's help to a popup. See git history.)

# =============================================================================
# Popup tools (display-popup -E -d '#{pane_current_path}')
# =============================================================================
# Floating scratch pane (tmux-floax) is on prefix + F (toggleable, persistent
# session named `float`). The bindings below are one-shot popups that close
# when the inner command exits — handy for "do one thing without disrupting
# the layout" workflows.

# prefix + G: lazygit popup at current pane path
bind-key "G" display-popup -E -w 90% -h 90% -d '#{pane_current_path}' -T ' lazygit ' "lazygit"

# prefix + ` (backtick): one-shot popup shell at current pane path.
# Closes when the inner shell exits (`exit` or Ctrl-D). Each invocation gets
# a fresh shell — no state preserved. For a persistent scratchpad with
# history, use floax (prefix + F) instead.
bind-key '`' display-popup -E -w 80% -h 80% -d '#{pane_current_path}' -T ' shell '

# =============================================================================
# Help / cheatsheet
# =============================================================================
# tmux's built-in `prefix + ?` (list-keys -N) is hard to scan and can't search
# user-defined bindings well. We replace it with tmux-fzf's keybinding picker
# (fzf popup, fuzzy-searchable). The original list-keys is still reachable on
# `prefix + C-?` as a fallback.
#
# `prefix + /` (built-in: prompt for a key, show what it's bound to) is left
# alone — it's already useful for "what does THIS key do?" lookups.
#
# `?` inside the prefix + Enter popup menu opens a glow-rendered
# cheatsheet (curated, grouped, prettier than list-keys).

unbind-key '?'
bind-key '?' run-shell -b "~/.tmux/plugins/tmux-fzf/main.sh"
bind-key 'C-?' list-keys -N

# `/` inside the Enter-popup uses this; standalone prefix + / stays built-in
# (key-prompt). We expose the cheatsheet through the popup menu's `?` entry.
bind-key M-/ display-popup -E -w 80% -h 80% -T ' tmux cheatsheet ' \
  "glow -p ~/.config/tmux/cheatsheet.md 2>/dev/null \
    || less ~/.config/tmux/cheatsheet.md"

# =============================================================================
# Popup Menu (prefix + Space)
# =============================================================================
# Two entry keys, same menu. The menu itself is generated by a script
# (`~/.config/tmux/menu.sh`) which:
#
#   1. Reads `#{client_height}` and emits a tier-trimmed row list. tmux's
#      `display-menu` does NOT paginate — if the menu is taller than the
#      terminal, the entire popup is silently suppressed (no error). The
#      script keeps the menu fitting on tiny mobile-SSH heights too.
#   2. Submenus are sibling scripts (menu-layouts.sh, menu-session.sh,
#      menu-sesh.sh, menu-popups.sh, menu-theme.sh, menu-system.sh). Each
#      `exec tmux display-menu …` so quoting context resets per submenu —
#      no nested-quote escaping disasters in keybindings.conf.
#
# History: an earlier flat ~50-row menu silently failed on smaller heights
# and was misdiagnosed as a csi-u key encoding bug, then as a quoting bug.
# Both real (the `\;` accelerator was broken, sesh fzf binds had nested-
# quote issues), but the dominant symptom — "menu doesn't open at all" —
# was actually menu-too-tall. See pitfalls/tmux-display-menu-silent-parse-failure.md.
#
# Discovery fallbacks if you forget the keys: `prefix + ?` (tmux-fzf fuzzy
# picker over every binding), `prefix + M-/` (glow cheatsheet popup), or
# right-click on a pane / status line.

unbind-key Space
unbind-key Enter
bind-key Space run-shell "~/.config/tmux/menu.sh"
# Note: `prefix + e` was previously a popup-menu alias (added as workaround
# for a misdiagnosed display-menu bug — see pitfalls/tmux-display-menu-silent-fail.md).
# Removed so `e` is free as a sub-menu mnemonic (e.g. "Even layout: horizontal"
# in the window right-click menu).

# =============================================================================
# Right-click menus on the keyboard (prefix + M-p / M-w / M-s)
# =============================================================================
# Keyboard equivalents of the three MouseDown3* right-click menus defined at
# the top of this file:
#
#   prefix + M-p  →  menu-pane.sh         (same as right-click on a pane)
#   prefix + M-w  →  menu-window.sh       (same as right-click on a window tab)
#   prefix + M-s  →  menu-status-left.sh  (same as right-click on the session
#                                          name in the status-left area)
#
# WHY scripts (not inline `display-menu` like the MouseDown3* bindings):
# `pitfalls/tmux-submenu-flash-and-bottom-right.md` — a `display-menu` launched
# indirectly via `run-shell` from a MouseDown3 binding has its mouse-release
# event leaked into the menu, dismissing it instantly. So the MouseDown3*
# bodies MUST stay inline above. Keyboard activation has no pending mouse
# event, so a script wrapper is safe — and keeps this file shorter. The menu
# bodies are duplicated between the MouseDown3* bindings here and the scripts
# under dot_config/tmux/menu-*.sh; each location carries a "sync me" comment.
#
# Requires terminal Option-as-Meta on macOS (already set by the repo's
# Ghostty/cmux config: `macos-option-as-alt = left`). On Linux terminals the
# Alt modifier is sent natively.

bind -N "right-click pane menu (keyboard)"      M-p run-shell "~/.config/tmux/menu-pane.sh"
bind -N "right-click window menu (keyboard)"    M-w run-shell "~/.config/tmux/menu-window.sh"
bind -N "right-click status-left menu (keyboard)" M-s run-shell "~/.config/tmux/menu-status-left.sh"
