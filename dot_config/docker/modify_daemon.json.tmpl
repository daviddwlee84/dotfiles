#!/bin/sh
# Managed by chezmoi. Sets `registry-mirrors` in ~/.config/docker/daemon.json
# when `useChineseMirror` is true. This is the rootless Docker daemon config
# path on Linux; the repo installs rootless Docker by default (see
# dot_ansible/roles/docker/tasks/main.yml). Preserves any other keys
# (e.g. `data-root`, `dns`, `experimental`, `features`) a user or installer
# wrote to this file.
#
# Post-apply reminder: daemon.json changes only take effect after
#   systemctl --user daemon-reload && systemctl --user restart docker
# chezmoi does not auto-restart the daemon (would kill running containers).
#
# On macOS this file is meaningless (Docker Desktop and OrbStack do not read
# it); the script below short-circuits before any template branching so no
# file is created there.
#
# If you are running rootful Docker on Linux instead, this file is a no-op --
# the rootful daemon only reads /etc/docker/daemon.json (sudo). See
# docs/tools/containers.md#migration-note-pre-pivot-rootful-installs for the
# recipe. For the full who-reads-what map across Docker / OrbStack / Desktop /
# Podman, see docs/tools/container-config-map.md.

set -eu

input=$(cat)
[ -z "$input" ] && input='{}'

if ! command -v jq >/dev/null 2>&1; then
  printf '%s' "$input"
  exit 0
fi

{{ if and (eq .chezmoi.os "linux") .useChineseMirror -}}
# Curated Docker Hub pull-through mirrors (5), high-reputation operators only.
# Trust note: a pull-through mirror resolves tag->digest, and Docker Content
# Trust is OFF by default, so a compromised/hijacked mirror can serve a
# malicious image for a tag like `latest`. For sensitive images pull by digest
# (repo@sha256:...) or enable Content Trust. Deliberately EXCLUDED:
# dockerhub.azk8s.cn (deprecated Azure-China) and dockerproxy.com (third-party,
# ToS-churned) -- dead/third-party domains risk lapsing and being re-registered
# into a malicious pull-through cache. See
# docs/tools/mirrors.md#security-and-trust-model.
printf '%s' "$input" | jq '.["registry-mirrors"] = [
  "https://docker.m.daocloud.io",
  "https://docker.mirrors.ustc.edu.cn",
  "https://docker.nju.edu.cn",
  "https://mirror.iscas.ac.cn",
  "https://mirror.baidubce.com"
]'
{{- else -}}
printf '%s' "$input" | jq 'del(.["registry-mirrors"]) | if . == {} then empty else . end'
{{- end }}
