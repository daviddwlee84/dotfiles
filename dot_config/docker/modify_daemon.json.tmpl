#!/bin/sh
# Managed by chezmoi. Sets `registry-mirrors` in ~/.config/docker/daemon.json
# when `useChineseMirror` is true. This is the rootless Docker daemon config
# path on Linux; the repo installs rootless Docker by default (see
# dot_ansible/roles/docker/tasks/main.yml). Preserves any other keys
# (e.g. `data-root`, `dns`, `experimental`, `features`) a user or installer
# wrote to this file.
#
# Key ownership -- this file is shared, and each writer touches ONLY its own key:
#   registry-mirrors  <- this script (declarative, same on every host)
#   proxies           <- `docker-net on` / `docker-net off` at RUNTIME. Never
#                        written here on purpose: the local proxy port moves
#                        (Verge 7897, mihomo 7890, ...) so a value baked in at
#                        apply time goes stale fast. See docs/tools/docker-net.md.
#
# Post-apply reminder -- the two keys do NOT cost the same to activate:
#   registry-mirrors  IS SIGHUP-reloadable: `systemctl --user reload docker`
#                     picks it up WITHOUT killing running containers.
#   proxies           is NOT: it needs `systemctl --user restart docker`.
# chezmoi does not do either automatically.
#
# On macOS this file is meaningless (Docker Desktop and OrbStack do not read
# it); the script below short-circuits before any template branching so no
# file is created there.
#
# If you are running rootful Docker on Linux instead, this file is a no-op --
# the rootful daemon only reads /etc/docker/daemon.json (sudo). See
# docs/tools/containers.md#migration-note-pre-pivot-rootful-installs for the
# recipe. For the full who-reads-what map across Docker / OrbStack / Desktop /
# Podman, see docs/tools/container-config-map.md.
#
# `docker-net doctor` checks all of the above against the LIVE daemon.

set -eu

input=$(cat)
[ -z "$input" ] && input='{}'

if ! command -v jq >/dev/null 2>&1; then
  printf '%s' "$input"
  exit 0
fi

{{ if and (eq .chezmoi.os "linux") .useChineseMirror -}}
# ONE curated Docker Hub pull-through mirror. Deliberately short.
#
# Security: a pull-through mirror resolves tag->digest, and Docker Content Trust
# is OFF by default, so whoever answers decides which image `latest` maps to.
# Every extra entry is another host that can do that, so the list is kept to the
# minimum that actually works. For sensitive images pull by digest
# (repo@sha256:...) or enable Content Trust.
#
# Reliability: Docker tries mirrors IN ORDER, and a dead entry costs a timeout
# (or worse, an error containerd surfaces as `failed to resolve reference`,
# which reads like "image does not exist"). Four of the five entries this list
# used to carry were measured dead on 2026-07 and removed:
#   docker.mirrors.ustc.edu.cn  domain has no DNS record at all
#   docker.nju.edu.cn           403, campus network only
#   mirror.iscas.ac.cn          502
#   mirror.baidubce.com         TLS reset, reachable only inside Baidu Cloud
# Also still excluded on supply-chain grounds: dockerhub.azk8s.cn (deprecated
# Azure-China) and dockerproxy.com (third-party, ToS-churned) -- a lapsed domain
# can be re-registered into a malicious pull-through cache.
#
# Anything that is NOT Docker Hub (ghcr.io / gcr.io / quay.io / registry.k8s.io)
# is not mirrored by this mechanism at all; that is what the daemon proxy and
# `docker-net pull` are for. Re-measure with `docker-net mirrors`.
# See docs/tools/mirrors.md#security-and-trust-model.
printf '%s' "$input" | jq '.["registry-mirrors"] = [
  "https://docker.m.daocloud.io"
]'
{{- else -}}
printf '%s' "$input" | jq 'del(.["registry-mirrors"]) | if . == {} then empty else . end'
{{- end }}
