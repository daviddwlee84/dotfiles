// niri config — managed by chezmoi (dot_config/niri/config.kdl).
//
// Deployed only when installNiri=true on an ubuntu_desktop profile (see
// .chezmoiignore.tmpl). niri also writes its own default config on first
// launch if this file is absent; this one is a curated starting point.
//
// Validate after editing:  niri validate
// Full reference:          https://github.com/niri-wm/niri/wiki
//
// NVIDIA (this machine has an RTX 3090): modern drivers (modeset on by default
// in 580+) run niri out of the box. The niri ansible role also writes an
// application-profile that caps the driver's VRAM free-buffer pool. niri picks
// the primary GPU automatically; on multi-GPU boxes (RTX 3090 + AMD here) you
// can pin the render device under `debug { render-drm-device "..." }` — see the
// commented block at the bottom.

input {
    keyboard {
        xkb {
            // layout "us"
        }
        repeat-delay 600
        repeat-rate 25
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {}

    // Focus follows the mouse only when it crosses into another window.
    // focus-follows-mouse max-scroll-amount="0%"
}

// Leave outputs auto-configured. To pin a resolution/scale, uncomment and use
// the connector name from `niri msg outputs`:
// output "DP-1" {
//     mode "3840x2160@144"
//     scale 1.5
//     position x=0 y=0
// }

layout {
    gaps 16
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        off
    }
}

// Don't draw client-side decorations when the client allows it.
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Start essential services. xwayland-satellite gives X11 apps a home; remove
// if you don't need X11 compatibility.
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

environment {
    // Hint toolkits toward Wayland backends.
    QT_QPA_PLATFORM "wayland"
    MOZ_ENABLE_WAYLAND "1"
    DISPLAY ":0"
    // Put per-user tool dirs on PATH for `spawn` (Mod+T → alacritty lives in
    // ~/.cargo/bin, which is NOT on the GDM/systemd session PATH). niri applies
    // this to every process it spawns. Done here (per-user, chezmoi-templated
    // $HOME) rather than a system-wide /usr/local/bin symlink, so it stays
    // correct on multi-user hosts. niri does not append, so the value is the
    // full PATH; keep the standard session dirs after the user-local ones.
    PATH "{{ .chezmoi.homeDir }}/.cargo/bin:{{ .chezmoi.homeDir }}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin"
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Launchers — alacritty is installed by gui_apps_linux. fuzzel is a common
    // niri launcher; install it (apt/cargo) or swap for your preferred one.
    Mod+T hotkey-overlay-title="Open Terminal: alacritty" { spawn "alacritty"; }
    Mod+D hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }

    Mod+Q { close-window; }

    // Focus movement (arrows + vim hjkl).
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // Move the focused window/column.
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    // Workspaces.
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }

    // Column / window sizing.
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Screenshots.
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Media / brightness keys.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "10%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "10%-"; }

    // Session.
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
}

// Multi-GPU render device override (RTX 3090 + AMD on this box). niri auto-picks
// the primary GPU; uncomment and set the DRM node to force a specific card:
// debug {
//     render-drm-device "/dev/dri/renderD128"
// }
