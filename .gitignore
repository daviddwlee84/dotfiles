# Secrets (never commit)
.env
.env.*
*.key
*.pem
!*.pem.pub
credentials.json
secrets.yaml
secrets.yml

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
# .vscode/
*.code-workspace

# Sidecar & td
.todos/
.sidecar/

# Logs
*.log

# Python
__pycache__/

# Agent skills (installed via `npx skills`). Only the lock file is tracked;
# the skill source clones are owned by the npx CLI (rewritten on every
# `update`). Auto-restored on `chezmoi apply` by
# .chezmoiscripts/repo/run_onchange_after_45_bootstrap_skills.sh.tmpl, or manually via
# `just bootstrap-skills`. See docs/tools/agent-skills.md.
.agents/
.claude/skills/

# mkdocs build output
/site/
.venv/

# mkdocs `social` plugin card cache: ~290 generated OG card PNGs + the
# downloaded Noto Sans TC font (~70MB). Regenerated on every build and cached
# in CI via actions/cache — never commit it.
/.cache/

# Auto-generated by mkdocs-copy-to-llm plugin on every build (config-driven CSS
# vars from mkdocs.yml's button_hover_color / toast_bg_color). Was causing a
# ping-pong with end-of-file-fixer because the plugin writes the file without
# a trailing newline. CI re-generates it during `mkdocs build`, so it's safe
# to leave untracked. Referenced from mkdocs.yml:80 (extra_css).
docs/assets/copy-to-llm/copy-to-llm-custom.css
.sidecar-agent
.sidecar-task
.sidecar-pr
.sidecar-start.sh
.sidecar-base
.td-root
