#!/bin/bash
{{ $installBrewApps := false }}{{ if hasKey . "installBrewApps" }}{{ $installBrewApps = .installBrewApps }}{{ end -}}
{{ $installAiDesktopApps := false }}{{ if hasKey . "installAiDesktopApps" }}{{ $installAiDesktopApps = .installAiDesktopApps }}{{ end -}}
{{ $installGamingApps := false }}{{ if hasKey . "installGamingApps" }}{{ $installGamingApps = .installGamingApps }}{{ end -}}
# Run brew bundle when Brewfiles change
# Runs when general Brew apps are enabled, or on macOS when AI/gaming desktop apps are enabled
# Profile: {{ .profile }}
# installBrewApps: {{ $installBrewApps }}
# installAiDesktopApps: {{ $installAiDesktopApps }}
# installGamingApps: {{ $installGamingApps }}

{{ if and (not $installBrewApps) (or (ne .chezmoi.os "darwin") (and (not $installAiDesktopApps) (not $installGamingApps))) -}}
# Brew app installation is disabled for this profile
# To enable, run: chezmoi init --force
exit 0
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
# === Brewfile Hashes (changes trigger re-run) ===
# Brewfile: {{ include "dot_config/homebrew/Brewfile.tmpl" | sha256sum }}
# Brewfile.darwin: {{ include "dot_config/homebrew/Brewfile.darwin.tmpl" | sha256sum }}
{{ else -}}
# === Brewfile Hashes (changes trigger re-run) ===
# Brewfile: {{ include "dot_config/homebrew/Brewfile.tmpl" | sha256sum }}
# Brewfile.linux: {{ include "dot_config/homebrew/Brewfile.linux.tmpl" | sha256sum }}
{{ end -}}

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Setup Homebrew PATH
{{ if eq .chezmoi.os "darwin" -}}
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{ else -}}
# Linuxbrew
if [[ -d /home/linuxbrew/.linuxbrew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -d "$HOME/.linuxbrew" ]]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
fi
{{ end -}}

# Check if brew is available.
# Probe by OUTPUT, not exit status: a fake `brew` stub (`#!/bin/sh` +
# `exit 0`) satisfies `command -v brew` and returns 0 for every subcommand
# while printing nothing, so `brew bundle` would appear to succeed while
# installing exactly nothing. See pitfalls/ansible-homebrew-expecting-value-line-1-column-1.md.
if [[ -z "$(brew --prefix 2>/dev/null)" ]]; then
    {{ if eq .chezmoi.os "darwin" -}}
    error "Homebrew not found. It should have been installed by bootstrap."
    exit 1
    {{ else -}}
    warn "Homebrew (Linuxbrew) not installed. Skipping brew bundle."
    warn "To install: /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
    exit 0
    {{ end -}}
fi

BREWFILE_DIR="$HOME/.config/homebrew"

# Check if Brewfiles exist
if [[ ! -f "$BREWFILE_DIR/Brewfile" ]]; then
    warn "Brewfile not found at $BREWFILE_DIR/Brewfile"
    warn "Run 'chezmoi apply' to deploy Brewfiles first."
    exit 0
fi

{{ if eq .chezmoi.os "darwin" -}}
# --- Shared sudo session (see scripts/lib/sudo_shared.sh)
# Inlined at render time. By the time brew-bundle runs, bootstrap and ansible
# will usually have already prompted + spawned the watchdog (which keeps the
# TTY timestamp warm every 50 s). `sudo_session_init` is idempotent: if the
# session already exists, it just re-exports env vars + re-registers traps.
# If the user invoked brew-bundle standalone (without the other phases), the
# prompt happens here instead.
{{ include "scripts/lib/sudo_shared.sh" }}
# --- end sudo helper

# Pre-authenticate sudo so Homebrew cask pkg installers (e.g. google-drive,
# squirrel, ollama-app) can invoke /usr/sbin/installer without prompting from
# a non-TTY child. The watchdog refreshes the timestamp every 50 s, which
# is well inside sudo's default 5-minute tty_tickets window.
if sudo_session_init "brew"; then
    case "$(sudo_session_skip_reason)" in
        cached)
            # Warm the current TTY's timestamp right now so the FIRST cask
            # that shells out to `sudo /usr/sbin/installer` finds a live
            # ticket (cask installers read a TTY timestamp, not stdin).
            sudo_session_warm_cache || warn "sudo_session_warm_cache failed; pkg casks may prompt or fail"
            ;;
        passwordless)
            info "Passwordless sudo detected"
            ;;
        non-interactive | "")
            warn "Non-interactive mode without passwordless sudo - pkg-based casks may fail"
            ;;
    esac
else
    warn "Sudo session could not be established - pkg-based casks may fail"
fi

{{ end -}}
info "Running brew bundle..."

# `chezmoi apply` is install-only by design (see AGENTS.md). Skip the implicit
# `brew update` that `brew bundle` would otherwise trigger -- it slows things
# down, and on hosts using a Chinese mirror it can transiently fail with
# "Unable to find <sha> under https://mirrors.aliyun.com/homebrew/brew.git"
# while the mirror catches up to upstream. Upgrades go through `just upgrade-*`.
export HOMEBREW_NO_AUTO_UPDATE=1
# Quiet "you have N outdated formulae" hints during install-only flow.
export HOMEBREW_NO_INSTALL_UPGRADE=1

{{ if eq .chezmoi.os "darwin" -}}
# --- Adopt pre-flight (macOS only, OPT-IN)
# Casks installed manually (drag .app into /Applications) are invisible to brew
# until "adopted". `brew install --cask --adopt <name>` writes Caskroom
# metadata in-place so subsequent `brew bundle` runs skip the cask.
#
# Why opt-in (CHEZMOI_BREW_ADOPT_PREFLIGHT=1 to enable):
#
#   1. **Version-strict**: `--adopt` compares SHA256 of /Applications/Foo.app
#      against the SHA256 brew's formula expects. If your manually-installed
#      version differs by even a single byte (different download date, vendor
#      auto-update, etc.) brew raises "no installed App to adopt" and falls
#      back to a full download. In a typical real-world `Brewfile.darwin`
#      with 20+ casks, the hit rate observed was ~40% — the rest re-download
#      anyway, defeating the point.
#
#   2. **Password storm**: each `brew install --cask --adopt` invocation
#      internally calls `sudo /usr/sbin/installer` / `sudo xattr` / similar.
#      Our `sudo_session_warm_cache` warms the TTY timestamp but brew's
#      internal sudo invocations don't always reuse it (brew may `sudo -k`
#      before pkg installs, or use a different timestamp_type). Result:
#      one `Password:` prompt per pkg-based cask, often with multi-second
#      gaps where the user has to babysit the terminal.
#
#   3. **`--adopt` doesn't skip download**: brew calls `fetch_artifacts`
#      BEFORE `install_artifacts` (where --adopt branches), so casks whose
#      `.app` isn't present (or whose SHA mismatches) still get downloaded.
#      Even our filesystem pre-filter only catches the first case.
#
#   4. **Mac App Store conflicts**: if you have Tailscale (or others) from
#      the App Store, the brew cask version's pkg installer pops up an
#      interactive "already installed via Mac App Store" dialog mid-apply.
#      We detect this via `mas list` when opt-in is enabled.
#
# When useful:
#   - You're setting up a NEW mac, have just manually dragged some `.app`s
#     into /Applications/ from vendor DMGs, AND those apps happen to be the
#     CURRENT brew-formula versions (rare in practice). Most users should
#     leave this off and let `brew bundle` install everything fresh on
#     first apply — slower one-time download cost but no password storm and
#     no version-mismatch failures.
#
# To enable: `export CHEZMOI_BREW_ADOPT_PREFLIGHT=1` in ~/.shellrc.adhoc.
adopt_existing_casks() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    [[ -n "$(brew --prefix 2>/dev/null)" ]] || return 0

    # Resolve Caskroom path once (arm64 vs intel).
    local caskroom=""
    if [[ -d /opt/homebrew/Caskroom ]]; then
        caskroom=/opt/homebrew/Caskroom
    elif [[ -d /usr/local/Caskroom ]]; then
        caskroom=/usr/local/Caskroom
    fi

    # Snapshot /Applications/ once (lowercased, newline-separated). Avoids
    # forking ls/find per cask. Falls back to empty string if dir missing.
    local apps_lc=""
    if [[ -d /Applications ]]; then
        apps_lc="$(/bin/ls -1 /Applications 2>/dev/null | tr '[:upper:]' '[:lower:]')"
    fi

    # Snapshot mas-installed App Store apps (lowercased). Used to skip
    # casks whose app the user has via App Store — adopting them would
    # trigger a "Mac App Store Install Detected" dialog mid-apply.
    # `mas list` format: "<id>  <Name>  (<version>)"
    local mas_lc=""
    if command -v mas >/dev/null 2>&1; then
        mas_lc="$(mas list 2>/dev/null | tr '[:upper:]' '[:lower:]')"
    fi

    # Heuristic: does /Applications/ have an .app whose name matches this
    # cask? Tries a handful of candidate spellings derived from the cask
    # short-name. Misses on weird capitalization (chatgpt → ChatGPT.app works
    # because case-insensitive; aerospace → AeroSpace.app works too).
    _has_app_for_cask() {
        local short="$1"
        local stem="${short%-app}"
        stem="${stem%-desktop}"
        local candidates=(
            "${short}.app"
            "${stem}.app"
            "${short//-/ }.app"
            "${stem//-/ }.app"
            "${short//-/}.app"
            "${stem//-/}.app"
        )
        local c c_lc
        for c in "${candidates[@]}"; do
            c_lc="$(printf '%s' "$c" | tr '[:upper:]' '[:lower:]')"
            if printf '%s\n' "$apps_lc" | grep -qFx -- "$c_lc"; then
                return 0
            fi
        done
        return 1
    }

    # Heuristic: is this cask's app already installed via Mac App Store?
    # Matches the cask stem against `mas list` output (case-insensitive).
    # False positives possible (substring match) but the cost of a false
    # positive is just "we don't try to adopt" — cheap.
    _is_mas_installed() {
        [[ -z "$mas_lc" ]] && return 1
        local short="$1"
        local stem="${short%-app}"
        stem="${stem%-desktop}"
        # Replace dashes with spaces for the search term (App Store names
        # generally have spaces, e.g. "Tailscale" or "The Unarchiver").
        local search="${stem//-/ }"
        printf '%s\n' "$mas_lc" | grep -qF -- "$search" && return 0
        return 1
    }

    local cask_list
    cask_list="$(brew bundle list --casks --file="$file" 2>/dev/null)" || return 0
    [[ -n "$cask_list" ]] || return 0

    # Three-stage filter:
    #   - drop already-tracked (cheap filesystem check)
    #   - drop casks whose .app isn't in /Applications/ (no point — brew would
    #     download anyway)
    #   - drop casks already installed via Mac App Store (would trigger the
    #     "already installed via Mac App Store" pkg-installer dialog)
    local needs_adopt=() already=0 not_present=0 mas_conflict=0 cask short
    while IFS= read -r cask; do
        [[ -n "$cask" ]] || continue
        short="${cask##*/}"
        if [[ -n "$caskroom" && -d "$caskroom/$short" ]]; then
            already=$(( already + 1 ))
            continue
        fi
        if ! _has_app_for_cask "$short"; then
            not_present=$(( not_present + 1 ))
            continue
        fi
        if _is_mas_installed "$short"; then
            mas_conflict=$(( mas_conflict + 1 ))
            info "  skipping $short — also installed via Mac App Store (mas)"
            continue
        fi
        needs_adopt+=("$cask")
    done <<< "$cask_list"

    local total=${#needs_adopt[@]}
    if (( total == 0 )); then
        info "Adopt pre-flight: $already tracked, $not_present not in /Applications/, $mas_conflict mas-conflict, nothing to adopt"
        return 0
    fi

    info "Adopt pre-flight: $already tracked, $not_present not in /Applications/, $mas_conflict mas-conflict, attempting --adopt on $total cask(s)..."

    local adopted=0 failed=0 idx=0 err
    local err_file
    err_file="$(mktemp -t cz_adopt_err.XXXXXX)"
    for cask in "${needs_adopt[@]}"; do
        idx=$(( idx + 1 ))
        short="${cask##*/}"
        info "  ($idx/$total) trying $short..."
        # Re-warm sudo TTY timestamp before each adopt call. Pkg-based casks
        # (google-drive, etc.) shell out to `sudo /usr/sbin/installer` from a
        # subshell that doesn't always inherit our controlling TTY. Best-effort:
        # brew may still re-prompt for its own sudo invocations.
        command -v sudo_session_warm_cache >/dev/null 2>&1 && \
            sudo_session_warm_cache 2>/dev/null || true
        if brew install --cask --adopt "$cask" >/dev/null 2>"$err_file"; then
            adopted=$(( adopted + 1 ))
            info "    ✓ adopted: $short"
        else
            failed=$(( failed + 1 ))
            # Surface the first non-blank brew stderr line so user can
            # distinguish version-mismatch from pkg-conflict from network.
            err="$(grep -m1 -E '^(Error|Warning):' "$err_file" 2>/dev/null \
                    || head -n1 "$err_file" 2>/dev/null)"
            if [[ -n "$err" ]]; then
                info "    ✗ adopt failed: $short — ${err}"
            else
                info "    ✗ adopt failed (no brew stderr captured): $short"
            fi
        fi
    done
    rm -f "$err_file"

    info "Adopt pre-flight done: $adopted adopted, $already tracked, $not_present absent, $mas_conflict mas-conflict, $failed adopt-failed"
}

# Gated on CHEZMOI_BREW_ADOPT_PREFLIGHT=1 (opt-in). See block comment above
# for the trade-offs that made this opt-in.
if [[ "${CHEZMOI_BREW_ADOPT_PREFLIGHT:-0}" = "1" ]]; then
    info "Adopt pre-flight: scanning Brewfile.darwin for manually-installed casks (CHEZMOI_BREW_ADOPT_PREFLIGHT=1)..."
    adopt_existing_casks "$BREWFILE_DIR/Brewfile.darwin"
fi
{{ end -}}

# Run brew bundle up to N times. Subsequent attempts only retry items that
# failed (already-installed packages are skipped quickly). This papers over
# transient GitHub CDN / HTTP/2 errors that commonly hit large cask lists.
# Between attempts we wipe Homebrew's `.incomplete*` lockfiles so a previously
# interrupted parallel `brew fetch` doesn't poison the retry with
# "process has already locked ... .incomplete" errors.
BUNDLE_MAX_ATTEMPTS="${BUNDLE_MAX_ATTEMPTS:-2}"
clear_brew_download_locks() {
    local cache_dir
    cache_dir="$(brew --cache 2>/dev/null)/downloads"
    [[ -d "$cache_dir" ]] || return 0
    # Both .incomplete data files and their .lock siblings.
    find "$cache_dir" -maxdepth 1 -name '*.incomplete*' -print -delete 2>/dev/null \
        | head -20 \
        | while IFS= read -r f; do info "  cleared stale lock: $(basename "$f")"; done
}

trust_bundle_taps() {
    local file="$1"
    local taps tap info_out
    [[ -f "$file" ]] || return 0
    taps="$(brew bundle list --taps --file="$file" 2>/dev/null || true)"
    [[ -n "$taps" ]] || return 0

    while IFS= read -r tap; do
        [[ -n "$tap" ]] || continue
        if ! brew tap | grep -qFx -- "$tap"; then
            if ! brew tap "$tap"; then
                warn "Could not tap $tap before brew bundle; brew bundle will retry normally"
                continue
            fi
        fi

        info_out="$(brew tap-info "$tap" 2>/dev/null || true)"
        if [[ "$info_out" == *Untrusted* ]]; then
            info "Trusting Homebrew tap $tap"
            brew trust "$tap"
        fi
    done <<< "$taps"
}

run_bundle_with_retry() {
    local file="$1"
    local label="$2"
    local attempt=1
    while (( attempt <= BUNDLE_MAX_ATTEMPTS )); do
        if (( attempt == 1 )); then
            info "Installing $label..."
        else
            info "Retrying $label (attempt $attempt/$BUNDLE_MAX_ATTEMPTS, only missing items)..."
            clear_brew_download_locks
        fi
        trust_bundle_taps "$file"
        if brew bundle --file="$file" --no-upgrade; then
            return 0
        fi
        attempt=$(( attempt + 1 ))
    done
    warn "Some packages in $label still failed after $BUNDLE_MAX_ATTEMPTS attempts (continuing...)"
    warn "Rerun later with: brew bundle --file=\"$file\" --no-upgrade"
    return 0
}

# Run shared Brewfile first (installs mas, taps)
run_bundle_with_retry "$BREWFILE_DIR/Brewfile" "shared packages from Brewfile"

# Run platform-specific Brewfile
{{ if eq .chezmoi.os "darwin" -}}
if [[ -f "$BREWFILE_DIR/Brewfile.darwin" ]]; then
    run_bundle_with_retry "$BREWFILE_DIR/Brewfile.darwin" "macOS packages from Brewfile.darwin"
fi

# Remind about mas sign-in
if command -v mas &> /dev/null; then
    if ! mas account &> /dev/null; then
        warn "Not signed in to Mac App Store."
        warn "Sign in via App Store.app to install mas apps."
    fi
fi
{{ else -}}
if [[ -f "$BREWFILE_DIR/Brewfile.linux" ]]; then
    run_bundle_with_retry "$BREWFILE_DIR/Brewfile.linux" "Linux packages from Brewfile.linux"
fi
{{ end -}}

success "Brew bundle complete!"
