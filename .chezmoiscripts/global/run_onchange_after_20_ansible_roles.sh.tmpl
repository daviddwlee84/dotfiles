set -e
export PATH="$HOME/.local/bin:$PATH"

# Override locale to a safe default so ansible can start even before locale
# packages are installed. Prefer C.UTF-8 (universal since glibc 2.35) but
# fall back to en_US.UTF-8 on CentOS 7 (glibc 2.17) where C.UTF-8 is
# missing and `LC_ALL=C.UTF-8` triggers
# `Ansible could not initialize the preferred locale: unsupported locale
# setting`. Fall through silently if neither is available — the parent
# shell's LANG/LC_ALL (e.g. set via ENV in Dockerfile.centos7) wins.
if locale -a 2>/dev/null | grep -qiE '^C\.utf-?8$'; then
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
elif locale -a 2>/dev/null | grep -qiE '^en_US\.utf-?8$'; then
    export LC_ALL=en_US.UTF-8
    export LANG=en_US.UTF-8
fi

# --- Shared sudo session (see scripts/lib/sudo_shared.sh for full docs)
# Inlined at template-render time so this script carries the helper body.
# bootstrap has already prompted + spawned a watchdog in the normal flow;
# the idempotent `sudo_session_init` below just re-exports the env vars
# and (re)registers the INT/TERM/HUP abort trap. It will prompt here only
# when the user ran ansible manually without the bootstrap phase.
{{ include "scripts/lib/sudo_shared.sh" }}
# --- end sudo helper

# Whether ANY sudo surface is exercised in this run. Linux ansible always
# needs sudo unless noRoot. On macOS only the input_method role needs sudo.
NEED_SUDO={{ if or (and (eq .chezmoi.os "linux") (not .noRoot)) (and (eq .chezmoi.os "darwin") .installInputMethod) }}1{{ else }}0{{ end }}

# Setup Homebrew PATH so brew subprocesses can find sibling tools like git-lfs.
{{ if eq .chezmoi.os "darwin" -}}
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{ else -}}
# Linuxbrew — guard on the binary, not the dir. A failed Homebrew install
# leaves the /home/linuxbrew/.linuxbrew/ tree behind (sudo'd by the
# installer) without the brew binary, and `eval "$(.../bin/brew shellenv)"`
# would then noisy-fail on every chezmoi apply. See
# pitfalls/bootstrap-no-tty-sudo-prompt-skipped.md → CentOS 7 brew note.
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x "$HOME/.linuxbrew/bin/brew" ]]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
fi
{{ end -}}

# Install-only apply doesn't need Homebrew's periodic auto-update, whose `brew
# update` (git fetch) can hang for many minutes on a constrained network/mirror
# — it stalled the opt-in calibre cask install for ~34 min. Inherited by the
# ansible community.general.homebrew{,_cask} subprocesses. Matches
# run_onchange_after_30_brew_bundle.sh.tmpl.
export HOMEBREW_NO_AUTO_UPDATE=1

{{ if .useChineseMirror -}}
# GFW mirrors (useChineseMirror=true) — exported so ansible subprocesses
# (community.general.homebrew, mise, rustup, gem) inherit them. Without
# this, ghcr.io bottle downloads frequently fail with
# `curl: (18) Transferred a partial file` and rust-lang.org / nodejs.org
# downloads time out on constrained networks.
# Ref: https://mirrors.bfsu.edu.cn/help/homebrew-bottles/
# BFSU is fastest overall behind GFW (benchmarked 2026-07). Do NOT set
# HOMEBREW_CORE_GIT_REMOTE — brew 4.x uses the JSON API; setting it forces a
# ~1 GB homebrew-core git clone. See
# pitfalls/homebrew-aliyun-brew-git-hang-core-clone-bloat.md.
export HOMEBREW_API_DOMAIN="https://mirrors.bfsu.edu.cn/homebrew-bottles/api"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.bfsu.edu.cn/homebrew-bottles"
export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.bfsu.edu.cn/git/homebrew/brew.git"
export RUSTUP_DIST_SERVER="https://mirrors.tuna.tsinghua.edu.cn/rustup"
export RUSTUP_UPDATE_ROOT="https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup"
# Aliyun mirror — TUNA's nodejs-release keeps only ~5 versions; see
# pitfalls/tuna-nodejs-mirror-aggressive-gc.md.
export MISE_NODE_MIRROR_URL="https://mirrors.aliyun.com/nodejs-release/"
export NODE_BUILD_MIRROR_URL="https://mirrors.aliyun.com/nodejs-release/"
{{ end -}}

