# ~/.ssh/config
# dotfiles-ssh-layout: grouped-v1
# Created only when missing. Existing configurations are never migrated by apply.
# Groups organize files; this explicit Include list defines precedence.
# Use dev ssh format for indentation, or dev ssh organize to move Host blocks
# and their comments while preserving their original Include order.
Include ~/.ssh/config.d/git/github.conf
Include ~/.ssh/config.d/git/gitlab.conf
Include ~/.ssh/config.d/common/defaults.conf
