#!/bin/bash
# Bootstrap script - installs Homebrew, uv, ansible, mise, and galaxy collections
# Runs BEFORE any ansible playbooks
# Profile: {{ .profile }}

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Fix broken locale (e.g. RPi with LC_ALL=en_US.UTF-8 but locale not generated)
# Ansible requires UTF-8 encoding, so fall back to C.UTF-8 (not plain C).
if locale 2>&1 | grep -qi "cannot set"; then
    warn "Broken locale detected, falling back to LC_ALL=C.UTF-8"
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
fi

# Ensure PATH includes local bin and Homebrew
export PATH="$HOME/.local/bin:$PATH"

# --- Shared sudo session (prompt once, reuse across bootstrap + ansible + brew)
# Inlined from scripts/lib/sudo_shared.sh via chezmoi's `include` so the helper
# travels with the rendered script (no runtime path lookup back to the source
# tree). See that file for API, lifetime, and clean-up guarantees.
{{ include "scripts/lib/sudo_shared.sh" }}
# --- end sudo helper

# Decide at render time whether *any* script in the apply flow will need sudo.
# If not, we never prompt, never create the state dir, never spawn a watchdog.
# Conditions mirror the sudo surfaces in every run-script:
#   - Linux, non-noRoot: bootstrap apt-get + ansible become tasks.
#   - macOS, installBrewApps: pkg-based cask installers (google-drive, etc.).
#   - macOS, installInputMethod: Squirrel cask pkg installer (ansible).
NEED_SUDO={{ if or (and (eq .chezmoi.os "linux") (not .noRoot)) (and (eq .chezmoi.os "darwin") (or .installBrewApps .installInputMethod)) }}1{{ else }}0{{ end }}

# Set up the shared sudo session FIRST so bootstrap's own `apt-get` lines (and
# every later run-script) reuse the same cached credential. Trap INT/TERM/HUP
# only — no EXIT trap, because the next run-script needs the state to survive
# this process exiting. End-of-flow cleanup is done by the detached watchdog
# (see sudo_shared.sh).
if [[ "$NEED_SUDO" == "1" ]]; then
    if ! sudo_session_init "bootstrap"; then
        warn "Could not establish a sudo session (no TTY and sudo needs a password);"
        warn "bootstrap will attempt its sudo steps anyway and they may prompt or skip."
    fi
fi

{{ if .useChineseMirror -}}
# GFW mirrors (useChineseMirror=true). Must be set BEFORE the first
# `brew install`, `rustup`, or `mise install` so every bootstrap fetch
# goes through the mirror instead of the blocked upstream.
# Homebrew mirrors — BFSU is fastest overall behind GFW (benchmarked 2026-07:
# brew.git fetch 1.1s + bottles 31 MB/s). Ordering: BFSU > USTC > Aliyun
# (git upload-pack BROKEN — hangs — bottles fine) > TUNA (queueing, both slow).
#   BFSU: https://mirrors.bfsu.edu.cn/help/homebrew-bottles/
#   USTC: https://mirrors.ustc.edu.cn/help/brew.git.html
# Do NOT set HOMEBREW_CORE_GIT_REMOTE: brew 4.x uses the JSON API
# (HOMEBREW_API_DOMAIN); setting core forces a full ~1 GB homebrew-core git
# clone. See pitfalls/homebrew-aliyun-brew-git-hang-core-clone-bloat.md.
# Homebrew env vars are single-value — no native fallback. To switch, comment
# out the active block and uncomment another.
export HOMEBREW_API_DOMAIN="https://mirrors.bfsu.edu.cn/homebrew-bottles/api"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.bfsu.edu.cn/homebrew-bottles"
export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.bfsu.edu.cn/git/homebrew/brew.git"
# USTC alternative:
#   export HOMEBREW_API_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles/api"
#   export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles"
#   export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.ustc.edu.cn/brew.git"
# Aliyun alternative (bottles only — brew.git is BROKEN, do NOT set it):
#   export HOMEBREW_API_DOMAIN="https://mirrors.aliyun.com/homebrew-bottles/api"
#   export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.aliyun.com/homebrew-bottles"
# TUNA alternative:
#   export HOMEBREW_API_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/api"
#   export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles"
#   export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/brew.git"
export RUSTUP_DIST_SERVER="https://mirrors.tuna.tsinghua.edu.cn/rustup"
export RUSTUP_UPDATE_ROOT="https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup"
export MISE_NODE_MIRROR_URL="https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/"
export NODE_BUILD_MIRROR_URL="https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/"
info "useChineseMirror=true: using BFSU (Homebrew) + TUNA (Rustup / mise) mirrors"
{{ end -}}

# Add Homebrew to PATH if installed
{{ if eq .chezmoi.os "darwin" -}}
# macOS: Apple Silicon and Intel paths
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{ else -}}
# Linux: Linuxbrew paths — guard on the binary, not the dir, because a
# failed Homebrew installer (e.g. CentOS 7 where curl < 7.41 aborts mid-
# install) leaves /home/linuxbrew/.linuxbrew/ as an empty sudo'd skeleton,
# which would make `eval "$(.../bin/brew shellenv)"` print
# "No such file or directory" on every bootstrap re-run.
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x "$HOME/.linuxbrew/bin/brew" ]]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
fi
{{ end -}}

# =============================================================================
# 0. Homebrew Installation
# =============================================================================
# macOS: Always install Homebrew (required for ansible roles)
# Linux: Optional - only install if installBrewApps is enabled
# =============================================================================

{{ if eq .chezmoi.os "darwin" -}}
# macOS: Install Homebrew (required for package management)
if ! command -v brew &> /dev/null; then
    info "Installing Homebrew (macOS)..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    # Add to PATH for this session
    if [[ -f /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
    success "Homebrew installed successfully"
else
    info "Homebrew is already installed"
fi
{{ else -}}
# Linux: Install Linuxbrew (useful for packages not available or outdated in apt)
{{ $noRoot := false }}{{ if hasKey . "noRoot" }}{{ $noRoot = .noRoot }}{{ end -}}
{{ if $noRoot -}}
# noRoot mode: Skip Linuxbrew (requires sudo for dependencies)
info "noRoot mode: Skipping Linuxbrew installation (requires sudo)"
{{ else -}}
# Detect userland architecture (kernel may differ, e.g. RPi 4: armhf userland + aarch64 kernel)
if command -v dpkg &>/dev/null; then
    BREW_REAL_ARCH="$(dpkg --print-architecture)"
else
    BREW_REAL_ARCH="$(uname -m)"
fi

# glibc floor. Homebrew/Linux advertises glibc >= 2.13, but every modern
# bottle is built against a much newer one, so on an old distro `brew
# install` silently degrades to compiling *everything* from source — hours
# per formula, and the installer itself often aborts first (CentOS 7 ships
# curl < 7.41; see the -x guard above). 2.28 is the RHEL 8 / Debian 10
# floor: it excludes CentOS/RHEL 7 (2.17) while leaving Ubuntu 20.04
# (2.31) and everything newer on the normal path.
#
# Without this gate, the only way to stop bootstrap from re-attempting the
# install on a CentOS 7 box was to drop a fake `brew` stub (`#!/bin/sh` +
# `exit 0`) on PATH — which then silently poisoned every `command -v brew`
# probe in the ansible roles. See pitfalls/ansible-homebrew-expecting-value-line-1-column-1.md.
BREW_GLIBC_OK=1
BREW_GLIBC_VER="$(ldd --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+([0-9.]*)?$' || true)"
if [[ -n "$BREW_GLIBC_VER" ]]; then
    if ! awk -v v="$BREW_GLIBC_VER" 'BEGIN {
            split(v, a, ".");
            exit !((a[1] > 2) || (a[1] == 2 && a[2] >= 28))
        }'; then
        BREW_GLIBC_OK=0
    fi
fi

if [[ "$BREW_GLIBC_OK" -eq 0 ]]; then
    warn "Skipping Linuxbrew: glibc $BREW_GLIBC_VER is older than 2.28 — Homebrew would compile every formula from source. Use the distro package manager / mise / uv / cargo instead."
else
case "$BREW_REAL_ARCH" in
    amd64|x86_64|arm64|aarch64)
        if ! command -v brew &> /dev/null; then
            info "Installing Linuxbrew..."
            # Install Linuxbrew dependencies first. Uses sudo_run so the
            # already-cached password is piped in on stdin (no mid-script
            # prompt, no plaintext in argv).
            if command -v apt-get &> /dev/null; then
                sudo_run apt-get update
                sudo_run apt-get install -y build-essential procps curl file git
            fi
            # Install Linuxbrew
            NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            # Add to PATH for this session — same -x guard as the upper
            # path-detection block (failed installer leaves dirs but no
            # brew binary; eval would emit "No such file or directory").
            if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
                eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
            elif [[ -x "$HOME/.linuxbrew/bin/brew" ]]; then
                eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
            fi
            success "Linuxbrew installed successfully"
        else
            info "Linuxbrew is already installed"
        fi
        ;;
    *)
        warn "Skipping Linuxbrew: unsupported userland architecture '$BREW_REAL_ARCH' (Homebrew requires amd64 or arm64)"
        # Remove broken Linuxbrew if it was installed before arch detection existed
        if command -v brew &>/dev/null; then
            warn "Removing unusable Linuxbrew installation for '$BREW_REAL_ARCH'..."
            if [[ -d /home/linuxbrew/.linuxbrew ]]; then
                sudo_run rm -rf /home/linuxbrew/.linuxbrew
            fi
        fi
        ;;
esac
fi
{{ end -}}
{{ end -}}
# 1. Install uv if missing
if ! command -v uv &> /dev/null; then
    info "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    success "uv installed successfully"
else
    info "uv is already installed"
fi

# 2. Install build dependencies needed by mise tools (Ruby) and ansible (cryptography)
{{ $noRootDeps := false }}{{ if hasKey . "noRoot" }}{{ $noRootDeps = .noRoot }}{{ end -}}
{{ if not $noRootDeps -}}
if command -v apt-get &> /dev/null; then
    # sudo_run pipes the shared-session password on stdin; falls back to
    # plain `sudo` when NOPASSWD is detected (CHEZMOI_SUDO_PASS_FILE unset).
    sudo_run apt-get install -y libffi-dev libyaml-dev python3-dev 2>/dev/null || true
fi
{{ end -}}

# 3. Install mise if missing (runtime manager for Node.js, etc.)
# Use "mise --version" instead of "command -v" to catch arch-mismatch binaries
# (e.g. aarch64 binary on armhf userland — file exists but cannot execute)
if ! mise --version &> /dev/null; then
    info "Installing mise..."
    # Remove broken binary if present (wrong architecture)
    if command -v mise &> /dev/null && ! mise --version &> /dev/null; then
        warn "Removing non-functional mise binary (possible architecture mismatch)..."
        rm -f "$(command -v mise)" 2>/dev/null || true
    fi

    # Detect glibc version: mise's default `linux-x64` binary is built against
    # modern glibc (~2.28+) and crashes on CentOS 7 (glibc 2.17) with
    # `GLIBC_2.28 not found`. On such hosts skip the curl installer entirely
    # and reach for the musl variant directly — otherwise we waste a network
    # round-trip + a 120s timeout on the glibc binary that could never run.
    MISE_GLIBC_OLD=0
    if command -v ldd &> /dev/null; then
        MISE_GLIBC_VER="$(ldd --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1)"
        if [[ -n "$MISE_GLIBC_VER" ]]; then
            # awk fragment compares glibc version to 2.28 (works without `bc`).
            awk -v v="$MISE_GLIBC_VER" 'BEGIN { split(v, a, "."); exit !(a[1]<2 || (a[1]==2 && a[2]<28)) }' \
                && MISE_GLIBC_OLD=1
        fi
    fi

    MISE_REAL_ARCH="$(dpkg --print-architecture 2>/dev/null || uname -m)"
    case "$MISE_REAL_ARCH" in
        amd64|x86_64) MISE_BIN_ARCH="x64" ;;
        arm64|aarch64) MISE_BIN_ARCH="arm64" ;;
        armhf) MISE_BIN_ARCH="armv7" ;;
        *) MISE_BIN_ARCH="" ;;
    esac

{{ $noRootMise := false }}{{ if hasKey . "noRoot" }}{{ $noRootMise = .noRoot }}{{ end -}}
    if [[ "$MISE_GLIBC_OLD" == "1" && -n "$MISE_BIN_ARCH" ]]; then
        # CentOS 7 / RHEL 7 path — go straight to musl (glibc-independent).
        info "glibc $MISE_GLIBC_VER < 2.28 — preferring mise musl variant directly"
        MISE_URL_MUSL="https://mise.jdx.dev/mise-latest-linux-${MISE_BIN_ARCH}-musl"
        if curl -fsSL --connect-timeout 10 --max-time 120 "$MISE_URL_MUSL" -o "$HOME/.local/bin/mise" \
           && chmod +x "$HOME/.local/bin/mise" \
           && "$HOME/.local/bin/mise" --version &> /dev/null; then
            success "mise installed via direct binary download (linux-${MISE_BIN_ARCH}-musl)"
        else
            rm -f "$HOME/.local/bin/mise" 2>/dev/null || true
            warn "Could not install mise from $MISE_URL_MUSL — skipping (Node.js via mise will not be available)"
            warn "  Manual fallback: download from https://github.com/jdx/mise/releases/latest"
        fi
    elif curl -fsSL --connect-timeout 10 --max-time 60 https://mise.run | sh && mise --version &> /dev/null; then
        # Modern glibc path — the standard installer drops a glibc-built
        # binary that runs fine.
        success "mise installed via curl"
{{ if not $noRootMise -}}
    else
        # Modern-glibc fallback: curl installer succeeded but mise binary
        # didn't run (rare — e.g. a brand-new arch upstream hasn't built for).
        warn "curl installer failed or produced non-functional binary, trying direct download..."
        # Clean up broken binary from curl installer
        if command -v mise &> /dev/null && ! mise --version &> /dev/null; then
            rm -f "$(command -v mise)" 2>/dev/null || true
        fi
        if [[ -n "$MISE_BIN_ARCH" ]]; then
            MISE_URL="https://mise.jdx.dev/mise-latest-linux-${MISE_BIN_ARCH}"
            info "Downloading mise from ${MISE_URL}..."
            if curl -fsSL --connect-timeout 10 --max-time 120 "$MISE_URL" -o "$HOME/.local/bin/mise" && chmod +x "$HOME/.local/bin/mise"; then
                if "$HOME/.local/bin/mise" --version &> /dev/null; then
                    success "mise installed via direct binary download (linux-${MISE_BIN_ARCH})"
                else
                    warn "glibc binary failed, trying musl variant..."
                    MISE_URL_MUSL="https://mise.jdx.dev/mise-latest-linux-${MISE_BIN_ARCH}-musl"
                    if curl -fsSL --connect-timeout 10 --max-time 120 "$MISE_URL_MUSL" -o "$HOME/.local/bin/mise" && chmod +x "$HOME/.local/bin/mise" && "$HOME/.local/bin/mise" --version &> /dev/null; then
                        success "mise installed via direct binary download (linux-${MISE_BIN_ARCH}-musl)"
                    else
                        rm -f "$HOME/.local/bin/mise" 2>/dev/null || true
                        warn "Could not install mise — skipping (Node.js via mise will not be available)"
                        warn "  Tried: linux-${MISE_BIN_ARCH} and linux-${MISE_BIN_ARCH}-musl"
                        warn "  You can install mise manually: https://mise.jdx.dev/installing-mise.html"
                    fi
                fi
            else
                rm -f "$HOME/.local/bin/mise" 2>/dev/null || true
                warn "Could not download mise — skipping"
            fi
        else
            warn "Could not install mise — unsupported architecture '$MISE_REAL_ARCH'"
        fi
{{ end -}}
    fi
else
    info "mise is already installed"
fi

# 4. Install ansible if missing (or refresh if running on stale Python <3.10)
#
# `uv tool install` defaults to the system Python. On CentOS 7 / RHEL 7 the
# system is Python 3.6.8 — uv would resolve `ansible-core` to 2.11.12 (last
# version supporting Py3.6, August 2021) which predates Galaxy NG and crashes
# on `ansible-galaxy collection install community.general` with a KeyError on
# the `/api/v3/plugin/ansible/content/...` URL. Pin to Python 3.13 so uv
# auto-fetches a python-build-standalone interpreter (statically linked,
# glibc-2.17 compatible) and pulls a modern ansible-core (2.18+) that speaks
# Galaxy NG. Mirrors the `uv tool install --python 3.13 pre-commit` pattern
# in dot_ansible/roles/security_tools/tasks/main.yml.
NEED_ANSIBLE_INSTALL=0
if ! command -v ansible-playbook &> /dev/null; then
    NEED_ANSIBLE_INSTALL=1
elif ansible-playbook --version 2>/dev/null | grep -qE 'python version = 3\.(6|7|8|9)\.'; then
    info "Detected ansible on stale Python (<3.10); will reinstall on Python 3.13"
    NEED_ANSIBLE_INSTALL=1
fi
if [[ "$NEED_ANSIBLE_INSTALL" == "1" ]]; then
    info "Installing ansible via uv (Python 3.13)..."
    uv tool install --force --python 3.13 ansible-core
    success "ansible installed successfully"
else
    info "ansible is already installed"
fi

# 5. Install ansible-galaxy collections
info "Installing ansible-galaxy collections..."
if ansible-galaxy collection install community.general --force-with-deps; then
    success "ansible-galaxy collections installed"
else
    # Check if collection is already installed (e.g. network blocked by GFW)
    if ansible-galaxy collection list community.general 2>/dev/null | grep -q community.general; then
        warn "Galaxy download failed but community.general is already installed, continuing..."
    else
        error "Failed to install community.general collection. Ansible playbooks will not work."
        error "Try setting: export https_proxy=http://your-proxy:port"
        exit 1
    fi
fi

# 6. Install mise global tools (Node.js) if mise config exists
MISE_BIN="${HOME}/.local/bin/mise"
[[ ! -x "$MISE_BIN" ]] && MISE_BIN="$(command -v mise 2>/dev/null || true)"
if [[ -x "$MISE_BIN" ]] && [[ -f "$HOME/.config/mise/config.toml" ]]; then
    info "Installing mise global tools..."
    if "$MISE_BIN" install --yes; then
        success "mise tools installed"
    else
        warn "mise install had errors (some tools may have failed to build). Continuing..."
    fi
fi

# 7. Ensure ~/.local/bin is on PATH for bash sessions (idempotent)
# chezmoi, uv, mise all live in ~/.local/bin. Dotfiles only wire this up in
# zsh; until the user switches shells, bash needs help finding them.
BASHRC="$HOME/.bashrc"
LOCAL_BIN_LINE='export PATH="$HOME/.local/bin:$PATH"'
if [[ -f "$BASHRC" ]] || [[ "${SHELL##*/}" == "bash" ]]; then
    touch "$BASHRC"
    if ! grep -qF "$LOCAL_BIN_LINE" "$BASHRC"; then
        {
            echo ""
            echo "# Added by chezmoi bootstrap - ~/.local/bin for uv, mise, chezmoi"
            echo "$LOCAL_BIN_LINE"
        } >> "$BASHRC"
        info "Added ~/.local/bin to PATH in $BASHRC"
    fi
fi

success "Bootstrap complete!"
