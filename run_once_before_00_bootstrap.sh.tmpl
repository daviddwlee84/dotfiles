#!/bin/bash
# Bootstrap script - installs Homebrew, uv, ansible, mise, and galaxy collections
# Runs BEFORE any ansible playbooks
# Profile: {{ .profile }}

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Fix broken locale (e.g. RPi with LC_ALL=en_US.UTF-8 but locale not generated)
# Ansible requires UTF-8 encoding, so fall back to C.UTF-8 (not plain C).
if locale 2>&1 | grep -qi "cannot set"; then
    warn "Broken locale detected, falling back to LC_ALL=C.UTF-8"
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
fi

# Ensure PATH includes local bin and Homebrew
export PATH="$HOME/.local/bin:$PATH"

# Add Homebrew to PATH if installed
{{ if or (eq .profile "macos") (eq .profile "macos_intel") -}}
# macOS: Apple Silicon and Intel paths
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{ else -}}
# Linux: Linuxbrew paths
if [[ -d /home/linuxbrew/.linuxbrew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -d "$HOME/.linuxbrew" ]]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
fi
{{ end -}}

# =============================================================================
# 0. Homebrew Installation
# =============================================================================
# macOS: Always install Homebrew (required for ansible roles)
# Linux: Optional - only install if installBrewApps is enabled
# =============================================================================

{{ if or (eq .profile "macos") (eq .profile "macos_intel") -}}
# macOS: Install Homebrew (required for package management)
if ! command -v brew &> /dev/null; then
    info "Installing Homebrew (macOS)..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    # Add to PATH for this session
    if [[ -f /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
    success "Homebrew installed successfully"
else
    info "Homebrew is already installed"
fi
{{ else -}}
# Linux: Install Linuxbrew (useful for packages not available or outdated in apt)
{{ $noRoot := false }}{{ if hasKey . "noRoot" }}{{ $noRoot = .noRoot }}{{ end -}}
{{ if $noRoot -}}
# noRoot mode: Skip Linuxbrew (requires sudo for dependencies)
info "noRoot mode: Skipping Linuxbrew installation (requires sudo)"
{{ else -}}
# Detect userland architecture (kernel may differ, e.g. RPi 4: armhf userland + aarch64 kernel)
if command -v dpkg &>/dev/null; then
    BREW_REAL_ARCH="$(dpkg --print-architecture)"
else
    BREW_REAL_ARCH="$(uname -m)"
fi

case "$BREW_REAL_ARCH" in
    amd64|x86_64|arm64|aarch64)
        if ! command -v brew &> /dev/null; then
            info "Installing Linuxbrew..."
            # Install Linuxbrew dependencies first
            if command -v apt-get &> /dev/null; then
                sudo apt-get update
                sudo apt-get install -y build-essential procps curl file git
            fi
            # Install Linuxbrew
            NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            # Add to PATH for this session
            if [[ -d /home/linuxbrew/.linuxbrew ]]; then
                eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
            elif [[ -d "$HOME/.linuxbrew" ]]; then
                eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
            fi
            success "Linuxbrew installed successfully"
        else
            info "Linuxbrew is already installed"
        fi
        ;;
    *)
        warn "Skipping Linuxbrew: unsupported userland architecture '$BREW_REAL_ARCH' (Homebrew requires amd64 or arm64)"
        # Remove broken Linuxbrew if it was installed before arch detection existed
        if command -v brew &>/dev/null; then
            warn "Removing unusable Linuxbrew installation for '$BREW_REAL_ARCH'..."
            if [[ -d /home/linuxbrew/.linuxbrew ]]; then
                sudo rm -rf /home/linuxbrew/.linuxbrew
            fi
        fi
        ;;
esac
{{ end -}}
{{ end -}}
# 1. Install uv if missing
if ! command -v uv &> /dev/null; then
    info "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    success "uv installed successfully"
else
    info "uv is already installed"
fi

# 2. Install build dependencies needed by mise tools (Ruby) and ansible (cryptography)
{{ $noRootDeps := false }}{{ if hasKey . "noRoot" }}{{ $noRootDeps = .noRoot }}{{ end -}}
{{ if not $noRootDeps -}}
if command -v apt-get &> /dev/null; then
    sudo apt-get install -y libffi-dev libyaml-dev python3-dev 2>/dev/null || true
fi
{{ end -}}

# 3. Install mise if missing (runtime manager for Node.js, etc.)
# Use "mise --version" instead of "command -v" to catch arch-mismatch binaries
# (e.g. aarch64 binary on armhf userland — file exists but cannot execute)
if ! mise --version &> /dev/null; then
    info "Installing mise..."
    # Remove broken binary if present (wrong architecture)
    if command -v mise &> /dev/null && ! mise --version &> /dev/null; then
        warn "Removing non-functional mise binary (possible architecture mismatch)..."
        rm -f "$(command -v mise)" 2>/dev/null || true
    fi
    # Try curl installer first (fast, no sudo)
    if curl -fsSL --connect-timeout 10 --max-time 60 https://mise.run | sh && mise --version &> /dev/null; then
        success "mise installed via curl"
{{ $noRootMise := false }}{{ if hasKey . "noRoot" }}{{ $noRootMise = .noRoot }}{{ end -}}
{{ if not $noRootMise -}}
    else
        # Fallback: try direct binary download with correct userland arch
        warn "curl installer failed or produced non-functional binary, trying direct download..."
        # Clean up broken binary from curl installer
        if command -v mise &> /dev/null && ! mise --version &> /dev/null; then
            rm -f "$(command -v mise)" 2>/dev/null || true
        fi
        MISE_REAL_ARCH="$(dpkg --print-architecture 2>/dev/null || uname -m)"
        case "$MISE_REAL_ARCH" in
            amd64|x86_64) MISE_BIN_ARCH="x64" ;;
            arm64|aarch64) MISE_BIN_ARCH="arm64" ;;
            armhf) MISE_BIN_ARCH="armv7" ;;
            *) MISE_BIN_ARCH="" ;;
        esac
        if [[ -n "$MISE_BIN_ARCH" ]]; then
            MISE_URL="https://mise.jdx.dev/mise-latest-linux-${MISE_BIN_ARCH}"
            info "Downloading mise from ${MISE_URL}..."
            if curl -fsSL --connect-timeout 10 --max-time 120 "$MISE_URL" -o "$HOME/.local/bin/mise" && chmod +x "$HOME/.local/bin/mise"; then
                # Verify the binary actually runs
                if "$HOME/.local/bin/mise" --version &> /dev/null; then
                    success "mise installed via direct binary download (linux-${MISE_BIN_ARCH})"
                else
                    # Try musl variant (some armhf systems need it)
                    warn "glibc binary failed, trying musl variant..."
                    MISE_URL_MUSL="https://mise.jdx.dev/mise-latest-linux-${MISE_BIN_ARCH}-musl"
                    if curl -fsSL --connect-timeout 10 --max-time 120 "$MISE_URL_MUSL" -o "$HOME/.local/bin/mise" && chmod +x "$HOME/.local/bin/mise" && "$HOME/.local/bin/mise" --version &> /dev/null; then
                        success "mise installed via direct binary download (linux-${MISE_BIN_ARCH}-musl)"
                    else
                        rm -f "$HOME/.local/bin/mise" 2>/dev/null || true
                        warn "Could not install mise — skipping (Node.js via mise will not be available)"
                        warn "  Tried: linux-${MISE_BIN_ARCH} and linux-${MISE_BIN_ARCH}-musl"
                        warn "  You can install mise manually: https://mise.jdx.dev/installing-mise.html"
                    fi
                fi
            else
                rm -f "$HOME/.local/bin/mise" 2>/dev/null || true
                warn "Could not download mise — skipping"
            fi
        else
            warn "Could not install mise — unsupported architecture '$MISE_REAL_ARCH'"
        fi
{{ end -}}
    fi
else
    info "mise is already installed"
fi

# 4. Install ansible if missing
if ! command -v ansible-playbook &> /dev/null; then
    info "Installing ansible via uv..."
    uv tool install ansible-core
    success "ansible installed successfully"
else
    info "ansible is already installed"
fi

# 5. Install ansible-galaxy collections
info "Installing ansible-galaxy collections..."
if ansible-galaxy collection install community.general --force-with-deps; then
    success "ansible-galaxy collections installed"
else
    # Check if collection is already installed (e.g. network blocked by GFW)
    if ansible-galaxy collection list community.general 2>/dev/null | grep -q community.general; then
        warn "Galaxy download failed but community.general is already installed, continuing..."
    else
        error "Failed to install community.general collection. Ansible playbooks will not work."
        error "Try setting: export https_proxy=http://your-proxy:port"
        exit 1
    fi
fi

# 6. Install mise global tools (Node.js) if mise config exists
MISE_BIN="${HOME}/.local/bin/mise"
[[ ! -x "$MISE_BIN" ]] && MISE_BIN="$(command -v mise 2>/dev/null || true)"
if [[ -x "$MISE_BIN" ]] && [[ -f "$HOME/.config/mise/config.toml" ]]; then
    info "Installing mise global tools..."
    if "$MISE_BIN" install --yes; then
        success "mise tools installed"
    else
        warn "mise install had errors (some tools may have failed to build). Continuing..."
    fi
fi

# 7. Ensure ~/.local/bin is on PATH for bash sessions (idempotent)
# chezmoi, uv, mise all live in ~/.local/bin. Dotfiles only wire this up in
# zsh; until the user switches shells, bash needs help finding them.
BASHRC="$HOME/.bashrc"
LOCAL_BIN_LINE='export PATH="$HOME/.local/bin:$PATH"'
if [[ -f "$BASHRC" ]] || [[ "${SHELL##*/}" == "bash" ]]; then
    touch "$BASHRC"
    if ! grep -qF "$LOCAL_BIN_LINE" "$BASHRC"; then
        {
            echo ""
            echo "# Added by chezmoi bootstrap - ~/.local/bin for uv, mise, chezmoi"
            echo "$LOCAL_BIN_LINE"
        } >> "$BASHRC"
        info "Added ~/.local/bin to PATH in $BASHRC"
    fi
fi

success "Bootstrap complete!"
