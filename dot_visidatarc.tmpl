# VisiData personal config (~/.visidatarc).
# Loaded by VisiData at startup AFTER bundled loaders register themselves.
# Anything we set on `VisiData` / `vd` here wins over in-tree defaults.
#
# Managed by chezmoi (source: dot_visidatarc.tmpl). Edits to ~/.visidatarc
# will be reverted on next `chezmoi apply` — change the source instead.
#
# -----------------------------------------------------------------------------
# Why ~/.visidatarc and not $XDG_CONFIG_HOME/visidata/config.py?
# -----------------------------------------------------------------------------
# VisiData v2.9+ supports an XDG-located config.py
# (visidata/settings.py:_get_config_file): if
# appdirs.user_config_dir('visidata')/config.py exists, it wins over
# ~/.visidatarc.  But appdirs on Darwin returns
# ~/Library/Preferences/visidata (NOT ~/.config/visidata) — so a naive
# Linux-style migration would silently fail on macOS.
#
# Path forward (tracked in TODO.md "[P3/S] Migrate VisiData rc to XDG path"):
#   export VD_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/visidata/config.py"
#   export VD_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/visidata"
# in dot_config/shell/00_exports.sh.tmpl, then move source to
# dot_config/visidata/config.py.tmpl.  VD_CONFIG/VD_DIR are read by
# loadConfigAndPlugins() at settings.py:440-441 and are the intended
# upstream-supported override.  Full caveat:
# pitfalls/visidata-feather-stringdtype-numpy-dtype.md → "XDG path / macOS
# appdirs caveat".

# -----------------------------------------------------------------------------
# .feather → ArrowSheet (bypass the broken PandasSheet path)
#
# VisiData 3.3's bundled feather loader funnels through pandas:
#   loaders/_pandas.py auto-registers open_feather → PandasSheet
#     → pd.read_feather() → PandasSheet.reload() → dtype_to_type(Series)
#     → np.issubdtype(StringDtype, np.integer)  ← ValueError
#
# This is unavoidable when the .feather schema metadata embeds
# `numpy_type: string` (i.e. any DataFrame written from pandas ≥ 2.0 with
# string columns). Downgrading the reader doesn't help — the dtype identity
# is in the file, and pd.read_feather faithfully restores it.
#
# The fix is to route .feather through VisiData's *other* loader,
# loaders/arrow.py (`ArrowSheet`), which is pure pyarrow and never touches
# pandas. Feather v2 IS the Arrow IPC file format, so the same bytes load
# cleanly there.
#
# Implementation note: `setattr(VisiData, 'open_feather', …)` direct
# assignment, NOT the `@VisiData.api` decorator. The decorator routes
# through the live `vd` instance and (on v3.3) does NOT shadow the class
# attribute that loaders/_pandas.py installs at import time, so the
# PandasSheet path still wins. Direct class-attribute assignment replaces
# the attribute where the loader dispatch looks it up.
#
# Trade-off: ArrowSheet lacks PandasSheet's vectorized selectByRegex /
# in-place sort / undoable addRow/delete_row paths. Everyday "open & look"
# is identical; if you specifically want PandasSheet semantics on a
# known-StringDtype-free file, fall back to `visidata -f feather <file>`.
#
# See pitfalls/visidata-feather-stringdtype-numpy-dtype.md for the full
# investigation (the dtype-in-the-file diagnosis, the version matrix that
# disproves the downgrade path, the upstream code references).
# Drop this override once VisiData ships a fix.

try:
    from visidata import VisiData  # noqa: E402

    from visidata.loaders.arrow import ArrowSheet  # noqa: E402

    def open_feather(vd, p):  # noqa: ARG001 (signature matches VisiData's contract)
        """Route .feather to ArrowSheet (pure pyarrow), bypassing PandasSheet.

        Workaround for VisiData 3.3 + pandas StringDtype incompatibility.
        See pitfalls/visidata-feather-stringdtype-numpy-dtype.md.
        """
        return ArrowSheet(p.base_stem, source=p)

    VisiData.open_feather = open_feather
{{- if .enableVimMode }}

    # -------------------------------------------------------------------------
    # enableVimMode customizations
    # -------------------------------------------------------------------------
    # VisiData's defaults are already vim-flavored: h/j/k/l navigation, gg/G
    # for top/bottom row, gh/gl for go-leftmost/go-rightmost column (mirrors
    # the gg/G row-nav convention), /? search, n/N next/prev match, q/Q quit.
    # This block ADDS strict-vim parity for line-internal navigation chars
    # (0 / $ / _ / ^) and INSERT-mode mnemonic (i) on top of the defaults.
    #
    # Per https://www.visidata.org/docs/customize/#example-bind-i-to-edit-cell-globally
    from visidata import TableSheet  # noqa: E402

    # --- INSERT mnemonic ----------------------------------------------------
    # `i` -> edit-cell (additive — `e` keeps working as the historical bind).
    # Displaces `addcol-incr` (features/incr.py:27).  Still reachable via the
    # Alt+H command menu or `Space addcol-incr<Enter>`; the gi / zi / gzi
    # set-incr family is unaffected.
    TableSheet.unbindkey('i')
    TableSheet.bindkey('i', 'edit-cell')

    # --- Column navigation (vim line-internal chars) ------------------------
    # `0` was unbound by default — free slot, zero trade-off.
    # `$` / `_` / `^` displace useful single-letter commands; we relocate
    # them to mnemonic 2-char slots in the same block so they're not lost.
    #
    #   key  | new action       | displaced from   | relocated to
    #   -----+------------------+------------------+--------------
    #    0   | go-leftmost      | (was unbound)    | -
    #    $   | go-rightmost     | type-currency    | z$  (extends $)
    #    _   | go-leftmost      | resize-col-max   | zw  (z + Width)
    #    ^   | go-leftmost      | rename-col       | zN  (z + Name)
    #
    # `gh` / `gl` (VisiData defaults) remain bound to go-leftmost/go-rightmost
    # and provide a non-overloaded fallback.
    TableSheet.bindkey('0', 'go-leftmost')
    TableSheet.unbindkey('$'); TableSheet.bindkey('$', 'go-rightmost')
    TableSheet.unbindkey('_'); TableSheet.bindkey('_', 'go-leftmost')
    TableSheet.unbindkey('^'); TableSheet.bindkey('^', 'go-leftmost')

    # Relocate displaced commands to mnemonic 2-char slots.  These slots
    # are verified free (no clash with VisiData's existing z*/g* families
    # like z_ = resize-col-input, z^ = rename-col-selected, etc.).
    TableSheet.bindkey('z$', 'type-currency')
    TableSheet.bindkey('zw', 'resize-col-max')
    TableSheet.bindkey('zN', 'rename-col')
{{- end }}
except ImportError:
    # pyarrow / visidata.loaders.arrow not available — leave the default
    # PandasSheet path in place. The user will get the standard pandas
    # error if they hit a StringDtype feather, which is no worse than not
    # having this override at all.
    pass
