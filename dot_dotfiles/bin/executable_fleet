#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "asyncssh>=2.18",
#   "tyro>=0.9",
#   "rich>=13.9",
# ]
# ///
"""fleet — umbrella CLI for the dotfiles fleet.

Top-level layout (2026-05-13):

  fleet chezmoi <action>         Chezmoi-specific deploy ops (apply / status /
                                 diff / tail / kill / compact). Backed by
                                 scripts/fleet/apply.py.
  fleet tmux [...]               Cross-host tmux session summary
  fleet info [...]               Cross-host system status snapshot
  fleet pueue [...]              Cross-host pueue queue summary
  fleet exec [OPTS] -- CMD [...]  Cross-host ad-hoc command runner
  fleet hosts [NAME|--list*]     Interactive picker (via `tv fleet-hosts`)
                                 for SSH'ing into a fleet-configured host.
                                 Backed by scripts/fleet/hosts.py.
  fleet edit                     $EDITOR ~/.config/fleet/machines.toml
                                 (fleet-meta — used by every subcommand)

The `fleet chezmoi <action>` namespace was introduced to free the top
level for generic primitives. `apply` / `status` / `diff` / etc. are NO
LONGER top-level subcommands — they only exist under `chezmoi`. The
`just fleet-*` recipes still call scripts/fleet/apply.py directly with
its underlying flags (`--readiness`, `--status`, `--kill-orphans`,
`--compact`, etc.) and continue to work unchanged.

Discovers the chezmoi source dir at runtime via `chezmoi source-path` (falls
back to ~/.local/share/chezmoi), so the binary works from any cwd.

Deployed by chezmoi as ~/.dotfiles/bin/fleet. See docs/this_repo/fleet-apply.md.
"""
from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path

USAGE = """\
Usage: fleet <subcommand> [args...]

Chezmoi-specific deploy ops (under `chezmoi` namespace):
  chezmoi apply [--hosts ...] [--dry-run] [--force] [...]
                          Run chezmoi update --init across the fleet.
  chezmoi status          Pre-flight readiness probe (predicts apply outcome).
  chezmoi status --quick  Skip remote `git fetch` (faster).
  chezmoi status --live   Process-liveness probe (use during/after apply).
  chezmoi status --live --watch N  Poll every N seconds.
  chezmoi diff HOST [args...]
                          Shortcut: chezmoi apply --dry-run --hosts HOST --serial.
  chezmoi tail HOST[:RUN_ID]
                          Live-tail a host's fleet-apply log.
  chezmoi kill [--hosts ...]
                          pkill chezmoi/ansible across the fleet.
  chezmoi compact [--run-id ID]
                          Post-mortem summary.

Generic primitives (top-level — work regardless of deploy tool):
  edit                    Open ~/.config/fleet/machines.toml in $EDITOR.
  tmux [--hosts ...] [--json] [--deep]
                          Cross-host tmux session summary.
  info [--hosts ...] [--ff] [--full] [--modules a,b,c] [--json]
                          Cross-host system status snapshot.
  pueue [--hosts ...] [--group G] [--json] [--ai [--report [--out PATH]]]
                          Cross-host pueue queue summary. --ai pipes the
                          merged JSON to `pqsum` for cleanability + recovery
                          analysis (one prompt template, shared with local
                          `pqsum --ai`).
  exec [--hosts ...] [--shell BIN] [--login] [--json|--out-dir DIR|--ai] -- CMD [ARG...]
                          Cross-host argv-list command runner. Argv after
                          `--` is safe by default (no shell expansion). Use
                          --shell bash|zsh for pipes/globs; --login for full
                          rc-loaded env; --ai for succeeded/differed/failed
                          classification across hosts.
  hosts [NAME] [--list|--list-tsv|--list-json|--describe N|--probe N]
                          Interactive picker (via `tv fleet-hosts`) for
                          SSH'ing into a fleet host. `fleet hosts NAME` skips
                          the picker and SSHes directly. `--list*` modes are
                          script-friendly inventory dumps; `--describe` /
                          `--probe` back the TV cable's preview + Alt+T.

Examples:
  fleet chezmoi status               # readiness across all hosts
  fleet chezmoi apply --hosts ts_nas # apply to one host
  fleet chezmoi diff hanru_mac       # dry-run diff against one host
  fleet tmux --hosts self,ts_nas     # tmux sessions, 2 hosts
  fleet info --full --json | jq .    # everything as JSON
  fleet pueue --ai                   # AI summary of every host's queue
  fleet pueue --ai --report --out /tmp/q.md
                                     # markdown report across the fleet
  fleet exec -- pueue --version      # audit version drift
  fleet exec --ai -- df -h /         # AI summary of disk usage
  fleet exec --shell bash -- 'cat *.log | wc -l'
                                     # opt-in shell expansion (pipes/globs)
  fleet hosts                        # TV picker → Enter to SSH
  fleet hosts lab-box                # SSH straight into one host
  fleet hosts --list-tsv             # name<TAB>target<TAB>kind (cable source)

See docs/this_repo/fleet-apply.md for full mental model.
"""


def _source_path() -> Path:
    """Locate the chezmoi source dir. Required to find scripts/fleet_*."""
    chezmoi = shutil.which("chezmoi")
    if chezmoi:
        try:
            out = subprocess.run(
                [chezmoi, "source-path"],
                capture_output=True, text=True, check=False, timeout=5,
            )
            if out.returncode == 0 and out.stdout.strip():
                return Path(out.stdout.strip())
        except (subprocess.TimeoutExpired, OSError):
            pass
    fallback = Path.home() / ".local" / "share" / "chezmoi"
    if (fallback / "scripts" / "fleet" / "apply.py").is_file():
        return fallback
    print(
        "fleet: cannot locate chezmoi source dir.\n"
        "  Tried: `chezmoi source-path` and ~/.local/share/chezmoi.\n"
        "  Install chezmoi or ensure the source dir exists.",
        file=sys.stderr,
    )
    sys.exit(2)


def _dispatch_apply(forwarded: list[str]) -> int:
    """Forward to scripts.fleet.apply.main() with argv swap."""
    sys.argv = ["fleet apply", *forwarded]
    from scripts.fleet.apply import main as apply_main
    return apply_main()


def _dispatch_status(args: list[str]) -> int:
    """`fleet status` overload:
       default        → --readiness
       --quick        → --readiness --readiness-no-fetch
       --live         → --status
       --live --watch → --status --watch N (default 10)
    """
    live = "--live" in args
    quick = "--quick" in args
    rest = [a for a in args if a not in ("--live", "--quick")]
    if live:
        flags = ["--status"]
        # Default watch interval when --live is passed without a numeric --watch
        if "--watch" not in rest:
            pass  # one-shot probe
    else:
        flags = ["--readiness"]
        if quick:
            flags.append("--readiness-no-fetch")
    return _dispatch_apply(flags + rest)


def _dispatch_diff(args: list[str]) -> int:
    if not args:
        print("fleet diff: missing HOST argument", file=sys.stderr)
        return 2
    host = args[0]
    rest = args[1:]
    return _dispatch_apply(["--dry-run", "--hosts", host, "--serial", *rest])


def _dispatch_tail(args: list[str]) -> int:
    if not args:
        print("fleet tail: missing HOST[:RUN_ID] argument", file=sys.stderr)
        return 2
    return _dispatch_apply(["--tail", args[0], *args[1:]])


def _dispatch_kill(args: list[str]) -> int:
    return _dispatch_apply(["--kill-orphans", *args])


def _dispatch_compact(args: list[str]) -> int:
    return _dispatch_apply(["--compact", *args])


_SEED_TEMPLATE = """\
# fleet-apply inventory — see docs/this_repo/fleet-apply.md
# Schema reference: dot_config/fleet/create_private_machines.toml.tmpl

[defaults]
chezmoi_path    = "auto"
connect_timeout = 30
command_timeout = 7200

# [[hosts]]
# name      = "lab-box"
# ssh_alias = "lab-box"
# no_root_machine = false
# password_source = { type = "prompt" }
"""


def _dispatch_edit(_args: list[str]) -> int:
    """Open ~/.config/fleet/machines.toml in $EDITOR; seed it on first run."""
    cfg = Path.home() / ".config" / "fleet" / "machines.toml"
    cfg.parent.mkdir(parents=True, exist_ok=True)
    if not cfg.exists():
        print(f"[INFO] seeding empty {cfg} — add [[hosts]] entries below", file=sys.stderr)
        cfg.write_text(_SEED_TEMPLATE)
        os.chmod(cfg, 0o600)
    editor = os.environ.get("EDITOR", "nvim")
    return subprocess.call([editor, str(cfg)])


def _dispatch_tmux(forwarded: list[str]) -> int:
    sys.argv = ["fleet tmux", *forwarded]
    from scripts.fleet.tmux import main as tmux_main
    return tmux_main()


def _dispatch_info(forwarded: list[str]) -> int:
    sys.argv = ["fleet info", *forwarded]
    from scripts.fleet.info import main as info_main
    return info_main()


def _dispatch_pueue(forwarded: list[str]) -> int:
    sys.argv = ["fleet pueue", *forwarded]
    from scripts.fleet.pueue import main as pueue_main
    return pueue_main()


def _dispatch_exec(forwarded: list[str]) -> int:
    sys.argv = ["fleet exec", *forwarded]
    from scripts.fleet.exec import main as exec_main
    return exec_main()


def _dispatch_hosts(forwarded: list[str]) -> int:
    sys.argv = ["fleet hosts", *forwarded]
    from scripts.fleet.hosts import main as hosts_main
    return hosts_main()


_CHEZMOI_ACTIONS = """\
Subcommands under `fleet chezmoi`:
  apply [...]      Run chezmoi update --init across the fleet
  status           Pre-flight readiness probe
  status --quick   Skip remote git fetch
  status --live    Process-liveness probe
  diff HOST        chezmoi diff on one host (--dry-run --hosts HOST --serial)
  tail HOST[:RUN]  Live-tail remote fleet-apply log
  kill             pkill chezmoi/ansible across the fleet
  compact          Post-mortem summary
"""


def _dispatch_chezmoi(forwarded: list[str]) -> int:
    """Route `fleet chezmoi <action> [args...]` to the chezmoi-backend helpers.

    The top-level `apply`/`status`/`diff`/`tail`/`kill`/`compact` subcommands
    were removed on 2026-05-13 to free the top level for generic primitives
    (`tmux` / `info` / `pueue` / `exec`). All chezmoi-specific deploy ops
    live under this namespace now.
    """
    if not forwarded or forwarded[0] in ("-h", "--help", "help"):
        print(_CHEZMOI_ACTIONS)
        return 0
    action = forwarded[0]
    rest = forwarded[1:]
    nested = {
        "apply": _dispatch_apply,
        "status": _dispatch_status,
        "diff": _dispatch_diff,
        "tail": _dispatch_tail,
        "kill": _dispatch_kill,
        "compact": _dispatch_compact,
    }
    fn = nested.get(action)
    if fn is None:
        print(f"fleet chezmoi: unknown action '{action}'\n\n{_CHEZMOI_ACTIONS}", file=sys.stderr)
        return 2
    return fn(rest)


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(USAGE)
        return 0

    sub = sys.argv[1]
    rest = sys.argv[2:]

    src = _source_path()
    if str(src) not in sys.path:
        sys.path.insert(0, str(src))

    dispatch = {
        # Chezmoi-specific deploy ops under `fleet chezmoi <action>`.
        # The bare top-level names (apply/status/diff/tail/kill/compact) were
        # removed on 2026-05-13 — `fleet apply` now errors with "unknown
        # subcommand" by design so the namespace stays clean.
        "chezmoi": _dispatch_chezmoi,
        # Fleet-meta (inventory editor; no SSH).
        "edit": _dispatch_edit,
        # Generic cross-host primitives (deploy-tool-agnostic).
        "tmux": _dispatch_tmux,
        "info": _dispatch_info,
        "pueue": _dispatch_pueue,
        "exec": _dispatch_exec,
        "hosts": _dispatch_hosts,
    }
    fn = dispatch.get(sub)
    if fn is None:
        print(f"fleet: unknown subcommand '{sub}'\n\n{USAGE}", file=sys.stderr)
        return 2
    return fn(rest)


if __name__ == "__main__":
    sys.exit(main())
