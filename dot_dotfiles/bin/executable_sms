#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "huawei-lte-api>=1.10",
#   "platformdirs>=4",
#   "rich>=13",
#   "tyro>=0.8",
# ]
# ///
"""Read SMS from a Huawei HiLink router over its XML API.

Deployed via chezmoi as ~/.dotfiles/bin/sms. Uses huawei-lte-api (handles
CSRF, SCRAM-SHA-256 login, session cookies) instead of scraping the JS SPA.
`sms watch` polls the router and pushes each new SMS through apprise.
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import shutil
import signal
import sqlite3
import subprocess
import sys
import time
import tomllib
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path
from typing import Annotated, Any, Iterator, Literal, Union

import tyro
from platformdirs import user_cache_dir, user_config_dir, user_data_dir, user_state_dir

APP = "sms"
DEFAULT_HOST = "192.168.168.1"
DEFAULT_USER = "admin"
DEFAULT_TTL = 30
DEFAULT_INTERVAL = 10.0
DEFAULT_FULL_SYNC = 300.0
DEFAULT_CAPACITY_WARN = 0.95
MAX_BACKOFF = 300.0
SEEN_CAP = 5000
CODE_RE = re.compile(r"(?<!\d)(\d{4,8})(?!\d)")
CODE_KEYWORDS = re.compile(
    r"verification|驗證|验证|\bcode\b|OTP|one[- ]?time|密碼|密码", re.I
)

CONFIG_DIR = Path(user_config_dir(APP))
CACHE_DIR = Path(user_cache_dir(APP))
CONFIG_FILE = CONFIG_DIR / "config.toml"
INBOX_CACHE = CACHE_DIR / "inbox.json"
STATE_DIR = Path(user_state_dir(APP))
SEEN_FILE = STATE_DIR / "seen.json"
NOTIFY_LOG = STATE_DIR / "notify.log"
DATA_DIR = Path(user_data_dir(APP))
ARCHIVE_DB = DATA_DIR / "archive.sqlite"
PAGE_SIZE = 50  # router max per sms-list page
UNIT_NAME = "sms-watch.service"
UNIT_FILE = Path.home() / ".config" / "systemd" / "user" / UNIT_NAME


def die(msg: str, code: int = 1) -> None:
    print(f"sms: {msg}", file=sys.stderr)
    sys.exit(code)


def log(msg: str) -> None:
    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}", file=sys.stderr, flush=True)


# ---------- config / cache --------------------------------------------------

def read_config_file() -> dict[str, Any]:
    if not CONFIG_FILE.exists():
        return {}
    try:
        return tomllib.loads(CONFIG_FILE.read_text())
    except Exception as e:
        die(f"bad config {CONFIG_FILE}: {e}")
        return {}


def load_config() -> dict[str, str]:
    cfg = read_config_file()
    host = os.environ.get("SMS_ROUTER_HOST") or cfg.get("host") or DEFAULT_HOST
    user = os.environ.get("SMS_ROUTER_USER") or cfg.get("user") or DEFAULT_USER
    pw = os.environ.get("SMS_ROUTER_PASS") or cfg.get("password")
    if not pw:
        pw = prompt_and_save(host, user)
    return {"host": host, "user": user, "password": pw}


def prompt_and_save(host: str, user: str) -> str:
    import getpass
    if not sys.stdin.isatty():
        die("no password; set SMS_ROUTER_PASS or populate ~/.config/sms/config.toml", 2)
    print(f"sms: router http://{host}/ user={user} — password not configured", file=sys.stderr)
    pw = getpass.getpass("Router password: ")
    if not pw:
        die("empty password", 2)
    ans = input("Save to ~/.config/sms/config.toml (chmod 600)? [Y/n] ").strip().lower()
    if ans in ("", "y", "yes"):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(
            f'host = "{host}"\nuser = "{user}"\npassword = "{pw}"\n'
        )
        CONFIG_FILE.chmod(0o600)
        print(f"sms: saved {CONFIG_FILE}", file=sys.stderr)
    return pw


def cache_ttl() -> int:
    raw = os.environ.get("SMS_CACHE_TTL")
    if raw is None:
        return DEFAULT_TTL
    try:
        return max(0, int(raw))
    except ValueError:
        return DEFAULT_TTL


def read_cache() -> list[dict[str, Any]] | None:
    ttl = cache_ttl()
    if ttl == 0 or not INBOX_CACHE.exists():
        return None
    age = time.time() - INBOX_CACHE.stat().st_mtime
    if age > ttl:
        return None
    try:
        return json.loads(INBOX_CACHE.read_text())
    except Exception:
        return None


def write_cache(messages: list[dict[str, Any]]) -> None:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    INBOX_CACHE.write_text(json.dumps(messages, ensure_ascii=False))
    INBOX_CACHE.chmod(0o600)


def clear_cache() -> None:
    INBOX_CACHE.unlink(missing_ok=True)


# ---------- router API ------------------------------------------------------

def _url(cfg: dict[str, str], login: bool = True) -> str:
    from urllib.parse import quote
    if not login:
        return f"http://{cfg['host']}/"
    user = quote(cfg["user"], safe="")
    pw = quote(cfg["password"], safe="")
    return f"http://{user}:{pw}@{cfg['host']}/"


@contextmanager
def open_client(cfg: dict[str, str], login: bool = True, timeout: float = 10) -> Iterator[Any]:
    """Yield a huawei-lte-api Client; logs out on exit when `login`.

    The router is a LAN device, so ignore ambient HTTP(S)/SOCKS proxy env
    (ALL_PROXY etc.) — same fix as mi-router/reyee (trust_env=False).
    """
    import requests
    from huawei_lte_api.Client import Client
    from huawei_lte_api.Connection import Connection

    session = requests.Session()
    session.trust_env = False
    try:
        with Connection(_url(cfg, login), timeout=timeout, requests_session=session) as conn:
            yield Client(conn)
    finally:
        session.close()


def _normalize(raw: Any) -> list[dict[str, Any]]:
    msgs_node = (raw or {}).get("Messages") or {}
    items = msgs_node.get("Message") or []
    if isinstance(items, dict):
        items = [items]
    norm = []
    for m in items:
        norm.append({
            "index": str(m.get("Index", "")),
            "phone": str(m.get("Phone", "")),
            "content": str(m.get("Content", "") or ""),
            "date": str(m.get("Date", "")),
            "smstat": str(m.get("Smstat", "")),
            "unread": str(m.get("Smstat", "")) == "0",
        })
    return norm


def list_page(client: Any, page: int = 1, count: int = 50, ascending: bool = False) -> list[dict[str, Any]]:
    from huawei_lte_api.enums.sms import BoxTypeEnum, SortTypeEnum

    return _normalize(client.sms.get_sms_list(
        page=page,
        box_type=BoxTypeEnum.LOCAL_INBOX,
        read_count=count,
        sort_type=SortTypeEnum.DATE,
        ascending=ascending,
        unread_preferred=False,
    ))


def list_all(client: Any, ascending: bool = False) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    page = 1
    while True:
        batch = list_page(client, page=page, count=PAGE_SIZE, ascending=ascending)
        out.extend(batch)
        if len(batch) < PAGE_SIZE:
            return out
        page += 1


def pick_victims(client: Any, total: int, keep: int, include_unread: bool) -> tuple[int, list[dict[str, Any]]]:
    """(excess, victims): the oldest `total - keep` messages, minus unread
    ones unless `include_unread`. The newest `keep` are never touched."""
    excess = total - keep
    victims: list[dict[str, Any]] = []
    seen = 0
    page = 1
    while seen < excess:
        batch = list_page(client, page=page, count=PAGE_SIZE, ascending=True)
        if not batch:
            break
        for m in batch[: excess - seen]:
            if include_unread or not m["unread"]:
                victims.append(m)
        seen += min(len(batch), excess - seen)
        page += 1
    return max(excess, 0), victims


def delete_messages(client: Any, cfg: dict[str, str], victims: list[dict[str, Any]], archive: bool) -> None:
    """Delete victims; when `archive`, they are written to the archive FIRST,
    so a failed archive write aborts before anything is lost."""
    if archive:
        with archive_open() as db:
            archive_upsert(db, victims, cfg["host"])
    for m in victims:
        client.sms.delete_sms(int(m["index"]))
    clear_cache()


def fetch_inbox(cfg: dict[str, str], count: int = 50) -> list[dict[str, Any]]:
    try:
        with open_client(cfg) as client:
            return list_page(client, count=count)
    except Exception as e:
        die(f"router error: {e}")
        return []


def sms_count(cfg: dict[str, str]) -> dict[str, int]:
    """Inbox counters. Many firmwares (incl. B525s) serve this without login,
    which lets `watch` poll without holding or churning an admin session.

    Polled with ONE plain GET + `Connection: close` rather than a library
    Connection: that one first GETs `/` for CSRF tokens and then reuses the
    keep-alive socket, which the router's httpd sometimes has already closed
    → sporadic RemoteDisconnected (~1 in 60 polls on the B525s; raw: 0/60).
    """
    import xml.etree.ElementTree as ET

    import requests

    with requests.Session() as s:
        s.trust_env = False  # LAN device — ignore ambient proxy env
        r = s.get(f"http://{cfg['host']}/api/sms/sms-count",
                  headers={"Connection": "close"}, timeout=10)
        r.raise_for_status()
    root = ET.fromstring(r.content)
    if root.tag == "error":  # e.g. 100003 login required on stricter firmware
        with open_client(cfg) as client:
            raw = client.sms.sms_count()
    else:
        raw = {el.tag: (el.text or "").strip() for el in root}
    return {k: int(v) for k, v in (raw or {}).items() if str(v).lstrip("-").isdigit()}


# ---------- archive (SQLite) ------------------------------------------------

ARCHIVE_SCHEMA = """
CREATE TABLE IF NOT EXISTS sms (
    key          TEXT PRIMARY KEY,   -- msg_key(): sha1(index|phone|date)
    router_index INTEGER,
    phone        TEXT NOT NULL,
    date         TEXT NOT NULL,      -- router local time, 'YYYY-MM-DD HH:MM:SS'
    content      TEXT NOT NULL,
    unread       INTEGER NOT NULL,   -- read state on the router when last archived
    host         TEXT NOT NULL,
    archived_at  TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS sms_date ON sms(date);
"""


@contextmanager
def archive_open() -> Iterator[sqlite3.Connection]:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(ARCHIVE_DB)
    try:
        db.executescript(ARCHIVE_SCHEMA)
        with db:  # one transaction
            yield db
    finally:
        db.close()
    ARCHIVE_DB.chmod(0o600)


def archive_upsert(db: sqlite3.Connection, msgs: list[dict[str, Any]], host: str) -> int:
    """Insert unseen messages (refresh read state of known ones). Returns # new."""
    now = time.strftime("%Y-%m-%d %H:%M:%S")
    new = 0
    for m in msgs:
        cur = db.execute(
            "INSERT OR IGNORE INTO sms VALUES (?,?,?,?,?,?,?,?)",
            (msg_key(m), int(m["index"] or 0), m["phone"], m["date"], m["content"],
             int(m["unread"]), host, now),
        )
        if cur.rowcount:
            new += 1
        else:
            db.execute("UPDATE sms SET unread=? WHERE key=?", (int(m["unread"]), msg_key(m)))
    return new


def archive_rows(where: str = "", params: tuple[Any, ...] = (), newest_first: bool = False) -> list[dict[str, Any]]:
    if not ARCHIVE_DB.exists():
        return []
    db = sqlite3.connect(ARCHIVE_DB)
    db.row_factory = sqlite3.Row
    order = "DESC" if newest_first else "ASC"
    try:
        sql = f"SELECT * FROM sms {'WHERE ' + where if where else ''} ORDER BY date {order}, router_index {order}"
        return [dict(r) for r in db.execute(sql, params)]
    finally:
        db.close()


def get_messages(cfg: dict[str, str], use_cache: bool = True, count: int = 50) -> list[dict[str, Any]]:
    if use_cache:
        cached = read_cache()
        if cached is not None:
            return cached
    msgs = fetch_inbox(cfg, count=count)
    write_cache(msgs)
    return msgs


# ---------- helpers ---------------------------------------------------------

def extract_code(content: str) -> str | None:
    for m in CODE_RE.finditer(content):
        digits = m.group(1)
        if 4 <= len(digits) <= 8:
            return digits
    return None


def pick_code(messages: list[dict[str, Any]]) -> tuple[dict[str, Any], str] | None:
    for m in messages:
        if CODE_KEYWORDS.search(m["content"]):
            code = extract_code(m["content"])
            if code:
                return m, code
    for m in messages:
        code = extract_code(m["content"])
        if code:
            return m, code
    return None


def clipboard_copy(text: str) -> bool:
    x_path = shutil.which("x") or str(Path.home() / "bin" / "x")
    if Path(x_path).exists():
        try:
            subprocess.run([x_path, "copy"], input=text, text=True, check=True)
            return True
        except subprocess.CalledProcessError:
            return False
    for tool, args in (
        ("pbcopy", []),
        ("wl-copy", []),
        ("xclip", ["-selection", "clipboard"]),
        ("xsel", ["--clipboard", "--input"]),
    ):
        if shutil.which(tool):
            try:
                subprocess.run([tool, *args], input=text, text=True, check=True)
                return True
            except subprocess.CalledProcessError:
                continue
    return False


def render_table(msgs: list[dict[str, Any]]) -> None:
    from rich.console import Console
    from rich.table import Table

    table = Table(show_lines=False, expand=True)
    table.add_column("#", style="dim", no_wrap=True)
    table.add_column("R", no_wrap=True)
    table.add_column("From", no_wrap=True)
    table.add_column("Date", no_wrap=True)
    table.add_column("Content", overflow="fold")
    for m in msgs:
        flag = "●" if m["unread"] else " "
        content = m["content"].replace("\n", " ")
        table.add_row(m["index"], flag, m["phone"], m["date"], content)
    Console().print(table)


# ---------- commands (tyro dataclasses) -------------------------------------

@dataclass
class ListCmd:
    """List SMS inbox."""
    limit: int = 0
    """Max messages to show (0 = all)."""
    unread: bool = False
    """Only show unread messages."""
    json: bool = False
    """Output as JSON."""
    no_cache: bool = False
    """Bypass inbox cache."""

    def run(self) -> int:
        cfg = load_config()
        msgs = get_messages(cfg, use_cache=not self.no_cache)
        if self.unread:
            msgs = [m for m in msgs if m["unread"]]
        if self.limit:
            msgs = msgs[: self.limit]
        if self.json:
            json_dump(msgs)
            return 0
        render_table(msgs)
        return 0


@dataclass
class LatestCmd:
    """Show N most recent messages."""
    n: tyro.conf.Positional[int] = 5
    no_cache: bool = False

    def run(self) -> int:
        return ListCmd(limit=self.n, no_cache=self.no_cache).run()


@dataclass
class ShowCmd:
    """Show a single message by index."""
    index: tyro.conf.Positional[str]
    json: bool = False
    no_cache: bool = False

    def run(self) -> int:
        cfg = load_config()
        msgs = get_messages(cfg, use_cache=not self.no_cache)
        for m in msgs:
            if m["index"] == self.index:
                if self.json:
                    json_dump(m)
                else:
                    print(f"From:  {m['phone']}")
                    print(f"Date:  {m['date']}")
                    print(f"State: {'unread' if m['unread'] else 'read'}")
                    print()
                    print(m["content"])
                return 0
        die(f"no message with index {self.index}")
        return 1


@dataclass
class CodeCmd:
    """Print and copy the latest verification code."""
    copy: bool = True
    """Copy the code to the clipboard via `x copy` when available."""
    no_cache: bool = False

    def run(self) -> int:
        cfg = load_config()
        msgs = get_messages(cfg, use_cache=not self.no_cache)
        pick = pick_code(msgs)
        if not pick:
            die("no verification code found in recent SMS", 3)
        msg, code = pick
        print(code)
        prefix = "copied — " if self.copy and clipboard_copy(code) else ""
        print(f"({prefix}from {msg['phone']} at {msg['date']})", file=sys.stderr)
        return 0


@dataclass
class DeleteCmd:
    """Delete an SMS by index."""
    index: tyro.conf.Positional[str]

    def run(self) -> int:
        cfg = load_config()
        try:
            with open_client(cfg) as client:
                client.sms.delete_sms(int(self.index))
        except Exception as e:
            die(f"router error: {e}")
        clear_cache()
        print(f"deleted {self.index}")
        return 0


@dataclass
class RefreshCmd:
    """Bust the cache and refetch the inbox."""

    def run(self) -> int:
        clear_cache()
        cfg = load_config()
        msgs = get_messages(cfg, use_cache=False)
        print(f"cached {len(msgs)} messages")
        return 0


@dataclass
class LoginTestCmd:
    """Verify credentials by querying device info."""

    def run(self) -> int:
        cfg = load_config()
        try:
            with open_client(cfg) as client:
                info = client.device.information()
        except Exception as e:
            die(f"login failed: {e}")
        print(f"ok host={cfg['host']} user={cfg['user']}")
        for k in ("DeviceName", "HardwareVersion", "SoftwareVersion", "Imei", "Msisdn"):
            if info.get(k):
                print(f"  {k}: {info[k]}")
        return 0


@dataclass
class CountCmd:
    """Show inbox counters (total / max / unread)."""
    json: bool = False

    def run(self) -> int:
        cfg = load_config()
        try:
            c = sms_count(cfg)
        except Exception as e:
            die(f"router error: {e}")
        if self.json:
            json_dump(c)
            return 0
        inbox, cap = c.get("LocalInbox", 0), c.get("LocalMax", 0)
        pct = f" ({inbox / cap:.0%})" if cap else ""
        print(f"inbox  {inbox}/{cap}{pct}")
        print(f"unread {c.get('LocalUnread', 0)}")
        if c.get("SimInbox") or c.get("SimMax"):
            print(f"sim    {c.get('SimInbox', 0)}/{c.get('SimMax', 0)}")
        return 0


@dataclass
class PruneCmd:
    """Delete the oldest messages, keeping the newest N."""
    keep: int = 100
    """Number of newest messages to keep."""
    include_unread: bool = False
    """Also delete unread messages (default: only read ones are eligible)."""
    yes: bool = False
    """Skip the confirmation prompt."""
    no_archive: bool = False
    """Don't save victims to the local archive before deleting (lossy)."""

    def run(self) -> int:
        cfg = load_config()
        try:
            total = sms_count(cfg).get("LocalInbox", 0)
            if total <= self.keep:
                print(f"inbox has {total} ≤ {self.keep}; nothing to prune")
                return 0
            with open_client(cfg) as client:
                excess, victims = pick_victims(client, total, self.keep, self.include_unread)
                if not victims:
                    print(f"{excess} oldest messages are all unread; use --include-unread")
                    return 0
                print(f"will delete {len(victims)} message(s), "
                      f"{victims[0]['date']} … {victims[-1]['date']}", file=sys.stderr)
                if not self.yes:
                    if not sys.stdin.isatty():
                        die("refusing to prune without --yes on a non-TTY", 2)
                    if input("Proceed? [y/N] ").strip().lower() not in ("y", "yes"):
                        return 1
                delete_messages(client, cfg, victims, archive=not self.no_archive)
        except Exception as e:
            die(f"router error: {e}")
        where = "" if self.no_archive else f" (archived to {ARCHIVE_DB})"
        print(f"deleted {len(victims)}{where}")
        return 0


@dataclass
class ArchiveCmd:
    """Copy every inbox message into the local SQLite archive (idempotent)."""

    def run(self) -> int:
        cfg = load_config()
        try:
            with open_client(cfg) as client:
                msgs = list_all(client)
        except Exception as e:
            die(f"router error: {e}")
        with archive_open() as db:
            new = archive_upsert(db, msgs, cfg["host"])
            total = db.execute("SELECT COUNT(*) FROM sms").fetchone()[0]
        print(f"archived {new} new of {len(msgs)} on router; archive holds {total} → {ARCHIVE_DB}")
        return 0


def _router_dt(date: str) -> Any:
    """Router dates are naive local time; assume this machine's timezone."""
    from datetime import datetime
    try:
        return datetime.strptime(date, "%Y-%m-%d %H:%M:%S").astimezone()
    except ValueError:
        return None


def export_sbr(rows: list[dict[str, Any]]) -> str:
    """'SMS Backup & Restore' (SyncTech) XML — importable into Android's SMS
    store by that app, viewable in its web viewer, widely converted."""
    from xml.sax.saxutils import quoteattr as q

    out = ["<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>",
           f'<smses count="{len(rows)}">']
    for r in rows:
        dt = _router_dt(r["date"])
        ms = int(dt.timestamp() * 1000) if dt else 0
        readable = dt.strftime("%b %d, %Y %I:%M:%S %p") if dt else r["date"]
        out.append(
            f'  <sms protocol="0" address={q(r["phone"])} date="{ms}" type="1" subject="null" '
            f'body={q(r["content"], {chr(10): "&#10;", chr(13): "&#13;"})} toa="null" sc_toa="null" '
            f'service_center="null" read="{0 if r["unread"] else 1}" status="-1" locked="0" '
            f'date_sent="0" readable_date={q(readable)} contact_name="(Unknown)" />'
        )
    out.append("</smses>")
    return "\n".join(out) + "\n"


def export_mbox(rows: list[dict[str, Any]], path: Path) -> None:
    """One SMS = one RFC 5322 message, so any mail client / notmuch can read it."""
    import mailbox
    from email.message import EmailMessage
    from email.utils import format_datetime

    tmp = path.with_name(path.name + ".tmp")
    tmp.unlink(missing_ok=True)
    box = mailbox.mbox(tmp)
    try:
        for r in rows:
            local = re.sub(r"[^0-9A-Za-z+._-]", "_", r["phone"]) or "unknown"
            msg = EmailMessage()
            msg["From"] = f'"{r["phone"]}" <{local}@sms.invalid>'
            msg["To"] = f"<sms@{r['host']}.invalid>"
            first = r["content"].replace("\n", " ").strip()
            msg["Subject"] = (first[:70] + "…") if len(first) > 70 else (first or "(empty)")
            dt = _router_dt(r["date"])
            if dt:
                msg["Date"] = format_datetime(dt)
            msg["Message-ID"] = f"<{r['key']}@sms.invalid>"
            msg["X-SMS-Unread"] = str(r["unread"])
            msg.set_content(r["content"])
            box.add(mailbox.mboxMessage(msg))
        box.flush()
    finally:
        box.close()
    tmp.replace(path)


@dataclass
class ExportCmd:
    """Export the local archive as SMS Backup & Restore XML, mbox, or JSONL."""
    format: Literal["sbr", "mbox", "jsonl"] = "sbr"
    """sbr = Android 'SMS Backup & Restore' XML; mbox = mail clients; jsonl = scripts."""
    output: Annotated[str, tyro.conf.arg(aliases=["-o"])] = "-"
    """Output file ('-' = stdout; mbox needs a real file)."""
    refresh: bool = False
    """Run `sms archive` first so the export includes the router's current inbox."""

    def run(self) -> int:
        if self.refresh:
            ArchiveCmd().run()
        rows = archive_rows()
        if not rows:
            die(f"archive is empty ({ARCHIVE_DB}); run `sms archive` first", 3)
        if self.format == "mbox":
            if self.output == "-":
                die("mbox needs a file: sms export --format mbox -o sms.mbox", 2)
            export_mbox(rows, Path(self.output))
        else:
            text = (export_sbr(rows) if self.format == "sbr"
                    else "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rows))
            if self.output == "-":
                sys.stdout.write(text)
                return 0
            Path(self.output).write_text(text, encoding="utf-8")
        print(f"exported {len(rows)} message(s) → {self.output}", file=sys.stderr)
        return 0


# ---------- watch: seen-state + apprise push ---------------------------------

def msg_key(m: dict[str, Any]) -> str:
    # Index alone is reused by the router after deletions.
    return hashlib.sha1(f"{m['index']}|{m['phone']}|{m['date']}".encode()).hexdigest()[:16]


def load_seen() -> dict[str, Any] | None:
    if not SEEN_FILE.exists():
        return None
    try:
        return json.loads(SEEN_FILE.read_text())
    except Exception:
        return None


def save_seen(state: dict[str, Any]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    state["keys"] = state["keys"][-SEEN_CAP:]
    tmp = SEEN_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state))
    tmp.replace(SEEN_FILE)


def notify_targets(watch_cfg: dict[str, Any]) -> tuple[list[str], str | None]:
    """(apprise URLs, apprise tag). URLs win over tag."""
    env = os.environ.get("SMS_NOTIFY_URLS", "").split()
    urls = env or [str(u) for u in watch_cfg.get("notify_urls") or []]
    tag = None if urls else (watch_cfg.get("notify_tag") or None)
    return urls, tag


def notify(title: str, body: str, urls: list[str], tag: str | None) -> bool:
    apprise = shutil.which("apprise") or str(Path.home() / ".local" / "bin" / "apprise")
    ok = False
    if Path(apprise).exists():
        cmd = [apprise, "-t", title, "-b", body]
        env = dict(os.environ)
        if urls:
            # Pass URLs via env, not argv, so tokens don't show up in `ps`.
            env["APPRISE_URLS"] = " ".join(urls)
        elif tag:
            cmd += ["--tag", tag]
        try:
            r = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=60)
            ok = r.returncode == 0
            if not ok:
                log(f"apprise exit {r.returncode}: {(r.stderr or r.stdout).strip()[:300]}")
        except Exception as e:
            log(f"apprise failed: {e}")
    else:
        log("apprise not found on PATH")
    if not ok:
        # Never let a failed push vanish silently.
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            with NOTIFY_LOG.open("a") as f:
                flat = body.replace("\n", " ")
                f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')}\t{title}\t{flat}\n")
        except Exception:
            pass
    return ok


def format_push(m: dict[str, Any]) -> tuple[str, str]:
    code = extract_code(m["content"]) if CODE_KEYWORDS.search(m["content"]) else None
    body = f"[code {code}] {m['content']}" if code else m["content"]
    return f"SMS from {m['phone']}", f"{body}\n— {m['date']}"


@dataclass
class WatchCmd:
    """Poll the router and push each new SMS via apprise (Ctrl+C to stop)."""
    interval: float = 0
    """Seconds between counter polls (0 = config `interval` or 10)."""
    full_sync: float = 0
    """Force an inbox diff at least this often, in seconds (0 = config or 300)."""
    once: bool = False
    """Run a single poll + diff and exit."""
    json: bool = False
    """Print new messages to stdout as JSON lines."""
    no_notify: bool = False
    """Don't push; only print new messages to stdout."""
    mark_read: bool = False
    """Mark pushed messages as read on the router (or config `mark_read`)."""
    notify_existing_unread: bool = False
    """On the first run (no state yet), push current unread messages instead of silently seeding."""

    def run(self) -> int:
        cfg = load_config()
        wcfg = read_config_file().get("watch") or {}
        interval = self.interval or float(wcfg.get("interval", DEFAULT_INTERVAL))
        full_sync = self.full_sync or float(wcfg.get("full_sync", DEFAULT_FULL_SYNC))
        cap_warn = float(wcfg.get("capacity_warn", DEFAULT_CAPACITY_WARN))
        mark_read = self.mark_read or bool(wcfg.get("mark_read", False))
        self._archive = bool(wcfg.get("archive", False))
        self._prune_keep = int(wcfg.get("auto_prune_keep", 0))
        self._prune_unread = bool(wcfg.get("auto_prune_include_unread", False))
        self._backfilled = self._prune_warned = False
        if self._prune_keep and not self._archive:
            die("[watch] auto_prune_keep needs archive = true (pruning must be lossless)", 2)
        if 0 < self._prune_keep < PAGE_SIZE:
            die(f"[watch] auto_prune_keep must be ≥ {PAGE_SIZE} (the diff window)", 2)
        urls, tag = notify_targets(wcfg)
        if not self.no_notify and not urls and not tag:
            die("no notify target: set SMS_NOTIFY_URLS, or [watch] notify_urls / "
                "notify_tag in ~/.config/sms/config.toml (or pass --no-notify)", 2)

        def _term(*_: Any) -> None:
            # SIGTERM can arrive twice (process-group kill + uv forwarding it,
            # e.g. under systemd); ignore repeats so shutdown stays quiet.
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
            raise KeyboardInterrupt
        signal.signal(signal.SIGTERM, _term)

        target = "stdout only" if self.no_notify else (f"tag={tag}" if tag else f"{len(urls)} apprise URL(s)")
        extras = (" + archive" if self._archive else "") + (
            f" + auto-prune >{self._prune_keep}" if self._prune_keep else "")
        log(f"watching {cfg['host']} every {interval:g}s ({target}{extras})")

        last_sig: tuple[int, int] | None = None
        last_full = 0.0
        cap_alerted = False
        failures = 0
        while True:
            try:
                c = sms_count(cfg)
                inbox, cap = c.get("LocalInbox", 0), c.get("LocalMax", 0)
                if cap and inbox >= cap * cap_warn:
                    if not cap_alerted:
                        cap_alerted = True
                        log(f"inbox nearly full: {inbox}/{cap}")
                        if not self.no_notify:
                            notify("SMS inbox nearly full",
                                   f"{inbox}/{cap} on {cfg['host']} — new SMS will be dropped "
                                   f"when full. Run `sms prune`.", urls, tag)
                else:
                    cap_alerted = False

                sig = (inbox, c.get("LocalUnread", 0))
                now = time.monotonic()
                if sig != last_sig or now - last_full >= full_sync:
                    self._sync(cfg, urls, tag, mark_read, inbox)
                    last_sig, last_full = sig, now
                if failures > 1:
                    log(f"router reachable again after {failures} failed attempt(s)")
                failures = 0
            except Exception as e:
                failures += 1
                if failures == 1:
                    # The router's tiny httpd drops a connection now and then;
                    # one quick, silent retry absorbs it.
                    time.sleep(2)
                    continue
                if self.once:
                    die(f"router error: {e}")
                backoff = min(interval * 2 ** (failures - 1), MAX_BACKOFF)
                log(f"router error: {type(e).__name__}: {e} — retry in {backoff:g}s")
                time.sleep(backoff)
                continue
            if self.once:
                return 0
            time.sleep(interval)

    def _sync(self, cfg: dict[str, str], urls: list[str], tag: str | None, mark_read: bool,
              inbox: int) -> None:
        with open_client(cfg) as client:
            msgs = list_page(client)
            if self._archive:
                # First sync archives the whole inbox; later ones the newest page.
                batch = msgs if self._backfilled else list_all(client)
                with archive_open() as db:
                    n = archive_upsert(db, batch, cfg["host"])
                if not self._backfilled and n:
                    log(f"archived {n} message(s) → {ARCHIVE_DB}")
                self._backfilled = True
            state = load_seen()
            first = state is None
            if first:
                # Watermark = newest date at seed time. A never-seen message
                # older than this (e.g. an old one sliding back into the
                # 50-message window after deletions) is not "new".
                state = {"since": max((m["date"] for m in msgs), default=""), "keys": []}
            seen = set(state["keys"])
            fresh = [m for m in msgs if msg_key(m) not in seen]
            if first:
                new = [m for m in fresh if m["unread"]] if self.notify_existing_unread else []
                log(f"seeded state with {len(fresh)} message(s)")
            else:
                new = [m for m in fresh if not m["date"] or m["date"] >= state["since"]]

            for m in reversed(new):  # oldest first
                if self.json:
                    json_dump(m)
                else:
                    print(f"{m['date']}  {m['phone']}  {m['content']}".replace("\n", " "), flush=True)
                if not self.no_notify:
                    title, body = format_push(m)
                    notify(title, body, urls, tag)
                if mark_read and m["unread"]:
                    client.sms.set_read(int(m["index"]))
            sys.stdout.flush()

            state["keys"].extend(msg_key(m) for m in fresh)
            save_seen(state)

            if self._prune_keep and inbox > self._prune_keep:
                excess, victims = pick_victims(client, inbox, self._prune_keep, self._prune_unread)
                if victims:
                    delete_messages(client, cfg, victims, archive=True)
                    log(f"auto-pruned {len(victims)} oldest message(s) (archived first)")
                elif not self._prune_warned:
                    self._prune_warned = True
                    log(f"auto-prune: {excess} oldest message(s) are unread; "
                        f"set [watch] auto_prune_include_unread = true to prune them")
        if new:
            clear_cache()  # so `sms` / `tv sms` see it immediately


@dataclass
class NotifyTestCmd:
    """Send one test push through the same apprise targets `watch` uses."""
    latest: bool = False
    """Push the newest real SMS (formatted like `watch`) instead of a canned message."""
    dry_run: bool = False
    """Only show which services apprise would notify; send nothing."""

    def run(self) -> int:
        urls, tag = notify_targets(read_config_file().get("watch") or {})
        if not urls and not tag:
            die("no notify target: set SMS_NOTIFY_URLS, or [watch] notify_urls / "
                "notify_tag in ~/.config/sms/config.toml", 2)
        if self.dry_run:
            env = dict(os.environ)
            cmd = ["apprise", "--dry-run", "-b", "x"]
            if urls:
                env["APPRISE_URLS"] = " ".join(urls)
            else:
                cmd += ["--tag", str(tag)]
            return subprocess.run(cmd, env=env).returncode
        if self.latest:
            msgs = get_messages(load_config())
            if not msgs:
                die("inbox is empty", 3)
            title, body = format_push(msgs[0])
        else:
            import socket
            title = "sms notify-test"
            body = f"[code 123456] Test push from `sms` on {socket.gethostname()}\n— {time.strftime('%Y-%m-%d %H:%M:%S')}"
        if notify(title, body, urls, tag):
            print("sent")
            return 0
        print(f"failed — see {NOTIFY_LOG}", file=sys.stderr)
        return 1


# ---------- systemd user service (Linux) -------------------------------------

UNIT_TEMPLATE = """\
[Unit]
Description=Push new Huawei router SMS via apprise (sms watch)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart={exe} watch
Restart=always
RestartSec=30
Environment=PATH={path}
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
"""


@dataclass
class ServiceCmd:
    """Manage the `sms watch` systemd --user service (Linux only)."""
    action: tyro.conf.Positional[Literal["install", "uninstall", "status"]]

    def run(self) -> int:
        if not sys.platform.startswith("linux") or not shutil.which("systemctl"):
            die("service management needs Linux + systemd; run `sms watch` "
                "under tmux/pueue/launchd instead", 2)
        sc = ["systemctl", "--user"]
        if self.action == "status":
            return subprocess.run([*sc, "status", UNIT_NAME, "--no-pager"]).returncode
        if self.action == "uninstall":
            subprocess.run([*sc, "disable", "--now", UNIT_NAME])
            UNIT_FILE.unlink(missing_ok=True)
            subprocess.run([*sc, "daemon-reload"], check=True)
            print(f"removed {UNIT_FILE}")
            return 0

        # install: validate config up front so the unit doesn't crash-loop.
        load_config()
        urls, tag = notify_targets(read_config_file().get("watch") or {})
        if not urls and not tag:
            die("configure [watch] notify_urls or notify_tag in ~/.config/sms/config.toml first "
                "(SMS_NOTIFY_URLS from your shell is not visible to systemd)", 2)
        exe = Path(sys.argv[0]).resolve()
        UNIT_FILE.parent.mkdir(parents=True, exist_ok=True)
        UNIT_FILE.write_text(UNIT_TEMPLATE.format(exe=exe, path=os.environ.get("PATH", "")))
        subprocess.run([*sc, "daemon-reload"], check=True)
        subprocess.run([*sc, "enable", "--now", UNIT_NAME], check=True)
        print(f"installed {UNIT_FILE}; logs: journalctl --user -u {UNIT_NAME} -f")
        user = os.environ.get("USER", "")
        r = subprocess.run(["loginctl", "show-user", user, "-p", "Linger", "--value"],
                           capture_output=True, text=True)
        if r.stdout.strip() != "yes":
            print(f"note: lingering is off — the service stops when you log out. "
                  f"Run: sudo loginctl enable-linger {user}", file=sys.stderr)
        return 0


def json_dump(obj: Any) -> None:
    json.dump(obj, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


# ---------- entrypoint ------------------------------------------------------

@dataclass
class SearchCmd:
    """Search the local archive (newest first). Words are AND-ed substring matches."""
    query: tyro.conf.Positional[list[str]]
    phone: str = ""
    """Only messages whose sender contains this."""
    since: str = ""
    """Only messages on/after this date prefix, e.g. 2026-10 or 2026-10-12."""
    codes: bool = False
    """Only messages that look like verification codes."""
    limit: int = 20
    """Max results (0 = all)."""
    json: bool = False
    """Output JSON lines (one archived row per line)."""
    key: str = ""
    """Show the message(s) whose archive key starts with this (full detail)."""

    def run(self) -> int:
        if not ARCHIVE_DB.exists():
            die(f"archive is empty ({ARCHIVE_DB}); run `sms archive` first", 3)
        clauses: list[str] = []
        params: list[Any] = []
        for word in self.query:
            clauses.append("(content LIKE ? OR phone LIKE ?)")
            params += [f"%{word}%", f"%{word}%"]
        if self.phone:
            clauses.append("phone LIKE ?")
            params.append(f"%{self.phone}%")
        if self.since:
            clauses.append("date >= ?")
            params.append(self.since)
        if self.key:
            clauses.append("key LIKE ?")
            params.append(f"{self.key}%")
        rows = archive_rows(" AND ".join(clauses), tuple(params), newest_first=True)
        if self.codes:
            rows = [r for r in rows if CODE_KEYWORDS.search(r["content"]) and extract_code(r["content"])]
        if self.limit:
            rows = rows[: self.limit]

        if self.json:
            for r in rows:
                json_dump(r)
            return 0
        if not rows:
            print("no matches", file=sys.stderr)
            return 1
        if self.key and len(rows) == 1:
            r = rows[0]
            code = extract_code(r["content"]) if CODE_KEYWORDS.search(r["content"]) else None
            print(f"From:  {r['phone']}")
            print(f"Date:  {r['date']}")
            print(f"State: {'unread' if r['unread'] else 'read'} (on router when archived)")
            if code:
                print(f"Code:  {code}")
            print(f"Key:   {r['key']}")
            print()
            print(r["content"])
            return 0

        from rich.console import Console
        from rich.table import Table

        table = Table(show_lines=False, expand=True)
        table.add_column("Key", style="dim", no_wrap=True)
        table.add_column("Date", no_wrap=True)
        table.add_column("From", no_wrap=True)
        table.add_column("Content", overflow="fold")
        for r in rows:
            table.add_row(r["key"][:8], r["date"], r["phone"], r["content"].replace("\n", " "))
        Console().print(table)
        return 0


Command = Union[
    Annotated[ListCmd, tyro.conf.subcommand("list")],
    Annotated[LatestCmd, tyro.conf.subcommand("latest")],
    Annotated[ShowCmd, tyro.conf.subcommand("show")],
    Annotated[CodeCmd, tyro.conf.subcommand("code")],
    Annotated[DeleteCmd, tyro.conf.subcommand("delete")],
    Annotated[RefreshCmd, tyro.conf.subcommand("refresh")],
    Annotated[LoginTestCmd, tyro.conf.subcommand("login-test")],
    Annotated[CountCmd, tyro.conf.subcommand("count")],
    Annotated[PruneCmd, tyro.conf.subcommand("prune")],
    Annotated[ArchiveCmd, tyro.conf.subcommand("archive")],
    Annotated[ExportCmd, tyro.conf.subcommand("export")],
    Annotated[SearchCmd, tyro.conf.subcommand("search")],
    Annotated[WatchCmd, tyro.conf.subcommand("watch")],
    Annotated[NotifyTestCmd, tyro.conf.subcommand("notify-test")],
    Annotated[ServiceCmd, tyro.conf.subcommand("service")],
]


def main() -> int:
    # Default action when no subcommand given: `code`.
    if len(sys.argv) == 1:
        sys.argv.append("code")
    cmd = tyro.cli(Command, prog="sms", description="Huawei router SMS reader.")
    return cmd.run()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
