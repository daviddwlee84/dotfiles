#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro>=0.9"]
# ///
"""agent-warmup — start the Claude Pro/Max 5-hour subscription window on a schedule.

Why interactive (and not ``claude -p``):
  Since the 2026-06-15 Anthropic billing split, only *interactive* Claude Code
  usage advances the rolling 5-hour subscription window. Headless ``claude -p``
  (and the Agent SDK) draw from a separate metered credit pool and do NOT move
  the window. So to "warm up" the window we must drive a real interactive
  ``claude`` TUI: this tool launches one in an isolated Herdr workspace
  (preferred) or a detached tmux session, sends a tiny prompt + Enter, then
  tears it down. See pitfalls/headless-claude-p-does-not-move-5h-window.md.

  Whether a multiplexer-driven interactive session still counts as interactive to
  Anthropic is unverified — run ``agent-warmup verify`` near a reset boundary and
  eyeball the captured /usage panel before trusting the recurring install.

Subcommands:
  run        Spawn interactive claude, send the warmup prompt, log the result.
  at         Queue a one-shot ``run`` via pueue (--at / --delay).
  install    Generate + load a recurring timer (macOS launchd / Linux systemd).
  uninstall  Unload + remove the recurring timer.
  status     Show pending one-shots, the installed timer, and recent run logs.
  cancel     Remove pending pueue one-shots.
  verify     run --verify --keep — the empirical experiment helper.

Run flags (shared by run / at / install):
  --model M     Claude model (default: $AICAP_CLAUDE_MODEL or "haiku" — keeps
                window-token consumption tiny).
  --prompt P    Warmup prompt (default: a one-line "reply hi").
  --timeout S   Seconds to wait for a reply before giving up (default 120).
  --verify      After the reply, send /usage and capture the panel into the log.
  --keep        Do not close the created workspace/session (for inspection).
  --backend B   auto (prefer Herdr), herdr, or tmux.
  --herdr-session NAME  Select a running named Herdr session.

Env:
  AICAP_CLAUDE_MODEL    default model (mirrors dot_config/shell/04_ai_agents.sh)

Cache / logs: $XDG_CACHE_HOME/agent-warmup/ (run-*.log, launchd/systemd output).
"""
from __future__ import annotations

import base64
import getpass
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
from dataclasses import asdict, dataclass
from datetime import datetime
from pathlib import Path
from typing import Literal

GROUP = "agent-warmup"
LABEL_PREFIX = "agent-warmup:"
LAUNCHD_LABEL = f"com.{getpass.getuser()}.agent-warmup"
SYSTEMD_UNIT = "agent-warmup"
DEFAULT_PROMPT = "Reply with just: hi"
DEFAULT_TIMEOUT = 120
READY_TIMEOUT = 45
STABLE_SECS = 4.0
BOOTSTRAP_SENTINEL_TIMEOUT = 30
SCHEDULE_SCHEMA = 1
Backend = Literal["auto", "tmux", "herdr"]


@dataclass
class Run:
    """Spawn interactive Claude and send the warmup prompt."""

    model: str | None = None
    prompt: str | None = None
    timeout: int = DEFAULT_TIMEOUT
    verify: bool = False
    keep: bool = False
    backend: Backend = "auto"
    herdr_session: str | None = None


@dataclass
class At:
    """Queue a one-shot run via pueue."""

    at: str | None = None
    delay: str | None = None
    dry_run: bool = False
    model: str | None = None
    prompt: str | None = None
    timeout: int = DEFAULT_TIMEOUT
    verify: bool = False
    backend: Backend = "auto"
    herdr_session: str | None = None


@dataclass
class Install:
    """Install a recurring launchd/systemd timer."""

    daily: str = "weekdays"
    time: str = "06:00"
    model: str | None = None
    prompt: str | None = None
    timeout: int = DEFAULT_TIMEOUT
    verify: bool = False
    backend: Backend = "auto"
    herdr_session: str | None = None


@dataclass
class Uninstall:
    """Remove the recurring timer."""


@dataclass
class Status:
    """Show timer, pending one-shots, and recent runs."""

    json: bool = False


@dataclass
class Cancel:
    """Remove pending pueue one-shots."""


@dataclass
class Verify:
    """Run with --verify --keep for empirical inspection."""

    model: str | None = None
    prompt: str | None = None
    timeout: int = DEFAULT_TIMEOUT
    backend: Backend = "auto"
    herdr_session: str | None = None


Command = (
    Run | At | Install | Uninstall | Status | Cancel | Verify
)

# Mirror scripts/fleet/exec.py:_PATH_PRELUDE so tmux/claude/pueue/launchctl are
# found in the minimal env launchd/systemd hand us (deliberately puts package
# manager dirs ahead of legacy ~/bin). Expanded and merged into PATH at startup.
_PATH_PRELUDE = [
    "~/.dotfiles/bin", "~/.cargo/bin", "~/.local/bin", "~/bin",
    "/opt/homebrew/bin", "/usr/local/bin", "/home/linuxbrew/.linuxbrew/bin",
    "~/.linuxbrew/bin",
]


def _augment_path() -> None:
    extra = [str(Path(p).expanduser()) for p in _PATH_PRELUDE]
    current = os.environ.get("PATH", "").split(os.pathsep)
    merged = extra + [p for p in current if p and p not in extra]
    os.environ["PATH"] = os.pathsep.join(merged)


def cache_dir() -> Path:
    base = os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
    d = Path(base) / "agent-warmup"
    d.mkdir(parents=True, exist_ok=True)
    return d


def isolated_cwd() -> Path:
    d = cache_dir() / "claude"
    d.mkdir(parents=True, exist_ok=True)
    return d


def script_path() -> Path:
    override = os.environ.get("AGENT_WARMUP_SCRIPT")
    if override:
        return Path(override).expanduser()
    return Path(__file__).resolve()


def run(
    cmd: list[str], *, check: bool = False, timeout: float | None = None
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            check=check, timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        # 124 mirrors coreutils `timeout`; callers treat non-zero as failure.
        return subprocess.CompletedProcess(
            cmd, 124, exc.stdout or "", (exc.stderr or "") + "\n[agent-warmup: command timed out]"
        )


def notify(title: str, message: str) -> None:
    """Best-effort desktop notification; always also echo to stderr."""
    print(f"{title}: {message}", file=sys.stderr)
    if sys.platform == "darwin" and shutil.which("osascript"):
        body = message.replace('"', "'")
        head = title.replace('"', "'")
        run(["osascript", "-e", f'display notification "{body}" with title "{head}"'])
    elif shutil.which("notify-send"):
        run(["notify-send", title, message])


# --- tmux helpers -----------------------------------------------------------
# We operate on the user's DEFAULT tmux server (the one their GUI login created),
# NOT a private `-L` socket. Critical finding (2026-06-20): claude's TUI renders
# nothing when its tmux server was created by a background daemon (launchd/pueue)
# — same env, same flags. But a daemon CONNECTING to the already-running
# GUI-session server and spawning claude there renders fine. So the scheduled
# run injects a transient session into the existing server. Every tmux call has
# a timeout so a hung server can't wedge us forever. See the pitfall.

def _tmux(*args: str, timeout: float = 15) -> subprocess.CompletedProcess[str]:
    return run(["tmux", *args], timeout=timeout)


def _server_alive() -> bool:
    return _tmux("list-sessions").returncode == 0


def _session_alive(session: str) -> bool:
    return _tmux("has-session", "-t", session).returncode == 0


def _capture(session: str, lines: int = 200) -> str:
    cp = _tmux("capture-pane", "-p", "-S", f"-{lines}", "-t", session)
    return cp.stdout if cp.returncode == 0 else ""


def _send_text(session: str, text: str) -> None:
    # Clear any pre-filled input, type the text literally, pause, then submit.
    _tmux("send-keys", "-t", session, "C-u")
    _tmux("send-keys", "-t", session, "-l", text)
    time.sleep(0.4)
    _tmux("send-keys", "-t", session, "Enter")


# --- run --------------------------------------------------------------------

_TRUST_MARKERS = ("do you trust", "trust the files", "trust this folder")
_READY_MARKERS = ("for shortcuts", "? for", "› ", "│ >", "welcome to claude")
_AUTH_MARKERS = ("setup-token", "please run /login", "invalid api key", "authentication", "logged out")


def _wait_ready(session: str, deadline: float) -> tuple[bool, str]:
    """Wait for the claude TUI input box; accept a first-run folder-trust prompt."""
    trusted = False
    while time.time() < deadline:
        if not _session_alive(session):
            return False, _capture(session)
        text = _capture(session).lower()
        if not trusted and any(m in text for m in _TRUST_MARKERS):
            _tmux("send-keys", "-t", session, "Enter")
            trusted = True
            time.sleep(1.0)
            continue
        if any(m in text for m in _AUTH_MARKERS):
            return False, _capture(session)
        if any(m in text for m in _READY_MARKERS):
            return True, _capture(session)
        time.sleep(1.0)
    # Fall back to "probably ready" if the session is still alive after settling.
    return _session_alive(session), _capture(session)


def _wait_response(session: str, deadline: float) -> str:
    """Wait until the pane output stabilises (reply finished) or timeout."""
    last = ""
    last_change = time.time()
    while time.time() < deadline:
        if not _session_alive(session):
            break
        text = _capture(session)
        if text != last:
            last, last_change = text, time.time()
        elif time.time() - last_change >= STABLE_SECS:
            break
        time.sleep(1.0)
    return last


def _json_result(cp: subprocess.CompletedProcess[str]) -> dict[str, object]:
    if cp.returncode != 0:
        return {}
    try:
        data = json.loads(cp.stdout)
    except json.JSONDecodeError:
        return {}
    if isinstance(data, dict) and isinstance(data.get("result"), dict):
        return data["result"]
    return data if isinstance(data, dict) else {}


def _agent_info(cp: subprocess.CompletedProcess[str]) -> dict[str, object]:
    result = _json_result(cp)
    agent = result.get("agent")
    return agent if isinstance(agent, dict) else result


def _herdr(session: str, *args: str, timeout: float = 15) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    env["HERDR_SESSION"] = session
    try:
        return subprocess.run(
            ["herdr", *args], text=True, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, env=env, timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        return subprocess.CompletedProcess(
            ["herdr", *args], 124, exc.stdout or "",
            (exc.stderr or "") + "\n[agent-warmup: herdr timed out]",
        )


def _running_herdr_sessions() -> list[dict[str, object]]:
    if not shutil.which("herdr"):
        return []
    result = _json_result(run(["herdr", "session", "list", "--json"], timeout=10))
    sessions = result.get("sessions", [])
    return [s for s in sessions if isinstance(s, dict) and s.get("running")]


def _resolve_herdr_session(explicit: str | None) -> str:
    sessions = _running_herdr_sessions()
    if explicit:
        if any(s.get("name") == explicit for s in sessions):
            return explicit
        raise RuntimeError(f"Herdr session {explicit!r} is not running")
    ambient = os.environ.get("HERDR_SESSION")
    if ambient and any(s.get("name") == ambient for s in sessions):
        return ambient
    ambient_socket = os.environ.get("HERDR_SOCKET_PATH")
    socket_matches = [str(s.get("name")) for s in sessions if s.get("socket_path") == ambient_socket]
    if len(socket_matches) == 1:
        return socket_matches[0]
    defaults = [str(s.get("name")) for s in sessions if s.get("default")]
    if len(defaults) == 1:
        return defaults[0]
    if len(sessions) == 1:
        return str(sessions[0].get("name"))
    if not sessions:
        raise RuntimeError("no running Herdr session")
    names = ", ".join(str(s.get("name")) for s in sessions)
    raise RuntimeError(f"multiple Herdr sessions are running ({names}); pass --herdr-session")


def _resolve_backend(args: Run | At | Install | Verify) -> tuple[str, str | None]:
    if args.backend == "herdr":
        return "herdr", _resolve_herdr_session(args.herdr_session)
    if args.backend == "tmux":
        return "tmux", None
    try:
        return "herdr", _resolve_herdr_session(args.herdr_session)
    except RuntimeError as exc:
        if str(exc) == "no running Herdr session":
            return "tmux", None
        raise


def _herdr_capture(session: str, pane: str, lines: int = 200) -> str:
    cp = _herdr(session, "agent", "read", pane, "--source", "visible", "--lines", str(lines))
    result = _json_result(cp)
    for key in ("text", "output", "content"):
        if isinstance(result.get(key), str):
            return str(result[key])
    return cp.stdout if cp.returncode == 0 else ""


def _find_created_ids(data: dict[str, object]) -> tuple[str, str]:
    workspace = str(data.get("workspace_id") or data.get("id") or "")
    pane = str(data.get("pane_id") or "")
    root = data.get("root_pane")
    workspace_rec = data.get("workspace")
    if isinstance(root, dict):
        workspace = workspace or str(root.get("workspace_id") or "")
        pane = pane or str(root.get("pane_id") or "")
    if isinstance(workspace_rec, dict):
        workspace = workspace or str(workspace_rec.get("workspace_id") or "")
    return workspace, pane


def _wait_herdr_ready(session: str, pane: str, deadline: float) -> tuple[bool, str]:
    trusted = False
    while time.time() < deadline:
        text = _herdr_capture(session, pane).lower()
        if not trusted and any(marker in text for marker in _TRUST_MARKERS):
            _herdr(session, "pane", "send-keys", pane, "enter")
            trusted = True
            time.sleep(1)
            continue
        if any(marker in text for marker in _AUTH_MARKERS):
            return False, _herdr_capture(session, pane)
        agent = _agent_info(_herdr(session, "agent", "get", pane))
        status = str(agent.get("agent_status") or agent.get("status") or "")
        if status in {"idle", "done"} and any(marker in text for marker in _READY_MARKERS):
            return True, _herdr_capture(session, pane)
        time.sleep(1)
    return False, _herdr_capture(session, pane)


def _wait_herdr_response(session: str, pane: str, timeout: int) -> str:
    _herdr(
        session, "agent", "wait", pane, "--until", "idle", "--until", "done",
        "--until", "blocked", "--timeout", str(timeout * 1000), timeout=timeout + 5,
    )
    return _herdr_capture(session, pane)


def _run_herdr(args: Run, session: str) -> int:
    if not shutil.which("claude"):
        notify("agent-warmup", "claude CLI not found on PATH; cannot warm up")
        return 127
    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    label = f"warmup-{ts}"
    log = cache_dir() / f"run-{ts}.log"
    cwd = isolated_cwd()
    model = args.model or os.environ.get("AICAP_CLAUDE_MODEL") or "haiku"
    prompt = args.prompt or DEFAULT_PROMPT
    workspace = pane = ""
    started = datetime.now().astimezone()

    def write_log(status: str, capture: str, usage: str = "") -> None:
        with log.open("w") as fh:
            fh.write(f"# agent-warmup run {started.isoformat()}\nstatus: {status}\n")
            fh.write(f"runtime: {os.environ.get('AGENT_WARMUP_RUNTIME', 'interactive')}\n")
            fh.write(f"backend: herdr\nherdr_session: {session}\nworkspace: {workspace}\npane: {pane}\n")
            fh.write(f"model: {model}\nprompt: {prompt}\ncwd: {cwd}\n")
            if usage:
                fh.write(f"\n## /usage panel\n{usage}\n")
            fh.write(f"\n## final pane capture\n{capture}\n")

    try:
        cp = _herdr(session, "workspace", "create", "--cwd", str(cwd), "--label", label, "--no-focus", timeout=30)
        workspace, pane = _find_created_ids(_json_result(cp))
        if cp.returncode != 0 or not workspace or not pane:
            write_log("error: Herdr workspace create failed", cp.stderr or cp.stdout)
            return 1

        shell_deadline = time.time() + 15
        while time.time() < shell_deadline:
            info = _json_result(_herdr(session, "pane", "process-info", "--pane", pane))
            process_info = info.get("process_info")
            processes = process_info.get("foreground_processes", []) if isinstance(process_info, dict) else []
            foreground = ""
            if processes and isinstance(processes[0], dict):
                foreground = str(processes[0].get("name") or processes[0].get("argv0") or "")
            if re.search(r"(?:^|/)(?:ba|z|fi)?sh$", foreground):
                break
            time.sleep(0.5)
        else:
            write_log("error: Herdr pane shell not ready", _herdr_capture(session, pane))
            return 2

        command = f"exec env -u ANTHROPIC_API_KEY claude --model {shlex.quote(model)}"
        cp = _herdr(session, "pane", "run", pane, command, timeout=30)
        if cp.returncode != 0:
            write_log("error: Herdr pane run failed", cp.stderr or cp.stdout)
            return 1
        ready, capture = _wait_herdr_ready(session, pane, time.time() + READY_TIMEOUT)
        if not ready:
            write_log("error: claude not ready / auth required", capture)
            return 2

        cp = _herdr(session, "agent", "prompt", pane, prompt)
        if cp.returncode != 0:
            write_log("error: Herdr agent prompt failed", cp.stderr or cp.stdout)
            return 2
        capture = _wait_herdr_response(session, pane, args.timeout)
        usage = ""
        if args.verify:
            cp = _herdr(session, "agent", "prompt", pane, "/usage")
            if cp.returncode == 0:
                usage = _wait_herdr_response(session, pane, 30)
        status = "ok" if capture.strip() else "warning: blank pane (claude did not render)"
        write_log(status, capture, usage)
        if args.keep:
            print(f"agent-warmup: warmup sent; kept Herdr {session}:{workspace}:{pane}; log {log}")
        else:
            print(f"agent-warmup: warmup sent via Herdr {session}; log {log}")
        return 0
    finally:
        if workspace and not args.keep:
            _herdr(session, "workspace", "close", workspace)


def _run_tmux(args: Run) -> int:
    if not shutil.which("tmux"):
        notify("agent-warmup", "tmux not found on PATH; cannot warm up")
        return 127
    if not shutil.which("claude"):
        notify("agent-warmup", "claude CLI not found on PATH; cannot warm up")
        return 127

    # claude's TUI only renders in a tmux server created by the GUI login
    # session. A daemon (launchd/pueue) that spawns its OWN server gets a blank
    # pane, so we require the user's existing default server and inject into it.
    # When attended (a real TTY), creating the server here is fine — it inherits
    # this interactive GUI-session context.
    if not _server_alive() and not sys.stdout.isatty():
        notify("agent-warmup", "no running tmux server to inject into — leave a tmux session open for scheduled warmups")
        print("agent-warmup: no tmux server (and not a TTY); cannot warm up", file=sys.stderr)
        return 4

    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    session = f"warmup-{ts}"
    log = cache_dir() / f"run-{ts}.log"
    cwd = isolated_cwd()
    model = args.model or os.environ.get("AICAP_CLAUDE_MODEL") or "haiku"
    prompt = args.prompt or DEFAULT_PROMPT

    started = datetime.now().astimezone()

    def write_log(status: str, capture: str, usage: str = "") -> None:
        with log.open("w") as fh:
            fh.write(f"# agent-warmup run {started.isoformat()}\n")
            fh.write(f"status: {status}\n")
            fh.write(f"runtime: {os.environ.get('AGENT_WARMUP_RUNTIME', 'interactive')}\n")
            fh.write("backend: tmux\n")
            fh.write(f"model: {model}\n")
            fh.write(f"prompt: {prompt}\n")
            fh.write(f"session: {session} (default tmux server)\n")
            fh.write(f"cwd: {cwd}\n")
            if usage:
                fh.write("\n## /usage panel\n")
                fh.write(usage)
                fh.write("\n")
            fh.write("\n## final pane capture\n")
            fh.write(capture)
            fh.write("\n")

    def cleanup() -> None:
        if not args.keep:
            _tmux("kill-session", "-t", session)  # only our transient session

    try:
        # `env -u ANTHROPIC_API_KEY`: force subscription auth (an API key would
        # route to metered credit and NOT advance the 5-hour window). Done in the
        # command because the session inherits the server's env, not ours.
        claude_cmd = f"exec env -u ANTHROPIC_API_KEY claude --model {shlex.quote(model)}"
        cp = _tmux("new-session", "-d", "-s", session, "-x", "200", "-y", "50",
                   "-c", str(cwd), claude_cmd, timeout=30)
        if cp.returncode != 0:
            write_log("error: tmux new-session failed", cp.stderr or cp.stdout)
            notify("agent-warmup", f"failed to spawn claude session: {cp.stderr.strip()}")
            return 1

        ready, capture = _wait_ready(session, time.time() + READY_TIMEOUT)
        if not ready:
            write_log("error: claude not ready / auth required", capture)
            notify("agent-warmup", "claude did not become ready (auth or startup issue) — check the log")
            print(f"agent-warmup: not ready; log {log}", file=sys.stderr)
            return 2

        _send_text(session, prompt)
        capture = _wait_response(session, time.time() + args.timeout)

        usage = ""
        if args.verify:
            _send_text(session, "/usage")
            time.sleep(2.0)
            usage = _wait_response(session, time.time() + 30)

        # A blank capture means claude never rendered (the daemon-server trap) —
        # report it instead of a false "ok".
        status = "ok" if capture.strip() else "warning: blank pane (claude did not render)"
        write_log(status, capture, usage)
        if not capture.strip():
            notify("agent-warmup", "warmup ran but claude rendered nothing — check the log")
        if args.keep:
            print(f"agent-warmup: warmup sent; session kept ({session}); log {log}")
            print(f"  attach with: tmux attach -t {session}")
        else:
            print(f"agent-warmup: warmup sent; log {log}")
        return 0
    finally:
        cleanup()


def cmd_run(args: Run) -> int:
    sentinel = os.environ.get("AGENT_WARMUP_STARTUP_SENTINEL")
    if sentinel:
        Path(sentinel).touch()
    try:
        backend, session = _resolve_backend(args)
    except RuntimeError as exc:
        print(f"agent-warmup: {exc}", file=sys.stderr)
        return 4
    if backend == "herdr":
        return _run_herdr(args, session or "default")
    return _run_tmux(args)


# --- pueue one-shot ---------------------------------------------------------

def _scheduled_python() -> str:
    """Pick a Python interpreter safe to launch from a daemon (pueue/launchd/systemd).

    Two traps, both observed 2026-06-20 (see the pitfall):
    1. The `uv run` shebang launcher hangs under launchd before Python starts —
       so we invoke a Python interpreter directly on the script.
    2. The uv-MANAGED interpreter often lives on a secondary volume
       (e.g. /Volumes/Data/.../uv-share/python/cpython-*/bin/python3.11). Memory-
       mapping its binary / C-extension .so files from that volume BLOCKS in dyld
       under a daemon bootstrap (a volume-access/TCC gate the GUI session has but
       daemons don't), wedging the run forever with no session and no log.

    So prefer a Python on the main system volume for the stdlib bootstrap. That
    bootstrap can then launch the PEP 723/Tyro environment through uv safely.
    """
    if sys.platform == "darwin":
        candidates = ["/opt/homebrew/bin/python3", "/usr/local/bin/python3"]
    else:
        candidates = ["/usr/bin/python3", "/usr/local/bin/python3"]
    for cand in candidates:
        if os.path.exists(cand):
            return cand
    # Last resort: whatever is on PATH, else the current interpreter (may be on a
    # secondary volume — better to try than to emit nothing).
    return shutil.which("python3") or sys.executable


def _as_run(args: Run | At | Install | Verify) -> Run:
    return Run(
        model=args.model, prompt=args.prompt, timeout=args.timeout,
        verify=getattr(args, "verify", False), keep=getattr(args, "keep", False),
        backend=args.backend, herdr_session=args.herdr_session,
    )


def _public_run_args(spec: Run) -> list[str]:
    argv = ["run"]
    if spec.model:
        argv += ["--model", spec.model]
    if spec.prompt:
        argv += ["--prompt", spec.prompt]
    if spec.timeout != DEFAULT_TIMEOUT:
        argv += ["--timeout", str(spec.timeout)]
    if spec.verify:
        argv.append("--verify")
    if spec.keep:
        argv.append("--keep")
    if spec.backend != "auto":
        argv += ["--backend", spec.backend]
    if spec.herdr_session:
        argv += ["--herdr-session", spec.herdr_session]
    return argv


def _encode_run_spec(spec: Run) -> str:
    raw = json.dumps({"schema": SCHEDULE_SCHEMA, "run": asdict(spec)}, separators=(",", ":"))
    return base64.urlsafe_b64encode(raw.encode()).decode().rstrip("=")


def _decode_run_spec(payload: str) -> Run:
    padded = payload + "=" * (-len(payload) % 4)
    data = json.loads(base64.urlsafe_b64decode(padded).decode())
    if data.get("schema") != SCHEDULE_SCHEMA or not isinstance(data.get("run"), dict):
        raise ValueError("unsupported scheduled payload schema")
    return Run(**data["run"])


def _run_argv(args: Run | At | Install | Verify) -> list[str]:
    """Build a stdlib-only scheduled bootstrap invocation."""
    spec = _as_run(args)
    backend, session = _resolve_backend(spec)
    spec.backend = backend  # Scheduled runs must not silently switch backends.
    spec.herdr_session = session
    spec.keep = False
    return [_scheduled_python(), str(script_path()), "__scheduled-run", _encode_run_spec(spec)]


def _prewarm_uv() -> None:
    uv = shutil.which("uv")
    if not uv:
        return
    cp = run([
        uv, "run", "--quiet", "--no-project", "--no-env-file",
        "--python", _scheduled_python(), "--script", str(script_path()), "--help",
    ], timeout=120)
    diagnostic = cache_dir() / "uv-bootstrap.log"
    with diagnostic.open("a") as fh:
        version = run([uv, "--version"], timeout=5)
        fh.write(f"{datetime.now().astimezone().isoformat()} prewarm rc={cp.returncode} ")
        fh.write(f"uv={uv} version={version.stdout.strip()}\n{cp.stderr}\n")


def _scheduled_bootstrap(payload: str) -> int:
    """Try uv first; direct-call the stdlib core only before its startup sentinel."""
    try:
        spec = _decode_run_spec(payload)
    except (ValueError, TypeError, json.JSONDecodeError) as exc:
        print(f"agent-warmup: invalid scheduled payload: {exc}", file=sys.stderr)
        return 2
    uv = shutil.which("uv")
    sentinel = cache_dir() / f"bootstrap-{os.getpid()}.started"
    diagnostic = cache_dir() / "uv-bootstrap.log"
    if uv:
        env = os.environ.copy()
        env["AGENT_WARMUP_STARTUP_SENTINEL"] = str(sentinel)
        env["AGENT_WARMUP_RUNTIME"] = "uv"
        command = [
            uv, "run", "--quiet", "--no-project", "--no-env-file", "--offline",
            "--python", _scheduled_python(), "--script", str(script_path()),
            *_public_run_args(spec),
        ]
        started = time.monotonic()
        try:
            proc = subprocess.Popen(
                command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                env=env, start_new_session=True,
            )
        except OSError as exc:
            with diagnostic.open("a") as fh:
                fh.write(f"{datetime.now().astimezone().isoformat()} fallback=uv-launch-error uv={uv}: {exc}\n")
            proc = None
        if proc is None:
            os.environ.pop("AGENT_WARMUP_STARTUP_SENTINEL", None)
            os.environ["AGENT_WARMUP_RUNTIME"] = "direct-fallback"
            return cmd_run(spec)
        while time.monotonic() - started < BOOTSTRAP_SENTINEL_TIMEOUT:
            if sentinel.exists():
                stdout, stderr = proc.communicate()
                if stdout:
                    print(stdout, end="")
                if stderr:
                    print(stderr, file=sys.stderr, end="")
                sentinel.unlink(missing_ok=True)
                return proc.returncode
            if proc.poll() is not None:
                break
            time.sleep(0.1)
        if proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
        stdout, stderr = proc.communicate()
        with diagnostic.open("a") as fh:
            version = run([uv, "--version"], timeout=5)
            reason = "timeout" if proc.returncode is None or time.monotonic() - started >= BOOTSTRAP_SENTINEL_TIMEOUT else "pre-sentinel-exit"
            fh.write(f"{datetime.now().astimezone().isoformat()} fallback={reason} rc={proc.returncode} ")
            fh.write(f"uv={uv} version={version.stdout.strip()}\n{stderr}\n")
        sentinel.unlink(missing_ok=True)
    os.environ.pop("AGENT_WARMUP_STARTUP_SENTINEL", None)
    os.environ["AGENT_WARMUP_RUNTIME"] = "direct-fallback"
    return cmd_run(spec)


def _ensure_group() -> None:
    run(["pueue", "group", "add", GROUP])
    run(["pueue", "parallel", "-g", GROUP, "1"])


def cmd_at(args: At) -> int:
    if not shutil.which("pueue"):
        print("agent-warmup: pueue not installed", file=sys.stderr)
        return 127
    if not args.at and not args.delay:
        print("agent-warmup at: pass --at or --delay", file=sys.stderr)
        return 2
    delay = args.delay or args.at
    command = " ".join(shlex.quote(p) for p in _run_argv(args))
    label = f"{LABEL_PREFIX}oneshot:{datetime.now().strftime('%Y%m%d-%H%M%S')}"
    if args.dry_run:
        print(f"pueue add -g {GROUP} --label {shlex.quote(label)} "
              f"--delay {shlex.quote(delay)} {shlex.quote(command)}")
        return 0
    _prewarm_uv()
    _ensure_group()
    cp = run(["pueue", "add", "-g", GROUP, "--label", label,
              "--delay", delay, "--print-task-id", command])
    if cp.returncode != 0:
        print(cp.stderr or cp.stdout, file=sys.stderr, end="")
        return cp.returncode
    print(f"scheduled {label} at {delay} (task {cp.stdout.strip()})")
    return 0


def _pueue_oneshots() -> list[tuple[str, str, str]]:
    """Return (task_id, status, label) for pending agent-warmup one-shots."""
    if not shutil.which("pueue"):
        return []
    cp = run(["pueue", "status", "--json"])
    if cp.returncode != 0:
        return []
    try:
        data = json.loads(cp.stdout)
    except json.JSONDecodeError:
        return []
    out = []
    for tid, task in (data.get("tasks") or {}).items():
        if not isinstance(task, dict):
            continue
        label = str(task.get("label") or "")
        if not label.startswith(LABEL_PREFIX):
            continue
        status = task.get("status")
        name = next(iter(status)) if isinstance(status, dict) and status else str(status)
        if name == "Done":
            continue
        out.append((str(task.get("id", tid)), name, label))
    return out


def cmd_cancel(args: Cancel) -> int:
    tasks = _pueue_oneshots()
    if not tasks:
        print("no pending agent-warmup one-shots")
        return 0
    for tid, _status, label in tasks:
        cp = run(["pueue", "remove", tid])
        if cp.returncode != 0:
            run(["pueue", "kill", tid])
            cp = run(["pueue", "remove", tid])
        print(f"removed task {tid} ({label})" if cp.returncode == 0
              else (cp.stderr or cp.stdout))
    return 0


# --- recurring timer install ------------------------------------------------

_WEEKDAY_NAMES = {
    "mon": 1, "tue": 2, "wed": 3, "thu": 4, "fri": 5, "sat": 6, "sun": 0,
}
_SYSTEMD_DAY = {1: "Mon", 2: "Tue", 3: "Wed", 4: "Thu", 5: "Fri", 6: "Sat", 0: "Sun"}


def _parse_days(spec: str) -> list[int]:
    """Return launchd Weekday integers (Sun=0..Sat=6). Empty list = every day."""
    spec = (spec or "daily").strip().lower()
    if spec in ("daily", "everyday", "all"):
        return []
    if spec == "weekdays":
        return [1, 2, 3, 4, 5]
    if spec == "weekends":
        return [0, 6]
    days = []
    for tok in re.split(r"[,\s]+", spec):
        if tok[:3] in _WEEKDAY_NAMES:
            days.append(_WEEKDAY_NAMES[tok[:3]])
    return sorted(set(days))


def _parse_hhmm(s: str) -> tuple[int, int]:
    m = re.fullmatch(r"(\d{1,2}):(\d{2})", s.strip())
    if not m:
        raise SystemExit(f"agent-warmup install: bad --time {s!r} (want HH:MM)")
    hh, mm = int(m.group(1)), int(m.group(2))
    if hh > 23 or mm > 59:
        raise SystemExit(f"agent-warmup install: time out of range {s!r}")
    return hh, mm


def _launchd_plist_path() -> Path:
    return Path.home() / "Library" / "LaunchAgents" / f"{LAUNCHD_LABEL}.plist"


def _install_launchd(args: Install, days: list[int], hh: int, mm: int) -> int:
    # Lazy import: plistlib pulls in the pyexpat C-extension, whose load triggers
    # macOS amfid code-sign verification that can STALL under a daemon (launchd /
    # pueue) bootstrap. The scheduled `run` hot path must never import it — only
    # `install` (always invoked interactively) needs it. See the pitfall.
    import plistlib
    program = _run_argv(args)
    if days:
        cal = [{"Weekday": d, "Hour": hh, "Minute": mm} for d in days]
    else:
        cal = {"Hour": hh, "Minute": mm}
    plist = {
        "Label": LAUNCHD_LABEL,
        "ProgramArguments": program,
        "StartCalendarInterval": cal,
        "EnvironmentVariables": {"PATH": os.environ["PATH"]},
        "StandardOutPath": str(cache_dir() / "launchd.out.log"),
        "StandardErrorPath": str(cache_dir() / "launchd.err.log"),
        "RunAtLoad": False,
    }
    path = _launchd_plist_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("wb") as fh:
        plistlib.dump(plist, fh)
    # Validate with the platform tool (repo invariant: validate config with the app).
    if shutil.which("plutil"):
        cp = run(["plutil", "-lint", str(path)])
        if cp.returncode != 0:
            print(cp.stdout or cp.stderr, file=sys.stderr, end="")
            return 1
    uid = os.getuid()
    run(["launchctl", "bootout", f"gui/{uid}/{LAUNCHD_LABEL}"])
    cp = run(["launchctl", "bootstrap", f"gui/{uid}", str(path)])
    if cp.returncode != 0:
        # Older macOS fallback.
        run(["launchctl", "unload", str(path)])
        cp = run(["launchctl", "load", "-w", str(path)])
    if cp.returncode != 0:
        print(cp.stderr or cp.stdout, file=sys.stderr, end="")
        return cp.returncode
    print(f"installed launchd agent {LAUNCHD_LABEL} → {path}")
    return 0


def _systemd_dir() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    d = Path(base) / "systemd" / "user"
    d.mkdir(parents=True, exist_ok=True)
    return d


def _install_systemd(args: Install, days: list[int], hh: int, mm: int) -> int:
    program = " ".join(shlex.quote(p) for p in _run_argv(args))
    if days:
        names = ",".join(_SYSTEMD_DAY[d] for d in sorted(days))
        oncal = f"{names} *-*-* {hh:02d}:{mm:02d}:00"
    else:
        oncal = f"*-*-* {hh:02d}:{mm:02d}:00"
    d = _systemd_dir()
    (d / f"{SYSTEMD_UNIT}.service").write_text(
        "[Unit]\n"
        "Description=Claude quota-window warmup\n\n"
        "[Service]\n"
        "Type=oneshot\n"
        f"ExecStart={program}\n"
    )
    (d / f"{SYSTEMD_UNIT}.timer").write_text(
        "[Unit]\n"
        "Description=Claude quota-window warmup timer\n\n"
        "[Timer]\n"
        f"OnCalendar={oncal}\n"
        "Persistent=true\n\n"
        "[Install]\n"
        "WantedBy=timers.target\n"
    )
    if shutil.which("systemd-analyze"):
        cp = run(["systemd-analyze", "verify", str(d / f"{SYSTEMD_UNIT}.timer")])
        if cp.returncode != 0:
            print(cp.stderr or cp.stdout, file=sys.stderr, end="")
            return 1
    run(["systemctl", "--user", "daemon-reload"])
    cp = run(["systemctl", "--user", "enable", "--now", f"{SYSTEMD_UNIT}.timer"])
    if cp.returncode != 0:
        print(cp.stderr or cp.stdout, file=sys.stderr, end="")
        return cp.returncode
    print(f"installed systemd user timer {SYSTEMD_UNIT}.timer (OnCalendar={oncal})")
    return 0


def cmd_install(args: Install) -> int:
    days = _parse_days(args.daily)
    hh, mm = _parse_hhmm(args.time)
    _prewarm_uv()
    if sys.platform == "darwin":
        return _install_launchd(args, days, hh, mm)
    return _install_systemd(args, days, hh, mm)


def cmd_uninstall(args: Uninstall) -> int:
    if sys.platform == "darwin":
        uid = os.getuid()
        run(["launchctl", "bootout", f"gui/{uid}/{LAUNCHD_LABEL}"])
        path = _launchd_plist_path()
        run(["launchctl", "unload", str(path)])
        if path.exists():
            path.unlink()
            print(f"removed launchd agent {LAUNCHD_LABEL}")
        else:
            print("no launchd agent installed")
        return 0
    run(["systemctl", "--user", "disable", "--now", f"{SYSTEMD_UNIT}.timer"])
    d = _systemd_dir()
    removed = False
    for name in (f"{SYSTEMD_UNIT}.timer", f"{SYSTEMD_UNIT}.service"):
        f = d / name
        if f.exists():
            f.unlink()
            removed = True
    run(["systemctl", "--user", "daemon-reload"])
    print("removed systemd user timer" if removed else "no systemd timer installed")
    return 0


# --- status -----------------------------------------------------------------

def _timer_state() -> str:
    if sys.platform == "darwin":
        path = _launchd_plist_path()
        if not path.exists():
            return "not installed"
        uid = os.getuid()
        cp = run(["launchctl", "print", f"gui/{uid}/{LAUNCHD_LABEL}"])
        return f"launchd {LAUNCHD_LABEL} ({'loaded' if cp.returncode == 0 else 'present, not loaded'})"
    if not (_systemd_dir() / f"{SYSTEMD_UNIT}.timer").exists():
        return "not installed"
    cp = run(["systemctl", "--user", "list-timers", "--no-pager", f"{SYSTEMD_UNIT}.timer"])
    next_line = ""
    for line in cp.stdout.splitlines():
        if SYSTEMD_UNIT in line:
            next_line = line.strip()
    return f"systemd {SYSTEMD_UNIT}.timer ({next_line or 'enabled'})"


def _recent_runs(limit: int = 5) -> list[tuple[str, str]]:
    logs = sorted(cache_dir().glob("run-*.log"), reverse=True)[:limit]
    out = []
    for log in logs:
        status = "?"
        for line in log.read_text(errors="replace").splitlines():
            if line.startswith("status:"):
                status = line.split(":", 1)[1].strip()
                break
        out.append((log.name, status))
    return out


def cmd_status(args: Status) -> int:
    if args.json:
        print(json.dumps({
            "timer": _timer_state(),
            "oneshots": [{"task_id": t, "status": s, "label": l} for t, s, l in _pueue_oneshots()],
            "recent_runs": [{"log": n, "status": s} for n, s in _recent_runs()],
        }, indent=2))
        return 0
    print(f"timer:    {_timer_state()}")
    oneshots = _pueue_oneshots()
    print(f"oneshots: {len(oneshots)} pending")
    for tid, status, label in oneshots:
        print(f"  task {tid}  {status}  {label}")
    runs = _recent_runs()
    print(f"recent:   {len(runs)} run log(s) in {cache_dir()}")
    for name, status in runs:
        print(f"  {name}  status={status}")
    return 0


def main(argv: list[str] | None = None) -> int:
    _augment_path()
    raw = list(sys.argv[1:] if argv is None else argv)
    if raw and raw[0] == "__scheduled-run":
        if len(raw) != 2:
            print("agent-warmup: __scheduled-run expects one payload", file=sys.stderr)
            return 2
        return _scheduled_bootstrap(raw[1])

    # Public parsing is Tyro; it stays out of the daemon bootstrap path above.
    import tyro

    if not raw:
        raw = ["--help"]
    command = tyro.cli(Command, args=raw, prog="agent-warmup")
    if isinstance(command, Run):
        return cmd_run(command)
    if isinstance(command, At):
        return cmd_at(command)
    if isinstance(command, Install):
        return cmd_install(command)
    if isinstance(command, Uninstall):
        return cmd_uninstall(command)
    if isinstance(command, Status):
        return cmd_status(command)
    if isinstance(command, Cancel):
        return cmd_cancel(command)
    if isinstance(command, Verify):
        return cmd_run(Run(
            model=command.model, prompt=command.prompt, timeout=command.timeout,
            verify=True, keep=True, backend=command.backend,
            herdr_session=command.herdr_session,
        ))
    raise AssertionError(f"unhandled command: {type(command).__name__}")


if __name__ == "__main__":
    raise SystemExit(main())
