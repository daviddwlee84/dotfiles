#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "rich>=13.9",
#   "textual>=5.0",
# ]
# ///
"""appsrc — detect how an installed app / CLI was installed & managed.

There is no single OS command that tells you whether an app came from a
Homebrew cask, the Mac App Store, a direct-download dmg/pkg, apt, snap,
flatpak, an AppImage, or a language package manager. This tool combines
several signals, ordered by specificity, and captures the evidence.

Subcommands (positional, default `scan`):
  scan            Batch-inventory installed GUI apps + CLI tools, attribute
                  each to its manager. Cached (per-item mtime invalidation).
  which <name>    which-style single lookup, always live (no cache). NAME may
                  be a shell command (docker) OR a GUI app name ("Google
                  Chrome") — auto-detected. Prints source + evidence.

scan flags:
  --json                     Emit JSON (list of records) instead of a table.
  --kind {gui,cli,all}       Restrict inventory (default: all).
  --source FILTER            Only rows whose source id/label matches FILTER.
  -r, --refresh              Recompute everything, ignore cache.
  --no-cache                 Don't read or write the cache.
  --list-names               Print GUI app names only (used by completions).

which flags:
  --json                     Emit the single record as JSON.
  --path PATH                Classify PATH directly (skip name resolution).

Caveats baked in (see pitfalls/tailscale-another-copy-app-store-leftover.md):
  `_MASReceipt` is NOT a reliable App Store discriminator (it exists in some
  standalone bundles too) — this tool leans on codesign Authority /
  CFBundleIdentifier / `mas list` / mdls receipt instead.

Cache:
  ${XDG_CACHE_HOME:-~/.cache}/appsrc/<hostname>.json
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
from dataclasses import asdict, dataclass
from pathlib import Path

from rich.console import Console
from rich.table import Table
from rich.text import Text

out = Console()
err = Console(stderr=True)

IS_MAC = sys.platform == "darwin"
IS_LINUX = sys.platform.startswith("linux")
HOME = Path.home()

# brew auto-update can hang on this repo's aliyun mirror (see the
# homebrew-aliyun-autoupdate-hang pitfall) — deadly when a `brew` call runs
# inside the TUI worker thread. Never let our read-only queries trigger it.
os.environ.setdefault("HOMEBREW_NO_AUTO_UPDATE", "1")

_CACHE_VERSION = "v3"


# ---------------------------------------------------------------------------
# Record + labels
# ---------------------------------------------------------------------------
@dataclass
class AppRecord:
    name: str
    kind: str                       # "gui" | "cli"
    path: str | None
    source: str                     # canonical id (see SOURCE_LABELS)
    manager: str | None = None      # human label
    package: str | None = None      # owning cask/formula/deb/snap/crate
    confidence: str = "heuristic"   # "authoritative" | "heuristic"
    bundle_id: str | None = None    # macOS CFBundleIdentifier
    signer: str | None = None       # macOS codesign Authority leaf
    origin_url: str | None = None   # macOS kMDItemWhereFroms
    detail: str | None = None
    mtime: float | None = None
    size_bytes: int | None = None   # bundle footprint; only filled by `scan --size`


@dataclass
class StorageItem:
    category: str                   # bundle|cache|data|container|prefs|state|logs|web|launch|xdg
    path: str
    size_bytes: int | None          # None = unreadable / du timed out
    confidence: str                 # "exact" | "fuzzy"
    note: str | None = None


@dataclass
class SizeReport:
    name: str
    source: str
    kind: str
    path: str | None
    bundle_bytes: int | None
    associated_bytes: int           # sum of non-bundle items
    total_bytes: int
    items: list[StorageItem]


SOURCE_LABELS = {
    "homebrew-cask": "Homebrew cask",
    "homebrew-formula": "Homebrew formula",
    "mac-app-store": "Mac App Store",
    "direct-download-pkg": "Direct download (pkg)",
    "direct-download-dmg": "Direct download (dmg/web)",
    "manual": "Manual / drag-in",
    "macos-system": "macOS system",
    "apt": "apt / dpkg",
    "snap": "snap",
    "flatpak": "flatpak",
    "appimage": "AppImage",
    "linuxbrew": "Homebrew (Linuxbrew)",
    "cargo": "cargo",
    "npm": "npm (global)",
    "pipx": "pipx",
    "uv": "uv tool",
    "mise": "mise",
    "go": "go install",
    "gem": "gem",
    "system": "system",
    "unknown": "unknown",
}

# Colour per source-family for the table.
SOURCE_COLOR = {
    "homebrew-cask": "cyan", "homebrew-formula": "cyan", "linuxbrew": "cyan",
    "mac-app-store": "green", "apt": "blue", "snap": "magenta",
    "flatpak": "magenta", "appimage": "yellow",
    "direct-download-pkg": "yellow", "direct-download-dmg": "yellow",
    "manual": "red", "unknown": "red",
    "macos-system": "bright_black", "system": "bright_black",
    "cargo": "bright_cyan", "npm": "bright_cyan", "pipx": "bright_cyan",
    "uv": "bright_cyan", "mise": "bright_cyan", "go": "bright_cyan", "gem": "bright_cyan",
}


def _label(source: str) -> str:
    return SOURCE_LABELS.get(source, source)


# ---------------------------------------------------------------------------
# Subprocess helper
# ---------------------------------------------------------------------------
def _run(cmd: list[str], timeout: float = 20.0) -> tuple[int, str, str]:
    """Run cmd; never raise. Returns (rc, stdout, stderr). rc=127 if missing.

    stdin=DEVNULL is load-bearing: without it a subprocess spawned from the TUI's
    worker thread inherits the raw-mode tty and can block forever (brew/mdls/…).
    """
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                           check=False, stdin=subprocess.DEVNULL)
        return r.returncode, r.stdout, r.stderr
    except FileNotFoundError:
        return 127, "", ""
    except (subprocess.TimeoutExpired, OSError):
        return 1, "", ""


def _has(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def _realpath(p: str | Path) -> str:
    try:
        return os.path.realpath(p)
    except OSError:
        return str(p)


def _mtime(p: str | Path) -> float | None:
    try:
        return Path(p).stat().st_mtime
    except OSError:
        return None


def _du_bytes(path: str | Path, timeout: float = 20.0) -> int | None:
    """Disk usage of PATH in bytes via `du -sk`. None on error / timeout.

    The subprocess timeout is the hard guard against a pathological cache dir
    (millions of tiny files / a networked mount) hanging the tool.
    """
    p = str(path)
    if not os.path.exists(p):
        return None
    rc, so, _ = _run(["du", "-sk", p], timeout=timeout)
    # du may exit non-zero on permission-denied subdirs yet still print the
    # total to stdout; a real timeout kills du → empty stdout → None.
    if not so.strip():
        return None
    try:
        return int(so.split()[0]) * 1024
    except (ValueError, IndexError):
        return None


def _du_many(paths: list[str], chunk: int = 400) -> dict[str, int]:
    """Batch disk-usage: `du -sk <many paths>` prints one line per path, so a
    few subprocess calls size thousands of items instead of one fork each
    (~40s of per-item forks → a few seconds). Returns {path: bytes}."""
    line_re = re.compile(r"^(\d+)\t(.*)$")           # macOS/GNU du: size<TAB>path
    alt_re = re.compile(r"^(\d+)\s+(.+)$")           # fallback: size<whitespace>path
    out: dict[str, int] = {}
    for i in range(0, len(paths), chunk):
        batch = [p for p in paths[i:i + chunk] if p]
        if not batch:
            continue
        rc, so, _ = _run(["du", "-sk", *batch], timeout=120)
        for line in so.splitlines():
            m = line_re.match(line) or alt_re.match(line)
            if m:
                out[m.group(2)] = int(m.group(1)) * 1024
    return out


def _human(n: int | None) -> str:
    if n is None:
        return "?"
    size = float(n)
    for unit in ("B", "K", "M", "G", "T"):
        if size < 1024 or unit == "T":
            return f"{size:.0f}{unit}" if unit == "B" else f"{size:.1f}{unit}"
        size /= 1024
    return f"{size:.1f}T"


# ---------------------------------------------------------------------------
# Shared: language-package-manager attribution by resolved path prefix
# ---------------------------------------------------------------------------
def _lang_source_for_path(rp: str) -> tuple[str, str | None] | None:
    """Attribute a resolved binary path to a language PM. (source, pkg) or None.

    Only trusts *manager-specific* dirs. A shared user-bin (`~/.local/bin`,
    `~/bin`) is deliberately NOT attributed here even if GOBIN points at it —
    that trap is resolved by a `go version` content-check in the classifier.
    """
    home = str(HOME)
    checks: list[tuple[str, str]] = [
        (f"{home}/.cargo/", "cargo"),
        (f"{home}/.local/share/uv/", "uv"),
        (f"{home}/.local/share/pipx/", "pipx"),
        (f"{home}/.local/pipx/", "pipx"),
        (f"{home}/.local/share/mise/", "mise"),
        (f"{home}/.local/share/rtx/", "mise"),
        (f"{home}/.gem/", "gem"),
    ]
    for prefix, source in checks:
        if rp.startswith(prefix):
            return source, None
    # go: conventional dirs only (~/go/bin, $GOPATH/bin) — never a shared GOBIN.
    gopath = (os.environ.get("GOPATH") or f"{home}/go").rstrip("/")
    if rp.startswith(f"{home}/go/bin/") or rp.startswith(f"{gopath}/bin/"):
        return "go", None
    if "/gems/" in rp and "/bin/" in rp:
        return "gem", None
    return None


def _is_go_binary(rp: str) -> bool:
    """True if rp is a compiled Go binary (`go version <file>` reports goX.Y)."""
    if not _has("go"):
        return False
    rc, so, _ = _run(["go", "version", rp], timeout=8)
    return rc == 0 and bool(re.search(r":\s*go\d", so))


def _shared_user_bin(rp: str) -> bool:
    return rp.startswith((f"{HOME}/.local/bin/", f"{HOME}/bin/"))


def _classify_user_bin(rec: AppRecord, rp: str) -> AppRecord:
    """Disambiguate a real binary in a shared user-bin: go-installed vs manual."""
    if _is_go_binary(rp):
        rec.source, rec.manager, rec.confidence = "go", _label("go"), "authoritative"
    else:
        rec.source, rec.manager = "manual", _label("manual")
        rec.detail = rec.detail or "self-contained binary in a shared user-bin"
    return rec


# ===========================================================================
# macOS
# ===========================================================================
class MacCtx:
    """Lazily-built forward inventories for macOS (one subprocess each)."""

    def __init__(self) -> None:
        self._prefix: str | None = "?"
        self._caskroom: str | None = "?"
        self._app_to_cask: dict[str, str] | None = None
        self._formula_bins: set[str] | None = None
        self._mas: dict[str, str] | None = None

    @property
    def brew_prefix(self) -> str | None:
        if self._prefix == "?":
            self._prefix = None
            if _has("brew"):
                rc, so, _ = _run(["brew", "--prefix"], timeout=10)
                if rc == 0 and so.strip():
                    self._prefix = so.strip()
            if not self._prefix:
                for p in ("/opt/homebrew", "/usr/local"):
                    if Path(p, "bin", "brew").exists():
                        self._prefix = p
                        break
        return self._prefix

    @property
    def caskroom(self) -> str | None:
        if self._caskroom == "?":
            self._caskroom = None
            for base in ("/opt/homebrew/Caskroom", "/usr/local/Caskroom"):
                if Path(base).is_dir():
                    self._caskroom = base
                    break
            if not self._caskroom and self.brew_prefix:
                cand = Path(self.brew_prefix) / "Caskroom"
                if cand.is_dir():
                    self._caskroom = str(cand)
        return self._caskroom

    @property
    def app_to_cask(self) -> dict[str, str]:
        """Map lowercase '<app>.app' basename -> cask token."""
        if self._app_to_cask is None:
            self._app_to_cask = {}
            if not _has("brew"):
                return self._app_to_cask
            rc, so, _ = _run(["brew", "list", "--cask"], timeout=20)
            casks = so.split() if rc == 0 else []
            if not casks:
                return self._app_to_cask
            rc, so, _ = _run(["brew", "info", "--cask", "--json=v2", *casks], timeout=60)
            if rc != 0 or not so.strip():
                return self._app_to_cask
            try:
                data = json.loads(so)
            except json.JSONDecodeError:
                return self._app_to_cask
            for cask in data.get("casks", []):
                token = cask.get("token") or ""
                for artifact in cask.get("artifacts", []) or []:
                    if not isinstance(artifact, dict):
                        continue
                    for app in artifact.get("app", []) or []:
                        target = None
                        if isinstance(app, str):
                            target = app
                        elif isinstance(app, dict):
                            target = app.get("target") or app.get("source")
                        if target:
                            self._app_to_cask[Path(target).name.lower()] = token
        return self._app_to_cask

    @property
    def mas(self) -> dict[str, str]:
        """Map lowercase App Store app name -> 'id'."""
        if self._mas is None:
            self._mas = {}
            if _has("mas"):
                rc, so, _ = _run(["mas", "list"], timeout=20)
                if rc == 0:
                    for line in so.splitlines():
                        # "<id>  <Name>  (<version>)"
                        m = re.match(r"^\s*(\d+)\s+(.*?)\s+\([^()]*\)\s*$", line)
                        if m:
                            self._mas[m.group(2).strip().lower()] = m.group(1)
        return self._mas


def _mac_bundle_id(app: Path) -> str | None:
    plist = app / "Contents" / "Info"
    rc, so, _ = _run(["defaults", "read", str(plist), "CFBundleIdentifier"], timeout=8)
    return so.strip() if rc == 0 and so.strip() else None


def _mac_bundle_name(app: Path) -> str | None:
    plist = app / "Contents" / "Info"
    rc, so, _ = _run(["defaults", "read", str(plist), "CFBundleName"], timeout=8)
    return so.strip() if rc == 0 and so.strip() else None


def _mac_signer(app: Path) -> str | None:
    # codesign writes to stderr; first Authority= line is the leaf certificate.
    rc, _, se = _run(["codesign", "-dv", "--verbose=4", str(app)], timeout=12)
    for line in se.splitlines():
        if line.startswith("Authority="):
            return line.split("=", 1)[1].strip()
    return None


def _mac_meta(app: Path) -> tuple[bool, str | None]:
    """One mdls fork → (has_app_store_receipt, first_where_from_url)."""
    rc, so, _ = _run(
        ["mdls", "-name", "kMDItemAppStoreHasReceipt", "-name", "kMDItemWhereFroms", str(app)],
        timeout=10,
    )
    if rc != 0:
        return False, None
    receipt = False
    for line in so.splitlines():
        if "kMDItemAppStoreHasReceipt" in line and line.rstrip().endswith("= 1"):
            receipt = True
            break
    m = re.search(r'"([^"]+)"', so)
    return receipt, (m.group(1) if m else None)


def _mac_pkg_for(path: Path) -> str | None:
    rc, so, _ = _run(["pkgutil", "--file-info", str(path)], timeout=10)
    if rc != 0:
        return None
    for line in so.splitlines():
        if line.strip().startswith("pkgid:"):
            return line.split(":", 1)[1].strip()
    return None


def _mac_classify_app(app: Path, ctx: MacCtx, *, evidence: bool) -> AppRecord:
    name = app.stem
    base_lc = app.name.lower()
    rec = AppRecord(name=name, kind="gui", path=str(app), source="unknown", mtime=_mtime(app))

    # 1. Homebrew cask (authoritative when Caskroom metadata is present).
    cask = ctx.app_to_cask.get(base_lc)
    if cask:
        rec.source = "homebrew-cask"
        rec.package = cask
        rec.manager = _label("homebrew-cask")
        if ctx.caskroom and Path(ctx.caskroom, cask).is_dir():
            rec.confidence = "authoritative"
        else:
            rec.confidence = "heuristic"
            rec.detail = "cask declares this app but no Caskroom entry (drag-installed / drift)"
        if evidence:
            rec.bundle_id = _mac_bundle_id(app)
            rec.signer = _mac_signer(app)
        return rec

    # 2. Mac App Store — cheapest tell first (in-memory `mas list` membership).
    if name.lower() in ctx.mas:
        rec.source = "mac-app-store"
        rec.manager = _label("mac-app-store")
        rec.package = ctx.mas.get(name.lower())
        rec.confidence = "authoritative"
        if evidence:
            rec.bundle_id = _mac_bundle_id(app)
            rec.signer = _mac_signer(app)
        return rec

    # Evidence (codesign/bundle-id) only when asked (which); it's the slow fork.
    if evidence:
        rec.signer = _mac_signer(app)
        rec.bundle_id = _mac_bundle_id(app)

    # One mdls fork gets both the App Store receipt and the download provenance.
    receipt, url = _mac_meta(app)

    # 2b. App Store via receipt / Apple re-signing (delisted apps not in `mas list`).
    #     Never rely on _MASReceipt alone — corroborated by receipt or signer.
    if receipt or (rec.signer or "").startswith("Apple Mac OS Application Signing"):
        rec.source = "mac-app-store"
        rec.manager = _label("mac-app-store")
        rec.confidence = "heuristic"
        return rec

    # 3. Direct download via .pkg installer (receipt on file).
    pkg = _mac_pkg_for(app)
    if pkg:
        rec.source = "direct-download-pkg"
        rec.manager = _label("direct-download-pkg")
        rec.package = pkg
        rec.confidence = "authoritative"
        return rec

    # 4. Direct download via dmg / browser (quarantine provenance URL).
    if url:
        rec.source = "direct-download-dmg"
        rec.manager = _label("direct-download-dmg")
        rec.origin_url = url
        rec.confidence = "heuristic"
        return rec

    # 5. Manual placement (no manager, no provenance).
    rec.source = "manual"
    rec.manager = _label("manual")
    rec.confidence = "heuristic"
    return rec


def _mac_classify_cli(rp: str, name: str, ctx: MacCtx) -> AppRecord:
    rec = AppRecord(name=name, kind="cli", path=rp, source="unknown", mtime=_mtime(rp))
    # CLI shim that points into a GUI .app bundle → attribute to that app.
    if ".app/Contents/" in rp:
        app = Path(rp[: rp.index(".app/Contents/") + 4])
        sub = _mac_classify_app(app, ctx, evidence=False)
        rec.source, rec.manager, rec.package = sub.source, sub.manager, sub.package
        rec.confidence = sub.confidence
        rec.detail = f"CLI shim into {app.name}"
        return rec
    if "/Caskroom/" in rp:
        rec.source, rec.manager, rec.confidence = "homebrew-cask", _label("homebrew-cask"), "authoritative"
        return rec
    if "/Cellar/" in rp or (ctx.brew_prefix and rp.startswith(ctx.brew_prefix.rstrip("/") + "/")):
        rec.source, rec.manager, rec.confidence = "homebrew-formula", _label("homebrew-formula"), "authoritative"
        return rec
    lang = _lang_source_for_path(rp)
    if lang:
        rec.source, rec.package = lang
        rec.manager, rec.confidence = _label(lang[0]), "authoritative"
        return rec
    # System / SIP binaries.
    if rp.startswith(("/usr/bin/", "/bin/", "/usr/sbin/", "/sbin/", "/System/")):
        rec.source, rec.manager, rec.confidence = "macos-system", _label("macos-system"), "authoritative"
        return rec
    if _shared_user_bin(rp):
        return _classify_user_bin(rec, rp)
    if rp.startswith("/usr/local/") or rp.startswith(str(HOME)):
        rec.source, rec.manager = "manual", _label("manual")
        return rec
    rec.manager = _label("unknown")
    return rec


# ===========================================================================
# Linux
# ===========================================================================
_LINUX_DESKTOP_DIRS = [
    "/usr/share/applications",
    str(HOME / ".local/share/applications"),
    "/var/lib/flatpak/exports/share/applications",
    str(HOME / ".local/share/flatpak/exports/share/applications"),
    "/var/lib/snapd/desktop/applications",
]


class LinuxCtx:
    def __init__(self) -> None:
        self._snaps: set[str] | None = None
        self._flatpaks: set[str] | None = None
        self._brew_prefix: str | None = "?"

    @property
    def snaps(self) -> set[str]:
        if self._snaps is None:
            self._snaps = set()
            if _has("snap"):
                rc, so, _ = _run(["snap", "list"], timeout=15)
                if rc == 0:
                    for line in so.splitlines()[1:]:
                        parts = line.split()
                        if parts:
                            self._snaps.add(parts[0].lower())
        return self._snaps

    @property
    def flatpaks(self) -> set[str]:
        if self._flatpaks is None:
            self._flatpaks = set()
            if _has("flatpak"):
                rc, so, _ = _run(["flatpak", "list", "--app", "--columns=application,name"], timeout=15)
                if rc == 0:
                    for line in so.splitlines():
                        for field in line.split("\t"):
                            if field.strip():
                                self._flatpaks.add(field.strip().lower())
        return self._flatpaks

    @property
    def brew_prefix(self) -> str | None:
        if self._brew_prefix == "?":
            self._brew_prefix = None
            for p in (f"{HOME}/.linuxbrew", "/home/linuxbrew/.linuxbrew"):
                if Path(p, "bin", "brew").exists():
                    self._brew_prefix = p
                    break
        return self._brew_prefix


def _dpkg_owner(rp: str) -> str | None:
    if not _has("dpkg"):
        return None
    rc, so, _ = _run(["dpkg", "-S", rp], timeout=15)
    if rc == 0 and ":" in so:
        return so.split(":", 1)[0].strip()
    return None


def _rpm_owner(rp: str) -> str | None:
    if not _has("rpm"):
        return None
    rc, so, _ = _run(["rpm", "-qf", rp], timeout=15)
    if rc == 0 and so.strip() and "not owned" not in so:
        return so.strip().splitlines()[0]
    return None


def _linux_classify_path(rp: str, name: str, ctx: LinuxCtx, *, kind: str) -> AppRecord:
    rec = AppRecord(name=name, kind=kind, path=rp, source="unknown", mtime=_mtime(rp))
    if rp.startswith("/snap/"):
        parts = rp.split("/")
        rec.source, rec.manager, rec.confidence = "snap", _label("snap"), "authoritative"
        rec.package = parts[2] if len(parts) > 2 else None
        return rec
    if rp.startswith("/var/lib/flatpak/") or rp.startswith(str(HOME / ".local/share/flatpak")):
        rec.source, rec.manager, rec.confidence = "flatpak", _label("flatpak"), "authoritative"
        return rec
    if rp.lower().endswith(".appimage"):
        rec.source, rec.manager, rec.confidence = "appimage", _label("appimage"), "authoritative"
        return rec
    if ctx.brew_prefix and rp.startswith(ctx.brew_prefix.rstrip("/") + "/"):
        rec.source, rec.manager, rec.confidence = "linuxbrew", _label("linuxbrew"), "authoritative"
        return rec
    lang = _lang_source_for_path(rp)
    if lang:
        rec.source, rec.package = lang
        rec.manager, rec.confidence = _label(lang[0]), "authoritative"
        return rec
    if _shared_user_bin(rp):
        return _classify_user_bin(rec, rp)
    owner = _dpkg_owner(rp) or _rpm_owner(rp)
    if owner:
        rec.source, rec.manager, rec.package, rec.confidence = "apt", _label("apt"), owner, "authoritative"
        return rec
    if rp.startswith("/usr/local/") or rp.startswith(str(HOME)):
        rec.source, rec.manager = "manual", _label("manual")
        return rec
    rec.manager = _label("unknown")
    return rec


def _linux_desktop_apps() -> list[tuple[str, str]]:
    """Return (display_name, exec_path) for GUI apps from .desktop files.

    Reuses the directory set + Name/Exec parsing idiom from
    dot_config/shell/56_linux_apps.sh (the debugged version).
    """
    seen: dict[str, tuple[str, str]] = {}
    for d in _LINUX_DESKTOP_DIRS:
        dd = Path(d)
        if not dd.is_dir():
            continue
        for f in sorted(dd.glob("*.desktop")):
            name = exec_line = ""
            nodisplay = False
            try:
                for line in f.read_text(encoding="utf-8", errors="replace").splitlines():
                    if line.startswith("Name=") and not name:
                        name = line[5:].strip()
                    elif line.startswith("Exec=") and not exec_line:
                        exec_line = line[5:].strip()
                    elif line.startswith("NoDisplay=") and line[10:].strip().lower() == "true":
                        nodisplay = True
            except OSError:
                continue
            if nodisplay or not name or not exec_line:
                continue
            # Strip %f/%u field codes; take the argv[0] token.
            cmd = re.sub(r"\s+%[a-zA-Z]", "", exec_line).split()
            if not cmd:
                continue
            token = cmd[0]
            path = token
            if token in ("flatpak", "snap", "gio"):
                path = exec_line  # keep whole line; classifier reads /var/lib markers
            elif not token.startswith("/"):
                resolved = shutil.which(token)
                path = _realpath(resolved) if resolved else token
            else:
                path = _realpath(token)
            seen.setdefault(name, (name, path))
    return list(seen.values())


# ===========================================================================
# Enumeration + orchestration
# ===========================================================================
def _mac_gui_apps() -> list[Path]:
    apps: list[Path] = []
    for base in ("/Applications", str(HOME / "Applications")):
        bd = Path(base)
        if bd.is_dir():
            apps.extend(sorted(bd.glob("*.app")))
    return apps


def _path_binaries() -> list[tuple[str, str]]:
    """(command_name, resolved_path) for every executable on $PATH, deduped."""
    seen_rp: set[str] = set()
    result: list[tuple[str, str]] = []
    seen_name: set[str] = set()
    for d in os.environ.get("PATH", "").split(os.pathsep):
        if not d:
            continue
        dd = Path(d)
        try:
            entries = sorted(dd.iterdir())
        except OSError:
            continue
        for entry in entries:
            name = entry.name
            if name in seen_name:
                continue
            try:
                if not (entry.is_file() or entry.is_symlink()):
                    continue
                if not os.access(entry, os.X_OK):
                    continue
            except OSError:
                continue
            rp = _realpath(entry)
            if rp in seen_rp:
                seen_name.add(name)
                continue
            seen_rp.add(rp)
            seen_name.add(name)
            result.append((name, rp))
    return result


def _classify_gui(path: Path, mac_ctx, lin_ctx, *, evidence: bool) -> AppRecord:
    if IS_MAC:
        return _mac_classify_app(path, mac_ctx, evidence=evidence)
    return _linux_classify_path(_realpath(path), path.name, lin_ctx, kind="gui")


def _classify_cli(name: str, rp: str, mac_ctx, lin_ctx) -> AppRecord:
    if IS_MAC:
        return _mac_classify_cli(rp, name, mac_ctx)
    return _linux_classify_path(rp, name, lin_ctx, kind="cli")


# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
def _cache_path() -> Path:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    d = Path(base) / "appsrc"
    d.mkdir(parents=True, exist_ok=True)
    host = socket.gethostname().split(".")[0] or "host"
    return d / f"{host}.json"


def _cache_load() -> dict[str, dict]:
    p = _cache_path()
    if not p.is_file():
        return {}
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return {}
    if data.get("version") != _CACHE_VERSION:
        return {}
    items = data.get("items")
    return items if isinstance(items, dict) else {}


def _cache_save(items: dict[str, dict]) -> None:
    p = _cache_path()
    tmp = p.with_suffix(".json.tmp")
    payload = {
        "version": _CACHE_VERSION,
        "generated_at": time.time(),
        "host": socket.gethostname().split(".")[0],
        "items": items,
    }
    try:
        tmp.write_text(json.dumps(payload, indent=2, default=str), encoding="utf-8")
        os.replace(tmp, p)
    except OSError as e:
        err.print(f"[yellow]appsrc: cache write failed: {e}[/yellow]")


# ---------------------------------------------------------------------------
# scan
# ---------------------------------------------------------------------------
def do_scan(args: argparse.Namespace) -> int:
    mac_ctx = MacCtx() if IS_MAC else None
    lin_ctx = LinuxCtx() if IS_LINUX else None

    kind = args.kind
    if getattr(args, "sort", "source") == "size":
        args.size = True  # can't sort by size without sizing
    loaded = _cache_load()                                  # always load, for cumulative merge
    cache = {} if (args.refresh or args.no_cache) else loaded  # used for mtime matching

    # (path_key, rec) pairs so we can size in parallel and rebuild the cache.
    keyed: list[tuple[str, AppRecord]] = []

    def resolve(path_key: str, mt: float | None, compute) -> AppRecord:
        cached = cache.get(path_key)
        if cached and mt is not None and cached.get("mtime") == mt:
            rec = AppRecord(**{k: v for k, v in cached.items() if k in AppRecord.__annotations__})
        else:
            rec = compute()
        keyed.append((path_key, rec))
        return rec

    if kind in ("gui", "all"):
        if IS_MAC:
            for app in _mac_gui_apps():
                resolve(str(app), _mtime(app),
                        lambda a=app: _mac_classify_app(a, mac_ctx, evidence=False))
        elif IS_LINUX:
            for name, path in _linux_desktop_apps():
                resolve(f"gui::{name}", _mtime(path),
                        lambda n=name, p=path: _linux_classify_path(_realpath(p), n, lin_ctx, kind="gui"))

    if kind in ("cli", "all"):
        for name, rp in _path_binaries():
            resolve(rp, _mtime(rp),
                    lambda n=name, r=rp: _classify_cli(n, r, mac_ctx, lin_ctx))

    records = [rec for _, rec in keyed]

    # --size rides the mtime cache; size only the still-unsized ones. Batch the
    # `du` calls (one line per path) — a cold full scan drops from ~40s of
    # per-item forks to a few seconds (this was the "stuck on sort" perf bug).
    if args.size:
        todo = [r for r in records if r.size_bytes is None and r.path]
        if todo:
            sizes = _du_many([r.path for r in todo])
            for r in todo:
                r.size_bytes = sizes.get(r.path)

    if not args.no_cache:
        # Cumulative cache: keep entries for kinds NOT scanned this run (a `gui`
        # scan must not evict the `cli` sizes) so a full-inventory size stays warm.
        merged = dict(loaded)
        merged.update({k: asdict(rec) for k, rec in keyed})
        _cache_save(merged)

    if args.source:
        f = args.source.lower()
        records = [r for r in records if f in r.source.lower() or f in _label(r.source).lower()]

    sort = getattr(args, "sort", "source")
    if sort == "size":
        records.sort(key=lambda r: -(r.size_bytes or 0))
    elif sort == "name":
        records.sort(key=lambda r: r.name.lower())
    else:
        records.sort(key=lambda r: (r.source, r.name.lower()))

    if args.json:
        print(json.dumps([asdict(r) for r in records], indent=2, default=str))
        return 0

    if args.tsv:
        for r in records:
            row = [r.name, _label(r.source), r.path or "", r.kind, r.package or ""]
            if args.size:
                if getattr(args, "human", False):
                    row.append(_human(r.size_bytes) if r.size_bytes is not None else "")
                else:
                    row.append(str(r.size_bytes) if r.size_bytes is not None else "")
            print("\t".join(row))
        return 0

    render_table(records, kind, show_size=args.size)
    return 0


# ---------------------------------------------------------------------------
# which
# ---------------------------------------------------------------------------
def _find_gui_app(name: str) -> Path | None:
    if name.lower().endswith(".app"):
        cand = Path(name)
        if cand.is_absolute() and cand.exists():
            return cand
    stem_lc = (name[:-4] if name.lower().endswith(".app") else name).lower()
    # Glob-scan (not an exact Path check) so we return the real on-disk casing —
    # APFS is case-insensitive, so `/Applications/docker.app` "exists" but would
    # mislabel the app "docker" instead of "Docker".
    for base in ("/Applications", str(HOME / "Applications")):
        bd = Path(base)
        if bd.is_dir():
            for app in bd.glob("*.app"):
                if app.stem.lower() == stem_lc:
                    return app
    return None


def _resolve_record(name: str, path: str, mac_ctx, lin_ctx, prefer_app: bool = False) -> AppRecord | None:
    """Resolve a NAME (command or GUI app) or explicit --path to an AppRecord.

    evidence=True so macOS bundle_id/signer are populated (needed for sizing).
    prefer_app=True (used by `size`) resolves a GUI app ahead of a same-named
    command, and maps a CLI shim living inside a .app back to that .app — so
    `appsrc size docker` sizes Docker.app + its containers, not the CLI shim.
    Returns None if nothing matches. Shared by `which` and `size`.
    """
    if path:
        p = Path(path)
        if IS_MAC and p.suffix == ".app":
            return _mac_classify_app(p, mac_ctx, evidence=True)
        if IS_MAC:
            return _mac_classify_cli(_realpath(p), p.name, mac_ctx)
        return _linux_classify_path(_realpath(p), p.name, lin_ctx,
                                    kind="gui" if p.suffix == ".desktop" else "cli")
    if prefer_app and IS_MAC and name:
        app = _find_gui_app(name)
        if app:
            return _mac_classify_app(app, mac_ctx, evidence=True)
    cmd = shutil.which(name)
    if cmd:
        rp = _realpath(cmd)
        if prefer_app and IS_MAC and ".app/Contents/" in rp:
            app = Path(rp[: rp.index(".app/Contents/") + 4])
            return _mac_classify_app(app, mac_ctx, evidence=True)
        return _classify_cli(name, rp, mac_ctx, lin_ctx)
    if IS_MAC:
        app = _find_gui_app(name)
        return _mac_classify_app(app, mac_ctx, evidence=True) if app else None
    if IS_LINUX:
        match = next((x for x in _linux_desktop_apps() if x[0].lower() == name.lower()), None)
        if match:
            return _linux_classify_path(_realpath(match[1]), match[0], lin_ctx, kind="gui")
    return None


def do_which(args: argparse.Namespace) -> int:
    mac_ctx = MacCtx() if IS_MAC else None
    lin_ctx = LinuxCtx() if IS_LINUX else None
    rec = _resolve_record(args.name, args.path, mac_ctx, lin_ctx)
    if rec is None:
        err.print(f"[red]appsrc: '{args.name or args.path}' not found on PATH or as an app.[/red]")
        return 1
    if args.json:
        print(json.dumps(asdict(rec), indent=2, default=str))
        return 0
    render_detail(rec)
    return 0


# ---------------------------------------------------------------------------
# size — footprint + associated storage
# ---------------------------------------------------------------------------
def _name_candidates(rec: AppRecord, app: Path | None) -> list[str]:
    """Name variants an app might use for its data/cache dirs (fuzzy matching)."""
    cands: list[str] = []

    def add(x: str | None) -> None:
        if x and x not in cands:
            cands.append(x)

    add(rec.name)
    if app is not None:
        add(app.stem)
        add(_mac_bundle_name(app))
    if rec.bundle_id:
        parts = rec.bundle_id.split(".")
        add(parts[-1])                          # product
        if len(parts) >= 3:
            add(f"{parts[-2]}/{parts[-1]}")     # Vendor/Product nesting (Google/Chrome)
    return cands


def _dedup_nested(items: list[StorageItem]) -> list[StorageItem]:
    """Drop any item whose path sits inside another kept item's path.

    A vendor/app data dir already contains its cache subdir; counting both
    would double-count. Keep the shortest (ancestor) path, drop descendants.
    """
    kept: list[StorageItem] = []
    for it in sorted(items, key=lambda i: len(i.path)):
        if any(it.path == k.path or it.path.startswith(k.path.rstrip("/") + "/") for k in kept):
            continue
        kept.append(it)
    return kept


def _sized_item(category: str, path: Path, confidence: str, note: str | None = None) -> StorageItem | None:
    if not path.exists():
        return None
    readable = os.access(path, os.R_OK)
    size = _du_bytes(path) if readable else None
    if not readable and note is None:
        note = "needs root"
    return StorageItem(category=category, path=str(path), size_bytes=size,
                       confidence=confidence, note=note)


def _mac_associated(rec: AppRecord, app: Path) -> list[StorageItem]:
    bid = rec.bundle_id
    lib = HOME / "Library"
    items: list[StorageItem] = []
    seen: set[str] = set()

    def push(it: StorageItem | None) -> None:
        if it and it.path not in seen:
            seen.add(it.path)
            items.append(it)

    if bid:
        for cat, p in (
            ("cache", lib / "Caches" / bid),
            ("cache", lib / "HTTPStorages" / bid),
            ("container", lib / "Containers" / bid),
            ("data", lib / "Application Scripts" / bid),
            ("prefs", lib / "Preferences" / f"{bid}.plist"),
            ("state", lib / "Saved Application State" / f"{bid}.savedState"),
            ("web", lib / "WebKit" / bid),
            ("web", lib / "Cookies" / f"{bid}.binarycookies"),
        ):
            push(_sized_item(cat, p, "exact"))
        for gc in (lib / "Group Containers").glob(f"*{bid}*"):
            push(_sized_item("container", gc, "exact"))
        for la in (lib / "LaunchAgents").glob(f"*{bid}*.plist"):
            push(_sized_item("launch", la, "exact"))
        for bh in (lib / "Preferences" / "ByHost").glob(f"{bid}.*"):
            push(_sized_item("prefs", bh, "exact"))
        for sysdir in (Path("/Library/LaunchDaemons"), Path("/Library/LaunchAgents")):
            for la in sysdir.glob(f"*{bid}*"):
                push(_sized_item("launch", la, "exact"))

    for cand in _name_candidates(rec, app):
        for base, cat in ((lib / "Application Support", "data"),
                          (lib / "Caches", "cache"),
                          (lib / "Logs", "logs"),
                          (Path("/Library/Application Support"), "data")):
            push(_sized_item(cat, base / cand, "fuzzy"))
    return items


def _cli_associated(rec: AppRecord) -> list[StorageItem]:
    items: list[StorageItem] = []
    seen: set[str] = set()

    def push(it: StorageItem | None) -> None:
        if it and it.path not in seen:
            seen.add(it.path)
            items.append(it)

    for cand in _name_candidates(rec, None):
        for base, cat in ((HOME / ".config", "data"), (HOME / ".cache", "cache"),
                          (HOME / ".local/share", "data"), (HOME / ".local/state", "state")):
            push(_sized_item(cat, base / cand, "fuzzy"))
        if IS_MAC:
            push(_sized_item("cache", HOME / "Library/Caches" / cand, "fuzzy"))
            push(_sized_item("data", HOME / "Library/Application Support" / cand, "fuzzy"))
    return items


def _linux_associated(rec: AppRecord) -> list[StorageItem]:
    items: list[StorageItem] = []
    nm = rec.package or rec.name
    if rec.source == "snap":
        for p in (HOME / "snap" / nm, Path("/var/snap") / nm):
            it = _sized_item("data", p, "exact")
            if it:
                items.append(it)
    elif rec.source == "flatpak":
        it = _sized_item("data", HOME / ".var/app" / nm, "fuzzy")
        if it:
            items.append(it)
    return items + _cli_associated(rec)


def _bundle_size(rec: AppRecord) -> tuple[int | None, str | None]:
    """(bytes, path_used). Walks up to the Homebrew keg / uses pkg metadata where apt."""
    if rec.source == "apt" and rec.package and _has("dpkg-query"):
        rc, so, _ = _run(["dpkg-query", "-W", "-f=${Installed-Size}", rec.package], timeout=10)
        if rc == 0 and so.strip().isdigit():
            return int(so.strip()) * 1024, f"dpkg:{rec.package}"
    if rec.source == "snap":
        keg = f"/snap/{rec.package or rec.name}/current"
        return _du_bytes(keg), keg
    if not rec.path:
        return None, None
    p = rec.path
    if rec.kind == "cli" and "/Cellar/" in p:
        idx = p.index("/Cellar/") + len("/Cellar/")
        rest = p[idx:].split("/")
        if len(rest) >= 2:
            keg = p[:idx] + "/".join(rest[:2])   # Cellar/<formula>/<version>
            return _du_bytes(keg), keg
    return _du_bytes(p), p


def compute_size(rec: AppRecord) -> SizeReport:
    bundle_bytes, bpath = _bundle_size(rec)
    items: list[StorageItem] = []
    if bpath:
        items.append(StorageItem("bundle", bpath, bundle_bytes, "exact"))
    if IS_MAC and rec.kind == "gui" and rec.path:
        items += _mac_associated(rec, Path(rec.path))
    elif IS_LINUX and rec.kind == "gui":
        items += _linux_associated(rec)
    else:
        items += _cli_associated(rec)
    items = _dedup_nested(items)
    assoc = sum(i.size_bytes or 0 for i in items if i.category != "bundle")
    total = (bundle_bytes or 0) + assoc
    return SizeReport(name=rec.name, source=rec.source, kind=rec.kind, path=rec.path,
                      bundle_bytes=bundle_bytes, associated_bytes=assoc,
                      total_bytes=total, items=items)


def do_size(args: argparse.Namespace) -> int:
    mac_ctx = MacCtx() if IS_MAC else None
    lin_ctx = LinuxCtx() if IS_LINUX else None
    rec = _resolve_record(args.name, args.path, mac_ctx, lin_ctx, prefer_app=True)
    if rec is None:
        err.print(f"[red]appsrc: '{args.name or args.path}' not found on PATH or as an app.[/red]")
        return 1
    rep = compute_size(rec)
    if args.json:
        print(json.dumps(asdict(rep), indent=2, default=str))
        return 0
    render_size(rep)
    return 0


# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
def render_table(records: list[AppRecord], kind: str, show_size: bool = False) -> None:
    if not records:
        err.print("[yellow]appsrc: nothing found.[/yellow]")
        return
    t = Table(title=f"Installed {kind} — install source", header_style="bold", expand=False)
    t.add_column("Name", overflow="fold")
    t.add_column("Source")
    t.add_column("Package", overflow="fold")
    t.add_column("Kind")
    if show_size:
        t.add_column("Size", justify="right")
    t.add_column("Path", overflow="fold", style="dim")
    for r in records:
        color = SOURCE_COLOR.get(r.source, "white")
        src = Text(_label(r.source), style=color)
        if r.confidence != "authoritative":
            src.append(" ?", style="dim")
        row = [r.name, src, r.package or "", r.kind]
        if show_size:
            row.append(_human(r.size_bytes))
        row.append(r.path or "")
        t.add_row(*row)
    out.print(t)
    # Source tally.
    tally: dict[str, int] = {}
    for r in records:
        tally[r.source] = tally.get(r.source, 0) + 1
    summary = "  ".join(f"[{SOURCE_COLOR.get(s,'white')}]{_label(s)}[/]: {n}"
                        for s, n in sorted(tally.items(), key=lambda kv: -kv[1]))
    extra = ""
    if show_size:
        tot = sum(r.size_bytes or 0 for r in records)
        extra = f"   [bold]{_human(tot)}[/bold] sized"
    out.print(f"\n{len(records)} total   {summary}{extra}")


def render_detail(r: AppRecord) -> None:
    color = SOURCE_COLOR.get(r.source, "white")
    out.print(f"[bold]{r.name}[/bold]  ([{color}]{_label(r.source)}[/])"
              + ("" if r.confidence == "authoritative" else "  [dim](heuristic)[/dim]"))
    rows = [
        ("kind", r.kind),
        ("path", r.path),
        ("package", r.package),
        ("bundle id", r.bundle_id),
        ("signer", r.signer),
        ("origin", r.origin_url),
        ("note", r.detail),
    ]
    for k, v in rows:
        if v:
            out.print(f"  [dim]{k:<10}[/dim] {v}")


def render_size(rep: SizeReport) -> None:
    color = SOURCE_COLOR.get(rep.source, "white")
    out.print(f"[bold]{rep.name}[/bold]  ([{color}]{_label(rep.source)}[/])   "
              f"total [bold]{_human(rep.total_bytes)}[/bold]")
    out.print(f"  [dim]bundle[/dim] {_human(rep.bundle_bytes)}    "
              f"[dim]other[/dim] {_human(rep.associated_bytes)}")
    if len(rep.items) <= 1:
        out.print("  [dim](no associated storage found)[/dim]")
        return
    rows = sorted(rep.items, key=lambda i: (i.category != "bundle", -(i.size_bytes or 0)))
    t = Table(header_style="bold", expand=False, show_edge=False, pad_edge=False, box=None)
    t.add_column("Size", justify="right")
    t.add_column("Category")
    t.add_column("Path", overflow="fold", style="dim")
    for it in rows:
        cat = it.category if it.confidence == "exact" else f"[dim]{it.category} ?[/dim]"
        path_cell = it.path if not it.note else f"{it.path}  [yellow dim]({it.note})[/yellow dim]"
        t.add_row(_human(it.size_bytes), cat, path_cell)
    out.print(t)
    if any(i.confidence == "fuzzy" for i in rep.items):
        out.print("  [dim]? = fuzzy (name-based) match — verify before acting; never auto-deleted[/dim]")


# ---------------------------------------------------------------------------
# TUI (Textual) — interactive dashboard; textual imported lazily in _run_tui
# ---------------------------------------------------------------------------
# The TUI shells out to `<self> scan/size --json` via asyncio-native subprocess
# (NOT blocking subprocess in a worker thread — that intermittently deadlocks
# under Textual's asyncio loop, since a scan spawns thousands of child procs).
# The child does all the brew/mdls/du work synchronously in its own process.
_SELF = os.path.abspath(__file__)


def _rec_from_dict(d: dict) -> AppRecord:
    return AppRecord(**{k: d.get(k) for k in AppRecord.__annotations__})


def _copy_to_clipboard(text: str) -> bool:
    for cmd in (["pbcopy"], ["wl-copy"], ["xclip", "-selection", "clipboard"]):
        if _has(cmd[0]):
            try:
                subprocess.run(cmd, input=text, text=True, timeout=5, check=False)
                return True
            except OSError:
                pass
    return False


def _reveal_path(path: str) -> None:
    if IS_MAC:
        _run(["open", "-R", path], timeout=5)
    elif _has("xdg-open"):
        _run(["xdg-open", path], timeout=5)


def _size_report_lines(rep: SizeReport) -> str:
    lines = [
        f"{rep.name}  ({_label(rep.source)})   total {_human(rep.total_bytes)}",
        f"  bundle {_human(rep.bundle_bytes)}    other {_human(rep.associated_bytes)}",
        "",
    ]
    for it in sorted(rep.items, key=lambda i: (i.category != "bundle", -(i.size_bytes or 0))):
        tag = "" if it.confidence == "exact" else " ?"
        note = f"  ({it.note})" if it.note else ""
        lines.append(f"{_human(it.size_bytes):>8}  {it.category + tag:<12} {it.path}{note}")
    if any(i.confidence != "exact" for i in rep.items):
        lines += ["", "? = fuzzy (name-based) match — verify before acting"]
    return "\n".join(lines)


def do_tui(args: argparse.Namespace) -> int:
    if not sys.stdout.isatty():
        err.print("[red]appsrc tui: needs a terminal (TTY). Use `appsrc scan` for pipes.[/red]")
        return 2
    try:
        return _run_tui(args.kind)
    except ModuleNotFoundError as e:
        err.print(f"[red]appsrc tui: {e}. Textual missing — reinstall the tool's deps.[/red]")
        return 2


def _run_tui(kind: str) -> int:
    _tui_app(kind).run()
    return 0


def _tui_app(kind: str):
    """Build (but don't run) the Textual app — factored out so run_test() pilots it."""
    import asyncio
    import shlex

    from textual import on, work
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import Vertical
    from textual.screen import ModalScreen
    from textual.widgets import DataTable, Footer, Header, Input, Static

    class DetailScreen(ModalScreen):
        BINDINGS = [Binding("escape,q,enter", "close", "Close")]
        CSS = """
        DetailScreen { align: center middle; }
        #box { width: 90%; height: 80%; border: round $accent; padding: 1 2; background: $surface; }
        """

        def __init__(self, title: str) -> None:
            super().__init__()
            self._title = title

        def compose(self) -> ComposeResult:
            with Vertical(id="box"):
                yield Static(f"{self._title}\n", id="content")

        def on_mount(self) -> None:
            self.query_one("#content", Static).loading = True   # spinner until filled

        def set_text(self, text: str) -> None:
            c = self.query_one("#content", Static)
            c.loading = False
            c.update(text)

        def action_close(self) -> None:
            self.dismiss()

    class AppsrcTUI(App):
        TITLE = "appsrc"
        CSS = """
        #filter { dock: top; display: none; }
        #filter.on { display: block; }
        #status { dock: bottom; height: 1; color: $text-muted; }
        DataTable { height: 1fr; }
        """
        BINDINGS = [
            Binding("q", "quit", "Quit"),
            Binding("slash", "filter", "Filter"),
            Binding("escape", "unfilter", "Esc", show=False),
            Binding("s", "sort_size", "Size↓"),
            Binding("o", "sort_source", "Source"),
            Binding("n", "sort_name", "Name"),
            Binding("t", "tldr", "tldr"),
            Binding("m", "man", "man"),
            Binding("y", "copy", "Copy"),
            Binding("r", "reveal", "Reveal"),
            Binding("R", "rescan", "Rescan"),
        ]

        def __init__(self, kind: str) -> None:
            super().__init__()
            self._kind = kind
            self._records: list[AppRecord] = []
            self._view: list[AppRecord] = []
            self._sort = "source"
            self._filter = ""

        def compose(self) -> ComposeResult:
            yield Header()
            yield Input(placeholder="filter — name / source…", id="filter")
            yield DataTable(id="table", cursor_type="row", zebra_stripes=True)
            yield Static("scanning…", id="status")
            yield Footer()

        def on_mount(self) -> None:
            t = self.query_one("#table", DataTable)
            t.add_columns("Name", "Source", "Kind", "Size", "Path")
            self.query_one("#filter", Input).can_focus = False  # don't let it eat s/o/n/y/r keys
            t.loading = True   # animated spinner until the first scan lands
            t.focus()
            self._scan()

        # ---- data (asyncio-native subprocess; NEVER blocking subprocess in a
        #      worker thread — that deadlocks under Textual's loop) ----
        async def _run_json(self, args: list[str], timeout: float = 300.0):
            try:
                proc = await asyncio.create_subprocess_exec(
                    sys.executable, _SELF, *args, "--json",
                    stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
                    stdin=asyncio.subprocess.DEVNULL)
                out, _ = await asyncio.wait_for(proc.communicate(), timeout=timeout)
                return json.loads(out.decode() or "null")
            except (OSError, ValueError, asyncio.TimeoutError):
                return None

        @work(exclusive=True, group="scan")
        async def _scan(self) -> None:
            table = self.query_one("#table", DataTable)
            table.loading = True
            self._set_status("scanning…")
            data = await self._run_json(["scan", "--kind", self._kind])
            table.loading = False
            if not isinstance(data, list):
                self._set_status("scan failed — try `appsrc scan` in a shell")
                return
            self._records = [_rec_from_dict(d) for d in data]
            self._rebuild()
            self.query_one("#table", DataTable).focus()
            self._set_status(
                f"{len(self._records)} items — [s]ize  [o/n]sort  [/]filter  [enter]detail  "
                "[t]ldr  [m]an  [y]copy  [r]eveal  [R]escan  [q]uit")

        @work(exclusive=True, group="size")
        async def _size_view(self) -> None:
            # Sort by size. Sizes may already be present (shared cache warmed by a
            # prior --size run); otherwise fetch them in ONE cached subprocess
            # (batched `du` inside → a few seconds), keeping rows visible.
            try:
                if any(r.size_bytes is None and r.path for r in self._records):
                    self._set_status("computing sizes… (first run may take a few seconds; cached after)")
                    data = await self._run_json(["scan", "--kind", self._kind, "--size"])
                    if isinstance(data, list):
                        self._records = [_rec_from_dict(d) for d in data]
                self._sort = "size"
                self._rebuild()
                self._set_status(f"{len(self._view)} shown — sorted by size (biggest first)")
            except Exception as e:  # noqa: BLE001 — surface, don't hang
                self._set_status(f"size failed: {e}")

        @work(exclusive=True, group="detail")
        async def _detail(self, rec: AppRecord) -> None:
            screen = DetailScreen(rec.name)
            await self.push_screen(screen)   # open immediately with a spinner
            self._set_status(f"sizing {rec.name}…")
            arg = ["size", "--path", rec.path] if rec.path else ["size", rec.name]
            data = await self._run_json(arg)
            try:
                if not isinstance(data, dict):
                    screen.set_text("size failed")
                else:
                    rep = SizeReport(
                        name=data.get("name", rec.name), source=data.get("source", rec.source),
                        kind=data.get("kind", rec.kind), path=data.get("path"),
                        bundle_bytes=data.get("bundle_bytes"), associated_bytes=data.get("associated_bytes", 0),
                        total_bytes=data.get("total_bytes", 0),
                        items=[StorageItem(category=it.get("category", ""), path=it.get("path", ""),
                                           size_bytes=it.get("size_bytes"), confidence=it.get("confidence", "exact"),
                                           note=it.get("note")) for it in data.get("items", [])])
                    screen.set_text(_size_report_lines(rep))
            except Exception:  # noqa: BLE001 — modal was closed before sizing finished
                pass
            self._set_status(f"{len(self._view)} shown")

        # ---- view helpers ----
        def _apply(self) -> None:
            f = self._filter.lower()
            self._view = [
                r for r in self._records
                if not f or f in r.name.lower() or f in r.source.lower() or f in _label(r.source).lower()
            ]
            if self._sort == "size":
                self._view.sort(key=lambda r: -(r.size_bytes or 0))
            elif self._sort == "name":
                self._view.sort(key=lambda r: r.name.lower())
            else:
                self._view.sort(key=lambda r: (r.source, r.name.lower()))

        def _rebuild(self) -> None:
            self._apply()
            t = self.query_one("#table", DataTable)
            t.clear()
            for r in self._view:
                t.add_row(r.name, _label(r.source), r.kind,
                          _human(r.size_bytes) if r.size_bytes is not None else "—",
                          r.path or "")

        def _set_status(self, msg: str) -> None:
            self.query_one("#status", Static).update(msg)

        def _current(self) -> "AppRecord | None":
            t = self.query_one("#table", DataTable)
            row = t.cursor_row
            return self._view[row] if 0 <= row < len(self._view) else None

        # ---- actions ----
        def action_filter(self) -> None:
            inp = self.query_one("#filter", Input)
            inp.can_focus = True
            inp.add_class("on")
            inp.focus()

        def action_unfilter(self) -> None:
            inp = self.query_one("#filter", Input)
            inp.value = ""
            inp.remove_class("on")
            inp.can_focus = False
            self._filter = ""
            self._rebuild()
            self.query_one("#table", DataTable).focus()

        @on(Input.Changed, "#filter")
        def _on_filter(self, e: Input.Changed) -> None:
            self._filter = e.value
            self._rebuild()

        @on(Input.Submitted, "#filter")
        def _on_submit(self, _e: Input.Submitted) -> None:
            self.query_one("#table", DataTable).focus()

        def action_sort_size(self) -> None:
            self._size_view()   # sizes any unsized visible rows, then sorts by size

        def action_sort_source(self) -> None:
            self._sort = "source"
            self._rebuild()

        def action_sort_name(self) -> None:
            self._sort = "name"
            self._rebuild()

        def _suspend_run(self, shell_cmd: str) -> None:
            """Drop out of the TUI to run a pager (man/tldr) in the real terminal."""
            with self.suspend():
                try:
                    subprocess.run(["sh", "-c", shell_cmd], check=False)
                except OSError:
                    pass
            self.query_one("#table", DataTable).focus()

        def action_tldr(self) -> None:
            rec = self._current()
            if not rec:
                return
            n = shlex.quote(rec.name)
            # tldr exits non-zero on a missing page → show a hint + wait.
            self._suspend_run(
                f"tldr {n} 2>/dev/null | ${{PAGER:-less}} -R "
                f"|| {{ printf '\\n  no tldr page for %s\\n  (press enter to return)… ' {n}; read -r _; }}")

        def action_man(self) -> None:
            rec = self._current()
            if not rec:
                return
            n = shlex.quote(rec.name)
            self._suspend_run(
                f"man {n} 2>/dev/null "
                f"|| {{ printf '\\n  no man page for %s\\n  (press enter to return)… ' {n}; read -r _; }}")

        @on(DataTable.RowSelected, "#table")
        def _row_selected(self, _e: "DataTable.RowSelected") -> None:
            rec = self._current()
            if rec:
                self._detail(rec)

        def action_copy(self) -> None:
            rec = self._current()
            if rec and rec.path:
                self._set_status(f"copied {rec.path}" if _copy_to_clipboard(rec.path) else "no clipboard tool")

        def action_reveal(self) -> None:
            rec = self._current()
            if rec and rec.path:
                _reveal_path(rec.path)

        def action_rescan(self) -> None:
            self._scan()

    return AppsrcTUI(kind)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="appsrc",
                                description="Detect how an installed app / CLI was installed & managed.")
    sub = p.add_subparsers(dest="cmd")

    ps = sub.add_parser("scan", help="Batch-inventory installed apps + CLIs (cached).")
    ps.add_argument("--json", action="store_true", help="Emit JSON.")
    ps.add_argument("--tsv", action="store_true",
                    help="Emit TSV: name<TAB>source<TAB>path<TAB>kind<TAB>package (for tv / scripts).")
    ps.add_argument("--kind", choices=["gui", "cli", "all"], default="all", help="Restrict inventory.")
    ps.add_argument("--source", default="", help="Filter by source id/label substring.")
    ps.add_argument("--sort", choices=["source", "name", "size"], default="source",
                    help="Sort order (size => biggest first; implies --size).")
    ps.add_argument("-r", "--refresh", action="store_true", help="Recompute; ignore cache.")
    ps.add_argument("--no-cache", action="store_true", help="Don't read or write cache.")
    ps.add_argument("--size", action="store_true",
                    help="Also compute each item's bundle size (slower; mtime-cached).")
    ps.add_argument("--human", action="store_true",
                    help="With --tsv, emit human-readable sizes (e.g. 3.7G) instead of bytes.")
    ps.add_argument("--list-names", action="store_true", help=argparse.SUPPRESS)

    pw = sub.add_parser("which", help="Single lookup (live): command or GUI app name.")
    pw.add_argument("name", nargs="?", default="", help="Command or app name.")
    pw.add_argument("--json", action="store_true", help="Emit JSON.")
    pw.add_argument("--path", default="", help="Classify PATH directly.")

    pz = sub.add_parser("size", help="Footprint + associated storage (cache/data/containers) for one app.")
    pz.add_argument("name", nargs="?", default="", help="Command or app name.")
    pz.add_argument("--json", action="store_true", help="Emit JSON.")
    pz.add_argument("--path", default="", help="Size PATH directly.")

    pt = sub.add_parser("tui", help="Interactive dashboard: sort by size, filter, drill in.")
    pt.add_argument("--kind", choices=["gui", "cli", "all"], default="all", help="Initial inventory.")

    # Default routing: bare `appsrc` / flags → scan; a bare word → `which WORD`.
    if not argv:
        argv = ["scan"]
    elif argv[0] in ("-h", "--help"):
        pass
    elif argv[0] not in ("scan", "which", "size", "tui"):
        argv = (["scan", *argv] if argv[0].startswith("-") else ["which", *argv])
    return p.parse_args(argv)


def _list_names() -> int:
    if IS_MAC:
        for app in _mac_gui_apps():
            print(app.stem)
    elif IS_LINUX:
        for name, _ in _linux_desktop_apps():
            print(name)
    return 0


def main() -> int:
    args = parse_args(sys.argv[1:])
    if getattr(args, "list_names", False):
        return _list_names()
    if args.cmd == "which":
        if not args.name and not args.path:
            err.print("[red]appsrc which: need a NAME or --path.[/red]")
            return 2
        return do_which(args)
    if args.cmd == "size":
        if not args.name and not args.path:
            err.print("[red]appsrc size: need a NAME or --path.[/red]")
            return 2
        return do_size(args)
    if args.cmd == "tui":
        return do_tui(args)
    return do_scan(args)


if __name__ == "__main__":
    sys.exit(main())
