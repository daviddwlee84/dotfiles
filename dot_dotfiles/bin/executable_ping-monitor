#!/usr/bin/env bash
#
# ping-monitor — record ping over time and flag latency spikes.
#
# Normal Wi-Fi gaming shows a low, steady baseline with occasional huge
# spikes. Pinging your own gateway isolates whether those spikes are local
# (Wi-Fi / router) vs. upstream: if the GATEWAY already spikes, the problem
# is the local wireless medium, not the ISP / game server. See
# docs/playbooks/wifi-latency-spikes.md.
#
# Usage:
#   ping-monitor [TARGET] [SPIKE_MS] [INTERVAL_S]
#   ping-monitor -g | --gateway [SPIKE_MS] [INTERVAL_S]
#
# Examples:
#   ping-monitor                 # ping default gateway, spike >100ms
#   ping-monitor -g 10           # gateway, flag anything >10ms (local test)
#   ping-monitor 8.8.8.8 150 0.5 # upstream, >150ms spike, every 0.5s
#
# Ctrl-C prints a summary (min/avg/max, p50/p95/p99, spike count, loss).
# A full log is written to ~/ping-monitor-YYYYmmdd-HHMMSS.log.

set -u

is_macos() { [[ "$(uname -s)" == Darwin ]]; }

default_gateway() {
    if is_macos; then
        route -n get default 2>/dev/null | awk '/gateway:/{print $2; exit}'
    else
        ip route show default 2>/dev/null | awk '/default/{print $3; exit}'
    fi
}

# One ICMP echo, ~$1s timeout, to $2. Prints the RTT in ms, or nothing on loss.
ping_once() {
    local timeout_s="$1" host="$2" out
    if is_macos; then
        out="$(ping -c1 -t"$timeout_s" "$host" 2>/dev/null)"
    else
        out="$(ping -c1 -W"$timeout_s" "$host" 2>/dev/null)"
    fi
    printf '%s' "$out" | sed -n 's/.*time=\([0-9.]*\) *ms.*/\1/p'
}

# ---- args ----
TARGET=""
case "${1:-}" in
    -g | --gateway)
        TARGET="$(default_gateway)"
        shift
        [[ -z "$TARGET" ]] && { echo "ping-monitor: could not find default gateway" >&2; exit 1; }
        ;;
    -h | --help)
        sed -n '3,28p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    "" ) ;;
    * ) TARGET="$1"; shift ;;
esac

if [[ -z "$TARGET" ]]; then
    TARGET="$(default_gateway)"
    [[ -z "$TARGET" ]] && { echo "ping-monitor: no target and no default gateway; pass a host" >&2; exit 1; }
    echo "No target given; using default gateway: $TARGET"
fi

THRESHOLD="${1:-100}"
INTERVAL="${2:-1}"
TIMEOUT=2

LOG="$HOME/ping-monitor-$(date +%Y%m%d-%H%M%S).log"

count=0 loss=0 spikes=0 sum=0 min="" max=0
times_file="$(mktemp)"

RED=$'\033[31m'; YEL=$'\033[33m'; DIM=$'\033[2m'; RST=$'\033[0m'

cleanup() {
    echo ""
    echo "================ summary ================"
    echo "target          : $TARGET"
    echo "spike threshold : ${THRESHOLD} ms"
    local total=$(( count + loss ))
    echo "packets         : $total  (ok $count / timeout $loss)"
    if (( total > 0 )); then
        echo "loss            : $(awk "BEGIN{printf \"%.1f\", $loss*100/$total}")%"
    fi
    if (( count > 0 )); then
        echo "min/avg/max     : ${min} / $(awk "BEGIN{printf \"%.1f\", $sum/$count}") / ${max} ms"
        sort -n "$times_file" > "${times_file}.s"
        local p50 p95 p99
        p50=$(awk '{a[NR]=$1} END{print a[int(NR*0.50)?int(NR*0.50):1]}' "${times_file}.s")
        p95=$(awk '{a[NR]=$1} END{print a[int(NR*0.95)?int(NR*0.95):1]}' "${times_file}.s")
        p99=$(awk '{a[NR]=$1} END{print a[int(NR*0.99)?int(NR*0.99):1]}' "${times_file}.s")
        echo "p50/p95/p99     : ${p50} / ${p95} / ${p99} ms"
        rm -f "${times_file}.s"
    fi
    echo "spikes          : ${spikes}  (>${THRESHOLD}ms)"
    echo "log             : $LOG"
    echo "========================================"
    rm -f "$times_file"
    exit 0
}
trap cleanup INT TERM

echo "Monitoring $TARGET  (spike >${THRESHOLD}ms, every ${INTERVAL}s)  log-> $LOG"
echo "Ctrl-C to stop and see the summary"
echo "----------------------------------------------"

while true; do
    ts="$(date '+%H:%M:%S')"
    t="$(ping_once "$TIMEOUT" "$TARGET")"
    if [[ -z "$t" ]]; then
        loss=$((loss + 1))
        line="$ts  TIMEOUT / loss"
        echo "${RED}${line}${RST}"; echo "$line" >> "$LOG"
    else
        count=$((count + 1))
        echo "$t" >> "$times_file"
        sum=$(awk "BEGIN{print $sum + $t}")
        [[ -z "$min" ]] && min="$t"
        (( $(awk "BEGIN{print ($t < $min)}") )) && min="$t"
        (( $(awk "BEGIN{print ($t > $max)}") )) && max="$t"
        if (( $(awk "BEGIN{print ($t >= $THRESHOLD)}") )); then
            spikes=$((spikes + 1))
            line="$ts  ${t} ms  <<< SPIKE"
            echo "${RED}${line}${RST}"; echo "$line" >> "$LOG"
        elif (( $(awk "BEGIN{print ($t >= $THRESHOLD*0.5)}") )); then
            line="$ts  ${t} ms"
            echo "${YEL}${line}${RST}"; echo "$line" >> "$LOG"
        else
            line="$ts  ${t} ms"
            echo "${DIM}${line}${RST}"; echo "$line" >> "$LOG"
        fi
    fi
    sleep "$INTERVAL"
done
