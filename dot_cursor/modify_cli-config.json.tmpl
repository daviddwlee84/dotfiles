#!/bin/sh
# chezmoi modify_ script: deep-merge a managed overlay into ~/.cursor/cli-config.json.
#
# Why: Cursor CLI rewrites this file at runtime (auth tokens, privacyCache,
# statsigBootstrap, hasChangedDefaultModel, etc). Tracking the whole file would
# leak secrets and produce constant diff. We only enforce the small set of
# stable preferences declared in the overlay.
#
# How: chezmoi pipes the current target file into stdin; this script prints
# the new contents on stdout. `jq '. * $overlay'` does recursive object merge,
# so only overlay keys are enforced; runtime keys (authInfo, privacyCache,
# statsigBootstrap, version, hasChangedDefaultModel, ...) are preserved.
#
# To manage an additional key: edit .chezmoitemplates/agents/cursor.cli-config.overlay.json
# Requires: jq (installed by the `base` ansible role). On a fresh-box first
# apply, jq isn't yet installed; this script falls back to passing the live
# file through unchanged. See pitfalls/modify-script-jq-bootstrap-cycle.md.
set -eu

overlay=$(cat <<'JSON'
{{ template "agents/cursor.cli-config.overlay.json" . }}
JSON
)

base=$(cat)
[ -z "$base" ] && base='{}'

# Cold-start fallback: jq is installed by the `base` ansible role, which
# runs AFTER this file-apply phase. Pass the live file through unchanged
# and warn — the next apply (after ansible) does the real merge.
if ! command -v jq >/dev/null 2>&1; then
  printf '%s\n' "modify_cli-config.json: jq not found; passing live file through unchanged. Re-run \`chezmoi apply\` after the base ansible role installs jq." >&2
  printf '%s' "$base"
  exit 0
fi

printf '%s' "$base" | jq --argjson overlay "$overlay" '. * $overlay'
