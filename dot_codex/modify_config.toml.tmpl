#!/bin/sh
# chezmoi modify_ script: deep-merge a managed overlay into ~/.codex/config.toml.
#
# Why: Codex CLI rewrites this file at runtime, adding per-project trust
# (`[projects."<absolute-path>"]`) and marketplace paths
# (`[marketplaces.<id>]`) that are machine-specific. Tracking the whole file
# would create constant diff and bake one machine's paths into another's apply.
# We enforce only stable preferences (personality, reasoning effort,
# [features], [tui.keymap.*], [plugins.*]) and round-trip the live machine
# state untouched. The default model is deliberately not pinned here so Codex
# can follow the account/CLI default unless the live config already has a
# user-chosen model.
#
# How: chezmoi pipes the current target file into stdin; this script prints
# the new contents on stdout. The merge runs in a small Python program because:
#   - jq doesn't speak TOML.
#   - mikefarah/yq's TOML emitter collapses nested tables into inline
#     `{ ... }` syntax and fails to quote keys with special characters
#     (e.g. `github@openai-curated`), producing invalid TOML on round-trip.
#   - Python 3.11+ ships `tomllib` built-in for reads; the inline writer below
#     handles the schema this file uses (scalars, nested string-key tables,
#     arrays-of-tables, inline tables inside mixed arrays) and quotes every
#     table key for safety.
#
# Comments do NOT survive the round-trip (tomllib discards them). That is safe
# for peon-ping's `# peon-ping Codex hooks begin` / `# install_dir = …` markers:
# its uninstaller (`hooks/peon-ping/scripts/codex-config.py`) also matches
# `[[hooks.<Event>.hooks]]` sections by adapter path, so it still finds and
# replaces its own block after the markers are stripped.
#
# Merge precedence (later wins):
#   1. Stripped live (everything except [projects] and [marketplaces.*]).
#   2. Managed overlay (this script's $overlay heredoc).
#   3. Machine-local state ([projects.*], [marketplaces.*]) re-attached
#      verbatim so per-project trust survives an overlay churn.
#
# To manage an additional key: edit .chezmoitemplates/agents/codex.config.overlay.toml
# Python runtime: prefer `uv` (Linuxbrew/cargo-installed in the base ansible
# role; standard on macOS), which fetches a managed Python ≥ 3.11 if the host
# system python is older — guaranteeing built-in `tomllib`. Falls back to
# system `python3`, then to a no-op pass-through, so a fresh-bootstrap host
# without uv yet doesn't fail this modify_ script.
set -eu

overlay=$(cat <<'TOML'
{{ include (joinPath .chezmoi.sourceDir ".chezmoitemplates/agents/codex.config.overlay.toml") }}
TOML
)

base=$(cat)

# Pick the python invocation. uv guarantees ≥3.11 → tomllib always
# importable; system python3 may be older but the script's own ImportError
# handler passes the live file through untouched if so. `--no-project`
# stops uv from picking up the dotfiles repo's pyproject.toml. `--quiet`
# silences "Installed X" log noise on first run.
if command -v uv >/dev/null 2>&1; then
  set -- uv run --no-project --quiet --python '>=3.11' python -
elif command -v python3 >/dev/null 2>&1; then
  set -- python3 -
else
  echo "modify_config.toml: neither uv nor python3 found; skipping merge" >&2
  printf '%s' "$base"
  exit 0
fi

# Pass live file + overlay via env vars; emit merged TOML on stdout. If
# anything goes wrong (tomllib missing on Python <3.11, malformed live file),
# Python prints to stderr and exits non-zero -> chezmoi skips the file.
CODEX_LIVE="$base" CODEX_OVERLAY="$overlay" "$@" <<'PYEOF'
import datetime
import os
import sys

try:
    import tomllib  # Python 3.11+
except ModuleNotFoundError:
    try:
        import tomli as tomllib  # backport for Python 3.10 and below
    except ModuleNotFoundError:
        print(
            "modify_config.toml: tomllib unavailable (need Python 3.11+ or "
            "`pip install tomli`); skipping merge",
            file=sys.stderr,
        )
        sys.stdout.write(os.environ.get("CODEX_LIVE", ""))
        sys.exit(0)


def parse(text: str) -> dict:
    text = text.strip()
    if not text:
        return {}
    return tomllib.loads(text)


def deep_merge(base: dict, overlay: dict) -> dict:
    """Recursive dict merge; overlay wins on conflict. Non-dict overlay
    values replace base wholesale (lists are not concatenated)."""
    out = dict(base)
    for k, v in overlay.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def prune_reserved_builtin_providers(live: dict) -> None:
    """Remove invalid overrides for Codex built-in provider IDs.

    Codex accepts `model_providers.openai.*` via one-off `-c` CLI overrides but
    rejects persisted config.toml files that override the reserved built-in
    `openai` provider. Removing the whole table repairs configs produced by
    the previous GFW retry experiment and any equivalent manual override.
    Custom provider IDs such as `openai-gfw` are left untouched.
    """
    providers = live.get("model_providers")
    if not isinstance(providers, dict):
        return
    providers.pop("openai", None)
    if not providers:
        del live["model_providers"]


def prune_deprecated_features(live: dict) -> None:
    """Drop deprecated `[features]` keys from live so they don't survive merge.

    Codex 0.130+ renamed `codex_hooks` → `hooks`. deep_merge only replaces keys
    present in overlay, so without explicit removal the live `codex_hooks =
    true` would persist alongside the new `hooks = true` and Codex would keep
    emitting the deprecation warning.
    """
    features = live.get("features")
    if not isinstance(features, dict):
        return
    features.pop("codex_hooks", None)
    if not features:
        del live["features"]


def prune_stale_managed_model(live: dict) -> None:
    """Drop old model pins previously managed by this dotfiles overlay.

    The overlay no longer pins Codex's default model; users can still keep a
    live `model = ...` of their own. Only remove exact stale values this repo
    is known to have written, so custom model choices survive the merge.
    """
    if live.get("model") in {"gpt-5.4"}:
        del live["model"]


def fmt_scalar(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        # Use basic-string with escaping. tomllib accepts both basic and
        # literal; basic is universal.
        return '"' + v.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'
    if isinstance(v, (datetime.datetime, datetime.date, datetime.time)):
        # tomllib decodes bare TOML date-times into datetime objects;
        # isoformat() is RFC 3339, which is exactly TOML's syntax. Unquoted
        # on purpose — quoting would demote them to strings on re-read.
        return v.isoformat()
    if isinstance(v, list):
        return "[" + ", ".join(fmt_scalar(x) for x in v) + "]"
    if isinstance(v, dict):
        # Inline table. Only reached for a table nested in a list that
        # is_table_array() rejected (mixed or empty); an all-table list is
        # emitted as [[array-of-tables]] headers by emit_table instead.
        inner = ", ".join(f"{quote_key(k)} = {fmt_scalar(x)}" for k, x in v.items())
        return "{ " + inner + " }" if inner else "{}"
    raise TypeError(f"unsupported scalar type for TOML emit: {type(v).__name__}")


def is_table_array(v) -> bool:
    """True for a list emittable as `[[header]]` blocks: non-empty, all tables.

    Empty lists (`k = []`) and mixed lists have no array-of-tables spelling,
    so they stay inline arrays and go through fmt_scalar. Codex itself writes
    no arrays-of-tables, but peon-ping's Codex adapter installs `[[hooks.
    <Event>]]` / `[[hooks.<Event>.hooks]]` blocks into this file, and those
    have to round-trip.
    """
    return isinstance(v, list) and bool(v) and all(isinstance(x, dict) for x in v)


def emit_table(prefix: str, table: dict, out: list[str], *, header: bool = True) -> None:
    """Emit a TOML table. `prefix` is the dotted header path (already quoted
    where needed); empty for root. Scalars come first, then nested tables,
    then arrays-of-tables. `header=False` skips the `[prefix]` line for an
    array-of-tables element whose `[[prefix]]` header the caller already
    wrote."""
    scalars = {
        k: v for k, v in table.items() if not isinstance(v, dict) and not is_table_array(v)
    }
    sub = {k: v for k, v in table.items() if isinstance(v, dict)}
    arrays = {k: v for k, v in table.items() if is_table_array(v)}

    if header and prefix and (scalars or not (sub or arrays)):
        out.append(f"[{prefix}]")
    for k, v in scalars.items():
        out.append(f"{quote_key(k)} = {fmt_scalar(v)}")
    if scalars and (sub or arrays):
        out.append("")

    # Plain sub-tables MUST precede arrays-of-tables at every level: after a
    # `[[p.arr]]` header, a following `[p.plain]` would still resolve against
    # `p`, but the reader's "last [[…]] element" cursor makes that far easier
    # to get wrong on the next edit. Emitting siblings first keeps each
    # `[[…]]` block self-contained, which is also what peon-ping's section
    # scanner expects (parent immediately followed by its handlers).
    for k, v in sub.items():
        sub_prefix = f"{prefix}.{quote_key(k)}" if prefix else quote_key(k)
        emit_table(sub_prefix, v, out)
        out.append("")

    for k, items in arrays.items():
        sub_prefix = f"{prefix}.{quote_key(k)}" if prefix else quote_key(k)
        for item in items:
            out.append(f"[[{sub_prefix}]]")
            emit_table(sub_prefix, item, out, header=False)
            out.append("")


def quote_key(k: str) -> str:
    """Quote any key that isn't a bare TOML key (alnum / `_` / `-` only).
    We over-quote rather than risk emitting invalid TOML for keys like
    `github@openai-curated` or absolute-path project keys."""
    if k and all(c.isalnum() or c in "_-" for c in k):
        return k
    return '"' + k.replace("\\", "\\\\").replace('"', '\\"') + '"'


live = parse(os.environ.get("CODEX_LIVE", ""))
overlay = parse(os.environ.get("CODEX_OVERLAY", ""))
prune_reserved_builtin_providers(live)
prune_deprecated_features(live)
prune_stale_managed_model(live)

# Pull machine-local subtrees out before merge; re-attach last so they win.
state = {}
for key in ("projects", "marketplaces"):
    if key in live:
        state[key] = live.pop(key)

merged = deep_merge(live, overlay)
merged = deep_merge(merged, state)

lines: list[str] = []
emit_table("", merged, lines)
text = "\n".join(line for line in lines if line is not None).rstrip() + "\n"
sys.stdout.write(text)
PYEOF
