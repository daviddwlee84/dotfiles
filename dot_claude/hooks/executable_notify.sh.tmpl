#!/usr/bin/env bash
set -euo pipefail

# Claude Code notification hook using apprise
# Notifications are configured in ~/.config/apprise/apprise.yaml
#
# Delivery is a three-rung ladder: apprise -> the OS notifier -> a log file.
# apprise fails CLOSED and QUIETLY whenever its desktop backend is unavailable
# — e.g. apprise installed as a uv tool whose venv has no dbus-python, which
# makes the dbus:// plugin disable itself and every send exit 1 with no output
# on stderr. This script used to end in `2>/dev/null || true`, which turned
# that into months of silently dropped notifications. Never let a failed send
# vanish again: if both notifiers fail, the log line is the evidence.
# See pitfalls/apprise-dbus-disabled-in-uv-tool-venv.md

# Where the last-resort record goes when nothing could be displayed.
NOTIFY_LOG="${CLAUDE_NOTIFY_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/claude/notify.log}"

# Read JSON from stdin
json="$(cat)"

# Parse fields
event="$(echo "$json" | jq -r '.hook_event_name // "unknown"')"
title="$(echo "$json" | jq -r '.title // "Claude Code"')"
msg="$(echo "$json" | jq -r '.message // empty')"
ntype="$(echo "$json" | jq -r '.notification_type // empty')"

# Handle Stop event (no message/title in payload)
if [[ "$event" == "Stop" ]]; then
  title="Claude Code"
  msg="Task finished"
fi

# Build full title with notification type
full_title="$title"
[[ -n "$ntype" ]] && full_title="$title [$ntype]"

# Rung 1: apprise using the desktop tag.
# Desktop notifications are auto-detected by OS in apprise.yaml
notify_via_apprise() {
  command -v apprise >/dev/null 2>&1 || return 1
  apprise --tag desktop --title "$full_title" --body "$msg" >/dev/null 2>&1
}

# Rung 2: the OS's own notifier, bypassing apprise entirely.
notify_via_os() {
{{- if eq .chezmoi.os "darwin" }}
  if command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "$full_title" -message "${msg:- }" >/dev/null 2>&1 && return 0
  fi
  # osascript is always present on macOS. Pass the text as arguments rather
  # than interpolating it into the AppleScript source — a message containing a
  # double quote would otherwise be a syntax error (or worse).
  command -v osascript >/dev/null 2>&1 || return 1
  osascript \
    -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
    -e 'end run' \
    "$full_title" "${msg:- }" >/dev/null 2>&1
{{- else if eq .chezmoi.os "linux" }}
  command -v notify-send >/dev/null 2>&1 || return 1
  notify-send -a "Claude Code" "$full_title" "${msg:- }" >/dev/null 2>&1
{{- else }}
  return 1
{{- end }}
}

# Rung 3: leave a durable trace. Tail it with:
#   tail -f "${XDG_STATE_HOME:-$HOME/.local/state}/claude/notify.log"
notify_via_log() {
  local dir
  dir="$(dirname "$NOTIFY_LOG")"
  mkdir -p "$dir" >/dev/null 2>&1 || return 1
  printf '%s\t%s\t%s\t%s\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$event" "$full_title" "$msg" \
    >>"$NOTIFY_LOG" 2>/dev/null
}

if ! notify_via_apprise && ! notify_via_os; then
  notify_via_log || true
fi

# A hook must never fail the tool call it is attached to.
exit 0
