#!/bin/sh
# chezmoi modify_ script: deep-merge a managed overlay into ~/.claude/settings.json.
#
# Why: Claude Code rewrites ~/.claude/settings.json at runtime (adds fields like
# "permissions", "skipAutoPermissionPrompt", reorders keys). Treating it as a
# static managed file produces diff noise on every `chezmoi apply`.
#
# How: chezmoi pipes the current target file into stdin; this script prints the
# new contents on stdout. `jq '. * $overlay'` does recursive object merge, so
# only the keys declared in $overlay are enforced by chezmoi; any other keys
# that Claude Code adds at runtime are preserved verbatim. Arrays inside the
# overlay replace their counterparts wholesale (no duplicate accumulation).
#
# To manage an additional key: add it to the $overlay JSON below.
# Requires: jq (installed by the `base` ansible role).
set -eu

overlay=$(cat <<'JSON'
{
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "claude-hud@claude-hud": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | sort -V | tail -1); runtime=$(command -v bun 2>/dev/null || command -v node 2>/dev/null); [ -z \"$runtime\" ] && exit 0; rt=\"${runtime##*/}\"; if [ \"$rt\" = \"bun\" ]; then exec \"$runtime\" --env-file /dev/null \"${plugin_dir}src/index.ts\"; else exec \"$runtime\" \"${plugin_dir}dist/index.js\"; fi'"
  }
}
JSON
)

base=$(cat)
[ -z "$base" ] && base='{}'

printf '%s' "$base" | jq --argjson overlay "$overlay" '. * $overlay'
