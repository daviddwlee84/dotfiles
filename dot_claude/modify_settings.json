#!/bin/sh
# chezmoi modify_ script: hook-aware deep-merge of a managed overlay into
# ~/.claude/settings.json.
#
# Why hook-aware? Claude Code rewrites this file at runtime AND CodeIsland
# (https://github.com/wxtsky/CodeIsland, macOS notch HUD) auto-installs its
# own entries into hooks.Notification / hooks.PermissionRequest / hooks.Stop
# / hooks.PreToolUse / etc. A naive `jq '. * $overlay'` deep-merge replaces
# arrays wholesale, so declaring our notify.sh hook in the overlay would
# silently delete every CodeIsland entry on each `chezmoi apply` (and
# CodeIsland would re-install on next launch — endless ping-pong).
#
# How: For all keys EXCEPT .hooks, do the normal recursive object merge.
# For .hooks.<event> arrays, additively merge — append overlay entries that
# aren't already present (matched by .hooks[0].command), preserving every
# entry the live file already contains. This lets our overlay enforce
# notify.sh while CodeIsland (or any other tool) freely manages its own
# parallel entries in the same event arrays.
#
# To manage an additional hook event: add it to $overlay.hooks below.
# To manage an additional non-hook key: add it to $overlay.
# Requires: jq (installed by the `base` ansible role). On a fresh-box first
# apply, jq isn't yet installed; this script falls back to passing the live
# file through unchanged. See pitfalls/modify-script-jq-bootstrap-cycle.md.
#
# See: docs/tools/agent-overlays.md → "CodeIsland integration".
set -eu

overlay=$(cat <<'JSON'
{
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "claude-hud@claude-hud": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | sort -V | tail -1); runtime=$(command -v bun 2>/dev/null || command -v node 2>/dev/null); [ -z \"$runtime\" ] && exit 0; rt=\"${runtime##*/}\"; if [ \"$rt\" = \"bun\" ]; then exec \"$runtime\" --env-file /dev/null \"${plugin_dir}src/index.ts\"; else exec \"$runtime\" \"${plugin_dir}dist/index.js\"; fi'"
  }
}
JSON
)

base=$(cat)
[ -z "$base" ] && base='{}'

# Cold-start fallback: jq is installed by the `base` ansible role, which
# runs AFTER this file-apply phase. Pass the live file through unchanged
# and warn — the next apply (after ansible) does the real merge.
if ! command -v jq >/dev/null 2>&1; then
  printf '%s\n' "modify_settings.json: jq not found; passing live file through unchanged. Re-run \`chezmoi apply\` after the base ansible role installs jq." >&2
  printf '%s' "$base"
  exit 0
fi

# Hook-aware merge:
#   1. Compute non-hook portion of overlay (everything except .hooks).
#   2. Deep-merge that into base normally: base * overlay_no_hooks.
#   3. For each event in overlay.hooks, append entries whose .hooks[0].command
#      isn't already represented in the live event array (by exact-string
#      command match on .hooks[0].command). Live entries are preserved
#      verbatim, and new overlay entries are added at the end.
printf '%s' "$base" | jq --argjson overlay "$overlay" '
  . as $base
  | ($overlay | del(.hooks)) as $non_hook_overlay
  | ($overlay.hooks // {}) as $overlay_hooks
  | ($base * $non_hook_overlay) as $merged
  | $merged
  | .hooks = (
      ($merged.hooks // {}) as $live_hooks
      | reduce ($overlay_hooks | to_entries[]) as $ev (
          $live_hooks;
          .[$ev.key] = (
            (.[$ev.key] // []) as $live_arr
            | ($live_arr | map(.hooks[0].command? // "")) as $live_cmds
            | $live_arr + (
                $ev.value
                | map(select(
                    (.hooks[0].command? // "") as $cmd
                    | ($cmd == "") or (($live_cmds | index($cmd)) == null)
                  ))
              )
          )
        )
    )
'
