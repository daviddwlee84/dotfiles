#!/bin/sh
# chezmoi modify_ script: hook-aware deep-merge of a managed overlay into
# ~/.claude/settings.json.
#
# Why hook-aware? Claude Code rewrites this file at runtime AND CodeIsland
# (https://github.com/wxtsky/CodeIsland, macOS notch HUD) auto-installs its
# own entries into hooks.Notification / hooks.PermissionRequest / hooks.Stop
# / hooks.PreToolUse / etc. workmux's `wm setup` ALSO writes Stop /
# UserPromptSubmit / Notification hook entries (see docs/tools/workmux.md
# → "Claude leak"). A naive `jq '. * $overlay'` deep-merge replaces arrays
# wholesale, so declaring our notify.sh hook in the overlay would silently
# delete every CodeIsland / workmux entry on each `chezmoi apply` (and the
# tools would re-install on next launch — endless ping-pong).
#
# How: For all keys EXCEPT .hooks, do the normal recursive object merge.
# For .hooks.<event> arrays, additively merge — append overlay entries that
# aren't already present (matched by .hooks[0].command), preserving every
# entry the live file already contains. This lets our overlay enforce
# notify.sh + workmux status updates while CodeIsland / workmux setup /
# any other tool freely manage their own parallel entries in the same
# event arrays.
#
# Workmux integration: We declare the workmux Stop / SubagentStop /
# UserPromptSubmit / Notification hooks here directly so they're enforced
# on every chezmoi apply WITHOUT requiring users to also run `wm setup`.
# The `command -v workmux` guard lets the hook no-op silently on machines
# where workmux isn't installed yet (fresh box, Linux without ansible run,
# etc.). This patches Claude's by-design 🤖-leak: Anthropic's Stop hook
# fires on every turn end, but workmux's `working` state never auto-clears
# without an explicit `done` set.
#
# To manage an additional hook event: add it to $overlay.hooks below.
# To manage an additional non-hook key: add it to $overlay.
# Requires: jq (installed by the `base` ansible role). On a fresh-box first
# apply, jq isn't yet installed; this script falls back to passing the live
# file through unchanged. See pitfalls/modify-script-jq-bootstrap-cycle.md.
#
# Completion feedback is gated on the `agentSounds` prompt (none|notify|peon|
# both) — see docs/tools/agent-sounds.md. This file is a TEMPLATE for that
# reason; the peon-ping hook entries below were lifted verbatim from a real
# `peon-ping-setup` run against a throwaway CLAUDE_CONFIG_DIR (its README
# documents a different, wrong command shape). We declare them ourselves and
# NEVER run `peon-ping-setup` on a managed machine — same rule as workmux's
# `wm setup`. The `[ -x … ]` guard makes the hook a silent no-op on a box
# where the binary isn't installed yet (fresh box, Linux without ansible),
# mirroring the mandatory `command -v workmux` guard.
#
# claude-hud is deliberately `enabledPlugins: false`. It ships two commands
# (`claude-hud:setup` / `claude-hud:configure`) that are install/config-time
# only, yet every session paid ~45 tokens to list them to the model. This is
# NOT a `skillOverrides` job — verified 2026-07 on CC 2.1.220 that neither
# "off" nor "user-invocable-only" gates *plugin* commands (the listing filter
# keys on a name that differs from the displayed `claude-hud:setup`); those
# values only work for user skills in ~/.claude/skills/.
#
# Disabling costs nothing here, because claude-hud is wired around the plugin
# system on every axis we use:
#   * the statusLine below globs ~/.claude/plugins/cache/claude-hud/*/ and
#     execs dist/index.js directly — it never resolves through the plugin
#     loader, so the HUD keeps rendering (verified by piping a real stdin
#     payload through it with the plugin disabled);
#   * updates come from roles/coding_agents/files/claude_hud_sync.py via
#     `just upgrade-plugins`, which only rewrites installed_plugins.json and
#     the versioned cache dir — it never reads enabledPlugins.
# Trade-off: `/claude-hud:setup` and `/claude-hud:configure` stop resolving.
# Flip this to true (or toggle in `/plugin`) for the rare reconfigure, then
# flip back. Day-to-day config lives in dot_claude/plugins/claude-hud/config.json.
#
# See: docs/tools/agent-overlays.md → "CodeIsland integration".
set -eu

overlay=$(cat <<'JSON'
{
  "hooks": {
{{- $peon := or (eq .agentSounds "peon") (eq .agentSounds "both") }}
{{- $notify := or (eq .agentSounds "notify") (eq .agentSounds "both") }}
{{- $peonCmd := "[ -x \"$HOME/.claude/hooks/peon-ping/peon.sh\" ] && \"$HOME/.claude/hooks/peon-ping/peon.sh\" || true" }}
{{- $retireObserveCmd := "command -v dev >/dev/null 2>&1 && command dev artifact observe-session-end >/dev/null 2>&1 || true" }}
    "SessionEnd": [
      { "matcher": "", "hooks": [ { "type": "command", "command": {{ $retireObserveCmd | quote }}, "timeout": 5 } ] }{{ if $peon }},
      { "matcher": "", "hooks": [ { "type": "command", "command": {{ $peonCmd | quote }}, "timeout": 10, "async": true } ] }{{ end }}
    ],
{{- if $peon }}
    "SessionStart": [
      { "matcher": "", "hooks": [ { "type": "command", "command": {{ $peonCmd | quote }}, "timeout": 10 } ] }
    ],
    "SubagentStart": [
      { "matcher": "", "hooks": [ { "type": "command", "command": {{ $peonCmd | quote }}, "timeout": 10, "async": true } ] }
    ],
    "PermissionRequest": [
      { "matcher": "", "hooks": [ { "type": "command", "command": {{ $peonCmd | quote }}, "timeout": 10, "async": true } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": {{ $peonCmd | quote }}, "timeout": 10, "async": true } ] }
    ],
    "PreCompact": [
      { "matcher": "", "hooks": [ { "type": "command", "command": {{ $peonCmd | quote }}, "timeout": 10, "async": true } ] }
    ],
{{- end }}
    "Notification": [
{{- if $notify }}
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      },
{{- end }}
{{- if $peon }}
      { "matcher": "", "hooks": [ { "type": "command", "command": {{ $peonCmd | quote }}, "timeout": 10, "async": true } ] },
{{- end }}
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status waiting || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
{{- if $peon }}
      { "matcher": "", "hooks": [ { "type": "command", "command": {{ $peonCmd | quote }}, "timeout": 10, "async": true } ] },
{{- end }}
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status working || true"
          }
        ]
      }
    ],
    "Stop": [
{{- if $notify }}
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      },
{{- end }}
{{- if $peon }}
      { "matcher": "", "hooks": [ { "type": "command", "command": {{ $peonCmd | quote }}, "timeout": 10, "async": true } ] },
{{- end }}
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status done || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status done || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "claude-hud@claude-hud": false
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | sort -V | tail -1); runtime=$(command -v bun 2>/dev/null || command -v node 2>/dev/null); [ -z \"$runtime\" ] && exit 0; rt=\"${runtime##*/}\"; if [ \"$rt\" = \"bun\" ]; then exec \"$runtime\" --env-file /dev/null \"${plugin_dir}src/index.ts\"; else exec \"$runtime\" \"${plugin_dir}dist/index.js\"; fi'"
  }
}
JSON
)

base=$(cat)
[ -z "$base" ] && base='{}'

# Cold-start fallback: jq is installed by the `base` ansible role, which
# runs AFTER this file-apply phase. Pass the live file through unchanged
# and warn — the next apply (after ansible) does the real merge.
if ! command -v jq >/dev/null 2>&1; then
  printf '%s\n' "modify_settings.json: jq not found; passing live file through unchanged. Re-run \`chezmoi apply\` after the base ansible role installs jq." >&2
  printf '%s' "$base"
  exit 0
fi

# Hook-aware merge:
#   1. Compute non-hook portion of overlay (everything except .hooks).
#   2. Deep-merge that into base normally: base * overlay_no_hooks.
#   3. For each event in overlay.hooks, append entries whose .hooks[0].command
#      isn't already represented in the live event array (by exact-string
#      command match on .hooks[0].command). Live entries are preserved
#      verbatim, and new overlay entries are added at the end.
#   4. Prune OUR OWN entries that the current agentSounds tier disables.
#
# Step 4 is the one deliberate exception to "never subtract". Without it the
# additive merge makes `agentSounds` a one-way ratchet: switching notify -> none
# would leave the already-installed notify.sh hook wired forever, so `none`
# would not actually silence a machine that previously had sound (verified
# 2026-07 — this is exactly what happened on the first apply).
#
# The invariant that matters is preserved: we only ever prune commands WE
# declare. $prune is built from our own fingerprints, never from a foreign
# command, so CodeIsland / workmux / herdr entries can never be touched no
# matter what the tier is. Empty event arrays are dropped so turning everything
# off doesn't leave "SessionStart": [] litter behind.
{{- $prune := list }}
{{- if not $notify }}{{ $prune = append $prune "/.claude/hooks/notify.sh" }}{{ end }}
{{- if not $peon }}{{ $prune = append $prune "/.claude/hooks/peon-ping/peon.sh" }}{{ end }}
printf '%s' "$base" | jq --argjson overlay "$overlay" --argjson prune {{ $prune | toJson | quote }} '
  . as $base
  | ($overlay | del(.hooks)) as $non_hook_overlay
  | ($overlay.hooks // {}) as $overlay_hooks
  | ($base * $non_hook_overlay) as $merged
  | $merged
  | .hooks = (
      ($merged.hooks // {}) as $live_hooks
      | reduce ($overlay_hooks | to_entries[]) as $ev (
          $live_hooks;
          .[$ev.key] = (
            (.[$ev.key] // []) as $live_arr
            | ($live_arr | map(.hooks[0].command? // "")) as $live_cmds
            | $live_arr + (
                $ev.value
                | map(select(
                    (.hooks[0].command? // "") as $cmd
                    | ($cmd == "") or (($live_cmds | index($cmd)) == null)
                  ))
              )
          )
        )
    )
  | .hooks = (
      .hooks
      | map_values(
          map(select(
            (.hooks[0].command? // "") as $cmd
            | ($prune | any(. as $frag | $cmd | contains($frag))) | not
          ))
        )
      | with_entries(select(.value | length > 0))
    )
'
